#!/bin/sh
# Clysm — a Common Lisp implementation targeting WebAssembly GC.
#
#   clysm compile [--shake] [--shake-symbols] [--shake-why REPORT] [--eval-string] FILE... [-o OUT.wasm]
#                                         compile Lisp sources (with the runtime) to a Wasm module;
#                                         --shake leaves out the functions nothing refers to;
#                                         --shake-symbols (implies --shake) the symbols too: the
#                                         program does not look up by name (INTERN, FIND-SYMBOL,
#                                         READ) symbols its code does not refer to;
#                                         --shake-why (implies --shake) writes the size of each
#                                         kept function and what kept it to REPORT; --eval-string
#                                         keeps the reader and evaluator for the host's eval_string
#                                         (a module without --shake always has them)
#   clysm build [--system NAME]... [--asd FILE.asd]... [--load FILE]... [--asdf] [--shake] [--eval FORM]... [--main FUNCTION [--image]] [-o OUT.wasm] [FILE...]
#                                         build an application into ONE module with the runtime:
#                                         the ASDF systems NAME (found as (require :asdf) and
#                                         Quicklisp find them, or defined by FILE.asd) with the
#                                         systems they depend on, then the FILEs, then the FORMs
#                                         (its entry point), compiled as a whole program; the
#                                         systems are loaded into the REPL image that compiles
#                                         them, so macros and EVAL-WHEN work as in COMPILE-FILE;
#                                         --load: a file loaded there first (where the systems are)
#                                         --asdf: ASDF and UIOP are part of the program;
#                                         --shake: without the functions nothing refers to
#                                         --main: the function the program runs; with --image
#                                         the heap after the toplevel forms ran is saved in
#                                         OUT.img, and `clysm exec OUT.wasm` starts from it
#                                         (see docs/INTERNALS.md, "Applications in one module")
#   clysm run FILE... [-- ARGS]           compile and run on Node.js
#   clysm repl [--interp] [--no-userinit] start the REPL (runs in Wasm; each form is compiled
#                                         to a new Wasm module, or interpreted with --interp);
#                                         ~/.clysmrc is loaded first unless --no-userinit
#   clysm script FILE                     load FILE in the REPL image
#   clysm eval [--no-userinit] FORM...    evaluate the FORMs in the REPL image
#   clysm swank [--port N]                start a SWANK server for SLIME (M-x slime-connect),
#                                         port 4005 by default; needs Quicklisp
#   clysm exec OUT.wasm [ARGS]            run a compiled module
#   clysm test [--watch] [-j N] [--dom] [--system NAME [--asd FILE]] FILE...
#                                         run test programs (see docs/INTERNALS.md)
#   clysm library [--shake] [--shake-symbols] [--shake-why REPORT] [--eval-string] FILE... -o DIR/NAME.wasm
#                                         compile a library for JavaScript: NAME.wasm,
#                                         NAME.wasm.debug (the names of its functions, for
#                                         stack traces), NAME.mjs (the functions of
#                                         JS:EXPORT), NAME.d.ts
set -e
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
NODE="${NODE:-node}"
# The young generation may grow to semi-spaces of 256 MB (the engine's default
# is 64; CLYSM_NURSERY_MB names another size): see host/run.mjs, which gives
# it to the worker a compiled program runs in; the main thread, where the REPL
# image runs, takes it from the command line.
# compile/library --shake --preinit-through FILE runs the program's toplevel
# forms through FILE during compilation; later files still run when loaded.
NURSERY="--max-semi-space-size=${CLYSM_NURSERY_MB:-256}"
# The compiler runs on SBCL, whose heap is 1 GB (or 8 GB, as it was built) unless it is told:
# a large program (a system of some hundred files, with --shake) needs more than 1 GB.
# CLYSM_SBCL_HEAP_MB names another size.
SBCL_HEAP="${CLYSM_SBCL_HEAP_MB:-4096}"
cmd="$1"; [ $# -gt 0 ] && shift
stale() { [ ! -f "$1" ] || [ -n "$(find "$ROOT/runtime" "$ROOT/src" "$ROOT/lib" -newer "$1" -name '*.lisp' 2>/dev/null | head -1)" ]; }
interp_image() {
  img="$ROOT/build/clysm-repl.wasm"
  if stale "$img"; then
    sbcl --script "$ROOT/tools/build.lisp" "$img" "$ROOT/lib/repl-main.lisp" >/dev/null 2>&1 || {
      echo "clysm: failed to build the REPL image" >&2; exit 1; }
  fi
  echo "$img"
}
repl_image() {
  img="$ROOT/build/clysm-native.wasm"
  if stale "$img"; then
    sbcl --script "$ROOT/tools/build-repl.lisp" "$img" >/dev/null 2>&1 || {
      echo "clysm: failed to build the REPL image" >&2; exit 1; }
  fi
  echo "$img"
}
# The REPL image starts from a heap image of itself saved after its toplevel
# forms ran (build/clysm-native.img, made when the image is built; see
# "Start-up and loading" in docs/INTERNALS.md), unless CLYSM_IMAGE names
# another or CLYSM_SAVE_IMAGE is set (an image started from a heap image
# cannot save one); CLYSM_NO_HEAP_IMAGE=1 starts it as it is.
heap_image() {
  [ -n "$CLYSM_IMAGE" ] || [ -n "$CLYSM_SAVE_IMAGE" ] || [ -n "$CLYSM_NO_HEAP_IMAGE" ] && return
  himg="${1%.wasm}.img"
  if [ ! -f "$himg" ] || [ "$1" -nt "$himg" ]; then
    tmp="$himg.tmp$$"
    CLYSM_SAVE_IMAGE=1 "$NODE" "$ROOT/host/run.mjs" "$1" --no-userinit \
      --eval "(sys::save-image \"$tmp\" (function sys::main))" </dev/null >/dev/null 2>&1 \
      && { CLYSM_IMAGE="$tmp" CLYSM_TRAIN_IMAGE=1 "$NODE" "$ROOT/host/run.mjs" "$1" --no-userinit \
             --eval "(load \"$ROOT/lib/image-training.lisp\")" </dev/null >/dev/null 2>&1; true; } \
      && mv -f "$tmp" "$himg" 2>/dev/null
    rm -f "$tmp"
  fi
  [ -f "$himg" ] && export CLYSM_IMAGE="$himg"
}
case "$cmd" in
  compile)
    out="a.wasm"; files=""; shake=""
    while [ $# -gt 0 ]; do
      case "$1" in -o) out="$2"; shift 2;; --shake) shake="--shake $shake"; shift;;
                   --shake-symbols) shake="--shake-symbols $shake"; shift;;
                   --shake-why) shake="$shake --shake-why $2"; shift 2;;
                   --preinit-through) [ $# -ge 2 ] || { echo "--preinit-through needs a source file" >&2; exit 1; }; shake="$shake --preinit-through $2"; shift 2;;
                   --eval-string) shake="$shake --eval-string"; shift;; *) files="$files $1"; shift;; esac
    done
    exec sbcl --dynamic-space-size "$SBCL_HEAP" --script "$ROOT/tools/build.lisp" $shake "$out" $files ;;
  library)
    out=""; files=""; shake=""
    while [ $# -gt 0 ]; do
      case "$1" in -o) out="$2"; shift 2;; --shake) shake="--shake $shake"; shift;;
                   --shake-symbols) shake="--shake-symbols $shake"; shift;;
                   --shake-why) shake="$shake --shake-why $2"; shift 2;;
                   --preinit-through) [ $# -ge 2 ] || { echo "--preinit-through needs a source file" >&2; exit 1; }; shake="$shake --preinit-through $2"; shift 2;;
                   --eval-string) shake="$shake --eval-string"; shift;; *) files="$files $1"; shift;; esac
    done
    [ -n "$out" ] || { echo "clysm library: -o DIR/NAME.wasm is needed" >&2; exit 1; }
    mkdir -p "$(dirname "$out")"
    sbcl --dynamic-space-size "$SBCL_HEAP" --script "$ROOT/tools/build.lisp" $shake "$out" $files || exit 1
    exec "$NODE" "$ROOT/tools/gen-library.mjs" "$out" ;;
  run)
    files=""
    while [ $# -gt 0 ]; do
      case "$1" in --) shift; break;; *) files="$files $1"; shift;; esac
    done
    mkdir -p "$ROOT/build"
    out="$ROOT/build/run-$$.wasm"
    sbcl --dynamic-space-size "$SBCL_HEAP" --script "$ROOT/tools/build.lisp" "$out" $files >/dev/null 2>"$out.log" || { cat "$out.log" >&2; rm -f "$out.log"; exit 1; }
    rm -f "$out.log"
    status=0; "$NODE" $NURSERY "$ROOT/host/run.mjs" "$out" "$@" || status=$?
    rm -f "$out"; exit $status ;;
  repl)   if [ "$1" = "--interp" ]; then shift; exec "$NODE" $NURSERY "$ROOT/host/run.mjs" "$(interp_image)" "$@"; fi
          img="$(repl_image)"; heap_image "$img"
          exec "$NODE" $NURSERY "$ROOT/host/run.mjs" "$img" "$@" ;;
  script) img="$(repl_image)"; heap_image "$img"
          exec "$NODE" $NURSERY "$ROOT/host/run.mjs" "$img" "$@" ;;
  eval)   img="$(repl_image)"; heap_image "$img"
          if [ "$1" = "--no-userinit" ]; then shift; exec "$NODE" $NURSERY "$ROOT/host/run.mjs" "$img" --no-userinit --eval "$@"; fi
          exec "$NODE" $NURSERY "$ROOT/host/run.mjs" "$img" --eval "$@" ;;
  swank)  port=4005
          while [ $# -gt 0 ]; do
            case "$1" in --port) port="$2"; shift 2;; *) echo "clysm swank: unknown option $1" >&2; exit 1;; esac
          done
          img="$(repl_image)"; heap_image "$img"
          CLYSM_SWANK_PORT="$port" exec "$NODE" $NURSERY "$ROOT/host/run.mjs" "$img" "$ROOT/contrib/swank/start.lisp" ;;
  build)  img="$(repl_image)"; heap_image "$img"
          # --image: the heap of the program after its toplevel forms ran is
          # saved next to the module (OUT.img), and `clysm exec` starts from it
          out="a.wasm"; image=""; prev=""
          for a in "$@"; do
            [ "$prev" = "-o" ] && out="$a"
            [ "$a" = "--image" ] && image=1
            prev="$a"
          done
          [ -n "$image" ] || exec "$NODE" $NURSERY "$ROOT/host/run.mjs" "$img" "$ROOT/tools/static-build.lisp" "$@"
          rm -f "${out%.wasm}.img"
          "$NODE" $NURSERY "$ROOT/host/run.mjs" "$img" "$ROOT/tools/static-build.lisp" "$@" || exit 1
          unset CLYSM_IMAGE
          CLYSM_SAVE_IMAGE=1 CLYSM_APP_IMAGE="${out%.wasm}.img.tmp$$" "$NODE" "$ROOT/host/run.mjs" "$out" </dev/null \
            && mv -f "${out%.wasm}.img.tmp$$" "${out%.wasm}.img" \
            || { rm -f "${out%.wasm}.img.tmp$$"; echo "clysm build: the heap image was not saved" >&2; exit 1; }
          echo "; wrote ${out%.wasm}.img ($(wc -c < "${out%.wasm}.img") bytes)" >&2 ;;
  exec)   img="$1"; shift
          # (a program built with --image starts from its heap image)
          himg="${img%.wasm}.img"
          if [ -z "$CLYSM_IMAGE" ] && [ -z "$CLYSM_SAVE_IMAGE" ] && [ -z "$CLYSM_NO_HEAP_IMAGE" ] \
             && [ -f "$himg" ] && [ ! "$img" -nt "$himg" ]; then export CLYSM_IMAGE="$himg"; fi
          exec "$NODE" $NURSERY "$ROOT/host/run.mjs" "$img" "$@" ;;
  test)   exec "$NODE" "$ROOT/bin/clysm.mjs" test "$@" ;;
  image-interp) interp_image ;;
  image-native) repl_image ;;
  *) sed -n '2,/^set -e/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
