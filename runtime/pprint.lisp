(defun %pprint-do (stream list &rest noise)
  (declare (ignore noise))
  (%pp-form-block (stream list)
    (output-object (pprint-pop) stream)
    (pprint-exit-if-list-exhausted)
    (write-char #\Space stream)
    (pprint-indent :current 0 stream)
    ;; ~:<~@{~:<~^~W~^ ~@_~:I~W~@{ ~_~W~}~:>~^~:@_~}~:>
    (let ((vars (pprint-pop)))
      (pprint-logical-block (stream vars :prefix "(" :suffix ")")
        (loop
          (pprint-exit-if-list-exhausted)
          (let ((v (pprint-pop)))
            (pprint-logical-block (stream v :prefix "(" :suffix ")")
              (pprint-exit-if-list-exhausted)
              (output-object (pprint-pop) stream)
              (pprint-exit-if-list-exhausted)
              (write-char #\Space stream)
              (pprint-newline :miser stream)
              (pprint-indent :current 0 stream)
              (output-object (pprint-pop) stream)
              (loop
                (pprint-exit-if-list-exhausted)
                (write-char #\Space stream)
                (pprint-newline :linear stream)
                (output-object (pprint-pop) stream))))
          (pprint-exit-if-list-exhausted)
          (pprint-newline :mandatory stream))))
    (pprint-exit-if-list-exhausted)
    (write-char #\Space stream)
    (pprint-newline :linear stream)
    (pprint-linear stream (pprint-pop))
    (%pprint-tagbody-guts stream)))

