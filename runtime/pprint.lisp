;;;; pprint.lisp — the pretty printer
;;;;
;;;; An XP-style pretty printer (Waters' algorithm, as in CMUCL/SBCL).  A
;;;; pretty stream buffers output and queues conditional newlines, indentation
;;;; changes, tabs and logical block boundaries; whenever the line fills up,
;;;; the queued operations are resolved and complete lines are written to the
;;;; target stream.  Objects are printed through *print-pprint-dispatch*; the
;;;; standard table reproduces SBCL's layout of data and code.

;;; ------------------------------------------------------------
;;; pretty streams
;;; ------------------------------------------------------------

(defstruct (%pps (:constructor %make-pps))
  target
  (line-length 80)
  (buffer (%make-string 128 #\Space))
  (fill 0)                ; buffer fill pointer
  (offset 0)              ; output position of buffer index 0
  (start-column 0)        ; column of buffer index 0
  (line-number 0)
  (print-lines nil)
  (blocks nil)            ; stack of %lblock (innermost first)
  (prefix (%make-string 128 #\Space))
  (suffix (%make-string 128 #\Space))
  (queue-tail nil)
  (queue-head nil)
  (pending-blocks nil))

(defstruct (%lblock (:constructor %make-lblock))
  (start-column 0)
  (section-column 0)
  (per-line-prefix-end 0)
  (prefix-length 0)
  (suffix-length 0)
  (section-start-line 0))

;;; queued operations; TYPE is :newline :indent :block-start :block-end :tab
(defstruct (%qop (:constructor %make-qop))
  type
  (posn 0)
  (depth 0) section-end          ; :newline, :block-start
  kind                           ; :newline kind, :indent kind
  (amount 0)                     ; :indent
  block-end prefix suffix        ; :block-start (suffix also :block-end)
  sectionp relativep (colnum 0) (colinc 0)) ; :tab

(defun %pretty-stream-p (s) (and (%streamp s) (eq (stream-kind s) :pp)))
(defun %pp-capture-p (s) (%pretty-stream-p s))

(defun %make-pretty-stream (target)
  (let ((pps (%make-pps :target target
                        :line-length (or *print-right-margin* 80)
                        :start-column (or (%stream-column target) 0)
                        :print-lines *print-lines*
                        :blocks (list (%make-lblock)))))
    (%make-stream :kind :pp :buffer pps)))

(defun %string-grow (old new-length keep)
  (let ((new (%make-string new-length #\Space)))
    (dotimes (i keep) (%set-schar new i (%schar old i)))
    new))

(defun %index-posn (index pps) (+ index (%pps-offset pps)))
(defun %posn-index (posn pps) (- posn (%pps-offset pps)))
(defun %posn-column (posn pps) (%index-column (%posn-index posn pps) pps))

(defun %index-column (index pps)
  (let ((column (%pps-start-column pps))
        (section-start (%lblock-section-column (car (%pps-blocks pps))))
        (end-posn (%index-posn index pps)))
    (dolist (op (%pps-queue-tail pps))
      (when (>= (%qop-posn op) end-posn) (return))
      (case (%qop-type op)
        (:tab
         (setq column (+ column (%compute-tab-size op section-start
                                                   (+ column (%posn-index (%qop-posn op) pps))))))
        ((:newline :block-start)
         (setq section-start (+ column (%posn-index (%qop-posn op) pps))))))
    (+ column index)))

(defun %pp-stream-column (s)
  (let ((pps (stream-buffer s)))
    (%index-column (%pps-fill pps) pps)))

(defun %enqueue (pps op)
  (setf (%qop-posn op) (%index-posn (%pps-fill pps) pps))
  (let ((cell (list op)) (head (%pps-queue-head pps)))
    (if head (setf (cdr head) cell) (setf (%pps-queue-tail pps) cell))
    (setf (%pps-queue-head pps) cell))
  op)

;;; character output (called by %stream-write-char for :pp streams)
(defun %pp-capture-write-char (s c)
  (let ((pps (stream-buffer s)))
    (if (char= c #\Newline)
        (%enqueue-newline pps :literal)
        (progn
          (%ensure-space-in-buffer pps 1)
          (let ((fill (%pps-fill pps)))
            (%set-schar (%pps-buffer pps) fill c)
            (setf (%pps-fill pps) (+ fill 1)))))))

(defun %ensure-space-in-buffer (pps want)
  (loop
    (let* ((buffer (%pps-buffer pps))
           (length (length buffer))
           (fill (%pps-fill pps))
           (available (- length fill)))
      (cond ((> available 0) (return available))
            ((> fill (%pps-line-length pps))
             (unless (%maybe-output pps nil)
               (%output-partial-line pps)))
            (t
             (setf (%pps-buffer pps)
                   (%string-grow buffer (max (* length 2) (+ length (floor (* want 5) 4))) fill)))))))

(defun %enqueue-newline (pps kind)
  (let* ((depth (length (%pps-pending-blocks pps)))
         (newline (%enqueue pps (%make-qop :type :newline :kind kind :depth depth))))
    (dolist (entry (%pps-queue-tail pps))
      (when (and (not (eq newline entry))
                 (member (%qop-type entry) '(:newline :block-start))
                 (null (%qop-section-end entry))
                 (<= depth (%qop-depth entry)))
        (setf (%qop-section-end entry) newline))))
  (%maybe-output pps (or (eq kind :literal) (eq kind :mandatory))))

(defun %start-logical-block (stream prefix per-line-p suffix)
  (let ((pps (stream-buffer stream)))
    (when (and prefix (> (length prefix) 0))
      (write-string prefix stream))
    (let* ((pending (%pps-pending-blocks pps))
           (start (%enqueue pps (%make-qop :type :block-start
                                           :prefix (and per-line-p prefix)
                                           :suffix suffix
                                           :depth (length pending)))))
      (setf (%pps-pending-blocks pps) (cons start pending)))))

(defun %end-logical-block (stream)
  (let* ((pps (stream-buffer stream))
         (start (pop (%pps-pending-blocks pps)))
         (suffix (%qop-suffix start))
         (end (%enqueue pps (%make-qop :type :block-end :suffix suffix))))
    (when (and suffix (> (length suffix) 0))
      (write-string suffix stream))
    (setf (%qop-block-end start) end)))

(defun %compute-tab-size (tab section-start column)
  (let* ((origin (if (%qop-sectionp tab) section-start 0))
         (colnum (%qop-colnum tab))
         (colinc (%qop-colinc tab))
         (position (- column origin)))
    (cond ((%qop-relativep tab)
           (when (> colinc 1)
             (let ((rem (rem (+ position colnum) colinc)))
               (unless (zerop rem) (setq colnum (+ colnum (- colinc rem))))))
           colnum)
          ((< position colnum) (- colnum position))
          ((zerop colinc) 0)
          (t (- colinc (rem (- position colnum) colinc))))))

(defun %misering-p (pps)
  (and *print-miser-width*
       (<= (- (%pps-line-length pps) (%lblock-start-column (car (%pps-blocks pps))))
           *print-miser-width*)))

(defun %fits-on-line-p (pps until force-newlines-p)
  (let ((available (%pps-line-length pps)))
    (when (and (not *print-readably*)
               (%pps-print-lines pps)
               (= (%pps-print-lines pps) (%pps-line-number pps)))
      (setq available (- available 3))
      (setq available (- available (%lblock-suffix-length (car (%pps-blocks pps))))))
    (cond (until (<= (%posn-column (%qop-posn until) pps) available))
          (force-newlines-p nil)
          ((> (%index-column (%pps-fill pps) pps) available) nil)
          (t :dont-know))))

(defun %maybe-output (pps force-newlines-p)
  (let ((tail (%pps-queue-tail pps))
        (output-anything nil))
    (loop
      (unless tail
        (setf (%pps-queue-head pps) nil)
        (return))
      (let* ((cell tail) (next (car cell)))
        (setq tail (cdr tail))
        (case (%qop-type next)
          (:newline
           (when (case (%qop-kind next)
                   ((:literal :mandatory :linear) t)
                   (:miser (%misering-p pps))
                   (:fill
                    (or (%misering-p pps)
                        (> (%pps-line-number pps)
                           (%lblock-section-start-line (car (%pps-blocks pps))))
                        (let ((fits (%fits-on-line-p pps (%qop-section-end next) force-newlines-p)))
                          (cond ((eq fits t) nil)
                                ((null fits) t)
                                (t (setq tail cell) (return))))))
                   (t nil))
             (setq output-anything t)
             (%output-line pps next)))
          (:indent
           (unless (%misering-p pps)
             (%set-indentation pps
                               (+ (if (eq (%qop-kind next) :block)
                                      (%lblock-start-column (car (%pps-blocks pps)))
                                      (%posn-column (%qop-posn next) pps))
                                  (%qop-amount next)))))
          (:block-start
           (let ((fits (%fits-on-line-p pps (%qop-section-end next) force-newlines-p)))
             (cond ((eq fits t)
                    ;; the whole block fits: treat it as one long literal
                    (let ((end (%qop-block-end next)))
                      (%expand-tabs pps end)
                      (setq tail (cdr (member end tail)))))
                   ((null fits)
                    (%really-start-logical-block pps (%posn-column (%qop-posn next) pps)
                                                 (%qop-prefix next) (%qop-suffix next)))
                   (t (setq tail cell) (return)))))
          (:block-end (%really-end-logical-block pps))
          (:tab (%expand-tabs pps next))))
      (setf (%pps-queue-tail pps) tail))
    (setf (%pps-queue-tail pps) tail)
    (unless tail (setf (%pps-queue-head pps) nil))
    output-anything))

(defun %write-buffer (pps start end)
  (let ((buffer (%pps-buffer pps)) (target (%pps-target pps)))
    (do ((i start (+ i 1))) ((>= i end))
      (write-char (%schar buffer i) target))))

(defun %output-line (pps until)
  (let* ((target (%pps-target pps))
         (buffer (%pps-buffer pps))
         (kind (%qop-kind until))
         (literal-p (eq kind :literal))
         (amount-to-consume (%posn-index (%qop-posn until) pps))
         (amount-to-print
           (if literal-p
               amount-to-consume
               (let ((last-non-blank nil))
                 (do ((i (- amount-to-consume 1) (- i 1))) ((< i 0))
                   (unless (char= (%schar buffer i) #\Space) (setq last-non-blank i) (return)))
                 (if last-non-blank (+ last-non-blank 1) 0)))))
    (%write-buffer pps 0 amount-to-print)
    (let ((line-number (+ (%pps-line-number pps) 1)))
      (when (and (not *print-readably*)
                 (%pps-print-lines pps)
                 (>= line-number (%pps-print-lines pps)))
        (write-string " .." target)
        (let ((suffix-length (%lblock-suffix-length (car (%pps-blocks pps)))))
          (when (> suffix-length 0)
            (let* ((suffix (%pps-suffix pps)) (len (length suffix)))
              (write-string suffix target :start (- len suffix-length) :end len))))
        (throw '%line-limit-abbreviation-happened t))
      (setf (%pps-line-number pps) line-number)
      (write-char #\Newline target)
      (setf (%pps-start-column pps) 0)
      (let* ((fill (%pps-fill pps))
             (block (car (%pps-blocks pps)))
             (prefix-len (if literal-p
                             (%lblock-per-line-prefix-end block)
                             (%lblock-prefix-length block)))
             (shift (- amount-to-consume prefix-len))
             (new-fill (- fill shift))
             (new-buffer buffer))
        (when (> new-fill (length buffer))
          (setq new-buffer (%make-string (max (* (length buffer) 2)
                                              (+ (length buffer) (floor (* (- new-fill (length buffer)) 5) 4)))
                                         #\Space))
          (setf (%pps-buffer pps) new-buffer))
        ;; move the rest of the line behind the new prefix
        (if (< prefix-len amount-to-consume)
            (do ((i 0 (+ i 1))) ((>= i (- fill amount-to-consume)))
              (%set-schar new-buffer (+ prefix-len i) (%schar buffer (+ amount-to-consume i))))
            (do ((i (- fill amount-to-consume 1) (- i 1))) ((< i 0))
              (%set-schar new-buffer (+ prefix-len i) (%schar buffer (+ amount-to-consume i)))))
        (let ((prefix (%pps-prefix pps)))
          (dotimes (i prefix-len) (%set-schar new-buffer i (%schar prefix i))))
        (setf (%pps-fill pps) new-fill)
        (setf (%pps-offset pps) (+ (%pps-offset pps) shift))
        (unless literal-p
          (setf (%lblock-section-column block) prefix-len)
          (setf (%lblock-section-start-line block) line-number))))))

(defun %output-partial-line (pps)
  (let* ((fill (%pps-fill pps))
         (tail (%pps-queue-tail pps))
         (count (if tail (%posn-index (%qop-posn (car tail)) pps) fill))
         (new-fill (- fill count))
         (buffer (%pps-buffer pps)))
    (when (zerop count)
      (error "Output-partial-line called when nothing can be output."))
    (%write-buffer pps 0 count)
    (setf (%pps-start-column pps) (+ (%pps-start-column pps) count))
    (dotimes (i new-fill) (%set-schar buffer i (%schar buffer (+ count i))))
    (setf (%pps-fill pps) new-fill)
    (setf (%pps-offset pps) (+ (%pps-offset pps) count))))

(defun %force-pretty-output (pps)
  (%maybe-output pps nil)
  (%expand-tabs pps nil)
  (%write-buffer pps 0 (%pps-fill pps))
  (setf (%pps-start-column pps) (+ (%pps-start-column pps) (%pps-fill pps)))
  (setf (%pps-offset pps) (+ (%pps-offset pps) (%pps-fill pps)))
  (setf (%pps-fill pps) 0))

(defun %really-start-logical-block (pps column prefix suffix)
  (let* ((blocks (%pps-blocks pps))
         (prev (car blocks))
         (per-line-end (%lblock-per-line-prefix-end prev))
         (prefix-length (%lblock-prefix-length prev))
         (suffix-length (%lblock-suffix-length prev))
         (block (%make-lblock :start-column column :section-column column
                              :per-line-prefix-end per-line-end
                              :prefix-length prefix-length
                              :suffix-length suffix-length
                              :section-start-line (%pps-line-number pps))))
    (setf (%pps-blocks pps) (cons block blocks))
    (%set-indentation pps column)
    (when prefix
      (setf (%lblock-per-line-prefix-end block) column)
      (let ((p (%pps-prefix pps)) (start (- column (length prefix))))
        (dotimes (i (length prefix))
          (when (>= (+ start i) 0)
            (%set-schar p (+ start i) (char prefix i))))))
    (when (and suffix (> (length suffix) 0))
      (let* ((total (%pps-suffix pps))
             (total-len (length total))
             (additional (length suffix))
             (new-len (+ suffix-length additional)))
        (when (> new-len total-len)
          (let* ((new-total-len (max (* total-len 2) (+ suffix-length (floor (* additional 5) 4))))
                 (new (%make-string new-total-len #\Space)))
            (dotimes (i suffix-length)
              (%set-schar new (+ (- new-total-len suffix-length) i)
                          (%schar total (+ (- total-len suffix-length) i))))
            (setq total new total-len new-total-len)
            (setf (%pps-suffix pps) new)))
        (dotimes (i additional)
          (%set-schar total (+ (- total-len new-len) i) (char suffix i)))
        (setf (%lblock-suffix-length block) new-len))))
  nil)

(defun %set-indentation (pps column)
  (let* ((prefix (%pps-prefix pps))
         (prefix-len (length prefix))
         (block (car (%pps-blocks pps)))
         (current (%lblock-prefix-length block))
         (minimum (%lblock-per-line-prefix-end block))
         (column (max minimum column)))
    (when (> column prefix-len)
      (setq prefix (%string-grow prefix (max (* prefix-len 2)
                                              (+ prefix-len (floor (* (- column prefix-len) 5) 4)))
                                 current))
      (setf (%pps-prefix pps) prefix))
    (when (> column current)
      (do ((i current (+ i 1))) ((>= i column)) (%set-schar prefix i #\Space)))
    (setf (%lblock-prefix-length block) column)))

(defun %really-end-logical-block (pps)
  (let* ((old (pop (%pps-blocks pps)))
         (old-indent (%lblock-prefix-length old))
         (new (car (%pps-blocks pps)))
         (new-indent (%lblock-prefix-length new)))
    (when (> new-indent old-indent)
      (let ((p (%pps-prefix pps)))
        (do ((i old-indent (+ i 1))) ((>= i new-indent)) (%set-schar p i #\Space)))))
  nil)

(defun %expand-tabs (pps through)
  (let ((insertions nil)
        (additional 0)
        (column (%pps-start-column pps))
        (section-start (%lblock-section-column (car (%pps-blocks pps)))))
    (dolist (op (%pps-queue-tail pps))
      (case (%qop-type op)
        (:tab
         (let* ((index (%posn-index (%qop-posn op) pps))
                (tabsize (%compute-tab-size op section-start (+ column index))))
           (unless (zerop tabsize)
             (push (cons index tabsize) insertions)
             (setq additional (+ additional tabsize))
             (setq column (+ column tabsize)))))
        ((:newline :block-start)
         (setq section-start (+ column (%posn-index (%qop-posn op) pps)))))
      (when (eq op through) (return)))
    (when insertions
      (let* ((fill (%pps-fill pps))
             (new-fill (+ fill additional))
             (buffer (%pps-buffer pps))
             (new-buffer buffer)
             (end fill))
        (when (> new-fill (length buffer))
          (setq new-buffer (%make-string (max (* (length buffer) 2)
                                              (+ (length buffer) (floor (* additional 5) 4)))
                                         #\Space))
          (setf (%pps-buffer pps) new-buffer))
        (setf (%pps-fill pps) new-fill)
        (setf (%pps-offset pps) (- (%pps-offset pps) additional))
        (dolist (insertion insertions)
          (let* ((srcpos (car insertion))
                 (amount (cdr insertion))
                 (dstpos (+ srcpos additional)))
            ;; move [srcpos, end) to dstpos (backwards: regions may overlap)
            (do ((i (- end srcpos 1) (- i 1))) ((< i 0))
              (%set-schar new-buffer (+ dstpos i) (%schar buffer (+ srcpos i))))
            (do ((i (- dstpos amount) (+ i 1))) ((>= i dstpos)) (%set-schar new-buffer i #\Space))
            (setq additional (- additional amount))
            (setq end srcpos)))
        (unless (eq new-buffer buffer)
          (dotimes (i end) (%set-schar new-buffer i (%schar buffer i))))))))

;;; Run FN with a pretty stream on STREAM (STREAM itself if it is one)
(defun %with-pretty-stream (stream fn)
  (if (%pretty-stream-p stream)
      (funcall fn stream)
      (let ((ps (%make-pretty-stream stream)))
        (catch '%line-limit-abbreviation-happened
          (funcall fn ps)
          (%force-pretty-output (stream-buffer ps)))))
  nil)

;;; ------------------------------------------------------------
;;; user interface: PPRINT-LOGICAL-BLOCK, PPRINT-NEWLINE ...
;;; ------------------------------------------------------------

(defun %check-pp-string (x)
  (unless (stringp x) (error 'type-error :datum x :expected-type 'string))
  x)

(defun %pprint-logical-block (stream object prefix per-line-p suffix body)
  (when prefix (%check-pp-string prefix))
  (%check-pp-string suffix)
  (%with-pretty-stream (%output-stream stream)
    (lambda (ps)
      (if (not (listp object))
          (output-object object ps)
          (%descend-into ps
            (lambda ()
              (flet ((run ()
                       (%start-logical-block ps prefix per-line-p suffix)
                       (funcall body ps object)
                       (%end-logical-block ps)))
                (cond ((or (not *print-circle*) (null object)
                           (eq object *%circle-checked-object*))
                       (let ((*%circle-checked-object* nil)) (run)))
                      (*circularity-hash-table*
                       (let ((marker (%check-for-circularity object t)))
                         (when (or (null marker) (%handle-circularity marker ps))
                           (let ((*%circle-checked-object* nil)) (run)))))
                      (t
                       (let ((*circularity-hash-table* (make-hash-table :test 'eq)))
                         (let ((*circularity-counter* nil))
                           (output-object object (make-broadcast-stream)))
                         (let ((*circularity-counter* 0))
                           (let ((marker (%check-for-circularity object t)))
                             (when marker (%handle-circularity marker ps)))
                           (let ((*%circle-checked-object* nil)) (run)))))))))))))

(defun %pprint-pop-punt (object count stream)
  "Handles the special cases of PPRINT-POP; returns true when the block must end."
  (cond ((and object (or (atom object) (%backquote-prefix object)))
         (write-string ". " stream)
         (output-object object stream)
         t)
        ((and (not *print-readably*) *print-length* (>= count *print-length*))
         (write-string "..." stream)
         t)
        ((and object (> count 0) (%check-for-circularity object))
         (write-string ". " stream)
         (output-object object stream)
         t)
        (t nil)))

(defmacro pprint-logical-block ((stream-symbol object &key (prefix nil prefixp)
                                               (per-line-prefix nil per-line-prefix-p)
                                               (suffix "")) &body body)
  (when (and prefixp per-line-prefix-p)
    (return-from pprint-logical-block
      `(error "PPRINT-LOGICAL-BLOCK: both :PREFIX and :PER-LINE-PREFIX were supplied")))
  (let* ((var (cond ((null stream-symbol) '*standard-output*)
                    ((eq stream-symbol t) '*terminal-io*)
                    (t stream-symbol)))
         (s (gensym "STREAM")) (list (gensym "LIST")) (count (gensym "COUNT")) (blk (gensym "BLOCK")))
    `(%pprint-logical-block
      ,(if (eq stream-symbol t) t var) ,object
      ,(cond (per-line-prefix-p per-line-prefix) (prefixp prefix) (t ""))
      ,per-line-prefix-p ,suffix
      (lambda (,s ,list)
        (declare (ignorable ,list))
        (let ((,var ,s) (,count 0))
          (declare (ignorable ,count))
          (block ,blk
            (macrolet ((pprint-pop ()
                         '(if (%pprint-pop-punt ,list ,count ,var)
                              (return-from ,blk nil)
                              (progn (setq ,count (+ ,count 1)) (pop ,list))))
                       (pprint-exit-if-list-exhausted ()
                         '(when (null ,list) (return-from ,blk nil))))
              ,@body)))))))

(defun pprint-newline (kind &optional stream)
  (unless (member kind '(:linear :fill :miser :mandatory))
    (error 'type-error :datum kind :expected-type '(member :linear :fill :miser :mandatory)))
  (let ((s (%output-stream stream)))
    (when (and *print-pretty* (%pretty-stream-p s))
      (%enqueue-newline (stream-buffer s) kind)))
  nil)

(defun pprint-indent (relative-to n &optional stream)
  (unless (member relative-to '(:block :current))
    (error 'type-error :datum relative-to :expected-type '(member :block :current)))
  (unless (realp n) (error 'type-error :datum n :expected-type 'real))
  (let ((s (%output-stream stream)))
    (when (and *print-pretty* (%pretty-stream-p s))
      (%enqueue (stream-buffer s) (%make-qop :type :indent :kind relative-to :amount (values (round n))))))
  nil)

(defun pprint-tab (kind colnum colinc &optional stream)
  (unless (member kind '(:line :section :line-relative :section-relative))
    (error 'type-error :datum kind :expected-type '(member :line :section :line-relative :section-relative)))
  (unless (and (integerp colnum) (>= colnum 0))
    (error 'type-error :datum colnum :expected-type 'unsigned-byte))
  (unless (and (integerp colinc) (>= colinc 0))
    (error 'type-error :datum colinc :expected-type 'unsigned-byte))
  (let ((s (%output-stream stream)))
    (when (and *print-pretty* (%pretty-stream-p s))
      (%enqueue (stream-buffer s)
                (%make-qop :type :tab
                           :sectionp (member kind '(:section :section-relative))
                           :relativep (member kind '(:line-relative :section-relative))
                           :colnum colnum :colinc colinc))))
  nil)

(defun pprint-fill (stream list &optional (colon t) at)
  (declare (ignore at))
  (pprint-logical-block (stream list :prefix (if colon "(" "") :suffix (if colon ")" ""))
    (pprint-exit-if-list-exhausted)
    (loop
      (output-object (pprint-pop) stream)
      (pprint-exit-if-list-exhausted)
      (write-char #\Space stream)
      (pprint-newline :fill stream))))

(defun pprint-linear (stream list &optional (colon t) at)
  (declare (ignore at))
  (pprint-logical-block (stream list :prefix (if colon "(" "") :suffix (if colon ")" ""))
    (pprint-exit-if-list-exhausted)
    (loop
      (output-object (pprint-pop) stream)
      (pprint-exit-if-list-exhausted)
      (write-char #\Space stream)
      (pprint-newline :linear stream))))

(defun pprint-tabular (stream list &optional (colon t) at (tabsize 16))
  (declare (ignore at))
  (let ((tabsize (or tabsize 16)))
    (pprint-logical-block (stream list :prefix (if colon "(" "") :suffix (if colon ")" ""))
      (pprint-exit-if-list-exhausted)
      (loop
        (output-object (pprint-pop) stream)
        (pprint-exit-if-list-exhausted)
        (write-char #\Space stream)
        (pprint-tab :section-relative 0 tabsize stream)
        (pprint-newline :fill stream)))))

;;; ------------------------------------------------------------
;;; printing functions that use logical blocks
;;; ------------------------------------------------------------

(defun print-unreadable-object* (object stream type identity body-fn)
  (when *print-readably* (%print-not-readable object))
  (let ((stream (%output-stream stream)))
    (flet ((description (s)
             (when type
               (write (type-of object) :stream s :circle nil :level nil :length nil)
               (when body-fn (write-char #\Space s) (pprint-newline :fill s)))
             (when body-fn (funcall body-fn))
             (when identity
               (write-char #\Space s)
               (pprint-newline :fill s)
               (write-char #\{ s)
               (write-string (%integer-to-string (%object-id object) 16) s)
               (write-char #\} s))))
      (if (and *print-pretty* (%pretty-stream-p stream))
          (pprint-logical-block (stream nil :prefix "#<" :suffix ">")
            (description stream))
          (progn
            (write-string "#<" stream)
            (description stream)
            (write-char #\> stream)))))
  nil)

(defun %write-structure (x stream)
  (let* ((class (%instance-layout x))
         (slots (%class-effective-slots class)))
    (flet ((slot-key (sd s)
             (write-char #\: s)
             (%output-symbol-token (symbol-name (%slotd-name sd)) s (%print-readtable))))
      (if (and *print-pretty* (not *print-readably*) (%pretty-stream-p stream))
          (pprint-logical-block (stream nil :prefix "#S(" :suffix ")")
            (let ((*print-escape* t)) (output-object (class-name class) stream))
            (when slots
              (write-char #\Space stream)
              (pprint-newline :linear stream)
              (loop
                (pprint-pop)
                (let ((sd (pop slots)))
                  (slot-key sd stream)
                  (write-char #\Space stream)
                  (pprint-newline :miser stream)
                  (output-object (%instance-ref x (%slotd-location sd)) stream)
                  (when (null slots) (return))
                  (write-char #\Space stream)
                  (pprint-newline :linear stream)))))
          (%descend-into stream
            (lambda ()
              (write-string "#S(" stream)
              (let ((*print-escape* t)) (output-object (class-name class) stream))
              (let ((i 0))
                (dolist (sd slots)
                  (write-char #\Space stream)
                  (when (%print-length-exceeded-p i)
                    (write-string "..." stream) (return))
                  (slot-key sd stream)
                  (write-char #\Space stream)
                  (output-object (%instance-ref x (%slotd-location sd)) stream)
                  (setq i (+ i 1))))
              (write-char #\) stream)))))))

;;; ------------------------------------------------------------
;;; pprint dispatch tables
;;; ------------------------------------------------------------

(defstruct (pprint-dispatch-table (:constructor %make-pprint-dispatch-table))
  (entries nil)          ; list of (type-spec priority function), highest priority first
  (read-only nil))

(defvar *%standard-pprint-dispatch* nil)

(defun %ppd-table (table)
  (cond ((null table) *%standard-pprint-dispatch*)
        ((pprint-dispatch-table-p table) table)
        (t (error 'type-error :datum table :expected-type '(or null pprint-dispatch-table)))))

(defun copy-pprint-dispatch (&optional (table *print-pprint-dispatch*))
  (let ((from (%ppd-table table)))
    (%make-pprint-dispatch-table :entries (copy-list (pprint-dispatch-table-entries from)))))

(defun set-pprint-dispatch (type-specifier function &optional (priority 0) (table *print-pprint-dispatch*))
  (unless (realp priority) (error 'type-error :datum priority :expected-type 'real))
  (unless (pprint-dispatch-table-p table)
    (error 'type-error :datum table :expected-type 'pprint-dispatch-table))
  (when (pprint-dispatch-table-read-only table)
    (error "The standard pprint dispatch table cannot be modified."))
  (let ((entries (remove type-specifier (pprint-dispatch-table-entries table)
                         :key #'car :test #'equal)))
    (when function
      (let ((entry (list type-specifier priority function)))
        ;; keep the list ordered by decreasing priority; a new entry goes
        ;; before older entries of the same priority
        (setq entries
              (let ((before nil) (rest entries))
                (loop
                  (when (or (null rest) (<= (cadr (car rest)) priority))
                    (return (append (nreverse before) (list entry) rest)))
                  (push (pop rest) before))))))
    (setf (pprint-dispatch-table-entries table) entries))
  nil)

(defun %ppd-user-lookup (object table)
  (dolist (e (pprint-dispatch-table-entries table) nil)
    (when (typep object (car e)) (return (caddr e)))))

(defun %pprint-dispatch-function (object)
  "The function the pretty printer uses for OBJECT, or NIL to print it plainly."
  (let ((table *print-pprint-dispatch*))
    (or (and (pprint-dispatch-table-p table)
             (pprint-dispatch-table-entries table)
             (%ppd-user-lookup object table))
        (%standard-pprint-function object))))

(defun %output-ugly-object-fn (stream object) (output-ugly-object object stream))

(defun pprint-dispatch (object &optional (table *print-pprint-dispatch*))
  (let* ((table (%ppd-table table))
         (fn (or (%ppd-user-lookup object table) (%standard-pprint-function object))))
    (if fn (values fn t) (values #'%output-ugly-object-fn nil))))

;;; ------------------------------------------------------------
;;; the standard dispatch functions (SBCL's layout)
;;; ------------------------------------------------------------

(defvar *%pp-cons-table* (make-hash-table :test 'eq))

(defun %pp-fboundp (s)
  (and (symbolp s) (or (fboundp s) (special-operator-p s) (macro-function s)
                       (member s '(cond and or)))))

(defun %standard-pprint-function (object)
  (cond ((consp object)
         (let ((op (car object)))
           (cond ((not (symbolp op)) #'pprint-fill)
                 ((gethash op *%pp-cons-table*))
                 ((%pp-fboundp op) #'%pprint-fun-call)
                 (t #'pprint-fill))))
        ((and (arrayp object) (not (%string-like-p object)) (not (bit-vector-p object)))
         #'%pprint-array)
        (t nil)))

(defun %pprint-array (stream array &rest noise)
  (declare (ignore noise))
  (cond ((or (not (or *print-array* *print-readably*))
             (and *print-readably* (not (%array-readably-printable-p array))))
         (output-ugly-object array stream))
        ((vectorp array) (%pprint-vector stream array))
        (t (%pprint-multi-dim-array stream array))))

(defun %pprint-vector (stream vector)
  (pprint-logical-block (stream nil :prefix "#(" :suffix ")")
    (dotimes (i (length vector))
      (unless (zerop i)
        (write-char #\Space stream)
        (pprint-newline :fill stream))
      (pprint-pop)
      (output-object (aref vector i) stream))))

(defun %pprint-multi-dim-array (stream array)
  (write-char #\# stream)
  (%write-decimal (array-rank array) stream)
  (write-char #\A stream)
  (labels ((guts (index dims)
             (if (null dims)
                 (output-object (row-major-aref array index) stream)
                 (pprint-logical-block (stream nil :prefix "(" :suffix ")")
                   (let ((dim (car dims)))
                     (unless (zerop dim)
                       (let* ((rest (cdr dims))
                              (step (reduce #'* rest))
                              (count 0))
                         (loop
                           (pprint-pop)
                           (guts index rest)
                           (setq count (+ count 1))
                           (when (= count dim) (return))
                           (write-char #\Space stream)
                           (pprint-newline (if rest :linear :fill) stream)
                           (setq index (+ index step))))))))))
    (guts 0 (array-dimensions array))))

;;; helpers for the code layouts below: each takes the stream and works
;;; inside a logical block whose list is popped with POP-FN
(defmacro %pp-form-block ((stream list) &body body)
  `(pprint-logical-block (,stream ,list :prefix "(" :suffix ")")
     (pprint-exit-if-list-exhausted)
     ,@body))

(defun %pprint-fun-call (stream list &rest noise)
  ;; ~:<~^~W~^ ~:_~:I~@{~W~^ ~:_~}~:>
  (declare (ignore noise))
  (%pp-form-block (stream list)
    (output-object (pprint-pop) stream)
    (pprint-exit-if-list-exhausted)
    (write-char #\Space stream)
    (pprint-newline :fill stream)
    (pprint-indent :current 0 stream)
    (loop
      (output-object (pprint-pop) stream)
      (pprint-exit-if-list-exhausted)
      (write-char #\Space stream)
      (pprint-newline :fill stream))))

(defun %pprint-body-forms (stream list n)
  ;; ~:<~^~W~^~3I ~:_~W ... ~1I~@{ ~_~W~}~:> with N leading arguments
  (pprint-logical-block (stream list :prefix "(" :suffix ")")
    (pprint-exit-if-list-exhausted)
    (output-object (pprint-pop) stream)
    (pprint-exit-if-list-exhausted)
    (pprint-indent :block 3 stream)
    (dotimes (i n)
      (write-char #\Space stream)
      (pprint-newline (if (= i 0) :fill :linear) stream)
      (output-object (pprint-pop) stream)
      (pprint-exit-if-list-exhausted))
    (pprint-indent :block 1 stream)
    (loop
      (write-char #\Space stream)
      (pprint-newline :linear stream)
      (output-object (pprint-pop) stream)
      (pprint-exit-if-list-exhausted))))

(defun %pprint-block (stream list &rest noise)
  ;; ~:<~^~W~^~3I ~:_~W~1I~@{ ~_~W~}~:>
  (declare (ignore noise))
  (%pprint-body-forms stream list 1))

(defun %pprint-prog2 (stream list &rest noise)
  ;; ~:<~^~W~^~3I ~:_~W~^ ~_~W~^~1I~@{ ~_~W~}~:>
  (declare (ignore noise))
  (%pprint-body-forms stream list 2))

(defun %pprint-progv (stream list &rest noise)
  ;; ~:<~^~W~^~3I ~_~W~^ ~_~W~^~1I~@{ ~_~W~}~:>
  (declare (ignore noise))
  (pprint-logical-block (stream list :prefix "(" :suffix ")")
    (pprint-exit-if-list-exhausted)
    (output-object (pprint-pop) stream)
    (pprint-exit-if-list-exhausted)
    (pprint-indent :block 3 stream)
    (dotimes (i 2)
      (write-char #\Space stream)
      (pprint-newline :linear stream)
      (output-object (pprint-pop) stream)
      (pprint-exit-if-list-exhausted))
    (pprint-indent :block 1 stream)
    (loop
      (write-char #\Space stream)
      (pprint-newline :linear stream)
      (output-object (pprint-pop) stream)
      (pprint-exit-if-list-exhausted))))

(defun %pprint-progn (stream list &rest noise)
  ;; ~:<~^~W~@{ ~_~W~}~:>
  (declare (ignore noise))
  (%pp-form-block (stream list)
    (output-object (pprint-pop) stream)
    (loop
      (pprint-exit-if-list-exhausted)
      (write-char #\Space stream)
      (pprint-newline :linear stream)
      (output-object (pprint-pop) stream))))

(defun %pprint-if (stream list &rest noise)
  (declare (ignore noise))
  (%pp-form-block (stream list)
    (output-object (pprint-pop) stream)
    (pprint-exit-if-list-exhausted)
    (write-char #\Space stream)
    (pprint-indent :current 0 stream)
    (output-object (pprint-pop) stream)
    (loop
      (pprint-exit-if-list-exhausted)
      (write-char #\Space stream)
      (pprint-newline :mandatory stream)
      (output-object (pprint-pop) stream))))

(defun %pprint-quote (stream list &rest noise)
  (declare (ignore noise))
  (if (and (consp list) (consp (cdr list)) (null (cddr list)))
      (case (car list)
        (function (write-string "#'" stream) (output-object (cadr list) stream))
        (quote (write-char #\' stream) (output-object (cadr list) stream))
        (t (pprint-fill stream list)))
      (pprint-fill stream list)))

(defun %pprint-backquote (stream list &rest noise)
  (declare (ignore noise))
  (let ((prefix (%backquote-prefix list)))
    (if prefix
        (progn (write-string prefix stream) (output-object (cadr list) stream))
        (pprint-fill stream list))))

(defun %pprint-declare (stream list &rest noise)
  ;; like a function call, but (FUNCTION F) declarations stay lists
  (declare (ignore noise))
  (%pp-form-block (stream list)
    (output-object (pprint-pop) stream)
    (pprint-exit-if-list-exhausted)
    (write-char #\Space stream)
    (pprint-newline :fill stream)
    (pprint-indent :current 0 stream)
    (loop
      (let ((spec (pprint-pop)))
        (if (and (consp spec) (eq (car spec) 'function))
            (pprint-fill stream spec)
            (output-object spec stream)))
      (pprint-exit-if-list-exhausted)
      (write-char #\Space stream)
      (pprint-newline :fill stream))))

(defun %pprint-let (stream list &rest noise)
  ;; ~:<~^~W~^ ~@_~:<~@{~:<~^~W~@{ ~_~W~}~:>~^ ~_~}~:>~1I~:@_~@{~W~^ ~_~}~:>
  (declare (ignore noise))
  (%pp-form-block (stream list)
    (output-object (pprint-pop) stream)
    (pprint-exit-if-list-exhausted)
    (write-char #\Space stream)
    (pprint-newline :miser stream)
    (let ((bindings (pprint-pop)))
      (pprint-logical-block (stream bindings :prefix "(" :suffix ")")
        (pprint-exit-if-list-exhausted)
        (loop
          (let ((b (pprint-pop)))
            (pprint-logical-block (stream b :prefix "(" :suffix ")")
              (pprint-exit-if-list-exhausted)
              (output-object (pprint-pop) stream)
              (loop
                (pprint-exit-if-list-exhausted)
                (write-char #\Space stream)
                (pprint-newline :linear stream)
                (output-object (pprint-pop) stream))))
          (pprint-exit-if-list-exhausted)
          (write-char #\Space stream)
          (pprint-newline :linear stream))))
    (pprint-indent :block 1 stream)
    (pprint-exit-if-list-exhausted)
    (pprint-newline :mandatory stream)
    (loop
      (output-object (pprint-pop) stream)
      (pprint-exit-if-list-exhausted)
      (write-char #\Space stream)
      (pprint-newline :linear stream))))

(defun %pprint-flet (stream list &rest noise)
  ;; ~:<~^~W~^ ~@_~:<~@{~:<~^~W~^~3I ~:_~/pprint-lambda-list/~1I~:@_~@{~W~^ ~_~}~:>~^ ~_~}~:>~1I~@:_~@{~W~^ ~_~}~:>
  (declare (ignore noise))
  (if (and (consp list) (consp (cdr list)) (consp (cddr list)) (not (eq (third list) :in)))
      (%pp-form-block (stream list)
        (output-object (pprint-pop) stream)
        (pprint-exit-if-list-exhausted)
        (write-char #\Space stream)
        (pprint-newline :miser stream)
        (let ((defs (pprint-pop)))
          (pprint-logical-block (stream defs :prefix "(" :suffix ")")
            (pprint-exit-if-list-exhausted)
            (loop
              (let ((def (pprint-pop)))
                (pprint-logical-block (stream def :prefix "(" :suffix ")")
                  (pprint-exit-if-list-exhausted)
                  (output-object (pprint-pop) stream)
                  (pprint-exit-if-list-exhausted)
                  (pprint-indent :block 3 stream)
                  (write-char #\Space stream)
                  (pprint-newline :fill stream)
                  (%pprint-lambda-list stream (pprint-pop))
                  (pprint-indent :block 1 stream)
                  (pprint-exit-if-list-exhausted)
                  (pprint-newline :mandatory stream)
                  (loop
                    (output-object (pprint-pop) stream)
                    (pprint-exit-if-list-exhausted)
                    (write-char #\Space stream)
                    (pprint-newline :linear stream))))
              (pprint-exit-if-list-exhausted)
              (write-char #\Space stream)
              (pprint-newline :linear stream))))
        (pprint-indent :block 1 stream)
        (pprint-exit-if-list-exhausted)
        (pprint-newline :mandatory stream)
        (loop
          (output-object (pprint-pop) stream)
          (pprint-exit-if-list-exhausted)
          (write-char #\Space stream)
          (pprint-newline :linear stream)))
      (pprint-logical-block (stream list :prefix "(" :suffix ")")
        (pprint-exit-if-list-exhausted)
        (output-object (pprint-pop) stream)
        (loop
          (pprint-exit-if-list-exhausted)
          (write-char #\Space stream)
          (output-object (pprint-pop) stream)))))

(defun %pprint-lambda-list (stream lambda-list &rest noise)
  (declare (ignore noise))
  (if (and (consp lambda-list) (%backquote-prefix lambda-list))
      (output-object lambda-list stream)
      (pprint-logical-block (stream lambda-list :prefix "(" :suffix ")")
        (let ((state :required) (first t))
          (loop
            (pprint-exit-if-list-exhausted)
            (unless first (write-char #\Space stream))
            (let ((arg (pprint-pop)))
              (unless first
                (case arg
                  (&optional (setq state :optional) (pprint-newline :linear stream))
                  ((&rest &body) (setq state :required) (pprint-newline :linear stream))
                  (&key (setq state :key) (pprint-newline :linear stream))
                  (&aux (setq state :optional) (pprint-newline :linear stream))
                  (t (pprint-newline :fill stream))))
              (case state
                (:required (%pprint-lambda-list stream arg))
                ((:optional :key)
                 (pprint-logical-block (stream arg :prefix "(" :suffix ")")
                   (pprint-exit-if-list-exhausted)
                   (if (eq state :key)
                       (pprint-logical-block (stream (pprint-pop) :prefix "(" :suffix ")")
                         (pprint-exit-if-list-exhausted)
                         (output-object (pprint-pop) stream)
                         (pprint-exit-if-list-exhausted)
                         (write-char #\Space stream)
                         (pprint-newline :fill stream)
                         (%pprint-lambda-list stream (pprint-pop))
                         (loop
                           (pprint-exit-if-list-exhausted)
                           (write-char #\Space stream)
                           (pprint-newline :fill stream)
                           (output-object (pprint-pop) stream)))
                       (%pprint-lambda-list stream (pprint-pop)))
                   (loop
                     (pprint-exit-if-list-exhausted)
                     (write-char #\Space stream)
                     (pprint-newline :linear stream)
                     (output-object (pprint-pop) stream))))))
            (setq first nil))))))

(defun %pprint-lambda (stream list &rest noise)
  ;; ~:<~^~W~^~3I ~:_~/pprint-lambda-list/~1I~@{ ~_~W~}~:>
  (declare (ignore noise))
  (%pp-form-block (stream list)
    (output-object (pprint-pop) stream)
    (pprint-exit-if-list-exhausted)
    (pprint-indent :block 3 stream)
    (write-char #\Space stream)
    (pprint-newline :fill stream)
    (%pprint-lambda-list stream (pprint-pop))
    (pprint-indent :block 1 stream)
    (loop
      (pprint-exit-if-list-exhausted)
      (write-char #\Space stream)
      (pprint-newline :linear stream)
      (output-object (pprint-pop) stream))))

(defun %pprint-defun (stream list &rest noise)
  ;; ~:<~^~W~^ ~@_~:I~W~^ ~:_~/pprint-lambda-list/~1I~@{ ~_~W~}~:>
  (declare (ignore noise))
  (%pp-form-block (stream list)
    (output-object (pprint-pop) stream)
    (pprint-exit-if-list-exhausted)
    (write-char #\Space stream)
    (pprint-newline :miser stream)
    (pprint-indent :current 0 stream)
    (output-object (pprint-pop) stream)
    (pprint-exit-if-list-exhausted)
    (write-char #\Space stream)
    (pprint-newline :fill stream)
    (%pprint-lambda-list stream (pprint-pop))
    (pprint-indent :block 1 stream)
    (loop
      (pprint-exit-if-list-exhausted)
      (write-char #\Space stream)
      (pprint-newline :linear stream)
      (output-object (pprint-pop) stream))))

(defun %pprint-defmethod (stream list &rest noise)
  (declare (ignore noise))
  (if (and (consp (cdr list)) (consp (cddr list)) (listp (third list)))
      (%pprint-defun stream list)
      ;; qualifiers before the lambda list
      (%pp-form-block (stream list)
        (output-object (pprint-pop) stream)
        (pprint-exit-if-list-exhausted)
        (write-char #\Space stream)
        (pprint-newline :miser stream)
        (pprint-indent :current 0 stream)
        (output-object (pprint-pop) stream)
        (loop
          (pprint-exit-if-list-exhausted)
          (write-char #\Space stream)
          (let ((x (pprint-pop)))
            (if (listp x)
                (progn
                  (pprint-newline :fill stream)
                  (%pprint-lambda-list stream x)
                  (return))
                (output-object x stream))))
        (pprint-indent :block 1 stream)
        (loop
          (pprint-exit-if-list-exhausted)
          (write-char #\Space stream)
          (pprint-newline :linear stream)
          (output-object (pprint-pop) stream)))))

(defun %pprint-destructuring-bind (stream list &rest noise)
  ;; ~:<~^~W~^~3I ~_~:/pprint-lambda-list/~^ ~_~W~^~1I~@{ ~_~W~}~:>
  (declare (ignore noise))
