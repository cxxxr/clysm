;; macros whose lambda list has N parameters before &BODY
(dolist (e '((defgeneric . 2) (define-compiler-macro . 2) (define-condition . 3) (handler-bind . 1)
             (restart-bind . 1) (restart-case . 1) (with-accessors . 2) (with-condition-restarts . 2)
             (with-slots . 2)))
  (let ((n (cdr e)))
    (%pp-register (car e) (lambda (stream list &rest noise)
                            (declare (ignore noise))
                            (%pprint-body-forms stream list n)))))

