;;;; extra.lisp — remaining standard operators

;;; bit arrays
(defun %bit-op (fn a b result)
  (let ((r (cond ((eq result t) a)
                 ((null result) (make-array (array-dimensions a) :element-type 'bit))
                 (t result))))
    (dotimes (i (array-total-size a) r)
      (setf (row-major-aref r i)
            (logand 1 (funcall fn (row-major-aref a i) (if b (row-major-aref b i) 0)))))))
(defun bit-and (a b &optional r) (%bit-op #'logand a b r))
(defun bit-ior (a b &optional r) (%bit-op #'logior a b r))
(defun bit-xor (a b &optional r) (%bit-op #'logxor a b r))
(defun bit-eqv (a b &optional r) (%bit-op #'logeqv a b r))
(defun bit-nand (a b &optional r) (%bit-op #'lognand a b r))
(defun bit-nor (a b &optional r) (%bit-op #'lognor a b r))
(defun bit-andc1 (a b &optional r) (%bit-op #'logandc1 a b r))
(defun bit-andc2 (a b &optional r) (%bit-op #'logandc2 a b r))
(defun bit-orc1 (a b &optional r) (%bit-op #'logorc1 a b r))
(defun bit-orc2 (a b &optional r) (%bit-op #'logorc2 a b r))
(defun bit-not (a &optional r) (%bit-op (lambda (x y) (declare (ignore y)) (lognot x)) a nil r))

;;; float constants (short and long floats are single and double floats)
(defconstant least-positive-short-float least-positive-single-float)
(defconstant least-negative-short-float least-negative-single-float)
(defconstant least-positive-long-float least-positive-double-float)
(defconstant least-negative-long-float least-negative-double-float)
(defconstant least-positive-normalized-short-float least-positive-normalized-single-float)
(defconstant least-positive-normalized-long-float least-positive-normalized-double-float)
(defconstant least-negative-normalized-single-float -1.1754944e-38)
(defconstant least-negative-normalized-short-float -1.1754944e-38)
(defconstant least-negative-normalized-double-float -2.2250738585072014d-308)
(defconstant least-negative-normalized-long-float -2.2250738585072014d-308)
(defconstant short-float-epsilon single-float-epsilon)
(defconstant short-float-negative-epsilon single-float-negative-epsilon)
(defconstant long-float-epsilon double-float-epsilon)
(defconstant long-float-negative-epsilon double-float-negative-epsilon)

;;; symbols
(defun find-all-symbols (name)
  (let ((name (string name)) (r nil))
    (dolist (p (list-all-packages) r)
      (multiple-value-bind (s status) (find-symbol name p)
        (when (and status (not (eq status :inherited))) (pushnew s r))))))

(defun get-setf-expansion (place &optional env) (%get-setf-expansion place env))

(defun disassemble (fn)
  (unless (or (functionp fn) (symbolp fn) (and (consp fn) (eq (car fn) 'lambda))
              (and (consp fn) (eq (car fn) 'setf) (consp (cdr fn)) (symbolp (cadr fn)) (null (cddr fn))))
    (error 'type-error :datum fn :expected-type '(or function symbol (cons (eql setf) (cons symbol null)))))
  (format t "~&; ~S is compiled to WebAssembly; use a Wasm disassembler on the module.~%" fn)
  nil)

;;; CLOS odds and ends
(defgeneric function-keywords (method))
(defmethod function-keywords ((m t))
  (let ((ll (%instance-ref m 4)) (keys nil))
    (dolist (x (cdr (member '&key ll)) (values (nreverse keys) (not (null (member '&allow-other-keys ll)))))
      (unless (member x lambda-list-keywords)
        (let ((spec (if (consp x) (car x) x)))
          (push (if (consp spec) (car spec) (intern (symbol-name spec) "KEYWORD")) keys))))))

(defun invalid-method-error (method format-control &rest args)
  (declare (ignore method))
  (apply #'error format-control args))
(defun method-combination-error (format-control &rest args)
  (apply #'error format-control args))

;;; macros
(defmacro with-standard-io-syntax (&body body)
  `(let ((*package* (find-package "COMMON-LISP-USER"))
         (*print-array* t) (*print-base* 10) (*print-case* :upcase) (*print-circle* nil)
         (*print-escape* t) (*print-gensym* t) (*print-length* nil) (*print-level* nil)
         (*print-lines* nil) (*print-miser-width* nil) (*print-pretty* nil) (*print-radix* nil)
         (*print-readably* t) (*print-right-margin* nil) (*read-base* 10)
         (*print-pprint-dispatch* *%standard-pprint-dispatch*)
         (*read-default-float-format* 'single-float) (*read-eval* t) (*read-suppress* nil)
         (*readtable* (copy-readtable nil)))
     ,@body))

(defmacro with-compilation-unit ((&rest options) &body body)
  (declare (ignore options))
  `(progn ,@body))

(%set-macro-function 'multiple-value-bind
  (lambda (form env)
    (declare (ignore env))
    (destructuring-bind (vars value-form &rest body) (cdr form)
      (let ((rest (gensym "REST")))
        `(multiple-value-call (lambda (&optional ,@vars &rest ,rest)
                                (declare (ignore ,rest))
                                ,@body)
           ,value-form)))))

(defmacro pprint-pop () '(error "PPRINT-POP outside of PPRINT-LOGICAL-BLOCK"))
(defmacro pprint-exit-if-list-exhausted ()
  '(error "PPRINT-EXIT-IF-LIST-EXHAUSTED outside of PPRINT-LOGICAL-BLOCK"))

;;; queries
(defun y-or-n-p (&optional control &rest args)
  (loop
    (when control (fresh-line *query-io*) (apply #'format *query-io* control args))
    (write-string " (y or n) " *query-io*)
    (let ((line (read-line *query-io* nil "")))
      (cond ((string-equal (string-trim " " line) "y") (return t))
            ((string-equal (string-trim " " line) "n") (return nil))
            ((eql (length line) 0) (return nil))))))
(defun yes-or-no-p (&optional control &rest args)
  (loop
    (when control (fresh-line *query-io*) (apply #'format *query-io* control args))
    (write-string " (yes or no) " *query-io*)
    (let ((line (read-line *query-io* nil "")))
      (cond ((string-equal (string-trim " " line) "yes") (return t))
            ((string-equal (string-trim " " line) "no") (return nil))
            ((eql (length line) 0) (return nil))))))
