;;;; format.lisp — FORMAT

(defun format (destination control &rest args)
  (cond ((null destination)
         (let ((s (make-string-output-stream)))
           (%format s control args)
           (get-output-stream-string s)))
        ((stringp destination)
         (let ((s (%make-stream :kind :string-out :buffer destination)))
           (%format s control args)
           nil))
        (t (%format (if (eq destination t) *standard-output* (%output-stream destination)) control args)
           nil)))

(defun %format (stream control args)
  (if (functionp control)
      (apply control stream args)
      (let ((av (vector (coerce args 'simple-vector) 0)))
        (catch '%format-up-and-out
          (%fmt stream control 0 (length control) av))))
  nil)

(defmacro formatter (control)
  `(lambda (stream &rest args) (%format stream ,control args) nil))

;;; argument cursor
(defun %fmt-remaining (av) (- (length (svref av 0)) (svref av 1)))
(defun %fmt-next (av)
  (let ((v (svref av 0)) (i (svref av 1)))
    (when (>= i (length v)) (error "FORMAT: not enough arguments"))
    (setf (svref av 1) (+ i 1))
    (svref v i)))
(defun %fmt-rest-list (av)
  (let ((v (svref av 0)) (r nil))
    (do ((i (- (length v) 1) (- i 1))) ((< i (svref av 1)) r) (push (svref v i) r))))

;;; directive parsing
(defun %fmt-parse (ctl i end av)
  "I points just after ~.  Returns (values params colon at char next)."
  (let ((params nil) (colon nil) (at nil))
    (loop
      (when (>= i end) (error "FORMAT: unterminated directive"))
      (let ((c (char ctl i)) (val nil) (have nil))
        (cond ((or (digit-char-p c)
                   (and (member c '(#\- #\+)) (< (+ i 1) end) (digit-char-p (char ctl (+ i 1)))))
               (let ((j (+ i 1)))
                 (do () ((not (and (< j end) (digit-char-p (char ctl j))))) (setq j (+ j 1)))
                 (setq val (parse-integer ctl :start i :end j) have t i j)))
              ((char= c #\') (setq val (char ctl (+ i 1)) have t i (+ i 2)))
              ((char-equal c #\v) (setq val (if av (%fmt-next av) nil) have t i (+ i 1)))
              ((char= c #\#) (setq val (if av (%fmt-remaining av) 0) have t i (+ i 1))))
        (if (char= (char ctl i) #\,)
            (progn (push val params) (setq i (+ i 1)))
            (progn (when (or have params) (push val params)) (return)))))
    (setq params (reverse params))
    (loop
      (let ((c (char ctl i)))
        (cond ((char= c #\:) (setq colon t i (+ i 1)))
              ((char= c #\@) (setq at t i (+ i 1)))
              (t (return)))))
    (values params colon at (char ctl i) (+ i 1))))

(defun %fmt-param (params n default)
  (let ((v (nth n params))) (if (null v) default v)))

(defun %fmt-find-close (ctl i end close)
  "Scan from I for the matching CLOSE directive char. Returns (values segments close-colon close-at next)
SEGMENTS is a list of (start end separator-colon-p) for clauses separated by ~;"
  (let ((depth 0) (seg-start i) (segments nil) (sep-colon nil))
    (loop
      (when (>= i end) (error "FORMAT: missing ~~~A" close))
      (let ((c (char ctl i)))
        (if (char/= c #\~)
            (setq i (+ i 1))
            (let ((dstart i))
              (multiple-value-bind (params colon at dc next) (%fmt-parse ctl (+ i 1) end nil)
                (declare (ignore params))
                (cond ((member dc '(#\[ #\{ #\( #\<)) (setq depth (+ depth 1)))
                      ((and (member dc '(#\] #\} #\) #\>)) (> depth 0)) (setq depth (- depth 1)))
                      ((and (= depth 0) (char= dc close))
                       (push (list seg-start dstart sep-colon) segments)
                       (return (values (reverse segments) colon at next)))
                      ((and (= depth 0) (char= dc #\;))
                       (push (list seg-start dstart sep-colon) segments)
                       (setq seg-start next sep-colon colon)))
                (setq i next))))))))

;;; main interpreter
(defun %fmt (stream ctl start end av)
  (let ((i start))
    (loop
      (when (>= i end) (return))
      (let ((c (char ctl i)))
        (if (char/= c #\~)
            (progn (write-char c stream) (setq i (+ i 1)))
            (multiple-value-bind (params colon at dc next) (%fmt-parse ctl (+ i 1) end av)
              (setq i (%fmt-directive stream ctl next end av params colon at (char-upcase dc)))))))))

(defun %fmt-pad (stream string mincol colinc minpad padchar left)
  (let* ((len (length string))
         (pad (max minpad 0)))
    (do () ((>= (+ len pad) mincol)) (setq pad (+ pad colinc)))
    (unless left (write-string string stream))
    (dotimes (k pad) (write-char padchar stream))
    (when left (write-string string stream))))

(defun %fmt-directive (stream ctl i end av params colon at dc)
  (case dc
    ((#\A #\S)
     (let* ((arg (%fmt-next av))
            (s (cond ((and colon (null arg)) "()")
                     ((char= dc #\A) (princ-to-string arg))
                     (t (prin1-to-string arg)))))
       (if (null params)
           (write-string s stream)
           (%fmt-pad stream s (%fmt-param params 0 0) (%fmt-param params 1 1) (%fmt-param params 2 0)
                     (%fmt-param params 3 #\Space) at)))
     i)
    (#\W (prin1 (%fmt-next av) stream) i)
    ((#\D #\B #\O #\X)
     (%fmt-integer stream (%fmt-next av) (case dc (#\D 10) (#\B 2) (#\O 8) (t 16)) params colon at)
     i)
    (#\R
     (let ((arg (%fmt-next av)))
       (if params
           (%fmt-integer stream arg (car params) (cdr params) colon at)
           (cond ((and at colon) (%fmt-roman stream arg t))
                 (at (%fmt-roman stream arg nil))
                 (colon (%fmt-ordinal stream arg))
                 (t (%fmt-cardinal stream arg)))))
     i)
    (#\P
     (when colon (setf (svref av 1) (- (svref av 1) 1)))
     (let ((arg (%fmt-next av)))
       (if at
           (write-string (if (eql arg 1) "y" "ies") stream)
           (unless (eql arg 1) (write-char #\s stream))))
     i)
    (#\C
     (let ((c (%fmt-next av)))
       (cond (at (prin1 c stream))
             (colon (let ((n (char-name c))) (if (and n (not (graphic-char-p c)) ) (write-string n stream)
                                                 (if (char= c #\Space) (write-string "Space" stream) (write-char c stream)))))
             (t (write-char c stream))))
     i)
    ((#\F) (%fmt-fixed stream (%fmt-next av) params at) i)
    ((#\E) (%fmt-exponential stream (%fmt-next av) params at) i)
    ((#\G) (%fmt-fixed stream (%fmt-next av) params at) i)
    (#\$ (%fmt-dollar stream (%fmt-next av) params colon at) i)
    (#\% (dotimes (k (%fmt-param params 0 1)) (terpri stream)) i)
    (#\& (let ((n (%fmt-param params 0 1)))
           (when (> n 0) (fresh-line stream) (dotimes (k (- n 1)) (terpri stream))))
     i)
    (#\| (dotimes (k (%fmt-param params 0 1)) (write-char (code-char 12) stream)) i)
    (#\~ (dotimes (k (%fmt-param params 0 1)) (write-char #\~ stream)) i)
    (#\Newline
     (when at (terpri stream))
     (if colon i
         (let ((j i))
           (do () ((not (and (< j end) (member (char ctl j) '(#\Space #\Tab #\Newline))))) (setq j (+ j 1)))
           j)))
    (#\T
     (let* ((colnum (%fmt-param params 0 1)) (colinc (%fmt-param params 1 1))
            (col (%stream-column stream)))
       (if at
           (progn
             (dotimes (k colnum) (write-char #\Space stream))
             (when (> colinc 1)
               (let ((c2 (%stream-column stream)))
                 (dotimes (k (mod (- colinc (mod c2 colinc)) colinc)) (write-char #\Space stream)))))
           (cond ((< col colnum) (dotimes (k (- colnum col)) (write-char #\Space stream)))
                 ((> colinc 0)
                  (dotimes (k (mod (- colinc (mod (- col colnum) colinc)) colinc)) (write-char #\Space stream))))))
     i)
    (#\*
     (cond (at (setf (svref av 1) (%fmt-param params 0 0)))
           (colon (setf (svref av 1) (- (svref av 1) (%fmt-param params 0 1))))
           (t (dotimes (k (%fmt-param params 0 1)) (%fmt-next av))))
     i)
    (#\?
     (let ((sub (%fmt-next av)))
       (if at
           (%fmt stream sub 0 (length sub) av)
           (let ((sargs (%fmt-next av)))
             (catch '%format-up-and-out
               (%fmt stream sub 0 (length sub) (vector (coerce sargs 'simple-vector) 0))))))
     i)
    (#\(
     (multiple-value-bind (segs cc ca next) (%fmt-find-close ctl i end #\))
       (declare (ignore cc ca))
       (let* ((seg (car segs))
              (s (with-output-to-string (tmp) (%fmt tmp ctl (car seg) (cadr seg) av))))
         (write-string (cond ((and colon at) (string-upcase s))
                             (colon (string-capitalize s))
                             (at (let ((d (string-downcase s)))
                                   (let ((p (position-if #'alpha-char-p d)))
                                     (when p (setf (char d p) (char-upcase (char d p)))))
                                   d))
                             (t (string-downcase s)))
                       stream))
       next))
    (#\[
     (multiple-value-bind (segs cc ca next) (%fmt-find-close ctl i end #\])
       (declare (ignore cc ca))
       (cond
         (at (let ((arg (%fmt-next av)))
               (when arg
                 (setf (svref av 1) (- (svref av 1) 1))
                 (let ((seg (car segs))) (%fmt stream ctl (car seg) (cadr seg) av)))))
         (colon (let* ((arg (%fmt-next av)) (seg (if arg (cadr segs) (car segs))))
                  (when seg (%fmt stream ctl (car seg) (cadr seg) av))))
         (t (let* ((n (if params (car params) (%fmt-next av)))
                   (default (find-if #'caddr segs))
                   (seg (if (and (integerp n) (>= n 0) (< n (length segs)) (not (caddr (nth n segs))))
                            (nth n segs)
                            (if default (nth (position default segs) segs) nil))))
              (when (and default (integerp n) (< n (length segs)) (caddr (nth n segs))) (setq seg default))
              (when seg (%fmt stream ctl (car seg) (cadr seg) av)))))
       next))
    (#\{
     (multiple-value-bind (segs cc ca next) (%fmt-find-close ctl i end #\})
       (declare (ignore ca))
       (let* ((seg (car segs))
              (body-start (car seg)) (body-end (cadr seg))
              (sub-ctl ctl)
              (max-iter (%fmt-param params 0 -1))
              (at-least-once cc))
         (when (= body-start body-end)
           (setq sub-ctl (%fmt-next av) body-start 0 body-end (length sub-ctl)))
         (flet ((run-body (args-av)
                  (%fmt stream sub-ctl body-start body-end args-av)))
           (cond
             ((and colon at)
              (let ((count 0))
                (catch '%format-colon-up
                  (loop
                    (when (or (and (<= (%fmt-remaining av) 0) (not (and at-least-once (= count 0))))
                              (= count max-iter))
                      (return))
                    (let ((sub (%fmt-next av)))
                      (catch '%format-up-and-out
                        (run-body (vector (coerce sub 'simple-vector) 0))))
                    (setq count (+ count 1))))))
             (colon
              (let ((lists (%fmt-next av)) (count 0))
                (catch '%format-colon-up
                  (loop
                    (when (or (and (null lists) (not (and at-least-once (= count 0)))) (= count max-iter))
                      (return))
                    (let ((sub (pop lists)))
                      (catch '%format-up-and-out
                        (run-body (vector (coerce sub 'simple-vector) 0))))
                    (setq count (+ count 1))))))
             (at
              (let ((count 0))
                (catch '%format-up-and-out
                  (loop
                    (when (or (and (<= (%fmt-remaining av) 0) (not (and at-least-once (= count 0))))
                              (= count max-iter))
                      (return))
                    (run-body av)
                    (setq count (+ count 1))))))
             (t
              (let* ((lst (%fmt-next av))
                     (sub-av (vector (coerce lst 'simple-vector) 0))
                     (count 0))
                (catch '%format-up-and-out
                  (loop
                    (when (or (and (<= (%fmt-remaining sub-av) 0) (not (and at-least-once (= count 0))))
                              (= count max-iter))
                      (return))
                    (run-body sub-av)
                    (setq count (+ count 1)))))))))
       next))
    (#\<
     (multiple-value-bind (segs cc ca next) (%fmt-find-close ctl i end #\>)
       (declare (ignore ca))
       (if cc
           ;; logical block ~<prefix~;body~;suffix~:>
           (let* ((n (length segs))
                  (prefix (if (> n 1) (subseq ctl (car (first segs)) (cadr (first segs))) (if colon "(" "")))
                  (suffix (if (> n 2) (subseq ctl (car (third segs)) (cadr (third segs))) (if colon ")" "")))
                  (body (if (> n 1) (second segs) (first segs)))
                  (arg (if at (%fmt-rest-list av) (%fmt-next av))))
             (when at (setf (svref av 1) (length (svref av 0))))
             (pprint-logical-block (stream arg :prefix prefix :suffix suffix)
               (catch '%format-up-and-out
                 (%fmt stream ctl (car body) (cadr body) (vector (coerce arg 'simple-vector) 0))))
             next)
           (let* ((pieces (mapcar (lambda (seg)
                                    (with-output-to-string (tmp)
                                      (catch '%format-up-and-out
                                        (%fmt tmp ctl (car seg) (cadr seg) av))))
                                  segs))
                  (mincol (%fmt-param params 0 0)) (padchar (%fmt-param params 3 #\Space))
                  (total (reduce #'+ (mapcar #'length pieces)))
                  (gaps (max 1 (- (length pieces) 1)))
                  (pad (max 0 (- mincol total))))
             (cond ((= (length pieces) 1)
                    (if (or at (not colon))
                        (progn (unless at (dotimes (k pad) (write-char padchar stream)))
                               (write-string (car pieces) stream)
                               (when at (dotimes (k pad) (write-char padchar stream))))
                        (progn (dotimes (k pad) (write-char padchar stream)) (write-string (car pieces) stream))))
                   (t
                    (let ((each (floor pad gaps)) (extra (mod pad gaps)))
                      (do ((p pieces (cdr p)) (k 0 (+ k 1))) ((null p))
                        (write-string (car p) stream)
                        (when (cdr p)
                          (dotimes (j (+ each (if (< k extra) 1 0))) (write-char padchar stream)))))))
             next))))
    (#\^
     (let ((done (cond ((cadr params) (= (car params) (cadr params)))
                       (params (= (car params) 0))
                       (t (<= (%fmt-remaining av) 0)))))
       (when done (throw (if colon '%format-colon-up '%format-up-and-out) nil)))
     i)
    (#\_ (pprint-newline (cond ((and colon at) :mandatory) (colon :fill) (at :miser) (t :linear)) stream) i)
    (#\I (pprint-indent (if colon :current :block) (%fmt-param params 0 0) stream) i)
    (#\/
     (let* ((close (position #\/ ctl :start i))
            (name (string-upcase (subseq ctl i close)))
            (colon-pos (position #\: name))
            (sym (if colon-pos
                     (intern (subseq name (if (and (< (+ colon-pos 1) (length name))
                                                   (char= (char name (+ colon-pos 1)) #\:))
                                              (+ colon-pos 2) (+ colon-pos 1)))
                             (subseq name 0 colon-pos))
                     (intern name "COMMON-LISP-USER"))))
       (apply sym stream (%fmt-next av) colon at params)
       (+ close 1)))
    (t (error "FORMAT: unknown directive ~~~A" dc))))

;;; numbers
(defun %fmt-group-digits (s comma interval)
  (let* ((neg (and (> (length s) 0) (char= (char s 0) #\-)))
         (digits (if neg (subseq s 1) s))
         (r nil) (n 0))
    (do ((i (- (length digits) 1) (- i 1))) ((< i 0))
      (when (and (> n 0) (= (mod n interval) 0)) (push comma r))
      (push (char digits i) r)
      (setq n (+ n 1)))
    (concatenate 'string (if neg "-" "") (coerce r 'string))))

(defun %fmt-integer (stream arg base params colon at)
  (if (not (integerp arg))
      (let ((*print-base* base)) (%fmt-pad stream (princ-to-string arg) (%fmt-param params 0 0) 1 0 (%fmt-param params 1 #\Space) t))
      (let* ((s (%integer-to-string arg base))
             (s (if colon (%fmt-group-digits s (%fmt-param params 2 #\,) (%fmt-param params 3 3)) s))
             (s (if (and at (>= arg 0)) (concatenate 'string "+" s) s)))
        (%fmt-pad stream s (%fmt-param params 0 0) 1 0 (%fmt-param params 1 #\Space) t))))

(defparameter *fmt-ones* #("zero" "one" "two" "three" "four" "five" "six" "seven" "eight" "nine" "ten"
                            "eleven" "twelve" "thirteen" "fourteen" "fifteen" "sixteen" "seventeen"
                            "eighteen" "nineteen"))
(defparameter *fmt-tens* #("" "" "twenty" "thirty" "forty" "fifty" "sixty" "seventy" "eighty" "ninety"))
(defparameter *fmt-illions* #("" " thousand" " million" " billion" " trillion" " quadrillion"
                               " quintillion" " sextillion" " septillion" " octillion" " nonillion"
                               " decillion"))

(defun %fmt-cardinal-string (n)
  (cond ((< n 0) (concatenate 'string "negative " (%fmt-cardinal-string (- n))))
        ((< n 20) (svref *fmt-ones* n))
        ((< n 100) (let ((tens (svref *fmt-tens* (floor n 10))) (ones (mod n 10)))
                     (if (= ones 0) tens (concatenate 'string tens "-" (svref *fmt-ones* ones)))))
        ((< n 1000) (let ((h (floor n 100)) (r (mod n 100)))
                      (concatenate 'string (svref *fmt-ones* h) " hundred"
                                   (if (= r 0) "" (concatenate 'string " " (%fmt-cardinal-string r))))))
        (t (let ((parts nil) (i 0))
             (do () ((= n 0))
               (let ((chunk (mod n 1000)))
                 (unless (= chunk 0)
                   (push (concatenate 'string (%fmt-cardinal-string chunk) (svref *fmt-illions* i)) parts)))
               (setq n (floor n 1000) i (+ i 1)))
             (let ((r (car parts)))
               (dolist (p (cdr parts) r) (setq r (concatenate 'string r " " p))))))))

(defun %fmt-cardinal (stream n) (write-string (%fmt-cardinal-string n) stream))

(defun %fmt-ordinal (stream n)
  (let* ((s (%fmt-cardinal-string n))
         (irregular '(("one" . "first") ("two" . "second") ("three" . "third") ("five" . "fifth")
                      ("eight" . "eighth") ("nine" . "ninth") ("twelve" . "twelfth"))))
    (let* ((sp (position-if (lambda (c) (member c '(#\Space #\-))) s :from-end t))
           (last-word (if sp (subseq s (+ sp 1)) s))
           (prefix (if sp (subseq s 0 (+ sp 1)) ""))
           (e (assoc last-word irregular :test #'string=)))
      (write-string prefix stream)
      (write-string (cond (e (cdr e))
                          ((char= (char last-word (- (length last-word) 1)) #\y)
                           (concatenate 'string (subseq last-word 0 (- (length last-word) 1)) "ieth"))
                          (t (concatenate 'string last-word "th")))
                    stream))))

(defun %fmt-roman (stream n old)
  (let ((table (if old
                   '((1000 . "M") (500 . "D") (100 . "C") (50 . "L") (10 . "X") (5 . "V") (1 . "I"))
                   '((1000 . "M") (900 . "CM") (500 . "D") (400 . "CD") (100 . "C") (90 . "XC")
                     (50 . "L") (40 . "XL") (10 . "X") (9 . "IX") (5 . "V") (4 . "IV") (1 . "I")))))
    (dolist (e table)
      (do () ((< n (car e))) (write-string (cdr e) stream) (setq n (- n (car e)))))))

;;; floats
(defun %fmt-fixed-string (x d)
  "Fixed notation of real X with D fraction digits (D may be NIL for shortest)."
  (if (null d)
      (if (floatp x)
          (multiple-value-bind (digits e) (%float-digits-and-exponent x)
            (let ((nd (length digits)))
              (cond ((zerop x) "0.0")
                    ((<= e 0) (concatenate 'string "0." (make-string (- e) :initial-element #\0) digits))
                    ((>= e nd) (concatenate 'string digits (make-string (- e nd) :initial-element #\0) ".0"))
                    (t (concatenate 'string (subseq digits 0 e) "." (subseq digits e))))))
          (%fmt-fixed-string (float x) nil))
      (let* ((r (abs (rational x)))
             (scaled (floor (+ (* r (expt 10 d)) 1/2)))
             (s (%integer-to-string scaled 10)))
        (when (< (length s) (+ d 1))
          (setq s (concatenate 'string (make-string (- (+ d 1) (length s)) :initial-element #\0) s)))
        (concatenate 'string (subseq s 0 (- (length s) d)) "." (subseq s (- (length s) d))))))

(defun %fmt-fixed (stream x params at)
  (if (not (realp x))
      (princ x stream)
      (let* ((w (%fmt-param params 0 nil)) (d (%fmt-param params 1 nil))
             (k (%fmt-param params 2 0))
             (ovf (%fmt-param params 3 nil)) (pad (%fmt-param params 4 #\Space))
             (xv (if (zerop k) x (* x (expt 10 k))))
             (neg (or (minusp xv) (and (floatp xv) (zerop xv) (= (%double-sign (%to-double xv)) 1))))
             (body (%fmt-fixed-string xv d))
             (sign (cond (neg "-") (at "+") (t ""))))
        (when (and w (null d))
          ;; choose digits to fit width
          (let ((avail (- w (length sign) 1)))
            (let ((int-len (length (%integer-to-string (truncate (abs xv)) 10))))
              (when (> avail int-len)
                (let ((dd (- avail int-len)))
                  (let ((short (%fmt-fixed-string xv nil)))
                    (if (<= (length short) (- w (length sign)))
                        (setq body short)
                        (setq body (%fmt-fixed-string xv dd)))))))))
        (let ((s (concatenate 'string sign body)))
          (when (and w (> (length s) w) (char= (char s (length sign)) #\0) (> (length s) 1))
            (setq s (concatenate 'string sign (subseq body 1))))
          (if (and w ovf (> (length s) w))
              (dotimes (i w) (write-char ovf stream))
              (progn (when w (dotimes (i (- w (length s))) (write-char pad stream)))
                     (write-string s stream)))))))

(defun %fmt-exponential (stream x params at)
  (if (not (realp x))
      (princ x stream)
      (let* ((d (%fmt-param params 1 nil)) (w (%fmt-param params 0 nil))
             (x (float x)))
        (if (zerop x)
            (write-string (if d (concatenate 'string "0." (make-string d :initial-element #\0) "e+0") "0.0e+0") stream)
            (multiple-value-bind (digits e) (%float-digits-and-exponent x)
              (let* ((expo (- e 1))
                     (mant (if d
                               (%fmt-fixed-string (/ (abs (rational x)) (expt 10 expo)) d)
                               (concatenate 'string (subseq digits 0 1) "."
                                            (if (> (length digits) 1) (subseq digits 1) "0"))))
                     (s (concatenate 'string (cond ((minusp x) "-") (at "+") (t ""))
                                     mant "e" (if (< expo 0) "-" "+") (%integer-to-string (abs expo) 10))))
                (when w (dotimes (i (- w (length s))) (write-char #\Space stream)))
                (write-string s stream)))))))

(defun %fmt-dollar (stream x params colon at)
  (let* ((d (%fmt-param params 0 2)) (n (%fmt-param params 1 1)) (w (%fmt-param params 2 0))
         (pad (%fmt-param params 3 #\Space))
         (body (%fmt-fixed-string (abs x) d))
         (point (position #\. body))
         (body (if (< point n) (concatenate 'string (make-string (- n point) :initial-element #\0) body) body))
         (sign (cond ((minusp x) "-") (at "+") (t ""))))
    (if colon
        (progn (write-string sign stream)
               (dotimes (i (- w (length sign) (length body))) (write-char pad stream))
               (write-string body stream))
        (progn (dotimes (i (- w (length sign) (length body))) (write-char pad stream))
               (write-string sign stream)
               (write-string body stream)))))
