  (if (and (%d< d 536870912.0d0) (%d< -536870913.0d0 d))
      (%double-to-fixnum d)
      (let* ((expo (%double-exponent d))
             (mant (+ (* (+ (%double-mant-hi d) 67108864) 67108864) (%double-mant-lo d)))
             (shift (- expo 1075))
