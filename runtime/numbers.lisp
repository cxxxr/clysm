;;;; numbers.lisp — the numeric tower
;;;;
;;;; fixnum (i31), bignum (sign + base 2^14 magnitude digits), ratio,
;;;; single-float (f32), double-float (f64), complex.

(defconstant most-positive-fixnum 536870911)
(defconstant most-negative-fixnum -536870912)
(defconstant +digit-bits+ 14)
(defconstant +digit-base+ 16384)
(defconstant +digit-mask+ 16383)

;;; ------------------------------------------------------------
;;; type predicates
;;; ------------------------------------------------------------

(defun bignump (x) (%bignump x))
(defun integerp (x) (or (fixnump x) (%bignump x)))
(defun rationalp (x) (or (fixnump x) (%bignump x) (%ratiop x)))
(defun floatp (x) (or (%double-float-p x) (%single-float-p x)))
(defun realp (x) (or (fixnump x) (%bignump x) (%ratiop x) (%double-float-p x) (%single-float-p x)))
(defun numberp (x) (or (realp x) (%complexp x)))
(defun complexp (x) (%complexp x))
(defun ratiop (x) (%ratiop x))
(defun single-float-p (x) (%single-float-p x))
(defun double-float-p (x) (%double-float-p x))

(defun %check-number (x) (if (numberp x) x (%type-error x 'number)))
(defun %check-real (x) (if (realp x) x (%type-error x 'real)))
(defun %check-integer (x) (if (integerp x) x (%type-error x 'integer)))

;;; ------------------------------------------------------------
;;; magnitudes: limbs arrays of base 2^14 digits, little endian
;;; ------------------------------------------------------------

(defun %mag-length (m)
  ;; length without leading zero digits
  (let ((n (%llen m)))
    (do () ((or (%fx= n 0) (not (%fx= (%lref m (%fx- n 1)) 0))) n)
      (setq n (%fx- n 1)))))

(defun %mag-trim (m)
  (let ((n (%mag-length m)))
    (if (%fx= n (%llen m)) m
        (let ((r (%make-limbs n)))
          (dotimes (i n r) (%lset r i (%lref m i)))))))

(defun %fixnum-mag (n)
  ;; magnitude of a fixnum's absolute value (|n| <= 2^29)
  (let ((a (if (%fx< n 0) (%fx- 0 n) n)))
    (cond ((%fx= n most-negative-fixnum)
           (let ((m (%make-limbs 3))) (%lset m 0 0) (%lset m 1 0) (%lset m 2 2) m))
          ((< a +digit-base+) (let ((m (%make-limbs 1))) (%lset m 0 a) m))
          ((< a 268435456)
           (let ((m (%make-limbs 2)))
             (%lset m 0 (%fxlogand a +digit-mask+))
             (%lset m 1 (%fxash-right a 14))
             m))
          (t
           ;; a may be 2^29 (bignum!) when n = most-negative-fixnum
           (let ((m (%make-limbs 3)))
             (if (fixnump a)
                 (progn (%lset m 0 (%fxlogand a +digit-mask+))
                        (%lset m 1 (%fxlogand (%fxash-right a 14) +digit-mask+))
                        (%lset m 2 (%fxash-right a 28)))
                 (progn (%lset m 0 0) (%lset m 1 0) (%lset m 2 2)))
             m)))))

(defun %int-sign (x) (if (fixnump x) (if (%fx< x 0) 1 0) (%bignum-sign x)))
(defun %int-mag (x) (if (fixnump x) (%fixnum-mag x) (%bignum-mag x)))

(defun %make-integer (sign mag)
  "Normalize a sign/magnitude pair into a fixnum or bignum."
  (let ((n (%mag-length mag)))
    (cond ((%fx= n 0) 0)
          ((%fx= n 1) (if (%fx= sign 1) (%fx- 0 (%lref mag 0)) (%lref mag 0)))
          ((%fx= n 2)
           (let ((v (%fx+ (%lref mag 0) (%fxash-left (%lref mag 1) 14))))
             (if (%fx= sign 1) (%fx- 0 v) v)))
          ((and (%fx= n 3) (%fx< (%lref mag 2) 2))
           (let ((v (%fx+ (%fx+ (%lref mag 0) (%fxash-left (%lref mag 1) 14))
                          (%fxash-left (%lref mag 2) 28))))
             (if (%fx= sign 1) (%fx- 0 v) v)))
          ((and (%fx= n 3) (%fx= sign 1) (%fx= (%lref mag 2) 2) (%fx= (%lref mag 1) 0) (%fx= (%lref mag 0) 0))
           most-negative-fixnum)
          (t (%make-bignum sign (%mag-trim mag))))))

(defun %mag-cmp (a b)
  (let ((la (%mag-length a)) (lb (%mag-length b)))
    (cond ((%fx< la lb) -1)
          ((%fx> la lb) 1)
          (t (do ((i (%fx- la 1) (%fx- i 1)))
                 ((%fx< i 0) 0)
               (let ((da (%lref a i)) (db (%lref b i)))
                 (cond ((%fx< da db) (return -1))
                       ((%fx> da db) (return 1)))))))))

(defun %mag-add (a b)
  (let* ((la (%mag-length a)) (lb (%mag-length b))
         (n (%fx+ (if (%fx> la lb) la lb) 1))
         (r (%make-limbs n)) (carry 0))
    (dotimes (i n r)
      (let ((s (%fx+ (%fx+ (if (%fx< i la) (%lref a i) 0) (if (%fx< i lb) (%lref b i) 0)) carry)))
        (%lset r i (%fxlogand s +digit-mask+))
        (setq carry (%fxash-right s 14))))))

(defun %mag-sub (a b)
  ;; a >= b
  (let* ((la (%mag-length a)) (lb (%mag-length b))
         (r (%make-limbs la)) (borrow 0))
    (dotimes (i la r)
      (let ((d (%fx- (%fx- (%lref a i) (if (%fx< i lb) (%lref b i) 0)) borrow)))
        (if (%fx< d 0)
            (progn (%lset r i (%fx+ d +digit-base+)) (setq borrow 1))
            (progn (%lset r i d) (setq borrow 0)))))))

(defun %mag-mul (a b)
  (let* ((la (%mag-length a)) (lb (%mag-length b))
         (r (%make-limbs (%fx+ la lb))))
    (dotimes (i la r)
      (let ((carry 0) (ai (%lref a i)))
        (unless (%fx= ai 0)
          (dotimes (j lb)
            (let ((tt (%fx+ (%fx+ (%fx* ai (%lref b j)) (%lref r (%fx+ i j))) carry)))
              (%lset r (%fx+ i j) (%fxlogand tt +digit-mask+))
              (setq carry (%fxash-right tt 14))))
          (%lset r (%fx+ i lb) carry))))))

(defun %mag-divmod-small (a d)
  "Divide magnitude A by fixnum 0 < d < 2^14.  Returns (values q-mag remainder)."
  (let* ((n (%mag-length a)) (q (%make-limbs n)) (rem 0))
    (do ((i (%fx- n 1) (%fx- i 1))) ((%fx< i 0) (values q rem))
      (let ((cur (%fx+ (%fxash-left rem 14) (%lref a i))))
        (%lset q i (%fxtruncate cur d))
        (setq rem (%fxrem cur d))))))

(defun %mag-shift-left-bits (a s)
  ;; 0 <= s < 14, returns new magnitude with one extra digit
  (let* ((n (%llen a)) (r (%make-limbs (%fx+ n 1))) (carry 0))
    (dotimes (i n)
      (let ((v (%fxlogior (%fxash-left (%lref a i) s) carry)))
        (%lset r i (%fxlogand v +digit-mask+))
        (setq carry (%fxash-right v 14))))
    (%lset r n carry)
    r))

(defun %mag-shift-right-bits (a s)
  (let* ((n (%llen a)) (r (%make-limbs n)))
    (dotimes (i n r)
      (let ((lo (%fxash-right (%lref a i) s))
            (hi (if (%fx< (%fx+ i 1) n)
                    (%fxlogand (%fxash-left (%lref a (%fx+ i 1)) (%fx- 14 s)) +digit-mask+)
                    0)))
        (%lset r i (%fxlogior lo hi))))))

(defun %mag-divmod (u v)
  "Knuth algorithm D.  Returns (values quotient-mag remainder-mag)."
  (let ((n (%mag-length v)) (m0 (%mag-length u)))
    (cond ((%fx= n 0) (error 'division-by-zero :operation 'truncate :operands nil))
          ((%fx< m0 n) (values (%make-limbs 0) u))
          ((%fx= n 1)
           (multiple-value-bind (q r) (%mag-divmod-small u (%lref v 0))
             (let ((rm (%make-limbs 1))) (%lset rm 0 r) (values q rm))))
          (t
           ;; normalize so that the top digit of v is >= base/2
           (let ((s 0) (top (%lref v (%fx- n 1))))
             (do () ((%fx>= top 8192)) (setq top (%fxash-left top 1)) (setq s (%fx+ s 1)))
             (let* ((vn (%mag-shift-left-bits (%mag-trim v) s))
                    (un (%mag-shift-left-bits (%mag-trim u) s))
                    (m (%fx- m0 n))
                    (q (%make-limbs (%fx+ m 1)))
                    (vtop (%lref vn (%fx- n 1)))
                    (vnext (%lref vn (%fx- n 2))))
               (do ((j m (%fx- j 1))) ((%fx< j 0))
                 (let* ((num (%fx+ (%fxash-left (%lref un (%fx+ j n)) 14) (%lref un (%fx+ j (%fx- n 1)))))
                        (qhat (%fxtruncate num vtop))
                        (rhat (%fxrem num vtop)))
                   (do () ((not (and (%fx< rhat +digit-base+)
                                     (or (%fx>= qhat +digit-base+)
                                         (%fx> (%fx* qhat vnext)
                                               (%fx+ (%fxash-left rhat 14) (%lref un (%fx+ j (%fx- n 2)))))))))
                     (setq qhat (%fx- qhat 1))
                     (setq rhat (%fx+ rhat vtop)))
                   ;; multiply and subtract
                   (let ((borrow 0) (carry 0))
                     (dotimes (i n)
                       (let* ((p (%fx+ (%fx* qhat (%lref vn i)) carry))
                              (sub (%fx- (%fx- (%lref un (%fx+ i j)) (%fxlogand p +digit-mask+)) borrow)))
                         (setq carry (%fxash-right p 14))
                         (if (%fx< sub 0)
                             (progn (%lset un (%fx+ i j) (%fx+ sub +digit-base+)) (setq borrow 1))
                             (progn (%lset un (%fx+ i j) sub) (setq borrow 0)))))
                     (let ((sub (%fx- (%fx- (%lref un (%fx+ j n)) carry) borrow)))
                       (if (%fx< sub 0)
                           (progn
                             ;; add back
                             (%lset un (%fx+ j n) (%fx+ sub +digit-base+))
                             (setq qhat (%fx- qhat 1))
                             (let ((c 0))
                               (dotimes (i n)
                                 (let ((s2 (%fx+ (%fx+ (%lref un (%fx+ i j)) (%lref vn i)) c)))
                                   (%lset un (%fx+ i j) (%fxlogand s2 +digit-mask+))
                                   (setq c (%fxash-right s2 14))))
                               (%lset un (%fx+ j n) (%fxlogand (%fx+ (%lref un (%fx+ j n)) c) +digit-mask+))))
                           (%lset un (%fx+ j n) sub))))
                   (%lset q j qhat)))
               ;; remainder = un >> s (low n digits)
               (let ((r (%make-limbs n)))
                 (dotimes (i n) (%lset r i (%lref un i)))
                 (values q (%mag-shift-right-bits r s)))))))))

;;; ------------------------------------------------------------
;;; integer arithmetic
;;; ------------------------------------------------------------

(defun %int-add (a b)
  (let ((sa (%int-sign a)) (sb (%int-sign b)) (ma (%int-mag a)) (mb (%int-mag b)))
    (if (%fx= sa sb)
        (%make-integer sa (%mag-add ma mb))
        (let ((c (%mag-cmp ma mb)))
          (cond ((%fx= c 0) 0)
                ((%fx> c 0) (%make-integer sa (%mag-sub ma mb)))
                (t (%make-integer sb (%mag-sub mb ma))))))))

(defun %int-negate (a)
  (if (fixnump a)
      (if (%fx= a most-negative-fixnum) (%make-integer 0 (%fixnum-mag a)) (%fx- 0 a))
      (%make-integer (%fx- 1 (%bignum-sign a)) (%bignum-mag a))))

(defun %int-sub (a b) (%int-add a (%int-negate b)))

(defun %int-mul (a b)
  (%make-integer (%fxlogxor (%int-sign a) (%int-sign b)) (%mag-mul (%int-mag a) (%int-mag b))))

(defun %int-truncate (a b)
  "Returns (values quotient remainder) of integers."
  (if (and (fixnump a) (fixnump b))
      (if (%fx= b 0)
          (error 'division-by-zero :operation 'truncate :operands (list a b))
          (if (and (%fx= b -1) (%fx= a most-negative-fixnum))
              (values (- a) 0)
              (values (%fxtruncate a b) (%fxrem a b))))
      (let ((sa (%int-sign a)) (sb (%int-sign b)))
        (multiple-value-bind (q r) (%mag-divmod (%int-mag a) (%int-mag b))
          (values (%make-integer (%fxlogxor sa sb) q) (%make-integer sa r))))))

(defun %int-cmp (a b)
  (if (and (fixnump a) (fixnump b))
      (cond ((%fx< a b) -1) ((%fx> a b) 1) (t 0))
      (let ((sa (%int-sign a)) (sb (%int-sign b)))
        (cond ((%fx< sa sb) 1)
              ((%fx> sa sb) -1)
              (t (let ((c (%mag-cmp (%int-mag a) (%int-mag b))))
                   (if (%fx= sa 1) (%fx- 0 c) c)))))))

(defun %int-zerop (x) (eql x 0))
(defun %int-minusp (x) (if (fixnump x) (%fx< x 0) (%fx= (%bignum-sign x) 1)))

(defun %int-ash (x count)
  (cond ((eql x 0) 0)
        ((eql count 0) x)
        ((> count 0)
         (if (and (fixnump x) (< count 29)
                  (let ((y (%fxash-left x count)))
                    (and (fixnump y) (%fx= (%fxash-right y count) x))))
             (%fxash-left x count)
             (let* ((digits (truncate count 14)) (bits (- count (* digits 14)))
                    (m (%mag-shift-left-bits (%int-mag x) bits))
                    (r (%make-limbs (+ (%llen m) digits))))
               (dotimes (i (%llen m)) (%lset r (+ i digits) (%lref m i)))
               (%make-integer (%int-sign x) r))))
        (t
         (let ((n (- count)))
           (if (fixnump x)
               (if (>= n 30) (if (%fx< x 0) -1 0) (%fxash-right x n))
               (if (%int-minusp x)
                   ;; floor semantics: -((|x|-1) >> n) - 1
                   (%int-sub (%int-negate (%int-ash (%int-sub (%int-negate x) 1) count)) 1)
                   (let* ((digits (truncate n 14)) (bits (- n (* digits 14)))
                          (m (%bignum-mag x)) (len (%llen m)))
                     (if (>= digits len) 0
                         (let ((r (%make-limbs (- len digits))))
                           (dotimes (i (- len digits)) (%lset r i (%lref m (+ i digits))))
                           (%make-integer 0 (%mag-shift-right-bits r bits)))))))))))

;;; two's complement digit vectors for logical ops
(defun %int-to-twos (x n)
  "N digits of the two's complement representation of X."
  (let ((r (%make-limbs n)) (m (%int-mag x)))
    (if (not (%int-minusp x))
        (dotimes (i n r) (%lset r i (if (< i (%llen m)) (%lref m i) 0)))
        ;; negative: complement of (|x| - 1)
        (let ((m1 (%int-mag (%int-sub (%int-negate x) 1))))
          (dotimes (i n r)
            (%lset r i (%fxlogxor +digit-mask+ (if (< i (%llen m1)) (%lref m1 i) 0))))))))

(defun %twos-to-int (r negative)
  (if (not negative)
      (%make-integer 0 r)
      (let ((m (%make-limbs (%llen r))))
        (dotimes (i (%llen r)) (%lset m i (%fxlogxor +digit-mask+ (%lref r i))))
        (%int-sub (%int-negate (%make-integer 0 m)) 1))))

(defun %int-logop (op a b)
  (if (and (fixnump a) (fixnump b))
      (case op (0 (%fxlogand a b)) (1 (%fxlogior a b)) (t (%fxlogxor a b)))
      (let* ((n (+ 1 (max (%llen (%int-mag a)) (%llen (%int-mag b)))))
             (ta (%int-to-twos a n)) (tb (%int-to-twos b n))
             (r (%make-limbs n))
             (na (%int-minusp a)) (nb (%int-minusp b)))
        (dotimes (i n)
          (let ((x (%lref ta i)) (y (%lref tb i)))
            (%lset r i (case op (0 (%fxlogand x y)) (1 (%fxlogior x y)) (t (%fxlogxor x y))))))
        (%twos-to-int r (case op (0 (and na nb)) (1 (or na nb)) (t (not (eq na nb))))))))

;;; ------------------------------------------------------------
;;; generic dispatch
;;; ------------------------------------------------------------

(defun %num-rank (x)
  (cond ((fixnump x) 0) ((%bignump x) 0) ((%ratiop x) 1)
        ((%single-float-p x) 2) ((%double-float-p x) 3) ((%complexp x) 4)
        (t (%type-error x 'number))))

(defun %to-double (x)
  (cond ((%double-float-p x) x)
        ((fixnump x) (%fixnum-to-double x))
        ((%single-float-p x) (%single-to-double x))
        ((%bignump x)
         (let* ((m (%bignum-mag x)) (r (%fixnum-to-double 0)) (base (%fixnum-to-double +digit-base+)))
           (do ((i (- (%llen m) 1) (- i 1))) ((< i 0))
             (setq r (%d+ (%d* r base) (%fixnum-to-double (%lref m i)))))
           (if (eql (%bignum-sign x) 1) (%dneg r) r)))
        ((%ratiop x) (%ratio-to-double x))
        (t (%type-error x 'real))))

(defun %ratio-to-double (x)
  (let ((n (%ratio-num x)) (d (%ratio-den x)))
    ;; scale to keep precision for large values
    (let ((ln (integer-length n)) (ld (integer-length d)))
      (if (and (< ln 1000) (< ld 1000))
          (%d/ (%to-double n) (%to-double d))
          (let ((shift (- ln ld 60)))
            (%d* (%to-double (truncate (ash n (- 60 (- ln ld))) d))
                 (%dexpt2 (- (- ln ld) 60))))))))

(defun %dexpt2 (k)
  (let ((r (%fixnum-to-double 1)) (two (%fixnum-to-double 2)) (half (%d/ (%fixnum-to-double 1) (%fixnum-to-double 2))))
    (if (>= k 0)
        (dotimes (i k r) (setq r (%d* r two)))
        (dotimes (i (- k) r) (setq r (%d* r half))))))

(defun %to-single (x)
  (if (%single-float-p x) x (%double-to-single (%to-double x))))

(defun %float-infinite-p (d)
  (and (%d= d (%d* d 2.0d0)) (not (%d= d 0.0d0))))

(defun %float-result (d rank)
  (let ((r (if (= rank 2) (%double-to-single d) d)))
    (when (and (%float-infinite-p (%to-double r)))
      (error 'floating-point-overflow :operation nil :operands nil))
    r))

(defun %contagion (a b)
  (let ((ra (%num-rank a)) (rb (%num-rank b)))
    (if (> ra rb) ra rb)))

(defun %generic-add (a b)
  (let ((r (%contagion a b)))
    (cond ((= r 0) (%int-add a b))
          ((= r 1) (%ratio-add a b))
          ((< r 4) (%float-result (%d+ (%to-double a) (%to-double b)) r))
          (t (%complex-add a b)))))

(defun %generic-sub (a b)
  (let ((r (%contagion a b)))
    (cond ((= r 0) (%int-sub a b))
          ((= r 1) (%ratio-add a (%negate b)))
          ((< r 4) (%float-result (%d- (%to-double a) (%to-double b)) r))
          (t (%complex-add a (%negate b))))))

(defun %negate (x)
  (cond ((integerp x) (%int-negate x))
        ((%ratiop x) (%make-ratio (%int-negate (%ratio-num x)) (%ratio-den x)))
        ((%double-float-p x) (%dneg x))
        ((%single-float-p x) (%double-to-single (%dneg (%single-to-double x))))
        ((%complexp x) (%make-complex (%negate (%complex-real x)) (%negate (%complex-imag x))))
        (t (%type-error x 'number))))

(defun %generic-mul (a b)
  (let ((r (%contagion a b)))
    (cond ((= r 0) (%int-mul a b))
          ((= r 1) (%ratio-mul a b))
          ((< r 4) (%float-result (%d* (%to-double a) (%to-double b)) r))
          (t (%complex-mul a b)))))

(defun %generic-div (a b)
  (let ((r (%contagion a b)))
    (cond ((<= r 1)
           (when (eql b 0) (error 'division-by-zero :operation '/ :operands (list a b)))
           (%ratio-mul a (%rational-reciprocal b)))
          ((< r 4)
           (let ((db (%to-double b)))
             (when (and (%d= db (%fixnum-to-double 0)) (rationalp b))
               (error 'division-by-zero :operation '/ :operands (list a b)))
             (%float-result (%d/ (%to-double a) db) r)))
          (t (%complex-div a b)))))

(defun %exact-compare-p (a b)
  "Rational vs float comparisons are done exactly (CLHS 12.1.4.1)."
  (and (or (floatp a) (floatp b)) (not (and (floatp a) (floatp b)))
       (realp a) (realp b)
       (not (%float-infinite-p (%to-double (if (floatp a) a b))))
       (not (%double-nan-p (%to-double (if (floatp a) a b))))))

(defun %generic-lt (a b)
  (let ((r (%contagion a b)))
    (cond ((and (< r 4) (%exact-compare-p a b)) (< (rational a) (rational b)))
          ((= r 0) (< (%int-cmp a b) 0))
          ((= r 1) (< (%int-cmp (* (numerator a) (denominator b)) (* (numerator b) (denominator a))) 0))
          ((< r 4) (%d< (%to-double a) (%to-double b)))
          (t (%type-error (if (complexp a) a b) 'real)))))

(defun %generic-num-eq (a b)
  (let ((r (%contagion a b)))
    (cond ((and (< r 4) (%exact-compare-p a b)) (= (rational a) (rational b)))
          ((= r 0) (= (%int-cmp a b) 0))
          ((= r 1) (and (= (numerator a) (numerator b)) (= (denominator a) (denominator b))))
          ((< r 4) (%d= (%to-double a) (%to-double b)))
          (t (and (= (realpart a) (realpart b)) (= (imagpart a) (imagpart b)))))))

(defun %eql-boxed (a b)
  (cond ((and (%bignump a) (%bignump b)) (= (%int-cmp a b) 0))
        ((and (%double-float-p a) (%double-float-p b)) (%double-eql a b))
        ((and (%single-float-p a) (%single-float-p b)) (%single-eql a b))
        ((and (%ratiop a) (%ratiop b))
         (and (eql (%ratio-num a) (%ratio-num b)) (eql (%ratio-den a) (%ratio-den b))))
        ((and (%complexp a) (%complexp b))
         (and (eql (%complex-real a) (%complex-real b)) (eql (%complex-imag a) (%complex-imag b))))
        (t nil)))

;;; ratios
(defun numerator (x) (if (%ratiop x) (%ratio-num x) (%check-integer x)))
(defun denominator (x) (if (%ratiop x) (%ratio-den x) (progn (%check-integer x) 1)))

(defun %make-rational (n d)
  (when (eql d 0) (error 'division-by-zero :operation '/ :operands (list n d)))
  (when (%int-minusp d) (setq n (%int-negate n) d (%int-negate d)))
  (let ((g (gcd n d)))
    (unless (eql g 1)
      (setq n (truncate n g) d (truncate d g)))
    (if (eql d 1) n (%make-ratio n d))))

(defun %ratio-add (a b)
  (%make-rational (+ (* (numerator a) (denominator b)) (* (numerator b) (denominator a)))
                  (* (denominator a) (denominator b))))
(defun %ratio-mul (a b)
  (%make-rational (* (numerator a) (numerator b)) (* (denominator a) (denominator b))))
(defun %rational-reciprocal (x)
  (%make-rational (denominator x) (numerator x)))

;;; complex
(defun complex (real &optional (imag 0))
  (cond ((and (rationalp real) (rationalp imag) (eql imag 0)) real)
        ((or (floatp real) (floatp imag))
         (let ((r (%contagion real imag)))
           (%make-complex (%float-result (%to-double real) r) (%float-result (%to-double imag) r))))
        (t (%make-complex real imag))))
(defun realpart (x) (if (%complexp x) (%complex-real x) (%check-real x)))
(defun imagpart (x) (if (%complexp x) (%complex-imag x) (* 0 (%check-real x))))
(defun conjugate (x) (if (%complexp x) (%make-complex (realpart x) (%negate (imagpart x))) x))
(defun %complex-add (a b) (complex (+ (realpart a) (realpart b)) (+ (imagpart a) (imagpart b))))
(defun %complex-mul (a b)
  (let ((ar (realpart a)) (ai (imagpart a)) (br (realpart b)) (bi (imagpart b)))
    (complex (- (* ar br) (* ai bi)) (+ (* ar bi) (* ai br)))))
(defun %complex-div (a b)
