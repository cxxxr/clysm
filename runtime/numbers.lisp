        ((and (integerp power) (floatp base))
         (if (minusp power) (/ 1 (expt base (- power)))
             (let ((result (float 1 base)) (b base) (p power))
               (do () ((eql p 0) result)
                 (when (oddp p) (setq result (* result b)))
                 (setq p (ash p -1))
                 (unless (eql p 0) (setq b (* b b)))))))
