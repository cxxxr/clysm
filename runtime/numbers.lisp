      (cond ((or (> twice ad) (and (= twice ad) (oddp q)))
             (if (eq (minusp number) (minusp divisor))
                 (values (+ q 1) (- r divisor))
                 (values (- q 1) (+ r divisor))))
            (t (values q r))))))

