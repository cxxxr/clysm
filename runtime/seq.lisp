(defparameter *char-name-aliases*
  '(("Linefeed" . 10) ("Null" . 0) ("Del" . 127) ("Escape" . 27) ("Bell" . 7)
    ("Backspace" . 8) ("Tab" . 9) ("Page" . 12) ("Return" . 13) ("Space" . 32)
    ("Rubout" . 127) ("Newline" . 10)))

(defvar *%name-char-table* nil)

;;; Names above Latin-1 come from data/unicode-names.txt in the Clysm
;;; installation ("HEX NAME" lines), read the first time one is needed
;;; (%UNICODE-NAMES, misc.lisp).
(defvar *%unicode-names* nil "(code->name . name->code) hash tables, or :none")

(defun char-name (c)
  (let ((code (char-code c)))
    (cond ((< code 256) (svref *char-names* code))
          ((let ((tables (%unicode-names))) (and tables (values (gethash code (car tables))))))
          ((not (graphic-char-p c)) (concatenate 'string "U+" (%integer-to-string code 16)))
          (t nil))))

(defun name-char (name)
  (let ((name (string name)))
    (unless *%name-char-table*
      (let ((h (make-hash-table :test 'equalp)))
        (dotimes (i 256)
          (let ((n (svref *char-names* i))) (when n (setf (gethash n h) i))))
        (dolist (a *char-name-aliases*) (setf (gethash (car a) h) (cdr a)))
        (setq *%name-char-table* h)))
    (let ((code (gethash name *%name-char-table*)))
      (cond (code (code-char code))
            ;; U+XXXX, and SBCL's UXX
            ((and (> (length name) 1) (char-equal (char name 0) #\U)
                  (let* ((start (if (char= (char name 1) #\+) 2 1))
                         (n (and (< start (length name))
                                 (every (lambda (ch) (digit-char-p ch 16)) (subseq name start))
                                 (parse-integer name :start start :radix 16))))
                    (and n (< n char-code-limit) (code-char n)))))
            ((let* ((tables (%unicode-names))
                    (code (and tables (gethash name (cdr tables)))))
               (and code (code-char code))))
            (t nil)))))

(defun character (x)
  (cond ((characterp x) x)
        ((and (stringp x) (= (length x) 1)) (char x 0))
        ((and (symbolp x) (= (length (symbol-name x)) 1)) (char (symbol-name x) 0))
        (t (%type-error x 'character))))

;;; ------------------------------------------------------------
;;; arrays
;;; ------------------------------------------------------------
;;; Simple 1-D arrays are bare storage objects (simple-vector, string, bytes,
;;; bits, f64vec).  Every other array is an $mdarray header:
;;;   data   : storage, or the array displaced to
;;;   fill   : fill pointer or NIL
;;;   dims   : list of dimensions
;;;   offset : displaced index offset
;;;   info   : (element-type adjustable . displaced)
;;; A header that is neither adjustable, displaced nor has a fill pointer is a
;;; simple array (multi-dimensional arrays, 0-D arrays, vectors of element type NIL).

(defun %simple-array-p (x)
  (or (%simple-vector-p x) (%simple-string-p x) (%bytes-p x) (%bits-p x) (%f64vec-p x)))

(defun %mdarray-simple-p (a)
  (let ((info (%mdarray-info a)))
    (and (null (%mdarray-fill a)) (null (cadr info)) (null (cddr info)))))
(defun %header-vector-p (x)
  (and (%mdarray-p x) (let ((d (%mdarray-dims x))) (and (consp d) (null (cdr d))))))

(defun arrayp (x) (or (%simple-array-p x) (%mdarray-p x)))
(defun %simple-array-type-p (x)
  (or (%simple-array-p x) (and (%mdarray-p x) (%mdarray-simple-p x))))
(defun simple-vector-p (x) (%simple-vector-p x))
(defun vectorp (x) (or (%simple-array-p x) (%header-vector-p x)))
(defun stringp (x)
  (or (%simple-string-p x) (and (%header-vector-p x) (%simple-string-p (%array-storage x)))))
(defun simple-string-p (x)
  (or (%simple-string-p x)
      (and (%header-vector-p x) (%mdarray-simple-p x) (%simple-string-p (%array-storage x)))))
(defun bit-vector-p (x)
  (or (%bits-p x) (and (%header-vector-p x) (%bits-p (%array-storage x)))))
(defun simple-bit-vector-p (x) (%bits-p x))

(defun %array-storage (a)
  ;; the innermost simple storage of an array
  (if (%mdarray-p a) (%array-storage (%mdarray-data a)) a))

(defun %check-array (a) (unless (arrayp a) (%type-error a 'array)) a)

(defun %simple-length (v)
  (cond ((%simple-vector-p v) (%svlength v))
        ((%simple-string-p v) (%string-length v))
        ((%bytes-p v) (%bytes-length v))
        ((%bits-p v) (%bits-length v))
        ((%f64vec-p v) (%f64vec-length v))
        (t (%type-error v 'vector))))

(defun %simple-ref (v i)
  (cond ((%simple-vector-p v) (%svref v i))
        ((%simple-string-p v) (%schar v i))
        ((%bytes-p v) (%bytes-ref v i))
        ((%bits-p v) (%bits-ref v i))
        ((%f64vec-p v) (%f64vec-ref v i))
        (t (%type-error v 'array))))

(defun %simple-set (v i x)
  (cond ((%simple-vector-p v) (%set-svref v i x))
        ((%simple-string-p v) (if (characterp x) (%set-schar v i x) (%type-error x 'character)))
        ((%bytes-p v) (if (and (fixnump x) (<= 0 x 255)) (%set-bytes-ref v i x)
                          (%type-error x '(unsigned-byte 8))))
        ((%bits-p v) (if (or (eql x 0) (eql x 1)) (%set-bits-ref v i x) (%type-error x 'bit)))
        ((%f64vec-p v) (if (%double-float-p x) (%set-f64vec-ref v i x) (%type-error x 'double-float)))
        (t (%type-error v 'array))))

(defun %make-storage (n et)
  "Fresh simple storage for N elements of the upgraded element type ET."
  (cond ((eq et t) (%make-simple-vector n nil))
        ((eq et 'character) (%make-string n (code-char 0)))
        ((eq et 'bit) (%make-bits n))
        ((eq et 'double-float) (%make-f64vec n))
        ((null et) (%make-string n (code-char 0)))
        ((equal et '(unsigned-byte 8)) (%make-bytes n))
        (t (%make-simple-vector n nil))))

(defun %storage-element-type (s)
  (cond ((%simple-vector-p s) t)
        ((%simple-string-p s) 'character)
        ((%bits-p s) 'bit)
        ((%bytes-p s) '(unsigned-byte 8))
        ((%f64vec-p s) 'double-float)
        (t t)))

(defun %make-simple-array (n element-type initial-element initp)
  (let* ((et (%normalize-element-type element-type)) (v (%make-storage n et)))
    (when initp (dotimes (i n) (%simple-set v i initial-element)))
    v))

(defun %normalize-element-type (et)
  (cond ((eq et t) t)
        ((member et '(character base-char standard-char)) 'character)
        ((eq et 'bit) 'bit)
        ((member et '(double-float long-float)) 'double-float)
        ((null et) nil)
        ((member et '(fixnum integer symbol number real float single-float short-float
                      rational ratio complex cons list atom sequence function)) t)
        ((and (consp et) (eq (car et) 'unsigned-byte) (integerp (cadr et)) (null (cddr et)))
         (cond ((= (cadr et) 1) 'bit) ((<= 1 (cadr et) 8) '(unsigned-byte 8)) (t t)))
        ((and (consp et) (eq (car et) 'signed-byte)) t)
        (t (%upgrade-element-type et))))

(defun %upgrade-element-type (et)
  (cond ((subtypep et nil) nil)
        ((subtypep et 'character) 'character)
        ((subtypep et 'bit) 'bit)
        ((subtypep et '(unsigned-byte 8)) '(unsigned-byte 8))
        ((subtypep et 'double-float) 'double-float)
        (t t)))

(defun upgraded-array-element-type (type &optional env)
  (declare (ignore env))
  (%normalize-element-type type))

(defconstant array-rank-limit 8)
(defconstant array-dimension-limit 536870911)
(defconstant array-total-size-limit 536870911)

(defun %default-element (et)
  (cond ((or (eq et 'character) (null et)) (code-char 0))
        ((eq et 'double-float) 0d0)
        ((eq et t) nil)
        (t 0)))

(defun make-array (dimensions &key (element-type t) (initial-element nil initp)
                                   (initial-contents nil contentsp) adjustable fill-pointer
                                   displaced-to (displaced-index-offset 0))
  (let* ((dims (if (listp dimensions) dimensions (list dimensions)))
         (total (let ((p 1))
                  (dolist (d dims p)
                    (unless (and (fixnump d) (>= d 0))
                      (%type-error d `(integer 0 (,array-dimension-limit))))
                    (setq p (* p d)))))
         (et (%normalize-element-type element-type))
         (fp (cond ((null fill-pointer) nil)
                   ((not (= (length-of-list dims) 1))
                    (error "MAKE-ARRAY: a fill pointer requires a one-dimensional array, not ~S" dims))
                   ((eq fill-pointer t) (car dims))
                   ((and (fixnump fill-pointer) (<= 0 fill-pointer (car dims))) fill-pointer)
                   (t (%type-error fill-pointer `(integer 0 ,(car dims)))))))
    (cond
      (displaced-to
       (unless (arrayp displaced-to) (%type-error displaced-to 'array))
       (unless (equal (array-element-type displaced-to) et)
         (error "MAKE-ARRAY: the element type ~S does not match that of ~S" element-type displaced-to))
       (unless (and (fixnump displaced-index-offset) (>= displaced-index-offset 0)
                    (<= (+ displaced-index-offset total) (array-total-size displaced-to)))
         (error "MAKE-ARRAY: cannot displace an array of size ~S to ~S at offset ~S"
                total displaced-to displaced-index-offset))
       (%make-mdarray displaced-to fp (copy-list dims) displaced-index-offset
                      (cons et (cons (not (null adjustable)) t))))
      (t
       (let ((data (%make-storage total et)))
         (cond (contentsp (%fill-from-contents data dims initial-contents))
               (initp (dotimes (i total) (%simple-set data i initial-element)))
               ((eq et t) (dotimes (i total) (%set-svref data i nil))))
         (if (and (null adjustable) (null fp) (consp dims) (null (cdr dims)) et)
             data
             (%make-mdarray data fp (copy-list dims) 0
                            (cons et (cons (not (null adjustable)) nil)))))))))

(defun %fill-from-contents (data dims contents)
  (let ((i 0))
    (labels ((walk (c ds)
               (if (null ds)
                   (progn (%simple-set data i c) (setq i (+ i 1)))
                   (progn
                     (unless (and (or (listp c) (vectorp c)) (eql (length c) (car ds)))
                       (error "MAKE-ARRAY: initial contents ~S do not match the dimensions ~S" c dims))
                     (map nil (lambda (x) (walk x (cdr ds))) c)))))
      (walk contents dims))))

(defun %array-info-type (a) (car (%mdarray-info a)))
(defun adjustable-array-p (a)
  (%check-array a)
  (and (%mdarray-p a) (not (null (cadr (%mdarray-info a))))))
(defun array-has-fill-pointer-p (a)
  (%check-array a)
  (and (%mdarray-p a) (not (null (%mdarray-fill a)))))
(defun fill-pointer (a)
  (if (and (arrayp a) (array-has-fill-pointer-p a)) (%mdarray-fill a)
      (error 'type-error :datum a :expected-type '(and vector (satisfies array-has-fill-pointer-p)))))
(defun %set-fill-pointer (a n)
  (unless (and (arrayp a) (array-has-fill-pointer-p a))
    (error 'type-error :datum a :expected-type '(and vector (satisfies array-has-fill-pointer-p))))
  (unless (and (fixnump n) (<= 0 n (car (%mdarray-dims a))))
    (%type-error n `(integer 0 ,(car (%mdarray-dims a)))))
  (%set-mdarray-fill a n) n)
(defun %displaced-p (a) (cddr (%mdarray-info a)))

(defun array-dimensions (a)
  (%check-array a)
  (if (%mdarray-p a) (copy-list (%mdarray-dims a)) (list (%simple-length a))))
(defun array-dimension (a axis)
  (%check-array a)
  (let ((r (array-rank a)))
    (unless (and (fixnump axis) (< -1 axis r)) (%type-error axis `(integer 0 (,r)))))
  (if (%mdarray-p a) (nth axis (%mdarray-dims a)) (%simple-length a)))
(defun array-rank (a)
  (%check-array a)
  (if (%mdarray-p a) (length-of-list (%mdarray-dims a)) 1))
(defun array-total-size (a)
  (%check-array a)
  (if (%mdarray-p a) (let ((p 1)) (dolist (d (%mdarray-dims a) p) (setq p (* p d)))) (%simple-length a)))
(defun array-element-type (a)
  (cond ((%mdarray-p a) (%array-info-type a))
        ((%simple-vector-p a) t)
        ((%simple-string-p a) 'character)
        ((%bits-p a) 'bit)
        ((%bytes-p a) '(unsigned-byte 8))
        ((%f64vec-p a) 'double-float)
        (t (%type-error a 'array))))
(defun array-displacement (a)
  (%check-array a)
  (if (and (%mdarray-p a) (%displaced-p a))
      (values (%mdarray-data a) (%mdarray-offset a))
      (values nil 0)))

(defun row-major-aref (a i)
  (if (%mdarray-p a)
      (let ((d (%mdarray-data a)))
        (if (%mdarray-p d) (row-major-aref d (+ i (%mdarray-offset a)))
            (%simple-ref d (+ i (%mdarray-offset a)))))
      (%simple-ref a i)))
(defun %row-major-aset (a i v)
  (if (%mdarray-p a)
      (let ((d (%mdarray-data a)))
        (if (%mdarray-p d) (%row-major-aset d (+ i (%mdarray-offset a)) v)
            (%simple-set d (+ i (%mdarray-offset a)) v)))
      (%simple-set a i v)))

(defun array-row-major-index (a &rest subscripts)
  (if (%mdarray-p a)
      (let ((idx 0) (dims (%mdarray-dims a)))
        (unless (= (length-of-list subscripts) (length-of-list dims))
          (error "Wrong number of subscripts ~S for array ~S" subscripts a))
        (do ((d dims (cdr d)) (s subscripts (cdr s))) ((null d) idx)
          (let ((sub (car s)))
            (unless (and (fixnump sub) (< -1 sub (car d)))
              (error 'index-out-of-bounds :datum sub :expected-type `(integer 0 (,(car d)))))
            (setq idx (+ (* idx (car d)) sub)))))
      (progn
        (%check-array a)
        (unless (and subscripts (null (cdr subscripts)))
          (error "Wrong number of subscripts ~S for array ~S" subscripts a))
        (let ((i (car subscripts)))
          (unless (and (fixnump i) (< -1 i (%simple-length a)))
            (error 'index-out-of-bounds :datum i :expected-type `(integer 0 (,(%simple-length a)))))
          i))))

(defun array-in-bounds-p (a &rest subscripts)
  (unless (= (length-of-list subscripts) (array-rank a))
    (error "Wrong number of subscripts ~S for array ~S" subscripts a))
  (do ((d (array-dimensions a) (cdr d)) (s subscripts (cdr s))) ((null d) t)
    (unless (integerp (car s)) (%type-error (car s) 'integer))
    (unless (< -1 (car s) (car d)) (return nil))))

(defun %aref1-slow (a i)
  (cond ((%simple-vector-p a) (%svref a (%check-index a i (%svlength a))))
        ((%simple-string-p a) (%schar a (%check-index a i (%string-length a))))
        ((%header-vector-p a)
         (row-major-aref a (%check-index a i (car (%mdarray-dims a)))))
        ((%mdarray-p a) (aref a i))
        (t (%check-array a) (%simple-ref a (%check-index a i (%simple-length a))))))

(defun %aset1-slow (a i v)
  (cond ((%simple-vector-p a) (%set-svref a (%check-index a i (%svlength a)) v))
        ((%simple-string-p a) (%simple-set a (%check-index a i (%string-length a)) v))
        ((%header-vector-p a)
         (%row-major-aset a (%check-index a i (car (%mdarray-dims a))) v))
        ((%mdarray-p a) (%aset a i v))
        (t (%check-array a) (%simple-set a (%check-index a i (%simple-length a)) v)))
  v)

(define-compiler-macro aref (&whole form a &rest subs)
  (if (and subs (null (cdr subs))) `(%aref1 ,a ,(car subs)) form))

(defun aref (a &rest subscripts)
  (if (and (%simple-vector-p a) subscripts (null (cdr subscripts)))
      (svref a (car subscripts))
      (row-major-aref a (apply #'array-row-major-index a subscripts))))
(defun %aset (a &rest subscripts-and-value)
  (let ((v (car (last subscripts-and-value)))
        (subs (butlast subscripts-and-value)))
    (%row-major-aset a (apply #'array-row-major-index a subs) v)
    v))

(defun %check-index (v i len)
  (unless (and (fixnump i) (< -1 i len))
    (error 'index-out-of-bounds :datum i :expected-type `(integer 0 (,len)) :sequence v))
  i)

(defun svref (v i)
  (unless (%simple-vector-p v) (%type-error v 'simple-vector))
  (%svref v (%check-index v i (%svlength v))))
(defun %aref1 (a i) (%aref1 a i))
(defun %aset1 (a i v) (%aset1 a i v))
(defun %svset (v i x)
  (unless (%simple-vector-p v) (%type-error v 'simple-vector))
  (%set-svref v (%check-index v i (%svlength v)) x))
(defun schar (s i)
  (unless (%simple-string-p s) (%type-error s 'simple-string))
  (%schar s (%check-index s i (%string-length s))))
(defun %scharset (s i c)
  (unless (%simple-string-p s) (%type-error s 'simple-string))
  (%simple-set s (%check-index s i (%string-length s)) c))
(defun char (s i)
  (cond ((%simple-string-p s) (%schar s (%check-index s i (%string-length s))))
        ((stringp s) (row-major-aref s (%check-index s i (array-total-size s))))
        (t (%type-error s 'string))))
(defun %charset (s i c)
  (cond ((%simple-string-p s) (%simple-set s (%check-index s i (%string-length s)) c))
        ((stringp s) (%row-major-aset s (%check-index s i (array-total-size s)) c))
        (t (%type-error s 'string))))
(defun bit (a &rest subs)
  (unless (and (arrayp a) (eq (array-element-type a) 'bit)) (%type-error a '(array bit)))
  (apply #'aref a subs))
(defun sbit (a &rest subs)
  (unless (and (%simple-array-type-p a) (eq (array-element-type a) 'bit)) (%type-error a '(simple-array bit)))
  (apply #'aref a subs))

(defun vector (&rest items)
  (let ((v (%make-simple-vector (length-of-list items) nil)) (i 0))
    (dolist (x items v) (%set-svref v i x) (setq i (+ i 1)))))

(defun vector-push (x v)
  (let ((fp (fill-pointer v)))
    (if (< fp (array-dimension v 0))
        (progn (%row-major-aset v fp x) (%set-mdarray-fill v (+ fp 1)) fp)
        nil)))

(defun vector-push-extend (x v &optional (extension 16))
  (let ((fp (fill-pointer v)))
    (when (>= fp (array-dimension v 0))
      (unless (adjustable-array-p v) (error "VECTOR-PUSH-EXTEND: ~S is not adjustable" v))
      (unless (and (integerp extension) (> extension 0)) (%type-error extension '(integer 1 *)))
      (%adjust-vector-storage v (+ fp (max extension fp 4))))
    (%row-major-aset v fp x)
    (%set-mdarray-fill v (+ fp 1))
    fp))

(defun vector-pop (v)
  (let ((fp (fill-pointer v)))
    (when (= fp 0) (error "VECTOR-POP: empty vector ~S" v))
    (%set-mdarray-fill v (- fp 1))
    (row-major-aref v (- fp 1))))

(defun %adjust-vector-storage (v new-size)
  (let* ((et (%array-info-type v))
         (new (%make-storage new-size et))
         (n (min new-size (array-total-size v))))
    (dotimes (i n) (%simple-set new i (row-major-aref v i)))
    (%set-mdarray-data v new)
    (%set-mdarray-offset v 0)
    (%set-mdarray-dims v (list new-size))
    (%set-mdarray-info v (cons et (cons (cadr (%mdarray-info v)) nil)))
    v))

(defun adjust-array (a new-dims &key (element-type nil etp) (initial-element nil initp)
                                     (initial-contents nil contentsp) (fill-pointer nil)
                                     displaced-to (displaced-index-offset 0))
  (%check-array a)
  (let* ((dims (if (listp new-dims) new-dims (list new-dims)))
         (et (array-element-type a)))
    (unless (= (length-of-list dims) (array-rank a))
      (error "ADJUST-ARRAY: the rank of ~S does not match the dimensions ~S" a dims))
    (when (and etp (not (equal (%normalize-element-type element-type) et)))
      (error "ADJUST-ARRAY: the element type ~S does not match that of ~S" element-type a))
    (when (and fill-pointer (not (array-has-fill-pointer-p a)))
      (error "ADJUST-ARRAY: ~S has no fill pointer" a))
    (let* ((fp (cond ((eq fill-pointer t) (car dims))
                     (fill-pointer fill-pointer)
                     ((array-has-fill-pointer-p a) (fill-pointer a))
                     (t nil)))
           (new (cond (displaced-to
                       (make-array dims :element-type et :displaced-to displaced-to
                                        :displaced-index-offset displaced-index-offset))
                      (contentsp (make-array dims :element-type et :initial-contents initial-contents))
                      (t (let ((n (make-array dims :element-type et
                                                   :initial-element (if initp initial-element
                                                                        (%default-element et)))))
                           (labels ((walk (prefix ds olds)
                                      (if (null ds)
                                          (%row-major-aset n (apply #'array-row-major-index n prefix)
                                                           (row-major-aref a (apply #'array-row-major-index a prefix)))
                                          (dotimes (i (min (car ds) (car olds)))
                                            (walk (append prefix (list i)) (cdr ds) (cdr olds))))))
                             (walk nil dims (array-dimensions a)))
                           n)))))
      (when (and fp (> fp (car dims)))
        (error "ADJUST-ARRAY: fill pointer ~S is larger than the new size ~S" fp (car dims)))
      (if (adjustable-array-p a)
          (progn
            (if (%mdarray-p new)
                (progn (%set-mdarray-data a (%mdarray-data new))
                       (%set-mdarray-offset a (%mdarray-offset new)))
                (progn (%set-mdarray-data a new) (%set-mdarray-offset a 0)))
            (%set-mdarray-dims a (copy-list dims))
            (%set-mdarray-info a (cons et (cons t (if displaced-to t nil))))
            (%set-mdarray-fill a fp)
            a)
          (if fp
              (if (%mdarray-p new)
                  (progn (%set-mdarray-fill new fp) new)
                  (%make-mdarray new fp (copy-list dims) 0 (cons et (cons nil nil))))
              new)))))

;;; ------------------------------------------------------------
;;; sequences: argument checking and iteration helpers
;;; ------------------------------------------------------------

(defun %fn (f)
  (cond ((functionp f) f)
        ((symbolp f) (symbol-function f))
        (t (%type-error f '(or function symbol)))))
(defun %keyfn (key)
  (cond ((null key) nil) ((functionp key) key) ((symbolp key) (symbol-function key))
        (t (%type-error key '(or function symbol)))))
(defun %seq-test (test test-not)
  (cond ((and test test-not) (error "Both :TEST and :TEST-NOT were supplied"))
        (test (%fn test))
        (test-not (let ((tn (%fn test-not))) (lambda (a b) (not (funcall tn a b)))))
        (t #'eql)))
(defmacro %key (key x) `(if ,key (funcall ,key ,x) ,x))

(defun %list-length-checked (l)
  (let ((n (list-length l)))
    (or n (%type-error l '(and list (satisfies list-length))))))

(defun %seq-length (seq)
  (cond ((listp seq) (%list-length-checked seq))
        ((vectorp seq) (length seq))
        (t (%type-error seq 'sequence))))

(defun %check-bounds (start end len)
  "Validates the bounding index designators START and END; returns the effective end."
  (unless (and (fixnump start) (<= 0 start len))
    (%type-error start `(integer 0 ,len)))
  (cond ((null end) len)
        ((and (fixnump end) (<= start end len)) end)
        (t (%type-error end `(or null (integer ,start ,len))))))

(defun %check-count (count)
  (cond ((null count) nil)
        ((integerp count) (if (< count 0) 0 count))
        (t (%type-error count '(or null integer)))))

(defun %list-region (list start end)
  "A fresh list of the elements of LIST in [START, END)."
  (let ((l (nthcdr start list)) (r nil))
    (dotimes (i (- end start) (nreverse-list r))
      (push (car l) r) (setq l (cdr l)))))

(defmacro %do-region ((var idx seq start end from-end) &body body)
  "Iterates over the elements of SEQ in [START, END), backwards when FROM-END.
IDX is bound to the index of each element.  (RETURN x) exits."
  (let ((s (gensym)) (l (gensym)) (e (gensym)) (st (gensym)))
    `(let ((,s ,seq) (,st ,start) (,e ,end))
       (block nil
         (if (listp ,s)
             (if ,from-end
                 (let ((,idx (- ,e 1)))
                   (dolist (,var (nreverse-list (%list-region ,s ,st ,e)))
                     ,@body
                     (setq ,idx (- ,idx 1))))
                 (let ((,idx ,st))
                   (do ((,l (nthcdr ,st ,s) (cdr ,l))) ((>= ,idx ,e))
                     (let ((,var (car ,l))) ,@body)
                     (setq ,idx (+ ,idx 1)))))
             (if ,from-end
                 (do ((,idx (- ,e 1) (- ,idx 1))) ((< ,idx ,st))
                   (let ((,var (row-major-aref ,s ,idx))) ,@body))
                 (do ((,idx ,st (+ ,idx 1))) ((>= ,idx ,e))
                   (let ((,var (row-major-aref ,s ,idx))) ,@body))))))))

;;; ------------------------------------------------------------
;;; sequence result types
;;; ------------------------------------------------------------

(defun %vector-type-dims-ok (dims)
  (or (eq dims '*) (eql dims 1)
      (and (consp dims) (null (cdr dims)) (or (eq (car dims) '*) (fixnump (car dims))))))

(defun %seq-type-spec (type)
  "Analyzes a sequence type specifier.  Returns (values kind element-type length exact):
KIND is :LIST or :VECTOR, LENGTH is the required length or NIL, and EXACT is true when
the type is fully described by the other values (otherwise the result is checked with TYPEP)."
  (let ((ty (if (%class-p type) (%class-name type) type)))
    (flet ((len (x) (if (or (null x) (eq x '*)) nil x)))
      (cond
        ((symbolp ty)
         (case ty
           ((list) (values :list nil nil t))
           ((cons null) (values :list nil nil nil))
           ((vector simple-vector) (values :vector t nil t))
           ((string simple-string base-string simple-base-string) (values :vector 'character nil t))
           ((bit-vector simple-bit-vector) (values :vector 'bit nil t))
           ((nil) (error 'type-error :datum type :expected-type 'sequence))
           (t (%seq-type-spec-general type ty))))
        ((consp ty)
         (case (car ty)
           ((vector)
            (let ((et (if (cdr ty) (cadr ty) '*)))
              (values :vector (if (eq et '*) t (%normalize-element-type et)) (len (caddr ty)) (not (eq et '*)))))
           ((simple-vector) (values :vector t (len (cadr ty)) t))
           ((string simple-string base-string simple-base-string) (values :vector 'character (len (cadr ty)) t))
           ((bit-vector simple-bit-vector) (values :vector 'bit (len (cadr ty)) t))
           ((array simple-array)
            (let ((et (if (cdr ty) (cadr ty) '*)) (dims (if (cddr ty) (caddr ty) '*)))
              (unless (%vector-type-dims-ok dims) (error 'type-error :datum type :expected-type 'sequence))
              (values :vector (if (eq et '*) t (%normalize-element-type et))
                      (if (consp dims) (len (car dims)) nil) (not (eq et '*)))))
           ((cons) (values :list nil nil nil))
           (t (%seq-type-spec-general type ty))))
        (t (error 'type-error :datum type :expected-type 'sequence))))))

(defun %seq-type-spec-general (type ty)
  (multiple-value-bind (exp found) (%expand-deftype ty)
    (cond (found (multiple-value-bind (kind et len) (%seq-type-spec exp) (values kind et len nil)))
          ((and (consp ty) (eq (car ty) 'or) (cdr ty))
           ;; every alternative must agree on the kind of sequence and the element type
           (let ((specs (mapcar (lambda (alt) (multiple-value-list (%seq-type-spec alt))) (cdr ty))))
             (dolist (sp (cdr specs))
               (unless (and (eq (first sp) (first (car specs))) (equal (second sp) (second (car specs))))
                 (error "The sequence type ~S is ambiguous" type)))
             (values (first (car specs)) (second (car specs)) nil nil)))
          ((subtypep ty nil) (error 'type-error :datum type :expected-type 'sequence))
          ((subtypep ty 'list) (values :list nil nil nil))
          ((subtypep ty 'vector)
           (flet ((sub (x) (multiple-value-bind (r certain) (subtypep ty x) (and r certain))))
             (values :vector
                     (cond ((sub '(vector character)) 'character)
                           ((sub '(vector bit)) 'bit)
                           ((sub '(vector (unsigned-byte 8))) '(unsigned-byte 8))
                           ((sub '(vector double-float)) 'double-float)
                           (t t))
                     nil nil)))
          (t (error 'type-error :datum type :expected-type 'sequence)))))

(defun %check-result-type (seq type exact)
  (unless (or exact (typep seq type))
    (error 'type-error :datum seq :expected-type type))
  seq)

(defun %make-sequence-from-list (type list)
  "A sequence of TYPE with the elements of LIST (which may be reused)."
  (multiple-value-bind (kind et len exact) (%seq-type-spec type)
    (let ((n (length-of-list list)))
      (when (and len (/= len n)) (error 'type-error :datum list :expected-type type))
      (if (eq kind :list)
          (%check-result-type list type exact)
          (let ((v (%make-storage n et)) (i 0))
            (dolist (x list) (%simple-set v i x) (setq i (+ i 1)))
            (%check-result-type v type exact))))))

(defun make-sequence (type size &key (initial-element nil initp))
  (multiple-value-bind (kind et len exact) (%seq-type-spec type)
    (unless (and (fixnump size) (>= size 0)) (%type-error size '(integer 0 *)))
    (when (and len (/= len size)) (error 'type-error :datum size :expected-type `(eql ,len)))
    (%check-result-type
     (if (eq kind :list)
         (make-list size :initial-element initial-element)
         (let ((v (%make-storage size et)))
           (when initp (dotimes (i size) (%simple-set v i initial-element)))
           v))
     type exact)))

;;; SUBTYPEP on array types.  An array type is canonicalized to a list of
;;; alternatives (simple element-type dims): SIMPLE is T for simple arrays only,
;;; ELEMENT-TYPE is an upgraded element type or *, DIMS is * or a list of * / sizes.

(defun %array-type-canon (ty)
  (flet ((et (x) (if (eq x '*) '* (%normalize-element-type x)))
         (dims (d) (cond ((eq d '*) '*)
                         ((fixnump d) (make-list d :initial-element '*))
                         ((listp d) d)
                         (t (return-from %array-type-canon :unknown))))
         (size (args) (if (or (null args) (eq (car args) '*)) '(*) (list (car args)))))
    (let ((head (if (consp ty) (car ty) ty)) (args (if (consp ty) (cdr ty) nil)))
      (case head
        ((and)
         ;; intersect the alternatives of the conjuncts
         (let ((r (list (list nil '* '*))))
           (dolist (x args r)
             (let ((c (%array-type-canon x)) (new nil))
               (when (eq c :unknown) (return-from %array-type-canon :unknown))
               (dolist (a r) (dolist (b c) (let ((i (%array-alt-intersect a b))) (when i (push i new)))))
               (setq r new)))))
        ((array simple-array)
         (list (list (eq head 'simple-array) (et (if args (car args) '*))
                     (dims (if (cdr args) (cadr args) '*)))))
        ((vector)
         (list (list nil (et (if args (car args) '*)) (size (cdr args)))))
        ((simple-vector) (list (list t t (size args))))
        ((string) (list (list nil 'character (size args)) (list nil nil (size args))))
        ((simple-string) (list (list t 'character (size args)) (list t nil (size args))))
        ((base-string) (list (list nil 'character (size args))))
        ((simple-base-string) (list (list t 'character (size args))))
        ((bit-vector) (list (list nil 'bit (size args))))
        ((simple-bit-vector) (list (list t 'bit (size args))))
        (t :unknown)))))

(defun %array-alt-intersect (a b)
  (destructuring-bind (s1 e1 d1) a
    (destructuring-bind (s2 e2 d2) b
      (let ((et (cond ((eq e1 '*) e2) ((eq e2 '*) e1) ((equal e1 e2) e1) (t (return-from %array-alt-intersect nil))))
            (dims (cond ((eq d1 '*) d2) ((eq d2 '*) d1)
                        ((/= (length-of-list d1) (length-of-list d2)) (return-from %array-alt-intersect nil))
                        (t (mapcar (lambda (x y) (cond ((eq x '*) y) ((eq y '*) x) ((eql x y) x)
                                                       (t (return-from %array-alt-intersect nil))))
                                   d1 d2)))))
        (list (or s1 s2) et dims)))))

(defun %array-alt-subtypep (a b)
  (destructuring-bind (s1 e1 d1) a
    (destructuring-bind (s2 e2 d2) b
      (and (or (not s2) s1)
           (or (eq e2 '*) (and (not (eq e1 '*)) (equal e1 e2)))
           (or (eq d2 '*)
               (and (listp d1) (= (length-of-list d1) (length-of-list d2))
                    (every (lambda (x y) (or (eq y '*) (eql x y))) d1 d2)))))))

(defun %subtypep-arrays (t1 t2)
  "Returns (values result certain known); KNOWN is NIL when the types are not handled."
  (let ((c1 (%array-type-canon t1)))
    (if (eq c1 :unknown)
        (values nil nil nil)
        (cond ((member t2 '(t atom)) (values t t t))
              ((null t2) (values (null c1) t t))
              ((eq t2 'sequence)
               (values (every (lambda (a) (and (listp (third a)) (= (length-of-list (third a)) 1))) c1) t t))
              ((member t2 '(list cons null symbol number character function hash-table package
                            integer real float rational structure-object standard-object))
               (values (null c1) t t))
              (t (let ((c2 (%array-type-canon t2)))
                   (if (eq c2 :unknown)
                       (values nil nil nil)
                       (values (every (lambda (a) (some (lambda (b) (%array-alt-subtypep a b)) c2)) c1)
                               t t))))))))

;;; ------------------------------------------------------------
;;; sequences: generic accessors
;;; ------------------------------------------------------------

(defun length (seq)
  (cond ((listp seq) (length-of-list seq))
        ((%simple-string-p seq) (%string-length seq))
        ((%simple-vector-p seq) (%svlength seq))
        ((%header-vector-p seq) (or (%mdarray-fill seq) (car (%mdarray-dims seq))))
        ((%simple-array-p seq) (%simple-length seq))
        (t (%type-error seq 'sequence))))

(defun sequencep (x) (or (listp x) (vectorp x)))

(defun elt (seq i)
  (cond ((listp seq)
         (unless (and (fixnump i) (>= i 0)) (%type-error i '(integer 0 *)))
         (let ((l (nthcdr i seq)))
           (if (consp l) (car l)
               (error 'index-out-of-bounds :datum i :expected-type `(integer 0 (,(length-of-list seq)))
                                           :sequence seq))))
        ((vectorp seq) (row-major-aref seq (%check-index seq i (length seq))))
        (t (%type-error seq 'sequence))))
(defun %setelt (seq i v)
  (cond ((listp seq)
         (unless (and (fixnump i) (>= i 0)) (%type-error i '(integer 0 *)))
         (let ((l (nthcdr i seq)))
           (if (consp l) (%setcar l v)
               (error 'index-out-of-bounds :datum i :expected-type `(integer 0 (,(length-of-list seq)))
                                           :sequence seq))))
        ((vectorp seq) (%row-major-aset seq (%check-index seq i (length seq)) v))
        (t (%type-error seq 'sequence)))
  v)

(defun %vector-like (seq n)
  "A fresh simple vector of the same element type as SEQ with N elements."
  (if (%mdarray-p seq) (%make-storage n (%array-info-type seq)) (%make-storage n (%storage-element-type seq))))

(defun %list-to-vector-like (list proto)
  (let* ((n (length-of-list list)) (v (%vector-like proto n)) (i 0))
    (dolist (x list v) (%simple-set v i x) (setq i (+ i 1)))))

(defun subseq (seq start &optional end)
  (cond ((listp seq)
         (unless (and (fixnump start) (>= start 0)) (%type-error start '(integer 0 *)))
         (when (and end (not (and (fixnump end) (>= end start)))) (%type-error end `(or null (integer ,start *))))
         (let ((l seq))
           (dotimes (i start)
             (unless (consp l) (%type-error start `(integer 0 ,i)))
             (setq l (cdr l)))
           (if end
               (let ((r nil))
                 (dotimes (i (- end start) (nreverse-list r))
                   (unless (consp l) (%type-error end `(or null (integer ,start ,(+ start i)))))
                   (push (car l) r) (setq l (cdr l))))
               (copy-list l))))
        ((vectorp seq)
         (let* ((len (length seq)) (end (%check-bounds start end len))
                (v (%vector-like seq (- end start))))
           (if (and (%simple-string-p seq) (%simple-string-p v))
               (dotimes (i (- end start) v) (%set-schar v i (%schar seq (+ start i))))
               (dotimes (i (- end start) v) (%simple-set v i (row-major-aref seq (+ start i)))))))
        (t (%type-error seq 'sequence))))

(defun %set-subseq (seq start &rest rest)
  (let ((new (car (last rest))) (end (if (cdr rest) (car rest) nil)))
    (replace seq new :start1 start :end1 end)
    new))

(defun copy-seq (seq) (if (listp seq) (copy-list seq) (subseq seq 0)))

(defun reverse (seq)
  (cond ((listp seq) (reverse-list seq))
        ((vectorp seq)
         (let* ((n (length seq)) (v (%vector-like seq n)))
           (dotimes (i n v) (%simple-set v i (row-major-aref seq (- n i 1))))))
        (t (%type-error seq 'sequence))))

(defun nreverse (seq)
  (cond ((listp seq) (nreverse-list seq))
        ((vectorp seq)
         (let ((n (length seq)))
           (dotimes (i (floor n 2) seq)
             (let ((tmp (row-major-aref seq i)))
               (%row-major-aset seq i (row-major-aref seq (- n i 1)))
               (%row-major-aset seq (- n i 1) tmp)))))
        (t (%type-error seq 'sequence))))

(defun %seq-to-list (seq &optional (start 0) end)
  (if (listp seq)
      (if (or (> start 0) end) (subseq seq start end) seq)
      (let ((r nil) (end (or end (length seq))))
        (do ((i (- end 1) (- i 1))) ((< i start) r) (push (row-major-aref seq i) r)))))

(defun %list-to-seq-like (list proto)
  (if (listp proto) list (%list-to-vector-like list proto)))

(defun concatenate (result-type &rest seqs)
  (dolist (s seqs) (unless (or (listp s) (vectorp s)) (%type-error s 'sequence)))
  (if (member result-type '(list string simple-string))
      (if (eq result-type 'list)
          (let ((r nil))
            (dolist (s seqs (nreverse-list r))
              (if (listp s) (dolist (x s) (push x r))
                  (dotimes (i (length s)) (push (row-major-aref s i) r)))))
          (let* ((total (let ((n 0)) (dolist (s seqs n) (setq n (+ n (length s))))))
                 (v (%make-string total (code-char 0))) (i 0))
            (dolist (s seqs v)
              (if (listp s)
                  (dolist (x s) (%simple-set v i x) (setq i (+ i 1)))
                  (dotimes (j (length s)) (%simple-set v i (row-major-aref s j)) (setq i (+ i 1)))))))
      (let ((r nil))
        (dolist (s seqs)
          (if (listp s) (dolist (x s) (push x r))
              (dotimes (i (length s)) (push (row-major-aref s i) r))))
        (%make-sequence-from-list result-type (nreverse-list r)))))

(defun %map-args (cursors i)
  ;; CURSORS is a fresh list: list sequences are replaced by their remaining tails
  (let ((args nil))
    (do ((c cursors (cdr c))) ((null c) (nreverse-list args))
      (let ((s (car c)))
        (if (listp s)
            (progn (push (car s) args) (%setcar c (cdr s)))
            (push (row-major-aref s i) args))))))

(defun %min-length (seqs)
  (let ((m nil))
    (dolist (s seqs (or m 0))
      (let ((l (cond ((listp s) (or (list-length s) most-positive-fixnum))
                     ((vectorp s) (length s))
                     (t (%type-error s 'sequence)))))
        (when (or (null m) (< l m)) (setq m l))))))

(defun map (result-type f seq &rest more)
  (let* ((f (%fn f)) (seqs (cons seq more)) (n (%min-length seqs)) (cursors (copy-list seqs)))
    (if (null result-type)
        (progn (dotimes (i n) (apply f (%map-args cursors i))) nil)
        (let ((results nil))
          (%seq-type-spec result-type)
          (dotimes (i n) (push (apply f (%map-args cursors i)) results))
          (%make-sequence-from-list result-type (nreverse-list results))))))

(defun map-into (result f &rest seqs)
  (let* ((f (%fn f))
         (n (cond ((listp result) (%list-length-checked result))
                  ((vectorp result) (if (array-has-fill-pointer-p result) (array-dimension result 0) (length result)))
                  (t (%type-error result 'sequence))))
         (n (if seqs (min n (%min-length seqs)) n))
         (cursors (copy-list seqs)))
    (if (listp result)
        (let ((l result))
          (dotimes (i n) (%setcar l (apply f (%map-args cursors i))) (setq l (cdr l))))
        (progn
          (dotimes (i n) (%row-major-aset result i (apply f (%map-args cursors i))))
          (when (array-has-fill-pointer-p result) (%set-mdarray-fill result n))))
    result))

(defun reduce (f seq &key key from-end (start 0) end (initial-value nil ivp))
  (let* ((f (%fn f)) (key (%keyfn key))
         (end (%check-bounds start end (%seq-length seq)))
         (acc initial-value) (first (not ivp)))
    (%do-region (x i seq start end from-end)
      (let ((v (%key key x)))
        (cond (first (setq acc v first nil))
              (from-end (setq acc (funcall f v acc)))
              (t (setq acc (funcall f acc v))))))
    (if first (funcall f) acc)))

(defun fill (seq item &key (start 0) end)
  (let ((end (%check-bounds start end (%seq-length seq))))
    (if (listp seq)
        (let ((l (nthcdr start seq)))
          (dotimes (i (- end start)) (%setcar l item) (setq l (cdr l))))
        (do ((i start (+ i 1))) ((>= i end)) (%row-major-aset seq i item)))
    seq))

(defun replace (seq1 seq2 &key (start1 0) end1 (start2 0) end2)
  (let* ((end1 (%check-bounds start1 end1 (%seq-length seq1)))
         (end2 (%check-bounds start2 end2 (%seq-length seq2)))
         (n (min (- end1 start1) (- end2 start2))))
    (cond ((and (eq seq1 seq2) (> start1 start2))
           (let ((tmp (%seq-to-list seq2 start2 (+ start2 n))))
             (replace seq1 tmp :start1 start1)))
          ((and (listp seq1) (listp seq2))
           (let ((a (nthcdr start1 seq1)) (b (nthcdr start2 seq2)))
             (dotimes (i n) (%setcar a (car b)) (setq a (cdr a) b (cdr b)))))
          ((listp seq1)
           (let ((a (nthcdr start1 seq1)))
             (dotimes (i n) (%setcar a (row-major-aref seq2 (+ start2 i))) (setq a (cdr a)))))
          ((listp seq2)
           (let ((b (nthcdr start2 seq2)))
             (dotimes (i n) (%row-major-aset seq1 (+ start1 i) (car b)) (setq b (cdr b)))))
          (t (dotimes (i n) (%row-major-aset seq1 (+ start1 i) (row-major-aref seq2 (+ start2 i))))))
    seq1))

;;; searching
(defun find-if (pred seq &key key from-end (start 0) end)
  (let* ((pred (%fn pred)) (key (%keyfn key)) (end (%check-bounds start end (%seq-length seq))))
    (%do-region (x i seq start end from-end)
      (when (funcall pred (%key key x)) (return x)))))
(defun find-if-not (pred seq &key key from-end (start 0) end)
  (let ((pred (%fn pred)))
    (find-if (lambda (x) (not (funcall pred x))) seq :key key :from-end from-end :start start :end end)))
(defun find (item seq &key key test test-not from-end (start 0) end)
  (if (and (listp seq) (null key) (null test) (null test-not) (null from-end) (eql start 0) (null end))
      (do ((l seq (cdr l))) ((%endp l) nil) (when (eql item (car l)) (return (car l))))
      (let ((tf (%seq-test test test-not)))
        (find-if (lambda (x) (funcall tf item x)) seq :key key :from-end from-end :start start :end end))))

(defun position-if (pred seq &key key from-end (start 0) end)
  (let* ((pred (%fn pred)) (key (%keyfn key)) (end (%check-bounds start end (%seq-length seq))))
    (%do-region (x i seq start end from-end)
      (when (funcall pred (%key key x)) (return i)))))
(defun position-if-not (pred seq &key key from-end (start 0) end)
  (let ((pred (%fn pred)))
    (position-if (lambda (x) (not (funcall pred x))) seq :key key :from-end from-end :start start :end end)))
(defun position (item seq &key key test test-not from-end (start 0) end)
  (let ((tf (%seq-test test test-not)))
    (position-if (lambda (x) (funcall tf item x)) seq :key key :from-end from-end :start start :end end)))

(defun count-if (pred seq &key key from-end (start 0) end)
  (let* ((pred (%fn pred)) (key (%keyfn key)) (end (%check-bounds start end (%seq-length seq))) (n 0))
    (%do-region (x i seq start end from-end)
      (when (funcall pred (%key key x)) (setq n (+ n 1))))
    n))
(defun count-if-not (pred seq &key key from-end (start 0) end)
  (let ((pred (%fn pred)))
    (count-if (lambda (x) (not (funcall pred x))) seq :key key :from-end from-end :start start :end end)))
(defun count (item seq &key key test test-not from-end (start 0) end)
  (let ((tf (%seq-test test test-not)))
    (count-if (lambda (x) (funcall tf item x)) seq :key key :from-end from-end :start start :end end)))

;;; removal
(defun %mark-matches (pred seq start end from-end count key)
  "A simple vector of flags for [START, END): T where an element is selected."
  (let ((marks (%make-simple-vector (- end start) nil)) (n 0))
    (unless (eql count 0)
      (%do-region (x i seq start end from-end)
        (when (funcall pred (%key key x))
          (%set-svref marks (- i start) t)
          (setq n (+ n 1))
          (when (and count (>= n count)) (return nil)))))
    (values marks n)))

(defun %remove-marked (seq start end marks)
  (if (listp seq)
      (let* ((head (cons nil nil)) (tail head) (l seq))
        (dotimes (i end)
          (unless (and (>= i start) (%svref marks (- i start)))
            (let ((c (cons (car l) nil))) (%setcdr tail c) (setq tail c)))
          (setq l (cdr l)))
        (%setcdr tail l)
        (cdr head))
      (let* ((len (length seq)) (removed 0))
        (dotimes (i (- end start)) (when (%svref marks i) (setq removed (+ removed 1))))
        (let ((v (%vector-like seq (- len removed))) (j 0))
          (dotimes (i len v)
            (unless (and (>= i start) (< i end) (%svref marks (- i start)))
              (%simple-set v j (row-major-aref seq i))
              (setq j (+ j 1))))))))

(defun remove-if (pred seq &key key from-end (start 0) end count)
  (let* ((pred (%fn pred)) (key (%keyfn key)) (count (%check-count count))
         (end (%check-bounds start end (%seq-length seq))))
    (multiple-value-bind (marks n) (%mark-matches pred seq start end from-end count key)
      (if (and (= n 0) (listp seq)) seq (%remove-marked seq start end marks)))))
(defun remove-if-not (pred seq &key key from-end (start 0) end count)
  (let ((pred (%fn pred)))
    (remove-if (lambda (x) (not (funcall pred x))) seq :key key :from-end from-end :start start :end end :count count)))
(defun remove (item seq &key key test test-not from-end (start 0) end count)
  (let ((tf (%seq-test test test-not)))
    (remove-if (lambda (x) (funcall tf item x)) seq :key key :from-end from-end :start start :end end :count count)))
(defun delete-if (pred seq &key key from-end (start 0) end count)
  (let* ((pred (%fn pred)) (key (%keyfn key)) (count (%check-count count))
         (end (%check-bounds start end (%seq-length seq))))
    (multiple-value-bind (marks n) (%mark-matches pred seq start end from-end count key)
      (cond ((= n 0) seq)
            ((and (vectorp seq) (array-has-fill-pointer-p seq))
             ;; compact in place
             (let ((len (length seq)) (j start))
               (do ((i start (+ i 1))) ((>= i len))
                 (unless (and (< i end) (%svref marks (- i start)))
                   (%row-major-aset seq j (row-major-aref seq i))
                   (setq j (+ j 1))))
               (%set-mdarray-fill seq j)
               seq))
            ((consp seq)
             ;; splice the marked conses out of the list itself
             (let* ((head (cons nil seq)) (prev head) (l seq))
               (dotimes (i end)
                 (if (and (>= i start) (%svref marks (- i start)))
                     (%setcdr prev (cdr l))
                     (setq prev l))
                 (setq l (cdr l)))
               (cdr head)))
            (t (%remove-marked seq start end marks))))))
(defun delete-if-not (pred seq &key key from-end (start 0) end count)
  (let ((pred (%fn pred)))
    (delete-if (lambda (x) (not (funcall pred x))) seq :key key :from-end from-end :start start :end end :count count)))
(defun delete (item seq &key key test test-not from-end (start 0) end count)
  (let ((tf (%seq-test test test-not)))
    (delete-if (lambda (x) (funcall tf item x)) seq :key key :from-end from-end :start start :end end :count count)))

(defun remove-duplicates (seq &key key test test-not from-end (start 0) end)
  (let* ((tf (%seq-test test test-not)) (key (%keyfn key))
         (end (%check-bounds start end (%seq-length seq)))
         (n (- end start))
         (items (let ((v (%make-simple-vector n nil)))
                  (%do-region (x i seq start end nil) (%set-svref v (- i start) (%key key x)))
                  v))
         (marks (%make-simple-vector n nil)) (found nil))
    (if from-end
        ;; keep the first occurrence: drop an element matching an earlier kept one
        (dotimes (j n)
          (dotimes (i j)
            (when (and (not (%svref marks i)) (funcall tf (%svref items i) (%svref items j)))
              (%set-svref marks j t) (setq found t) (return))))
        ;; keep the last occurrence: drop an element matching a later one
        (dotimes (i n)
          (do ((j (+ i 1) (+ j 1))) ((>= j n))
            (when (funcall tf (%svref items i) (%svref items j))
              (%set-svref marks i t) (setq found t) (return)))))
    (if (and (not found) (listp seq)) seq (%remove-marked seq start end marks))))
(defun delete-duplicates (seq &rest keys) (apply #'remove-duplicates seq keys))

;;; substitution
(defun %substitute (new pred seq key from-end start end count destructive)
  (let* ((pred (%fn pred)) (key (%keyfn key)) (count (%check-count count))
         (end (%check-bounds start end (%seq-length seq))))
    (let ((marks (%mark-matches pred seq start end from-end count key)))
      (cond (destructive
             (if (listp seq)
                 (let ((l (nthcdr start seq)))
                   (dotimes (i (- end start)) (when (%svref marks i) (%setcar l new)) (setq l (cdr l))))
                 (dotimes (i (- end start)) (when (%svref marks i) (%row-major-aset seq (+ start i) new))))
             seq)
            ((listp seq)
             (let* ((head (cons nil nil)) (tail head) (l seq))
               (dotimes (i end)
                 (let ((c (cons (if (and (>= i start) (%svref marks (- i start))) new (car l)) nil)))
                   (%setcdr tail c) (setq tail c))
                 (setq l (cdr l)))
               (%setcdr tail (copy-list l))
               (cdr head)))
            (t (let* ((len (length seq)) (v (%vector-like seq len)))
                 (dotimes (i len v)
                   (%simple-set v i (if (and (>= i start) (< i end) (%svref marks (- i start)))
                                        new (row-major-aref seq i))))))))))

(defun substitute-if (new pred seq &key key from-end (start 0) end count)
  (%substitute new pred seq key from-end start end count nil))
(defun substitute-if-not (new pred seq &key key from-end (start 0) end count)
  (let ((pred (%fn pred)))
    (%substitute new (lambda (x) (not (funcall pred x))) seq key from-end start end count nil)))
(defun substitute (new old seq &key key test test-not from-end (start 0) end count)
  (let ((tf (%seq-test test test-not)))
    (%substitute new (lambda (x) (funcall tf old x)) seq key from-end start end count nil)))
(defun nsubstitute-if (new pred seq &key key from-end (start 0) end count)
  (%substitute new pred seq key from-end start end count t))
(defun nsubstitute-if-not (new pred seq &key key from-end (start 0) end count)
  (let ((pred (%fn pred)))
    (%substitute new (lambda (x) (not (funcall pred x))) seq key from-end start end count t)))
(defun nsubstitute (new old seq &key key test test-not from-end (start 0) end count)
  (let ((tf (%seq-test test test-not)))
    (%substitute new (lambda (x) (funcall tf old x)) seq key from-end start end count t)))

(defun mismatch (s1 s2 &key key test test-not from-end (start1 0) end1 (start2 0) end2)
  (let* ((tf (%seq-test test test-not)) (key (%keyfn key))
         (end1 (%check-bounds start1 end1 (%seq-length s1)))
         (end2 (%check-bounds start2 end2 (%seq-length s2))))
    (if from-end
        (do ((i (- end1 1) (- i 1)) (j (- end2 1) (- j 1)))
            ((or (< i start1) (< j start2))
             (if (and (< i start1) (< j start2)) nil (+ i 1)))
          (unless (funcall tf (%key key (elt s1 i)) (%key key (elt s2 j)))
            (return (+ i 1))))
        (do ((i start1 (+ i 1)) (j start2 (+ j 1)))
            ((or (>= i end1) (>= j end2))
             (if (and (>= i end1) (>= j end2)) nil i))
          (unless (funcall tf (%key key (elt s1 i)) (%key key (elt s2 j)))
            (return i))))))

(defun search (s1 s2 &key key test test-not from-end (start1 0) end1 (start2 0) end2)
  (let* ((tf (%seq-test test test-not)) (key (%keyfn key))
         (end1 (%check-bounds start1 end1 (%seq-length s1)))
         (end2 (%check-bounds start2 end2 (%seq-length s2)))
         (n (- end1 start1)) (result nil))
    (do ((i start2 (+ i 1))) ((> (+ i n) end2) result)
      (when (do ((k 0 (+ k 1))) ((>= k n) t)
              (unless (funcall tf (%key key (elt s1 (+ start1 k))) (%key key (elt s2 (+ i k))))
                (return nil)))
        (if from-end (setq result i) (return i))))))

(defun every (pred seq &rest more)
  (let ((pred (%fn pred)))
    (if (and (null more) (listp seq))
        (do ((l seq (cdr l))) ((%endp l) t) (unless (funcall pred (car l)) (return nil)))
        (let* ((seqs (cons seq more)) (n (%min-length seqs)) (cursors (copy-list seqs)))
          (dotimes (i n t)
            (unless (apply pred (%map-args cursors i)) (return nil)))))))
(defun some (pred seq &rest more)
  (let ((pred (%fn pred)))
    (if (and (null more) (listp seq))
        (do ((l seq (cdr l))) ((%endp l) nil) (let ((v (funcall pred (car l)))) (when v (return v))))
        (let* ((seqs (cons seq more)) (n (%min-length seqs)) (cursors (copy-list seqs)))
          (dotimes (i n nil)
            (let ((v (apply pred (%map-args cursors i)))) (when v (return v))))))))
(defun notany (pred seq &rest more) (not (apply #'some pred seq more)))
(defun notevery (pred seq &rest more) (not (apply #'every pred seq more)))

;;; sorting (merge sort on lists)
(defun %merge-lists (a b pred key)
  (let* ((head (cons nil nil)) (tail head))
    (do () ((or (null a) (null b)))
      (if (funcall pred (%key key (car b)) (%key key (car a)))
          (progn (%setcdr tail b) (setq tail b b (cdr b)))
          (progn (%setcdr tail a) (setq tail a a (cdr a)))))
    (%setcdr tail (if a a b))
    (cdr head)))

(defun %sort-list (l pred key)
  (let ((n (length-of-list l)))
    (if (< n 2) l
        (let* ((mid (nthcdr (- (floor n 2) 1) l)) (b (cdr mid)))
          (%setcdr mid nil)
          (%merge-lists (%sort-list l pred key) (%sort-list b pred key) pred key)))))

(defun sort (seq pred &key key)
  (let ((pred (%fn pred)) (key (%keyfn key)))
    (cond ((listp seq) (%sort-list seq pred key))
          ((vectorp seq)
           (let ((sorted (%sort-list (%seq-to-list seq) pred key)) (i 0))
             (dolist (x sorted seq) (%row-major-aset seq i x) (setq i (+ i 1)))))
          (t (%type-error seq 'sequence)))))
(defun stable-sort (seq pred &key key) (sort seq pred :key key))

(defun merge (result-type s1 s2 pred &key key)
  (let ((pred (%fn pred)) (key (%keyfn key)))
    (%seq-type-spec result-type)
    (unless (or (listp s1) (vectorp s1)) (%type-error s1 'sequence))
    (unless (or (listp s2) (vectorp s2)) (%type-error s2 'sequence))
    (%make-sequence-from-list
     result-type
     (%merge-lists (copy-list (%seq-to-list s1)) (copy-list (%seq-to-list s2)) pred key))))


;;; ------------------------------------------------------------
;;; strings
;;; ------------------------------------------------------------

(defun make-string (n &key (initial-element (code-char 32)) (element-type 'character))
  (unless (and (fixnump n) (>= n 0)) (%type-error n '(integer 0 *)))
  (unless (characterp initial-element) (%type-error initial-element 'character))
  (let ((et (%normalize-element-type element-type)))
    (unless (member et '(character nil))
      (error "MAKE-STRING: ~S is not a subtype of CHARACTER" element-type)))
  (%make-string n initial-element))

(defun %copy-simple-string (s)
  (let* ((n (length s)) (r (%make-string n #\Space)))
    (dotimes (i n r) (%set-schar r i (char s i)))))

(defun %string-hash (s)
  ;; FNV-1a 32 bit, reduced to 29 bits (must match the compiler)
  (let ((h1 #x811C) (h0 #x9DC5))
    ;; represent the 32-bit hash as two 16-bit halves to stay in fixnum range
    (dotimes (i (length s))
      (let ((c (char-code (char s i))))
        (setq h0 (%fxlogxor h0 (%fxlogand c #xFFFF)))
        (setq h1 (%fxlogxor h1 (%fxash-right c 16)))
        ;; multiply (h1:h0) by 16777619 = 0x01000193 mod 2^32
        (let* ((lo (%fx* h0 #x193))
               (hi (%fx+ (%fx+ (%fx* h1 #x193) (%fxash-left (%fxlogand h0 #xFF) 8)) (%fxash-right lo 16))))
          (setq h0 (%fxlogand lo #xFFFF))
          (setq h1 (%fxlogand hi #xFFFF)))))
    (%fxlogior (%fxash-left (%fxlogand h1 #x1FFF) 16) h0)))

(defun string (x)
  (cond ((stringp x) x)
        ((symbolp x) (symbol-name x))
        ((characterp x) (%make-string 1 x))
        (t (%type-error x 'string-designator))))

(defun %string-bounds (s start end)
  (let ((start (or start 0)))
    (values start (%check-bounds start end (length s)))))

(defun %string-compare (s1 s2 start1 end1 start2 end2 ci)
  "Returns (values index-of-mismatch result) where result is :lt :eq :gt"
  (let ((s1 (string s1)) (s2 (string s2)))
    (multiple-value-bind (b1 e1) (%string-bounds s1 start1 end1)
      (multiple-value-bind (b2 e2) (%string-bounds s2 start2 end2)
        (do ((i b1 (+ i 1)) (j b2 (+ j 1)))
            ((or (>= i e1) (>= j e2))
             (values i (cond ((and (>= i e1) (>= j e2)) :eq) ((>= i e1) :lt) (t :gt))))
          (let ((c1 (char s1 i)) (c2 (char s2 j)))
            (when ci (setq c1 (char-upcase c1) c2 (char-upcase c2)))
            (unless (char= c1 c2)
              (return (values i (if (char< c1 c2) :lt :gt))))))))))

(defun string= (s1 s2 &key (start1 0) end1 (start2 0) end2)
  (eq (nth-value 1 (%string-compare s1 s2 start1 end1 start2 end2 nil)) :eq))
(defun string-equal (s1 s2 &key (start1 0) end1 (start2 0) end2)
  (eq (nth-value 1 (%string-compare s1 s2 start1 end1 start2 end2 t)) :eq))
(macrolet ((def (name ci results)
             `(defun ,name (s1 s2 &key (start1 0) end1 (start2 0) end2)
                (multiple-value-bind (i r) (%string-compare s1 s2 start1 end1 start2 end2 ,ci)
                  (if (member r ',results) i nil)))))
  (def string< nil (:lt)) (def string> nil (:gt)) (def string<= nil (:lt :eq)) (def string>= nil (:gt :eq))
  (def string/= nil (:lt :gt))
  (def string-lessp t (:lt)) (def string-greaterp t (:gt)) (def string-not-greaterp t (:lt :eq))
  (def string-not-lessp t (:gt :eq)) (def string-not-equal t (:lt :gt)))

(defun %string-case (s start end fn)
  (let* ((s (string s)) (r (%copy-simple-string s)) (end (%check-bounds start end (length r))))
    (do ((i start (+ i 1))) ((>= i end) r) (%set-schar r i (funcall fn (%schar r i))))))
(defun string-upcase (s &key (start 0) end) (%string-case s start end #'char-upcase))
(defun string-downcase (s &key (start 0) end) (%string-case s start end #'char-downcase))
(defun string-capitalize (s &key (start 0) end)
  (let* ((r (%copy-simple-string (string s))) (end (%check-bounds start end (length r))) (in-word nil))
    (do ((i start (+ i 1))) ((>= i end) r)
      (let ((c (%schar r i)))
        (if (alphanumericp c)
            (progn (%set-schar r i (if in-word (char-downcase c) (char-upcase c))) (setq in-word t))
            (setq in-word nil))))))
(defun nstring-upcase (s &key (start 0) end) (replace s (string-upcase s :start start :end end)))
(defun nstring-downcase (s &key (start 0) end) (replace s (string-downcase s :start start :end end)))
(defun nstring-capitalize (s &key (start 0) end) (replace s (string-capitalize s :start start :end end)))

(defun string-left-trim (bag s)
  (let* ((s (string s)) (n (length s)) (i 0))
    (do () ((or (>= i n) (not (find (char s i) bag)))) (setq i (+ i 1)))
    (subseq s i)))
(defun string-right-trim (bag s)
  (let* ((s (string s)) (n (length s)))
    (do () ((or (<= n 0) (not (find (char s (- n 1)) bag)))) (setq n (- n 1)))
    (subseq s 0 n)))
(defun string-trim (bag s) (string-right-trim bag (string-left-trim bag s)))

;;; ------------------------------------------------------------
;;; coerce
;;; ------------------------------------------------------------

(defun %coerce-error (x type)
  (error 'simple-type-error :datum x :expected-type type
                            :format-control "Cannot coerce ~S to ~S"
                            :format-arguments (list x type)))

(defun coerce (x type)
  (let* ((type (if (%class-p type) (%class-name type) type))
         (ty (if (consp type) (car type) type)))
    (cond ((eq type t) x)
          ((eq type 'list) (cond ((listp x) x) ((vectorp x) (%seq-to-list x)) (t (%coerce-error x type))))
          ((member ty '(float single-float short-float double-float long-float))
           (cond ((typep x type) x)
                 ((not (realp x)) (%coerce-error x type))
                 ((member ty '(double-float long-float)) (%to-double x))
                 ((and (eq ty 'float) (floatp x)) x)
                 (t (%to-single x))))
          ((eq ty 'complex)
           (cond ((not (numberp x)) (%coerce-error x type))
                 ((or (atom type) (null (cdr type)) (eq (cadr type) '*))
                  (if (complexp x) x (complex x 0)))
                 (t (complex (coerce (realpart x) (cadr type)) (coerce (imagpart x) (cadr type))))))
          ((eq ty 'character) (character x))
          ((eq ty 'function)
           (cond ((functionp x) x)
                 ((and (consp x) (eq (car x) 'lambda)) (eval (list 'function x)))
                 ((and (symbolp x) (fboundp x) (not (macro-function x)) (not (special-operator-p x)))
                  (fdefinition x))
                 (t (%coerce-error x type))))
          ((typep x type) x)
          ((or (listp x) (vectorp x))
           (%make-sequence-from-list type (copy-list (%seq-to-list x))))
          (t (%coerce-error x type)))))

;;; setf functions, for (setf (apply #'aref ...)) and #'(setf aref)
(defun (setf aref) (value array &rest subscripts) (apply #'%aset array (append subscripts (list value))))
(defun (setf bit) (value array &rest subscripts) (apply #'%aset array (append subscripts (list value))))
(defun (setf sbit) (value array &rest subscripts) (apply #'%aset array (append subscripts (list value))))
(defun (setf char) (value string index) (%charset string index value))
(defun (setf schar) (value string index) (%scharset string index value))
(defun (setf svref) (value vector index) (%svset vector index value))
(defun (setf elt) (value seq index) (%setelt seq index value))
