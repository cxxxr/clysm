;;;; seq.lisp — characters, arrays, strings, sequences

;;; ------------------------------------------------------------
;;; characters
;;; ------------------------------------------------------------

(defconstant char-code-limit 1114112)

(defun %check-char (c) (if (characterp c) c (%type-error c 'character)))

(defun char-int (c) (char-code c))
(defun char-upcase (c)
  (let ((n (char-code c)))
    (when (< n 128)                     ; ASCII
      (return-from char-upcase (if (and (>= n 97) (<= n 122)) (code-char (- n 32)) c)))
    (if (or (<= 97 n 122) (<= 224 n 254 ) (<= 945 n 969) (<= 1072 n 1103))
        (if (or (= n 247)) c (code-char (- n (if (<= 1072 n 1103) 32 32))))
        c)))
(defun char-downcase (c)
  (let ((n (char-code c)))
    (when (< n 128)                     ; ASCII
      (return-from char-downcase (if (and (>= n 65) (<= n 90)) (code-char (+ n 32)) c)))
    (if (or (<= 65 n 90) (<= 192 n 222) (<= 913 n 937) (<= 1040 n 1071))
        (if (= n 215) c (code-char (+ n 32)))
        c)))
(defun upper-case-p (c)
  (let ((n (char-code c)))
    (if (< n 128) (and (>= n 65) (<= n 90)) (not (eql (char-downcase c) c)))))
(defun lower-case-p (c)
  (let ((n (char-code c)))
    (if (< n 128) (and (>= n 97) (<= n 122)) (not (eql (char-upcase c) c)))))
(defun both-case-p (c) (or (upper-case-p c) (lower-case-p c)))
(defun alpha-char-p (c)
  (let ((n (char-code c)))
    (or (<= 65 n 90) (<= 97 n 122) (and (>= n 170) (both-case-p c))
        (<= #x3040 n #x30FF) (<= #x4E00 n #x9FFF))))
(defun digit-char-p (c &optional (radix 10))
  (let* ((n (char-code c))
         (d (cond ((<= 48 n 57) (- n 48))
                  ((<= 65 n 90) (- n 55))
                  ((<= 97 n 122) (- n 87))
                  (t nil))))
    (if (and d (< d radix)) d nil)))
(defun alphanumericp (c)
  (let ((n (char-code c)))
    (if (< n 128)
        (or (and (>= n 97) (<= n 122)) (and (>= n 65) (<= n 90)) (and (>= n 48) (<= n 57)))
        (alpha-char-p c))))
(defun graphic-char-p (c) (let ((n (char-code c))) (or (<= 32 n 126) (> n 159))))
(defun standard-char-p (c) (let ((n (char-code c))) (or (<= 32 n 126) (= n 10))))
(defun digit-char (weight &optional (radix 10))
  (if (and (>= weight 0) (< weight radix)) (%digit-char weight) nil))

(defmacro %char-ci-eq (x y)
  "True when the characters X and Y differ at most in case (no call for ASCII)."
  (let ((a (gensym)) (b (gensym)) (ca (gensym)) (cb (gensym)) (u (gensym)))
    `(let ((,a ,x) (,b ,y))
       (or (eq ,a ,b)
           (let ((,ca (%char-code ,a)) (,cb (%char-code ,b)))
             (declare (fixnum ,ca ,cb))
             (if (and (< ,ca 128) (< ,cb 128))
                 (and (eql (logxor ,ca ,cb) 32)
                      (let ((,u (logior ,ca 32))) (and (>= ,u 97) (<= ,u 122))))
                 (eq (char-upcase ,a) (char-upcase ,b))))))))

(defun %char-compare (chars fn)
  (do ((l chars (cdr l))) ((null (cdr l)) t)
    (unless (funcall fn (char-code (car l)) (char-code (cadr l))) (return nil))))
(defun %char-ci-compare (chars fn)
  (do ((l chars (cdr l))) ((null (cdr l)) t)
    (unless (funcall fn (char-code (char-upcase (car l))) (char-code (char-upcase (cadr l)))) (return nil))))
(defun char= (c &rest more) (if (and more (null (cdr more))) (char= c (car more)) (%char-compare (cons c more) #'=)))
(defun char/= (c &rest more)
  (if (and more (null (cdr more)))
      (not (char= c (car more)))
      (do ((l (cons c more) (cdr l))) ((null l) t)
        (when (member (car l) (cdr l)) (return nil)))))
(defun char-not-equal (c &rest more)
  (if (and more (null (cdr more)))
      (not (%char-equal-2 c (car more)))
      (do ((l (cons c more) (cdr l))) ((null l) t)
        (when (member (car l) (cdr l) :test #'char-equal) (return nil)))))

;;; The other comparisons: a function of two characters (NAME-2), which a call
;;; with two arguments is compiled to, and the function of any number.
(defmacro %define-char-comparison (name name-2 op case-insensitive)
  `(progn
     (defun ,name-2 (a b)
       ,(if case-insensitive
            `(,op (char-code (char-upcase a)) (char-code (char-upcase b)))
            `(,op (char-code a) (char-code b))))
     (defun ,name (c &rest more)
       (if (and more (null (cdr more)))
           (,name-2 c (car more))
           (,(if case-insensitive '%char-ci-compare '%char-compare) (cons c more) #',op)))
     (define-compiler-macro ,name (&whole form &rest args)
       (if (and (consp args) (consp (cdr args)) (null (cddr args)))
           (list ',name-2 (car args) (cadr args))
           form))))
(%define-char-comparison char< %char<-2 < nil)
(%define-char-comparison char> %char>-2 > nil)
(%define-char-comparison char<= %char<=-2 <= nil)
(%define-char-comparison char>= %char>=-2 >= nil)
(%define-char-comparison char-equal %char-equal-2 = t)
(%define-char-comparison char-lessp %char-lessp-2 < t)
(%define-char-comparison char-greaterp %char-greaterp-2 > t)
(%define-char-comparison char-not-greaterp %char-not-greaterp-2 <= t)
(%define-char-comparison char-not-lessp %char-not-lessp-2 >= t)

