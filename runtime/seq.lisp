(defparameter *char-name-aliases*
  '(("Linefeed" . 10) ("Null" . 0) ("Del" . 127) ("Escape" . 27) ("Bell" . 7)
    ("Backspace" . 8) ("Tab" . 9) ("Page" . 12) ("Return" . 13) ("Space" . 32)
    ("Rubout" . 127) ("Newline" . 10)))

(defvar *%name-char-table* nil)

;;; Names above Latin-1 come from data/unicode-names.txt in the Clysm
;;; installation ("HEX NAME" lines), read the first time one is needed
;;; (%UNICODE-NAMES, misc.lisp).
(defvar *%unicode-names* nil "(code->name . name->code) hash tables, or :none")

(defun char-name (c)
  (let ((code (char-code c)))
    (cond ((< code 256) (svref *char-names* code))
          ((let ((tables (%unicode-names))) (and tables (values (gethash code (car tables))))))
          ((not (graphic-char-p c)) (concatenate 'string "U+" (%integer-to-string code 16)))
          (t nil))))

(defun name-char (name)
  (let ((name (string name)))
    (unless *%name-char-table*
      (let ((h (make-hash-table :test 'equalp)))
        (dotimes (i 256)
          (let ((n (svref *char-names* i))) (when n (setf (gethash n h) i))))
        (dolist (a *char-name-aliases*) (setf (gethash (car a) h) (cdr a)))
        (setq *%name-char-table* h)))
    (let ((code (gethash name *%name-char-table*)))
      (cond (code (code-char code))
            ;; U+XXXX, and SBCL's UXX
            ((and (> (length name) 1) (char-equal (char name 0) #\U)
                  (let* ((start (if (char= (char name 1) #\+) 2 1))
                         (n (and (< start (length name))
                                 (every (lambda (ch) (digit-char-p ch 16)) (subseq name start))
                                 (parse-integer name :start start :radix 16))))
                    (and n (< n char-code-limit) (code-char n)))))
            ((let* ((tables (%unicode-names))
                    (code (and tables (gethash name (cdr tables)))))
               (and code (code-char code))))
            (t nil)))))

(defun character (x)
  (cond ((characterp x) x)
        ((and (stringp x) (= (length x) 1)) (char x 0))
        ((and (symbolp x) (= (length (symbol-name x)) 1)) (char (symbol-name x) 0))
        (t (%type-error x 'character))))

;;; ------------------------------------------------------------
;;; arrays
;;; ------------------------------------------------------------
;;; Simple 1-D arrays are bare storage objects (simple-vector, string, bytes,
;;; bits, f64vec).  Every other array is an $mdarray header:
;;;   data   : storage, or the array displaced to
;;;   fill   : fill pointer or NIL
;;;   dims   : list of dimensions
;;;   offset : displaced index offset
;;;   info   : (element-type adjustable . displaced)
;;; A header that is neither adjustable, displaced nor has a fill pointer is a
;;; simple array (multi-dimensional arrays, 0-D arrays, vectors of element type NIL).

(defun %simple-array-p (x)
  (or (%simple-vector-p x) (%simple-string-p x) (%bytes-p x) (%bits-p x) (%f64vec-p x)))

(defun %mdarray-simple-p (a)
  (let ((info (%mdarray-info a)))
    (and (null (%mdarray-fill a)) (null (cadr info)) (null (cddr info)))))
(defun %header-vector-p (x)
  (and (%mdarray-p x) (let ((d (%mdarray-dims x))) (and (consp d) (null (cdr d))))))

(defun arrayp (x) (or (%simple-array-p x) (%mdarray-p x)))
(defun %simple-array-type-p (x)
  (or (%simple-array-p x) (and (%mdarray-p x) (%mdarray-simple-p x))))
(defun simple-vector-p (x) (%simple-vector-p x))
(defun vectorp (x) (or (%simple-array-p x) (%header-vector-p x)))
(defun stringp (x)
  (or (%simple-string-p x) (and (%header-vector-p x) (%simple-string-p (%array-storage x)))))
(defun simple-string-p (x)
  (or (%simple-string-p x)
      (and (%header-vector-p x) (%mdarray-simple-p x) (%simple-string-p (%array-storage x)))))
(defun bit-vector-p (x)
  (or (%bits-p x) (and (%header-vector-p x) (%bits-p (%array-storage x)))))
(defun simple-bit-vector-p (x) (%bits-p x))

(defun %array-storage (a)
  ;; the innermost simple storage of an array
  (if (%mdarray-p a) (%array-storage (%mdarray-data a)) a))

(defun %check-array (a) (unless (arrayp a) (%type-error a 'array)) a)

(defun %simple-length (v)
  (cond ((%simple-vector-p v) (%svlength v))
        ((%simple-string-p v) (%string-length v))
        ((%bytes-p v) (%bytes-length v))
        ((%bits-p v) (%bits-length v))
        ((%f64vec-p v) (%f64vec-length v))
        (t (%type-error v 'vector))))

(defun %simple-ref (v i)
  (cond ((%simple-vector-p v) (%svref v i))
        ((%simple-string-p v) (%schar v i))
        ((%bytes-p v) (%bytes-ref v i))
        ((%bits-p v) (%bits-ref v i))
        ((%f64vec-p v) (%f64vec-ref v i))
        (t (%type-error v 'array))))

(defun %simple-set (v i x)
  (cond ((%simple-vector-p v) (%set-svref v i x))
        ((%simple-string-p v) (if (characterp x) (%set-schar v i x) (%type-error x 'character)))
        ((%bytes-p v) (if (and (fixnump x) (<= 0 x 255)) (%set-bytes-ref v i x)
                          (%type-error x '(unsigned-byte 8))))
        ((%bits-p v) (if (or (eql x 0) (eql x 1)) (%set-bits-ref v i x) (%type-error x 'bit)))
        ((%f64vec-p v) (if (%double-float-p x) (%set-f64vec-ref v i x) (%type-error x 'double-float)))
        (t (%type-error v 'array))))

(defun %make-storage (n et)
  "Fresh simple storage for N elements of the upgraded element type ET."
  (cond ((eq et t) (%make-simple-vector n nil))
        ((eq et 'character) (%make-string n (code-char 0)))
        ((eq et 'bit) (%make-bits n))
        ((eq et 'double-float) (%make-f64vec n))
        ((null et) (%make-string n (code-char 0)))
        ((equal et '(unsigned-byte 8)) (%make-bytes n))
        (t (%make-simple-vector n nil))))

(defun %storage-element-type (s)
  (cond ((%simple-vector-p s) t)
        ((%simple-string-p s) 'character)
        ((%bits-p s) 'bit)
        ((%bytes-p s) '(unsigned-byte 8))
        ((%f64vec-p s) 'double-float)
        (t t)))

(defun %make-simple-array (n element-type initial-element initp)
  (let* ((et (%normalize-element-type element-type)) (v (%make-storage n et)))
    (when initp (dotimes (i n) (%simple-set v i initial-element)))
    v))

(defun %normalize-element-type (et)
  (cond ((eq et t) t)
        ((member et '(character base-char standard-char)) 'character)
        ((eq et 'bit) 'bit)
        ((member et '(double-float long-float)) 'double-float)
        ((null et) nil)
        ((member et '(fixnum integer symbol number real float single-float short-float
                      rational ratio complex cons list atom sequence function)) t)
        ((and (consp et) (eq (car et) 'unsigned-byte) (integerp (cadr et)) (null (cddr et)))
         (cond ((= (cadr et) 1) 'bit) ((<= 1 (cadr et) 8) '(unsigned-byte 8)) (t t)))
        ((and (consp et) (eq (car et) 'signed-byte)) t)
        (t (%upgrade-element-type et))))

(defun %upgrade-element-type (et)
  (cond ((subtypep et nil) nil)
        ((subtypep et 'character) 'character)
        ((subtypep et 'bit) 'bit)
        ((subtypep et '(unsigned-byte 8)) '(unsigned-byte 8))
        ((subtypep et 'double-float) 'double-float)
        (t t)))

(defun upgraded-array-element-type (type &optional env)
  (declare (ignore env))
  (%normalize-element-type type))

(defconstant array-rank-limit 8)
(defconstant array-dimension-limit 536870911)
(defconstant array-total-size-limit 536870911)

(defun %default-element (et)
  (cond ((or (eq et 'character) (null et)) (code-char 0))
        ((eq et 'double-float) 0d0)
        ((eq et t) nil)
        (t 0)))

(defun make-array (dimensions &key (element-type t) (initial-element nil initp)
                                   (initial-contents nil contentsp) adjustable fill-pointer
                                   displaced-to (displaced-index-offset 0))
  ;; the common case: a simple vector of a fixnum size
  (when (and (fixnump dimensions) (>= dimensions 0) (eq element-type t) (not contentsp)
             (null adjustable) (null fill-pointer) (null displaced-to))
    (return-from make-array (%make-simple-vector dimensions initial-element)))
  (let* ((dims (if (listp dimensions) dimensions (list dimensions)))
         (total (let ((p 1))
                  (dolist (d dims p)
                    (unless (and (fixnump d) (>= d 0))
                      (%type-error d `(integer 0 (,array-dimension-limit))))
                    (setq p (* p d)))))
         (et (%normalize-element-type element-type))
         (fp (cond ((null fill-pointer) nil)
                   ((not (= (length-of-list dims) 1))
                    (error "MAKE-ARRAY: a fill pointer requires a one-dimensional array, not ~S" dims))
                   ((eq fill-pointer t) (car dims))
                   ((and (fixnump fill-pointer) (<= 0 fill-pointer (car dims))) fill-pointer)
                   (t (%type-error fill-pointer `(integer 0 ,(car dims)))))))
    (cond
      (displaced-to
       (unless (arrayp displaced-to) (%type-error displaced-to 'array))
       (unless (equal (array-element-type displaced-to) et)
         (error "MAKE-ARRAY: the element type ~S does not match that of ~S" element-type displaced-to))
       (unless (and (fixnump displaced-index-offset) (>= displaced-index-offset 0)
                    (<= (+ displaced-index-offset total) (array-total-size displaced-to)))
         (error "MAKE-ARRAY: cannot displace an array of size ~S to ~S at offset ~S"
                total displaced-to displaced-index-offset))
       (%make-mdarray displaced-to fp (copy-list dims) displaced-index-offset
                      (cons et (cons (not (null adjustable)) t))))
      (t
       (let ((data (%make-storage total et)))
         (cond (contentsp (%fill-from-contents data dims initial-contents))
               (initp (dotimes (i total) (%simple-set data i initial-element)))
               ((eq et t) (dotimes (i total) (%set-svref data i nil))))
         (if (and (null adjustable) (null fp) (consp dims) (null (cdr dims)) et)
             data
             (%make-mdarray data fp (copy-list dims) 0
                            (cons et (cons (not (null adjustable)) nil)))))))))

(defun %fill-from-contents (data dims contents)
  (let ((i 0))
    (labels ((walk (c ds)
               (if (null ds)
                   (progn (%simple-set data i c) (setq i (+ i 1)))
                   (progn
                     (unless (and (or (listp c) (vectorp c)) (eql (length c) (car ds)))
                       (error "MAKE-ARRAY: initial contents ~S do not match the dimensions ~S" c dims))
                     (map nil (lambda (x) (walk x (cdr ds))) c)))))
      (walk contents dims))))

(defun %array-info-type (a) (car (%mdarray-info a)))
(defun adjustable-array-p (a)
  (%check-array a)
  (and (%mdarray-p a) (not (null (cadr (%mdarray-info a))))))
(defun array-has-fill-pointer-p (a)
  (%check-array a)
  (and (%mdarray-p a) (not (null (%mdarray-fill a)))))
(defun fill-pointer (a)
  (if (and (%mdarray-p a) (%mdarray-fill a)) (%mdarray-fill a)
      (error 'type-error :datum a :expected-type '(and vector (satisfies array-has-fill-pointer-p)))))
(defun %set-fill-pointer (a n)
  (unless (and (arrayp a) (array-has-fill-pointer-p a))
    (error 'type-error :datum a :expected-type '(and vector (satisfies array-has-fill-pointer-p))))
  (unless (and (fixnump n) (<= 0 n (car (%mdarray-dims a))))
    (%type-error n `(integer 0 ,(car (%mdarray-dims a)))))
  (%set-mdarray-fill a n) n)
(defun %displaced-p (a) (cddr (%mdarray-info a)))

(defun array-dimensions (a)
  (%check-array a)
  (if (%mdarray-p a) (copy-list (%mdarray-dims a)) (list (%simple-length a))))
(defun array-dimension (a axis)
  (%check-array a)
  (let ((r (array-rank a)))
    (unless (and (fixnump axis) (< -1 axis r)) (%type-error axis `(integer 0 (,r)))))
  (if (%mdarray-p a) (nth axis (%mdarray-dims a)) (%simple-length a)))
(defun array-rank (a)
  (%check-array a)
  (if (%mdarray-p a) (length-of-list (%mdarray-dims a)) 1))
(defun array-total-size (a)
  (%check-array a)
  (if (%mdarray-p a) (let ((p 1)) (dolist (d (%mdarray-dims a) p) (setq p (* p d)))) (%simple-length a)))
(defun array-element-type (a)
  (cond ((%mdarray-p a) (%array-info-type a))
        ((%simple-vector-p a) t)
        ((%simple-string-p a) 'character)
        ((%bits-p a) 'bit)
        ((%bytes-p a) '(unsigned-byte 8))
        ((%f64vec-p a) 'double-float)
        (t (%type-error a 'array))))
(defun array-displacement (a)
  (%check-array a)
  (if (and (%mdarray-p a) (%displaced-p a))
      (values (%mdarray-data a) (%mdarray-offset a))
      (values nil 0)))

(defun row-major-aref (a i)
  (if (%mdarray-p a)
      (let ((d (%mdarray-data a)))
        (if (%mdarray-p d) (row-major-aref d (+ i (%mdarray-offset a)))
            (%simple-ref d (+ i (%mdarray-offset a)))))
      (%simple-ref a i)))
(defun %row-major-aset (a i v)
  (if (%mdarray-p a)
      (let ((d (%mdarray-data a)))
        (if (%mdarray-p d) (%row-major-aset d (+ i (%mdarray-offset a)) v)
            (%simple-set d (+ i (%mdarray-offset a)) v)))
      (%simple-set a i v)))

(defun array-row-major-index (a &rest subscripts)
  (if (%mdarray-p a)
      (let ((idx 0) (dims (%mdarray-dims a)))
        (unless (= (length-of-list subscripts) (length-of-list dims))
          (error "Wrong number of subscripts ~S for array ~S" subscripts a))
        (do ((d dims (cdr d)) (s subscripts (cdr s))) ((null d) idx)
          (let ((sub (car s)))
            (unless (and (fixnump sub) (< -1 sub (car d)))
              (error 'index-out-of-bounds :datum sub :expected-type `(integer 0 (,(car d)))))
            (setq idx (+ (* idx (car d)) sub)))))
      (progn
        (%check-array a)
        (unless (and subscripts (null (cdr subscripts)))
          (error "Wrong number of subscripts ~S for array ~S" subscripts a))
        (let ((i (car subscripts)))
          (unless (and (fixnump i) (< -1 i (%simple-length a)))
            (error 'index-out-of-bounds :datum i :expected-type `(integer 0 (,(%simple-length a)))))
          i))))

(defun array-in-bounds-p (a &rest subscripts)
  (unless (= (length-of-list subscripts) (array-rank a))
    (error "Wrong number of subscripts ~S for array ~S" subscripts a))
  (do ((d (array-dimensions a) (cdr d)) (s subscripts (cdr s))) ((null d) t)
    (unless (integerp (car s)) (%type-error (car s) 'integer))
    (unless (< -1 (car s) (car d)) (return nil))))

(defun %aref1-slow (a i)
  (cond ((%simple-vector-p a) (%svref a (%check-index a i (%svlength a))))
        ((%simple-string-p a) (%schar a (%check-index a i (%string-length a))))
        ((%header-vector-p a)
         (row-major-aref a (%check-index a i (car (%mdarray-dims a)))))
        ((%mdarray-p a) (aref a i))
        (t (%check-array a) (%simple-ref a (%check-index a i (%simple-length a))))))

(defun %aset1-slow (a i v)
  (cond ((%simple-vector-p a) (%set-svref a (%check-index a i (%svlength a)) v))
        ((%simple-string-p a) (%simple-set a (%check-index a i (%string-length a)) v))
        ((%header-vector-p a)
         (%row-major-aset a (%check-index a i (car (%mdarray-dims a))) v))
        ((%mdarray-p a) (%aset a i v))
        (t (%check-array a) (%simple-set a (%check-index a i (%simple-length a)) v)))
  v)

(define-compiler-macro aref (&whole form a &rest subs)
  (cond ((and subs (null (cdr subs))) `(%aref1 ,a ,(car subs)))
        ((and subs (cdr subs) (null (cddr subs))) `(%aref2 ,a ,(car subs) ,(cadr subs)))
        (t form)))

;;; two-dimensional arrays over simple storage
(defun %aref2 (a i j)
  (when (%mdarray-p a)
    (let ((dims (%mdarray-dims a)) (data (%mdarray-data a)))
      (when (and (consp dims) (consp (cdr dims)) (null (cddr dims))
                 (fixnump i) (fixnump j) (%fx< -1 i) (%fx< i (car dims))
                 (%fx< -1 j) (%fx< j (cadr dims)) (not (%mdarray-p data)))
        (return-from %aref2
          (%simple-ref data (%fx+ (%mdarray-offset a) (%fx+ (%fx* i (cadr dims)) j)))))))
  (row-major-aref a (array-row-major-index a i j)))
(defun %aset2 (a i j v)
  (when (%mdarray-p a)
    (let ((dims (%mdarray-dims a)) (data (%mdarray-data a)))
      (when (and (consp dims) (consp (cdr dims)) (null (cddr dims))
                 (fixnump i) (fixnump j) (%fx< -1 i) (%fx< i (car dims))
                 (%fx< -1 j) (%fx< j (cadr dims)) (not (%mdarray-p data)))
        (%simple-set data (%fx+ (%mdarray-offset a) (%fx+ (%fx* i (cadr dims)) j)) v)
        (return-from %aset2 v))))
  (%aset a i j v))

(defun aref (a &rest subscripts)
  (if (and (%simple-vector-p a) subscripts (null (cdr subscripts)))
      (svref a (car subscripts))
      (row-major-aref a (apply #'array-row-major-index a subscripts))))
(defun %aset (a &rest subscripts-and-value)
  (let ((v (car (last subscripts-and-value)))
        (subs (butlast subscripts-and-value)))
    (%row-major-aset a (apply #'array-row-major-index a subs) v)
    v))

(defun %check-index (v i len)
  (unless (and (fixnump i) (< -1 i len))
    (error 'index-out-of-bounds :datum i :expected-type `(integer 0 (,len)) :sequence v))
  i)

(defun svref (v i)
  (unless (%simple-vector-p v) (%type-error v 'simple-vector))
  (%svref v (%check-index v i (%svlength v))))
(defun %aref1 (a i) (%aref1 a i))
(defun %aset1 (a i v) (%aset1 a i v))
(defun %svset (v i x)
  (unless (%simple-vector-p v) (%type-error v 'simple-vector))
  (%set-svref v (%check-index v i (%svlength v)) x))
(defun schar (s i)
  (unless (%simple-string-p s) (%type-error s 'simple-string))
  (%schar s (%check-index s i (%string-length s))))
(defun %scharset (s i c)
  (unless (%simple-string-p s) (%type-error s 'simple-string))
  (%simple-set s (%check-index s i (%string-length s)) c))
(defun char (s i)
  (cond ((%simple-string-p s) (%schar s (%check-index s i (%string-length s))))
        ((stringp s) (row-major-aref s (%check-index s i (array-total-size s))))
        (t (%type-error s 'string))))
(defun %charset (s i c)
  (cond ((%simple-string-p s) (%simple-set s (%check-index s i (%string-length s)) c))
        ((stringp s) (%row-major-aset s (%check-index s i (array-total-size s)) c))
        (t (%type-error s 'string))))
(defun bit (a &rest subs)
  (unless (and (arrayp a) (eq (array-element-type a) 'bit)) (%type-error a '(array bit)))
  (apply #'aref a subs))
(defun sbit (a &rest subs)
  (unless (and (%simple-array-type-p a) (eq (array-element-type a) 'bit)) (%type-error a '(simple-array bit)))
  (apply #'aref a subs))

(defun vector (&rest items)
  (let ((v (%make-simple-vector (length-of-list items) nil)) (i 0))
    (dolist (x items v) (%set-svref v i x) (setq i (+ i 1)))))

(defun vector-push (x v)
  (let ((fp (fill-pointer v)))
    (declare (fixnum fp))
    (if (< fp (car (%mdarray-dims v)))
        (let ((data (%mdarray-data v)))
          (if (and (%simple-vector-p data) (eql (%mdarray-offset v) 0))
              (%set-svref data fp x)
              (%row-major-aset v fp x))
          (%set-mdarray-fill v (+ fp 1))
          fp)
        nil)))

(defun vector-push-extend (x v &optional (extension 16))
  ;; fast path: a 1-D header with a fill pointer over simple storage at offset 0
  (when (%mdarray-p v)
    (let ((fp (%mdarray-fill v)) (dims (%mdarray-dims v)) (data (%mdarray-data v)))
      (when (and (fixnump fp) (consp dims) (null (cdr dims)) (%fx< fp (car dims))
                 (eql (%mdarray-offset v) 0))
        (cond ((and (%simple-string-p data) (characterp x)) (%set-schar data fp x))
              ((%simple-vector-p data) (%set-svref data fp x))
              (t (setq fp nil)))
        (when fp
          (%set-mdarray-fill v (%fx+ fp 1))
          (return-from vector-push-extend fp)))))
  (let ((fp (fill-pointer v)))
    (when (>= fp (array-dimension v 0))
      (unless (adjustable-array-p v) (error "VECTOR-PUSH-EXTEND: ~S is not adjustable" v))
      (unless (and (integerp extension) (> extension 0)) (%type-error extension '(integer 1 *)))
      (%adjust-vector-storage v (+ fp (max extension fp 4))))
    (%row-major-aset v fp x)
    (%set-mdarray-fill v (+ fp 1))
    fp))

;;; append STRING[START,END) to the string BUF with a fill pointer; returns
;;; NIL (doing nothing) unless both are of the usual simple kind
(defun %string-buffer-append (buf string start end)
  (when (and (%mdarray-p buf) (%simple-string-p string) (eql (%mdarray-offset buf) 0)
             (%simple-string-p (%mdarray-data buf)) (fixnump (%mdarray-fill buf)))
    (let* ((fp (%mdarray-fill buf)) (n (%fx- end start)) (cap (car (%mdarray-dims buf))))
      (when (> (+ fp n) cap)
        (unless (adjustable-array-p buf) (return-from %string-buffer-append nil))
        (%adjust-vector-storage buf (max (+ fp n) (* 2 cap) 16)))
      (let ((data (%mdarray-data buf)))
        (%string-copy data fp string start n))
      (%set-mdarray-fill buf (%fx+ fp n))
      t)))

(defun vector-pop (v)
  (let ((fp (fill-pointer v)))
    (declare (fixnum fp))
    (when (eql fp 0) (error "VECTOR-POP: empty vector ~S" v))
    (%set-mdarray-fill v (- fp 1))
    (let ((data (%mdarray-data v)))
      (if (and (%simple-vector-p data) (eql (%mdarray-offset v) 0))
          (%svref data (- fp 1))
          (row-major-aref v (- fp 1))))))

(defun %adjust-vector-storage (v new-size)
  (let* ((et (%array-info-type v))
         (new (%make-storage new-size et))
         (n (min new-size (array-total-size v))))
    ;; storage to storage (the element types are the same)
    (%copy-elements new 0 (%array-storage v) (%array-total-offset v) n)
    (%set-mdarray-data v new)
    (%set-mdarray-offset v 0)
    (%set-mdarray-dims v (list new-size))
    (%set-mdarray-info v (cons et (cons (cadr (%mdarray-info v)) nil)))
    v))

(defun adjust-array (a new-dims &key (element-type nil etp) (initial-element nil initp)
                                     (initial-contents nil contentsp) (fill-pointer nil)
                                     displaced-to (displaced-index-offset 0))
  (%check-array a)
  (let* ((dims (if (listp new-dims) new-dims (list new-dims)))
         (et (array-element-type a)))
    (unless (= (length-of-list dims) (array-rank a))
      (error "ADJUST-ARRAY: the rank of ~S does not match the dimensions ~S" a dims))
    (when (and etp (not (equal (%normalize-element-type element-type) et)))
      (error "ADJUST-ARRAY: the element type ~S does not match that of ~S" element-type a))
    (when (and fill-pointer (not (array-has-fill-pointer-p a)))
      (error "ADJUST-ARRAY: ~S has no fill pointer" a))
    (let* ((fp (cond ((eq fill-pointer t) (car dims))
                     (fill-pointer fill-pointer)
                     ((array-has-fill-pointer-p a) (fill-pointer a))
                     (t nil)))
           (new (cond (displaced-to
                       (make-array dims :element-type et :displaced-to displaced-to
                                        :displaced-index-offset displaced-index-offset))
                      (contentsp (make-array dims :element-type et :initial-contents initial-contents))
                      ((and (null (cdr dims)) (vectorp a))
                       ;; a vector: the elements kept are copied storage to storage
                       (let* ((size (car dims))
                              (n (make-array size :element-type et
                                                  :initial-element (if initp initial-element
                                                                       (%default-element et))))
                              (old (array-dimension a 0)))
                         (%copy-elements (%array-storage n) (%array-total-offset n)
                                         (%array-storage a) (%array-total-offset a) (min size old))
                         n))
                      (t (let ((n (make-array dims :element-type et
                                                   :initial-element (if initp initial-element
                                                                        (%default-element et)))))
                           (labels ((walk (prefix ds olds)
                                      (if (null ds)
                                          (%row-major-aset n (apply #'array-row-major-index n prefix)
                                                           (row-major-aref a (apply #'array-row-major-index a prefix)))
                                          (dotimes (i (min (car ds) (car olds)))
                                            (walk (append prefix (list i)) (cdr ds) (cdr olds))))))
                             (walk nil dims (array-dimensions a)))
                           n)))))
      (when (and fp (> fp (car dims)))
        (error "ADJUST-ARRAY: fill pointer ~S is larger than the new size ~S" fp (car dims)))
      (if (adjustable-array-p a)
          (progn
            (if (%mdarray-p new)
                (progn (%set-mdarray-data a (%mdarray-data new))
                       (%set-mdarray-offset a (%mdarray-offset new)))
                (progn (%set-mdarray-data a new) (%set-mdarray-offset a 0)))
            (%set-mdarray-dims a (copy-list dims))
            (%set-mdarray-info a (cons et (cons t (if displaced-to t nil))))
            (%set-mdarray-fill a fp)
            a)
          (if fp
              (if (%mdarray-p new)
                  (progn (%set-mdarray-fill new fp) new)
                  (%make-mdarray new fp (copy-list dims) 0 (cons et (cons nil nil))))
              new)))))

;;; ------------------------------------------------------------
;;; sequences: argument checking and iteration helpers
;;; ------------------------------------------------------------

(defun %fn (f)
  (cond ((functionp f) f)
        ((symbolp f) (symbol-function f))
        (t (%type-error f '(or function symbol)))))
(defun %keyfn (key)
  (cond ((null key) nil) ((functionp key) key) ((symbolp key) (symbol-function key))
        (t (%type-error key '(or function symbol)))))
(defun %list-length-checked (l)
  (let ((n (list-length l)))
    (or n (%type-error l '(and list (satisfies list-length))))))

(defun %seq-length (seq)
  (cond ((listp seq) (%list-length-checked seq))
        ((vectorp seq) (length seq))
        (t (%type-error seq 'sequence))))

(defun %check-bounds (start end len)
  "Validates the bounding index designators START and END; returns the effective end."
  (unless (and (fixnump start) (<= 0 start len))
    (%type-error start `(integer 0 ,len)))
  (cond ((null end) len)
        ((and (fixnump end) (<= start end len)) end)
        (t (%type-error end `(or null (integer ,start ,len))))))

(defun %check-count (count)
  (cond ((null count) nil)
        ((integerp count) (if (< count 0) 0 count))
        (t (%type-error count '(or null integer)))))

(defun %list-region-vector (list start end)
  "A simple vector of the elements of LIST in [START, END)."
  (let ((v (%make-simple-vector (- end start) nil)) (l (nthcdr start list)))
    (dotimes (i (- end start) v) (%set-svref v i (car l)) (setq l (cdr l)))))

(defun %list-tail (list n)
  "The tail of LIST after N elements, which must be there."
  (do ((l list (cdr l)) (i n (- i 1))) ((<= i 0) l)
    (unless (consp l) (%type-error n `(integer 0 ,(- n i))))))

(defun %region-end (seq start end from-end)
  "Validates the bounding indices of SEQ as %CHECK-BOUNDS does and returns the
effective end -- except for a list read forwards to its end, whose length is
not needed: then only START is checked and the result is NIL (%DO-REGION
stops at the end of the list, and signals an error when START is beyond it)."
  (cond ((and (listp seq) (null end) (not from-end))
         (unless (and (fixnump start) (>= start 0)) (%type-error start '(integer 0 *)))
         nil)
        (t (%check-bounds start end (%seq-length seq)))))

;;; Access to the elements of a vector in a loop: the innermost simple storage
;;; and the total displacement are found once (%ARRAY-STORAGE,
;;; %ARRAY-TOTAL-OFFSET), and each element is then read from the storage.
(defun %array-total-offset (a)
  (if (%mdarray-p a) (+ (%mdarray-offset a) (%array-total-offset (%mdarray-data a))) 0))

(defmacro %vref (data i)
  "Element I of the simple storage DATA (no bounds check)."
  (let ((d (gensym)) (k (gensym)))
    `(let ((,d ,data) (,k ,i))
       (declare (fixnum ,k))
       (cond ((%simple-vector-p ,d) (%svref ,d ,k))
             ((%simple-string-p ,d) (%schar ,d ,k))
             (t (%simple-ref ,d ,k))))))

(defmacro %vset (data i value)
  "Stores VALUE (checked against the element type) at I of the simple storage DATA."
  (let ((d (gensym)) (k (gensym)) (v (gensym)))
    `(let ((,d ,data) (,k ,i) (,v ,value))
       (declare (fixnum ,k))
       (if (%simple-vector-p ,d) (%set-svref ,d ,k ,v) (%simple-set ,d ,k ,v)))))

(defmacro %do-region ((var idx seq start end from-end) &body body)
  "Iterates over the elements of SEQ in [START, END), backwards when FROM-END.
IDX is bound to the index of each element.  (RETURN x) exits.  START and END
must be the checked bounds (%CHECK-BOUNDS, or %REGION-END, whose NIL stands
for the end of a list).  A list region read backwards is copied to a vector."
  (let ((s (gensym)) (l (gensym)) (e (gensym)) (eo (gensym)) (st (gensym)) (k (gensym)) (fe (gensym))
        (d (gensym)) (off (gensym)) (i (gensym)) (lim (gensym)))
    `(let* ((,s ,seq) (,st ,start) (,eo ,end) (,e (if ,eo ,eo 0)) (,fe ,from-end)
            (,d (cond ((not (listp ,s)) (%array-storage ,s))
                      (,fe (%list-region-vector ,s ,st ,e))
                      (t nil)))
            (,off (cond ((not (listp ,s)) (%array-total-offset ,s))
                        (,fe (- ,st))
                        (t 0))))
       (declare (fixnum ,st ,e ,off))
       (block nil
         (cond
           ((null ,d)
            ;; a list, forwards (to its end when END is NIL)
            (let ((,idx ,st))
              (declare (fixnum ,idx))
              (do ((,l (%list-tail ,s ,st) (cdr ,l))
                   (,k (- ,e ,st) (- ,k 1)))
                  ((if ,eo (<= ,k 0) (%endp ,l)))
                (declare (fixnum ,k))
                (let ((,var (car ,l))) ,@body)
                (setq ,idx (+ ,idx 1)))))
           (,fe
            (do ((,i (+ (- ,e 1) ,off) (- ,i 1)) (,lim (+ ,st ,off))) ((< ,i ,lim))
              (declare (fixnum ,i ,lim))
              (let ((,idx (- ,i ,off)) (,var (%vref ,d ,i)))
                (declare (ignorable ,idx))
                ,@body)))
           (t
            (do ((,i (+ ,st ,off) (+ ,i 1)) (,lim (+ ,e ,off))) ((>= ,i ,lim))
              (declare (fixnum ,i ,lim))
              (let ((,idx (- ,i ,off)) (,var (%vref ,d ,i)))
                (declare (ignorable ,idx))
                ,@body))))))))

;;; ------------------------------------------------------------
;;; sequence result types
;;; ------------------------------------------------------------

(defun %vector-type-dims-ok (dims)
  (or (eq dims '*) (eql dims 1)
      (and (consp dims) (null (cdr dims)) (or (eq (car dims) '*) (fixnump (car dims))))))

(defun %seq-type-spec (type)
  "Analyzes a sequence type specifier.  Returns (values kind element-type length exact):
KIND is :LIST or :VECTOR, LENGTH is the required length or NIL, and EXACT is true when
the type is fully described by the other values (otherwise the result is checked with TYPEP)."
  (let ((ty (if (%class-p type) (%class-name type) type)))
    (flet ((len (x) (if (or (null x) (eq x '*)) nil x)))
      (cond
        ((symbolp ty)
         (case ty
           ((list) (values :list nil nil t))
           ((cons null) (values :list nil nil nil))
           ((vector simple-vector) (values :vector t nil t))
           ((string simple-string base-string simple-base-string) (values :vector 'character nil t))
           ((bit-vector simple-bit-vector) (values :vector 'bit nil t))
           ((nil) (error 'type-error :datum type :expected-type 'sequence))
           (t (%seq-type-spec-general type ty))))
        ((consp ty)
         (case (car ty)
           ((vector)
            (let ((et (if (cdr ty) (cadr ty) '*)))
              (values :vector (if (eq et '*) t (%normalize-element-type et)) (len (caddr ty)) (not (eq et '*)))))
           ((simple-vector) (values :vector t (len (cadr ty)) t))
           ((string simple-string base-string simple-base-string) (values :vector 'character (len (cadr ty)) t))
           ((bit-vector simple-bit-vector) (values :vector 'bit (len (cadr ty)) t))
           ((array simple-array)
            (let ((et (if (cdr ty) (cadr ty) '*)) (dims (if (cddr ty) (caddr ty) '*)))
              (unless (%vector-type-dims-ok dims) (error 'type-error :datum type :expected-type 'sequence))
              (values :vector (if (eq et '*) t (%normalize-element-type et))
                      (if (consp dims) (len (car dims)) nil) (not (eq et '*)))))
           ((cons) (values :list nil nil nil))
           (t (%seq-type-spec-general type ty))))
        (t (error 'type-error :datum type :expected-type 'sequence))))))

(defun %seq-type-spec-general (type ty)
  (multiple-value-bind (exp found) (%expand-deftype ty)
    (cond (found (multiple-value-bind (kind et len) (%seq-type-spec exp) (values kind et len nil)))
          ((and (consp ty) (eq (car ty) 'or) (cdr ty))
           ;; every alternative must agree on the kind of sequence and the element type
           (let ((specs (mapcar (lambda (alt) (multiple-value-list (%seq-type-spec alt))) (cdr ty))))
             (dolist (sp (cdr specs))
               (unless (and (eq (first sp) (first (car specs))) (equal (second sp) (second (car specs))))
                 (error "The sequence type ~S is ambiguous" type)))
             (values (first (car specs)) (second (car specs)) nil nil)))
          ((subtypep ty nil) (error 'type-error :datum type :expected-type 'sequence))
          ((subtypep ty 'list) (values :list nil nil nil))
          ((subtypep ty 'vector)
           (flet ((sub (x) (multiple-value-bind (r certain) (subtypep ty x) (and r certain))))
             (values :vector
                     (cond ((sub '(vector character)) 'character)
                           ((sub '(vector bit)) 'bit)
                           ((sub '(vector (unsigned-byte 8))) '(unsigned-byte 8))
                           ((sub '(vector double-float)) 'double-float)
                           (t t))
                     nil nil)))
          (t (error 'type-error :datum type :expected-type 'sequence)))))

(defun %check-result-type (seq type exact)
  (unless (or exact (typep seq type))
    (error 'type-error :datum seq :expected-type type))
  seq)

(defun %make-sequence-from-list (type list)
  "A sequence of TYPE with the elements of LIST (which may be reused)."
  (multiple-value-bind (kind et len exact) (%seq-type-spec type)
    (let ((n (length-of-list list)))
      (when (and len (/= len n)) (error 'type-error :datum list :expected-type type))
      (if (eq kind :list)
          (%check-result-type list type exact)
          (let ((v (%make-storage n et)) (i 0))
            (dolist (x list) (%simple-set v i x) (setq i (+ i 1)))
            (%check-result-type v type exact))))))

(defun make-sequence (type size &key (initial-element nil initp))
  (multiple-value-bind (kind et len exact) (%seq-type-spec type)
    (unless (and (fixnump size) (>= size 0)) (%type-error size '(integer 0 *)))
    (when (and len (/= len size)) (error 'type-error :datum size :expected-type `(eql ,len)))
    (%check-result-type
     (if (eq kind :list)
         (make-list size :initial-element initial-element)
         (let ((v (%make-storage size et)))
           (when initp (dotimes (i size) (%simple-set v i initial-element)))
           v))
     type exact)))

;;; SUBTYPEP on array types.  An array type is canonicalized to a list of
;;; alternatives (simple element-type dims): SIMPLE is T for simple arrays only,
;;; ELEMENT-TYPE is an upgraded element type or *, DIMS is * or a list of * / sizes.

(defun %array-type-canon (ty)
  (flet ((et (x) (if (eq x '*) '* (%normalize-element-type x)))
         (dims (d) (cond ((eq d '*) '*)
                         ((fixnump d) (make-list d :initial-element '*))
                         ((listp d) d)
                         (t (return-from %array-type-canon :unknown))))
         (size (args) (if (or (null args) (eq (car args) '*)) '(*) (list (car args)))))
    (let ((head (if (consp ty) (car ty) ty)) (args (if (consp ty) (cdr ty) nil)))
      (case head
        ((and)
         ;; intersect the alternatives of the conjuncts
         (let ((r (list (list nil '* '*))))
           (dolist (x args r)
             (let ((c (%array-type-canon x)) (new nil))
               (when (eq c :unknown) (return-from %array-type-canon :unknown))
               (dolist (a r) (dolist (b c) (let ((i (%array-alt-intersect a b))) (when i (push i new)))))
               (setq r new)))))
        ((array simple-array)
         (list (list (eq head 'simple-array) (et (if args (car args) '*))
                     (dims (if (cdr args) (cadr args) '*)))))
        ((vector)
         (list (list nil (et (if args (car args) '*)) (size (cdr args)))))
        ((simple-vector) (list (list t t (size args))))
        ((string) (list (list nil 'character (size args)) (list nil nil (size args))))
        ((simple-string) (list (list t 'character (size args)) (list t nil (size args))))
        ((base-string) (list (list nil 'character (size args))))
        ((simple-base-string) (list (list t 'character (size args))))
        ((bit-vector) (list (list nil 'bit (size args))))
        ((simple-bit-vector) (list (list t 'bit (size args))))
        (t :unknown)))))

(defun %array-alt-intersect (a b)
  (destructuring-bind (s1 e1 d1) a
    (destructuring-bind (s2 e2 d2) b
      (let ((et (cond ((eq e1 '*) e2) ((eq e2 '*) e1) ((equal e1 e2) e1) (t (return-from %array-alt-intersect nil))))
            (dims (cond ((eq d1 '*) d2) ((eq d2 '*) d1)
                        ((/= (length-of-list d1) (length-of-list d2)) (return-from %array-alt-intersect nil))
                        (t (mapcar (lambda (x y) (cond ((eq x '*) y) ((eq y '*) x) ((eql x y) x)
                                                       (t (return-from %array-alt-intersect nil))))
                                   d1 d2)))))
        (list (or s1 s2) et dims)))))

(defun %array-alt-subtypep (a b)
  (destructuring-bind (s1 e1 d1) a
    (destructuring-bind (s2 e2 d2) b
      (and (or (not s2) s1)
           (or (eq e2 '*) (and (not (eq e1 '*)) (equal e1 e2)))
           (or (eq d2 '*)
               (and (listp d1) (= (length-of-list d1) (length-of-list d2))
                    (every (lambda (x y) (or (eq y '*) (eql x y))) d1 d2)))))))

(defun %subtypep-arrays (t1 t2)
  "Returns (values result certain known); KNOWN is NIL when the types are not handled."
  (let ((c1 (%array-type-canon t1)))
    (if (eq c1 :unknown)
        (values nil nil nil)
        (cond ((member t2 '(t atom)) (values t t t))
              ((null t2) (values (null c1) t t))
              ((eq t2 'sequence)
               (values (every (lambda (a) (and (listp (third a)) (= (length-of-list (third a)) 1))) c1) t t))
              ((member t2 '(list cons null symbol number character function hash-table package
                            integer real float rational structure-object standard-object))
               (values (null c1) t t))
              (t (let ((c2 (%array-type-canon t2)))
                   (if (eq c2 :unknown)
                       (values nil nil nil)
                       (values (every (lambda (a) (some (lambda (b) (%array-alt-subtypep a b)) c2)) c1)
                               t t))))))))

;;; ------------------------------------------------------------
;;; sequences: generic accessors
;;; ------------------------------------------------------------

(defun length (seq)
  (cond ((listp seq) (length-of-list seq))
        ((%simple-string-p seq) (%string-length seq))
        ((%simple-vector-p seq) (%svlength seq))
        ((%header-vector-p seq) (or (%mdarray-fill seq) (car (%mdarray-dims seq))))
        ((%simple-array-p seq) (%simple-length seq))
        (t (%type-error seq 'sequence))))

(defun sequencep (x) (or (listp x) (vectorp x)))

(defun elt (seq i)
  (cond ((listp seq)
         (unless (and (fixnump i) (>= i 0)) (%type-error i '(integer 0 *)))
         (let ((l (nthcdr i seq)))
           (if (consp l) (car l)
               (error 'index-out-of-bounds :datum i :expected-type `(integer 0 (,(length-of-list seq)))
                                           :sequence seq))))
        ((vectorp seq) (row-major-aref seq (%check-index seq i (length seq))))
        (t (%type-error seq 'sequence))))
(defun %setelt (seq i v)
  (cond ((listp seq)
         (unless (and (fixnump i) (>= i 0)) (%type-error i '(integer 0 *)))
         (let ((l (nthcdr i seq)))
           (if (consp l) (%setcar l v)
               (error 'index-out-of-bounds :datum i :expected-type `(integer 0 (,(length-of-list seq)))
                                           :sequence seq))))
        ((vectorp seq) (%row-major-aset seq (%check-index seq i (length seq)) v))
        (t (%type-error seq 'sequence)))
  v)

(defun %vector-like (seq n)
  "A fresh simple vector of the same element type as SEQ with N elements."
  (if (%mdarray-p seq) (%make-storage n (%array-info-type seq)) (%make-storage n (%storage-element-type seq))))

(defun %list-to-vector-like (list proto)
  (let* ((n (length-of-list list)) (v (%vector-like proto n)) (i 0))
    (dolist (x list v) (%vset v i x) (setq i (+ i 1)))))

(defun %copy-elements (to to-start from from-start n)
  "Copies N elements between simple storage vectors (forwards)."
  (declare (fixnum to-start from-start n))
  (cond ((and (%simple-vector-p to) (%simple-vector-p from))
         (dotimes (i n) (%set-svref to (+ to-start i) (%svref from (+ from-start i)))))
        ((and (%simple-string-p to) (%simple-string-p from))
         (%string-copy to to-start from from-start n))
        (t (dotimes (i n) (%vset to (+ to-start i) (%vref from (+ from-start i))))))
  to)

(defun subseq (seq start &optional end)
  (cond ((listp seq)
         (unless (and (fixnump start) (>= start 0)) (%type-error start '(integer 0 *)))
         (when (and end (not (and (fixnump end) (>= end start)))) (%type-error end `(or null (integer ,start *))))
         (let ((l seq))
           (dotimes (i start)
             (unless (consp l) (%type-error start `(integer 0 ,i)))
             (setq l (cdr l)))
           (if end
               (let ((r nil))
                 (dotimes (i (- end start) (nreverse-list r))
                   (unless (consp l) (%type-error end `(or null (integer ,start ,(+ start i)))))
                   (push (car l) r) (setq l (cdr l))))
               (copy-list l))))
        ((%simple-string-p seq)
         (let* ((end (%check-bounds start end (%string-length seq))) (n (- end start)))
           (declare (fixnum n))
           (%string-copy (%make-string n (code-char 0)) 0 seq start n)))
        ((vectorp seq)
         (let* ((len (length seq)) (end (%check-bounds start end len)))
           (%copy-elements (%vector-like seq (- end start)) 0
                           (%array-storage seq) (+ start (%array-total-offset seq)) (- end start))))
        (t (%type-error seq 'sequence))))

(defun %set-subseq (seq start &rest rest)
  (let ((new (car (last rest))) (end (if (cdr rest) (car rest) nil)))
    (replace seq new :start1 start :end1 end)
    new))

(defun copy-seq (seq) (if (listp seq) (copy-list seq) (subseq seq 0)))

(defun reverse (seq)
  (cond ((listp seq) (reverse-list seq))
        ((vectorp seq)
         (let* ((n (length seq)) (v (%vector-like seq n))
                (d (%array-storage seq)) (last (+ (%array-total-offset seq) n -1)))
           (declare (fixnum n last))
           (dotimes (i n v) (%vset v i (%vref d (- last i))))))
        (t (%type-error seq 'sequence))))

(defun nreverse (seq)
  (cond ((listp seq) (nreverse-list seq))
        ((vectorp seq)
         (let* ((n (length seq)) (d (%array-storage seq)) (off (%array-total-offset seq)))
           (declare (fixnum n off))
           (do ((i off (+ i 1)) (j (+ off n -1) (- j 1))) ((>= i j) seq)
             (declare (fixnum i j))
             (let ((tmp (%vref d i)))
               (%vset d i (%vref d j))
               (%vset d j tmp)))))
        (t (%type-error seq 'sequence))))

(defun %seq-to-list (seq &optional (start 0) end)
  (if (listp seq)
      (if (or (> start 0) end) (subseq seq start end) seq)
      (let ((r nil) (end (or end (length seq)))
            (d (%array-storage seq)) (off (%array-total-offset seq)))
        (declare (fixnum start end off))
        (do ((i (- end 1) (- i 1))) ((< i start) r)
          (declare (fixnum i))
          (push (%vref d (+ i off)) r)))))

(defun %list-to-seq-like (list proto)
  (if (listp proto) list (%list-to-vector-like list proto)))

(defun %result-kind (result-type)
  "The kind of sequence a result type names: (values kind element-type length exact)
as %SEQ-TYPE-SPEC, with the usual names recognized at once."
  (cond ((eq result-type 'list) (values :list nil nil t))
        ((or (eq result-type 'vector) (eq result-type 'simple-vector)) (values :vector t nil t))
        ((or (eq result-type 'string) (eq result-type 'simple-string)) (values :vector 'character nil t))
        (t (%seq-type-spec result-type))))

(defun concatenate (result-type &rest seqs)
  (let ((total 0))
    (dolist (s seqs)
      (setq total (+ total (cond ((listp s) (length-of-list s))
                                 ((vectorp s) (length s))
                                 (t (%type-error s 'sequence))))))
    (multiple-value-bind (kind et len exact) (%result-kind result-type)
      (when (and len (/= len total))
        (error 'type-error :datum (apply #'concatenate 'list seqs) :expected-type result-type))
      (if (eq kind :list)
          (let* ((head (cons nil nil)) (tail head))
            (dolist (s seqs)
              (if (listp s)
                  (dolist (x s) (let ((c (cons x nil))) (%setcdr tail c) (setq tail c)))
                  (let ((d (%array-storage s)) (off (%array-total-offset s)))
                    (dotimes (i (length s))
                      (let ((c (cons (%vref d (+ i off)) nil))) (%setcdr tail c) (setq tail c))))))
            (%check-result-type (cdr head) result-type exact))
          (let ((v (%make-storage total et)) (i 0))
            (dolist (s seqs)
              (if (listp s)
                  (dolist (x s) (%vset v i x) (setq i (+ i 1)))
                  (let ((n (length s)))
                    (%copy-elements v i (%array-storage s) (%array-total-offset s) n)
                    (setq i (+ i n)))))
            (%check-result-type v result-type exact))))))

(defun %map-args (cursors i)
  ;; CURSORS is a fresh list: list sequences are replaced by their remaining tails
  (let ((args nil))
    (do ((c cursors (cdr c))) ((null c) (nreverse-list args))
      (let ((s (car c)))
        (if (listp s)
            (progn (push (car s) args) (%setcar c (cdr s)))
            (push (row-major-aref s i) args))))))

(defun %map-length (s)
  "The number of elements of S a mapping function visits (a circular list has no end)."
  (cond ((listp s) (or (list-length s) most-positive-fixnum))
        ((vectorp s) (length s))
        (t (%type-error s 'sequence))))

(defun %min-length (seqs)
  (let ((m nil))
    (dolist (s seqs (or m 0))
      (let ((l (%map-length s)))
        (when (or (null m) (< l m)) (setq m l))))))

;;; Stepping through sequences without an argument list: a list is followed
;;; by its tail (L), a vector is read from its storage (D, at offset OFF).
(defmacro %cursor-bind ((l d off) seq &body body)
  (let ((s (gensym)))
    `(let* ((,s ,seq)
            (,l (if (listp ,s) ,s nil))
            (,d (if (listp ,s) nil (%array-storage ,s)))
            (,off (if (listp ,s) 0 (%array-total-offset ,s))))
       (declare (fixnum ,off))
       ,@body)))
(defmacro %cursor-next (l d off i)
  "The element I; the elements must be asked for in order, each once."
  `(if ,d (%vref ,d (+ ,i ,off)) (prog1 (car ,l) (setq ,l (cdr ,l)))))

(defmacro %with-map-call ((f seq more n) general &body body)
  "For one or two sequences, runs BODY with N bound to the number of elements
to visit and the variable CALL-FORM usable through (%MAP-STEP i), which calls
F on the elements I; with more sequences runs GENERAL."
  `(if (cdr ,more)
       ,general
       (let* ((%two (not (null ,more))) (%s2 (if %two (car ,more) nil))
              (,n (if %two (min (%map-length ,seq) (%map-length %s2)) (%map-length ,seq))))
         (declare (fixnum ,n))
         (%cursor-bind (%l1 %d1 %o1) ,seq
           (%cursor-bind (%l2 %d2 %o2) %s2
             ,@body)))))
(defmacro %map-step (f i)
  `(let ((%x (%cursor-next %l1 %d1 %o1 ,i)))
     (if %two (funcall ,f %x (%cursor-next %l2 %d2 %o2 ,i)) (funcall ,f %x))))

(defun map (result-type f seq &rest more)
  (let ((f (%fn f)))
    (%with-map-call (f seq more n)
        ;; three or more sequences
        (let* ((seqs (cons seq more)) (n (%min-length seqs)) (cursors (copy-list seqs)))
          (if (null result-type)
              (progn (dotimes (i n) (apply f (%map-args cursors i))) nil)
              (let ((results nil))
                (%seq-type-spec result-type)
                (dotimes (i n) (push (apply f (%map-args cursors i)) results))
                (%make-sequence-from-list result-type (nreverse-list results)))))
      (if (null result-type)
          (dotimes (i n nil) (%map-step f i))
          (multiple-value-bind (kind et len exact) (%result-kind result-type)
            (let ((result
                    (if (eq kind :list)
                        (let* ((head (cons nil nil)) (tail head))
                          (dotimes (i n (cdr head))
                            (let ((c (cons (%map-step f i) nil))) (%setcdr tail c) (setq tail c))))
                        (let ((v (%make-storage n et)))
                          (dotimes (i n v) (%vset v i (%map-step f i)))))))
              (when (and len (/= len n)) (error 'type-error :datum result :expected-type result-type))
              (%check-result-type result result-type exact)))))))

(defun map-into (result f &rest seqs)
  (let* ((f (%fn f))
         (n (cond ((listp result) (%list-length-checked result))
                  ((vectorp result) (if (array-has-fill-pointer-p result) (array-dimension result 0) (length result)))
                  (t (%type-error result 'sequence)))))
    (if (or (null seqs) (cddr seqs))
        ;; no sequence, or three or more
        (let ((n (if seqs (min n (%min-length seqs)) n))
              (cursors (copy-list seqs)))
          (if (listp result)
              (let ((l result))
                (dotimes (i n) (%setcar l (apply f (%map-args cursors i))) (setq l (cdr l))))
              (progn
                (dotimes (i n) (%row-major-aset result i (apply f (%map-args cursors i))))
                (when (array-has-fill-pointer-p result) (%set-mdarray-fill result n)))))
        (let ((seq (car seqs)) (more (cdr seqs)))
          (%with-map-call (f seq more m) nil
            (let ((n (min n m)))
              (if (listp result)
                  (let ((l result))
                    (dotimes (i n) (%setcar l (%map-step f i)) (setq l (cdr l))))
                  (let ((d (%array-storage result)) (off (%array-total-offset result)))
                    (dotimes (i n) (%vset d (+ i off) (%map-step f i)))
                    (when (array-has-fill-pointer-p result) (%set-mdarray-fill result n))))))))
    result))

(defun reduce (f seq &key key from-end (start 0) end (initial-value nil ivp))
  (when (and (consp seq) (null key) (null from-end) (eql start 0) (null end))
    (let* ((f (%fn f)) (acc (if ivp initial-value (car seq))))
      (do ((l (if ivp seq (cdr seq)) (cdr l))) ((%endp l) (return-from reduce acc))
        (setq acc (funcall f acc (car l))))))
  (let* ((f (%fn f)) (key (%keyfn key))
         (end (%region-end seq start end from-end))
         (acc initial-value) (first (not ivp)))
    (%do-region (x i seq start end from-end)
      (let ((v (%key key x)))
        (cond (first (setq acc v first nil))
              (from-end (setq acc (funcall f v acc)))
              (t (setq acc (funcall f acc v))))))
    (if first (funcall f) acc)))

(defun fill (seq item &key (start 0) end)
  (let ((end (%check-bounds start end (%seq-length seq))))
    (if (listp seq)
        (let ((l (nthcdr start seq)))
          (dotimes (i (- end start)) (%setcar l item) (setq l (cdr l))))
        (let ((d (%array-storage seq)) (off (%array-total-offset seq)))
          (declare (fixnum start end off))
          (if (%simple-vector-p d)
              (do ((i (+ start off) (+ i 1)) (e (+ end off))) ((>= i e))
                (declare (fixnum i e))
                (%set-svref d i item))
              (do ((i (+ start off) (+ i 1)) (e (+ end off))) ((>= i e))
                (declare (fixnum i e))
                (%simple-set d i item)))))
    seq))

(defun replace (seq1 seq2 &key (start1 0) end1 (start2 0) end2)
  (let* ((end1 (%check-bounds start1 end1 (%seq-length seq1)))
         (end2 (%check-bounds start2 end2 (%seq-length seq2)))
         (n (min (- end1 start1) (- end2 start2))))
    (declare (fixnum start1 start2 end1 end2 n))
    (cond ((and (listp seq1) (listp seq2))
           (if (and (eq seq1 seq2) (> start1 start2))
               (replace seq1 (%seq-to-list seq2 start2 (+ start2 n)) :start1 start1)
               (let ((a (nthcdr start1 seq1)) (b (nthcdr start2 seq2)))
                 (dotimes (i n) (%setcar a (car b)) (setq a (cdr a) b (cdr b))))))
          ((listp seq1)
           (let ((a (nthcdr start1 seq1)) (d (%array-storage seq2)) (off (+ start2 (%array-total-offset seq2))))
             (dotimes (i n) (%setcar a (%vref d (+ off i))) (setq a (cdr a)))))
          ((listp seq2)
           (let ((b (nthcdr start2 seq2)) (d (%array-storage seq1)) (off (+ start1 (%array-total-offset seq1))))
             (dotimes (i n) (%vset d (+ off i) (car b)) (setq b (cdr b)))))
          (t
           (let ((d1 (%array-storage seq1)) (p1 (+ start1 (%array-total-offset seq1)))
                 (d2 (%array-storage seq2)) (p2 (+ start2 (%array-total-offset seq2))))
             (declare (fixnum p1 p2))
             (if (and (eq d1 d2) (> p1 p2))
                 ;; the regions may overlap: copy from the end
                 (do ((i (- n 1) (- i 1))) ((< i 0)) (%vset d1 (+ p1 i) (%vref d2 (+ p2 i))))
                 (%copy-elements d1 p1 d2 p2 n)))))
    seq1))

;;; searching
(defun %find-position (item mode fn neg seq key from-end start end posp)
  "The first (last when FROM-END) selected element of SEQ in [START, END), or
its index when POSP."
  (let* ((key (%keyfn key)) (end (%region-end seq start end from-end)))
    (%do-region (x i seq start end from-end)
      (when (%match mode fn neg item (%key key x)) (return (if posp i x))))))

(defun find-if (pred seq &key key from-end (start 0) end)
  (%find-position nil 2 (%fn pred) nil seq key from-end start end nil))
(defun find-if-not (pred seq &key key from-end (start 0) end)
  (%find-position nil 2 (%fn pred) t seq key from-end start end nil))
(defmacro %eql-scan (item seq start end on-match result)
  "A loop over a simple string, simple vector or list SEQ in [START, END)
comparing elements with EQL; ON-MATCH runs with I bound; RESULT at the end.
Expands to NIL when SEQ is of none of those kinds (the caller then goes the
general way)."
  `(cond ((and (%simple-string-p ,seq) (characterp ,item))
          ;; a character is EQL to the elements it is EQ to
          (let ((end (%check-bounds ,start ,end (%string-length ,seq))))
            (do ((i ,start (+ i 1))) ((>= i end) ,result)
              (when (eq ,item (%schar ,seq i)) ,on-match))))
         ((%simple-string-p ,seq)
          (let ((end (%check-bounds ,start ,end (%string-length ,seq))))
            (do ((i ,start (+ i 1))) ((>= i end) ,result)
              (when (eql ,item (%schar ,seq i)) ,on-match))))
         ((%simple-vector-p ,seq)
          (let ((end (%check-bounds ,start ,end (%svlength ,seq))))
            (do ((i ,start (+ i 1))) ((>= i end) ,result)
              (when (eql ,item (%svref ,seq i)) ,on-match))))
         ((and (null ,end) (eql ,start 0) (listp ,seq))
          (do ((l ,seq (cdr l)) (i 0 (+ i 1))) ((%endp l) ,result)
            (when (eql ,item (car l)) ,on-match)))
         (t nil)))

(defun find (item seq &key key test test-not from-end (start 0) end)
  (when (and (null key) (null test) (null test-not) (null from-end)
             (or (%simple-string-p seq) (%simple-vector-p seq)))
    (return-from find (%eql-scan item seq start end (return-from find (aref seq i)) nil)))
  (if (and (listp seq) (null key) (null test) (null test-not) (null from-end) (eql start 0) (null end))
      (do ((l seq (cdr l))) ((%endp l) nil) (when (eql item (car l)) (return (car l))))
      (%with-test (mode fn neg) (test test-not)
        (%find-position item mode fn neg seq key from-end start end nil))))

(defun position-if (pred seq &key key from-end (start 0) end)
  (%find-position nil 2 (%fn pred) nil seq key from-end start end t))
(defun position-if-not (pred seq &key key from-end (start 0) end)
  (%find-position nil 2 (%fn pred) t seq key from-end start end t))
(defun position (item seq &key key test test-not from-end (start 0) end)
  (when (and (null key) (null test) (null test-not) (null from-end)
             (or (%simple-string-p seq) (%simple-vector-p seq) (and (listp seq) (null end) (eql start 0))))
    (return-from position (%eql-scan item seq start end (return-from position i) nil)))
  (%with-test (mode fn neg) (test test-not)
    (%find-position item mode fn neg seq key from-end start end t)))

(defun %count-matches (item mode fn neg seq key from-end start end)
  (let* ((key (%keyfn key)) (end (%region-end seq start end from-end)) (n 0))
    (declare (fixnum n))
    (%do-region (x i seq start end from-end)
      (when (%match mode fn neg item (%key key x)) (setq n (+ n 1))))
    n))
(defun count-if (pred seq &key key from-end (start 0) end)
  (%count-matches nil 2 (%fn pred) nil seq key from-end start end))
(defun count-if-not (pred seq &key key from-end (start 0) end)
  (%count-matches nil 2 (%fn pred) t seq key from-end start end))
(defun count (item seq &key key test test-not from-end (start 0) end)
  (when (and (null key) (null test) (null test-not)
             (or (%simple-string-p seq) (%simple-vector-p seq) (and (listp seq) (null end) (eql start 0))))
    (return-from count (let ((n 0)) (%eql-scan item seq start end (setq n (+ n 1)) n))))
  (%with-test (mode fn neg) (test test-not)
    (%count-matches item mode fn neg seq key from-end start end)))

;;; removal
(defun %mark-matches (item mode fn neg seq start end from-end count key)
  "A simple vector of flags for [START, END): T where an element is selected
(at most COUNT of them); second value: how many are."
  (let ((marks (%make-simple-vector (- end start) nil)) (n 0))
    (declare (fixnum start end n))
    (unless (eql count 0)
      (%do-region (x i seq start end from-end)
        (when (%match mode fn neg item (%key key x))
          (%set-svref marks (- i start) t)
          (setq n (+ n 1))
          (when (and count (>= n count)) (return nil)))))
    (values marks n)))

(defun %remove-marked (seq start end marks n)
  "A copy of SEQ without the N elements of [START, END) flagged in MARKS; a
list result shares the tail after END."
  (if (listp seq)
      (let* ((head (cons nil nil)) (tail head) (l seq))
        (dotimes (i end)
          (unless (and (>= i start) (%svref marks (- i start)))
            (let ((c (cons (car l) nil))) (%setcdr tail c) (setq tail c)))
          (setq l (cdr l)))
        (%setcdr tail l)
        (cdr head))
      (let* ((len (length seq)) (d (%array-storage seq)) (off (%array-total-offset seq))
             (v (%vector-like seq (- len n))) (j 0))
        (declare (fixnum len off j start end))
        (do ((i 0 (+ i 1))) ((>= i start)) (%vset v j (%vref d (+ i off))) (setq j (+ j 1)))
        (do ((i start (+ i 1))) ((>= i end))
          (unless (%svref marks (- i start)) (%vset v j (%vref d (+ i off))) (setq j (+ j 1))))
        (do ((i end (+ i 1))) ((>= i len)) (%vset v j (%vref d (+ i off))) (setq j (+ j 1)))
        v)))

(defun %delete-marked (seq start end marks n)
  "SEQ without the N (> 0) flagged elements, reusing SEQ where that is possible."
  (cond ((consp seq)
         ;; splice the marked conses out of the list itself
         (let* ((head (cons nil seq)) (prev head) (l seq))
           (dotimes (i end)
             (if (and (>= i start) (%svref marks (- i start)))
                 (%setcdr prev (cdr l))
                 (setq prev l))
             (setq l (cdr l)))
           (cdr head)))
        ((and (%mdarray-p seq) (%mdarray-fill seq))
         ;; compact in place
         (let ((len (length seq)) (d (%array-storage seq)) (off (%array-total-offset seq)) (j start))
           (do ((i start (+ i 1))) ((>= i len))
             (unless (and (< i end) (%svref marks (- i start)))
               (%vset d (+ j off) (%vref d (+ i off)))
               (setq j (+ j 1))))
           (%set-mdarray-fill seq j)
           seq))
        (t (%remove-marked seq start end marks n))))

(defun %remove (item mode fn neg seq key from-end start end count destructive)
  (let* ((key (%keyfn key)) (count (%check-count count))
         (direct (and (listp seq) (null count) (not from-end)))
         ;; NIL for a list processed to its end in one pass
         (end (if direct (%region-end seq start end nil) (%check-bounds start end (%seq-length seq)))))
    (cond ((and direct (not destructive))
           ;; one pass: the elements kept, in a fresh list that shares the
           ;; tail after END (SEQ itself when nothing is removed)
           (let* ((head (cons nil nil)) (tail head) (l seq) (removed nil))
             (dotimes (k start)
               (unless (consp l) (%type-error start `(integer 0 ,k)))
               (let ((c (cons (car l) nil))) (%setcdr tail c) (setq tail c))
               (setq l (cdr l)))
             (do ((k (if end (- end start) 0) (- k 1))) ((if end (<= k 0) (%endp l)))
               (declare (fixnum k))
               (let ((x (car l)))
                 (if (%match mode fn neg item (%key key x))
                     (setq removed t)
                     (let ((c (cons x nil))) (%setcdr tail c) (setq tail c))))
               (setq l (cdr l)))
             (if removed (progn (%setcdr tail l) (cdr head)) seq)))
          (direct
           ;; one pass, splicing the selected conses out
           (let* ((head (cons nil seq)) (prev head) (l seq))
             (dotimes (k start)
               (unless (consp l) (%type-error start `(integer 0 ,k)))
               (setq prev l l (cdr l)))
             (do ((k (if end (- end start) 0) (- k 1))) ((if end (<= k 0) (%endp l)))
               (declare (fixnum k))
               (if (%match mode fn neg item (%key key (car l)))
                   (%setcdr prev (cdr l))
                   (setq prev l))
               (setq l (cdr l)))
             (cdr head)))
          ((and (null count) (not from-end) (not destructive))
           ;; a vector, one pass: the elements kept go to a vector of the
           ;; full length, which is the result unless some were removed
           (let* ((len (length seq)) (d (%array-storage seq)) (off (%array-total-offset seq))
                  (v (%vector-like seq len)) (j start))
             (declare (fixnum len off j start end))
             (%copy-elements v 0 d off start)
             (do ((i (+ start off) (+ i 1)) (lim (+ end off))) ((>= i lim))
               (declare (fixnum i lim))
               (let ((x (%vref d i)))
                 (unless (%match mode fn neg item (%key key x))
                   (%vset v j x)
                   (setq j (+ j 1)))))
             (if (eql j end)
                 (%copy-elements v end d (+ end off) (- len end))
                 (let ((r (%vector-like seq (- len (- end j)))))
                   (%copy-elements r 0 v 0 j)
                   (%copy-elements r j d (+ end off) (- len end))))))
          (t
           (multiple-value-bind (marks n) (%mark-matches item mode fn neg seq start end from-end count key)
             (cond (destructive (if (eql n 0) seq (%delete-marked seq start end marks n)))
                   ((and (eql n 0) (listp seq)) seq)
                   (t (%remove-marked seq start end marks n))))))))

(defun remove-if (pred seq &key key from-end (start 0) end count)
  (%remove nil 2 (%fn pred) nil seq key from-end start end count nil))
(defun remove-if-not (pred seq &key key from-end (start 0) end count)
  (%remove nil 2 (%fn pred) t seq key from-end start end count nil))
(defun remove (item seq &key key test test-not from-end (start 0) end count)
  (%with-test (mode fn neg) (test test-not)
    (%remove item mode fn neg seq key from-end start end count nil)))
(defun delete-if (pred seq &key key from-end (start 0) end count)
  (%remove nil 2 (%fn pred) nil seq key from-end start end count t))
(defun delete-if-not (pred seq &key key from-end (start 0) end count)
  (%remove nil 2 (%fn pred) t seq key from-end start end count t))
(defun delete (item seq &key key test test-not from-end (start 0) end count)
  (%with-test (mode fn neg) (test test-not)
    (%remove item mode fn neg seq key from-end start end count t)))

;;; REMOVE-DUPLICATES.  With the test EQ, EQL, EQUAL or EQUALP and more than a
;;; few elements the keys seen are kept in a hash table (one pass); any other
;;; test compares every pair.
(defun %remove-duplicates (seq key test test-not from-end start end destructive)
  (%with-test (mode fn neg) (test test-not)
    (let* ((key (%keyfn key))
           (end (%check-bounds start end (%seq-length seq)))
           (n (- end start))
           (items (let ((v (%make-simple-vector n nil)))
                    (%do-region (x i seq start end nil) (%set-svref v (- i start) (%key key x)))
                    v))
           (marks (%make-simple-vector n nil)) (found 0)
           (table-test (cond ((or (< n 20) (not (boundp '*hash-table-class*))) nil)
                             ((eql mode 0) 'eql)
                             (neg nil)
                             ((eq fn #'equal) 'equal)
                             ((eq fn #'equalp) 'equalp)
                             (t nil))))
      (cond
        (table-test
         (let ((seen (make-hash-table :test table-test :size n)))
           (if from-end
               ;; keep the first occurrence
               (dotimes (j n)
                 (let ((k (%svref items j)))
                   (if (nth-value 1 (gethash k seen))
                       (progn (%set-svref marks j t) (setq found (+ found 1)))
                       (setf (gethash k seen) t))))
               ;; keep the last occurrence
               (do ((i (- n 1) (- i 1))) ((< i 0))
                 (let ((k (%svref items i)))
                   (if (nth-value 1 (gethash k seen))
                       (progn (%set-svref marks i t) (setq found (+ found 1)))
                       (setf (gethash k seen) t)))))))
        (from-end
         ;; keep the first occurrence: drop an element matching an earlier kept one
         (dotimes (j n)
           (let ((kj (%svref items j)))
             (dotimes (i j)
               (when (and (not (%svref marks i)) (%match mode fn neg (%svref items i) kj))
                 (%set-svref marks j t) (setq found (+ found 1)) (return))))))
        (t
         ;; keep the last occurrence: drop an element matching a later one
         (dotimes (i n)
           (let ((ki (%svref items i)))
             (do ((j (+ i 1) (+ j 1))) ((>= j n))
               (when (%match mode fn neg ki (%svref items j))
                 (%set-svref marks i t) (setq found (+ found 1)) (return)))))))
      (cond ((and (eql found 0) (or destructive (listp seq))) seq)
            (destructive (%delete-marked seq start end marks found))
            (t (%remove-marked seq start end marks found))))))

(defun remove-duplicates (seq &key key test test-not from-end (start 0) end)
  (%remove-duplicates seq key test test-not from-end start end nil))
(defun delete-duplicates (seq &key key test test-not from-end (start 0) end)
  (%remove-duplicates seq key test test-not from-end start end t))

;;; substitution
(defun %substitute (new item mode fn neg seq key from-end start end count destructive)
  (let* ((key (%keyfn key)) (count (%check-count count))
         (end (%check-bounds start end (%seq-length seq)))
         ;; with a count, or from the end (the elements are then tested
         ;; last first), the elements to replace are found first
         (marks (if (or count from-end) (%mark-matches item mode fn neg seq start end from-end count key) nil))
         (result (if destructive seq (copy-seq seq))))
    (declare (fixnum start end))
    (if (listp result)
        (do ((l (nthcdr start result) (cdr l)) (i 0 (+ i 1)) (k (- end start) (- k 1))) ((<= k 0))
          (declare (fixnum i k))
          (when (if marks (%svref marks i) (%match mode fn neg item (%key key (car l))))
            (%setcar l new)))
        (let ((d (%array-storage result)) (off (%array-total-offset result)))
          (declare (fixnum off))
          (do ((i start (+ i 1))) ((>= i end))
            (declare (fixnum i))
            (when (if marks
                      (%svref marks (- i start))
                      (%match mode fn neg item (%key key (%vref d (+ i off)))))
              (%vset d (+ i off) new)))))
    result))

(defun substitute-if (new pred seq &key key from-end (start 0) end count)
  (%substitute new nil 2 (%fn pred) nil seq key from-end start end count nil))
(defun substitute-if-not (new pred seq &key key from-end (start 0) end count)
  (%substitute new nil 2 (%fn pred) t seq key from-end start end count nil))
(defun substitute (new old seq &key key test test-not from-end (start 0) end count)
  (%with-test (mode fn neg) (test test-not)
    (%substitute new old mode fn neg seq key from-end start end count nil)))
(defun nsubstitute-if (new pred seq &key key from-end (start 0) end count)
  (%substitute new nil 2 (%fn pred) nil seq key from-end start end count t))
(defun nsubstitute-if-not (new pred seq &key key from-end (start 0) end count)
  (%substitute new nil 2 (%fn pred) t seq key from-end start end count t))
(defun nsubstitute (new old seq &key key test test-not from-end (start 0) end count)
  (%with-test (mode fn neg) (test test-not)
    (%substitute new old mode fn neg seq key from-end start end count t)))

;;; Indexed access to a region of any sequence: D is simple storage and the
;;; element I of the sequence is at I + OFF (a list region is copied to a
;;; simple vector first).
(defmacro %with-indexable (((d off) seq start end) &body body)
  (let ((s (gensym)))
    `(let* ((,s ,seq)
            (,d (if (listp ,s) (%list-region-vector ,s ,start ,end) (%array-storage ,s)))
            (,off (if (listp ,s) (- ,start) (%array-total-offset ,s))))
       (declare (fixnum ,off))
       ,@body)))

(defun mismatch (s1 s2 &key key test test-not from-end (start1 0) end1 (start2 0) end2)
  (%with-test (mode fn neg) (test test-not)
    (let* ((key (%keyfn key))
           (end1 (%check-bounds start1 end1 (%seq-length s1)))
           (end2 (%check-bounds start2 end2 (%seq-length s2))))
      (declare (fixnum start1 start2 end1 end2))
      (if from-end
          (%with-indexable ((d1 o1) s1 start1 end1)
            (%with-indexable ((d2 o2) s2 start2 end2)
              (do ((i (- end1 1) (- i 1)) (j (- end2 1) (- j 1)))
                  ((or (< i start1) (< j start2))
                   (if (and (< i start1) (< j start2)) nil (+ i 1)))
                (unless (%match mode fn neg (%key key (%vref d1 (+ i o1))) (%key key (%vref d2 (+ j o2))))
                  (return (+ i 1))))))
          (%cursor-bind (l1 d1 o1) s1
            (%cursor-bind (l2 d2 o2) s2
              (when l1 (setq l1 (nthcdr start1 l1)))
              (when l2 (setq l2 (nthcdr start2 l2)))
              (do ((i start1 (+ i 1)) (j start2 (+ j 1)))
                  ((or (>= i end1) (>= j end2))
                   (if (and (>= i end1) (>= j end2)) nil i))
                (unless (%match mode fn neg (%key key (%cursor-next l1 d1 o1 i))
                                (%key key (%cursor-next l2 d2 o2 j)))
                  (return i)))))))))

(defun search (s1 s2 &key key test test-not from-end (start1 0) end1 (start2 0) end2)
  (%with-test (mode fn neg) (test test-not)
    (let* ((key (%keyfn key))
           (end1 (%check-bounds start1 end1 (%seq-length s1)))
           (end2 (%check-bounds start2 end2 (%seq-length s2)))
           (n (- end1 start1)) (last (- end2 n)))
      (declare (fixnum start1 start2 end1 end2 n last))
      (%with-indexable ((d1 o1) s1 start1 end1)
        (let ((p1 (+ start1 o1)))
          (cond
            ((and (null key) (eql mode 0) (%simple-string-p d1) (not (listp s2))
                  (%simple-string-p (%array-storage s2)))
             ;; a string in a string: characters are EQL when they are EQ
             (let ((d2 (%array-storage s2)) (o2 (%array-total-offset s2)))
               (if from-end
                   (do ((i last (- i 1))) ((< i start2) nil)
                     (when (do ((k 0 (+ k 1))) ((>= k n) t)
                             (unless (eq (%schar d1 (+ p1 k)) (%schar d2 (+ i o2 k))) (return nil)))
                       (return i)))
                   (do ((i start2 (+ i 1))) ((> i last) nil)
                     (when (do ((k 0 (+ k 1))) ((>= k n) t)
                             (unless (eq (%schar d1 (+ p1 k)) (%schar d2 (+ i o2 k))) (return nil)))
                       (return i))))))
            ((and (listp s2) (not from-end))
             ;; follow the list: no indexing
             (do ((i start2 (+ i 1)) (l (nthcdr start2 s2) (cdr l))) ((> i last) nil)
               (when (do ((k 0 (+ k 1)) (q l (cdr q))) ((>= k n) t)
                       (unless (%match mode fn neg (%key key (%vref d1 (+ p1 k))) (%key key (car q)))
                         (return nil)))
                 (return i))))
            (t
             (%with-indexable ((d2 o2) s2 start2 end2)
               (if from-end
                   (do ((i last (- i 1))) ((< i start2) nil)
                     (when (do ((k 0 (+ k 1))) ((>= k n) t)
                             (unless (%match mode fn neg (%key key (%vref d1 (+ p1 k)))
                                             (%key key (%vref d2 (+ i o2 k))))
                               (return nil)))
                       (return i)))
                   (do ((i start2 (+ i 1))) ((> i last) nil)
                     (when (do ((k 0 (+ k 1))) ((>= k n) t)
                             (unless (%match mode fn neg (%key key (%vref d1 (+ p1 k)))
                                             (%key key (%vref d2 (+ i o2 k))))
                               (return nil)))
                       (return i))))))))))))

;;; EVERY, SOME, NOTANY, NOTEVERY: MODE 0 stops at the first false value
;;; (EVERY), MODE 1 at the first true one (SOME).
(defmacro %quantifier-step (mode value)
  (let ((v (gensym)))
    `(let ((,v ,value))
       (if (eql ,mode 0)
           (unless ,v (return nil))
           (when ,v (return ,v))))))

(defun %quantify (mode pred seq more)
  (let ((pred (%fn pred)) (default (eql mode 0)))
    (cond ((and (null more) (listp seq))
           (do ((l seq (cdr l))) ((%endp l) default)
             (%quantifier-step mode (funcall pred (car l)))))
          ((null more)
           (unless (vectorp seq) (%type-error seq 'sequence))
           (let ((d (%array-storage seq)) (off (%array-total-offset seq)))
             (do ((i off (+ i 1)) (e (+ off (length seq)))) ((>= i e) default)
               (declare (fixnum i e))
               (%quantifier-step mode (funcall pred (%vref d i))))))
          ((null (cdr more))
           (let* ((s2 (car more)) (n (min (%map-length seq) (%map-length s2))))
             (declare (fixnum n))
             (%cursor-bind (l1 d1 o1) seq
               (%cursor-bind (l2 d2 o2) s2
                 (dotimes (i n default)
                   (%quantifier-step mode (funcall pred (%cursor-next l1 d1 o1 i)
                                                   (%cursor-next l2 d2 o2 i))))))))
          (t
           (let* ((seqs (cons seq more)) (n (%min-length seqs)) (cursors (copy-list seqs)))
             (dotimes (i n default)
               (%quantifier-step mode (apply pred (%map-args cursors i)))))))))

(defun every (pred seq &rest more) (%quantify 0 pred seq more))
(defun some (pred seq &rest more) (%quantify 1 pred seq more))
(defun notany (pred seq &rest more) (not (%quantify 1 pred seq more)))
(defun notevery (pred seq &rest more) (not (%quantify 0 pred seq more)))

;;; sorting: a stable merge sort, of the conses of a list and of the storage
;;; of a vector.  The key of an element is computed once for each merge step
;;; it takes part in (lists) or once in all (vectors).
(defun %merge-lists (a b pred key)
  (let* ((head (cons nil nil)) (tail head))
    (if key
        (when (and a b)
          ;; the keys of the two front elements are kept
          (let ((ka (funcall key (car a))) (kb (funcall key (car b))))
            (loop
              (if (funcall pred kb ka)
                  (progn (%setcdr tail b) (setq tail b b (cdr b))
                         (if b (setq kb (funcall key (car b))) (return)))
                  (progn (%setcdr tail a) (setq tail a a (cdr a))
                         (if a (setq ka (funcall key (car a))) (return)))))))
        (do () ((or (null a) (null b)))
          (if (funcall pred (car b) (car a))
              (progn (%setcdr tail b) (setq tail b b (cdr b)))
              (progn (%setcdr tail a) (setq tail a a (cdr a))))))
    (%setcdr tail (if a a b))
    (cdr head)))

(defun %sort-list (l pred key)
  (let ((n (length-of-list l)))
    (if (< n 2) l (values (%sort-list-n l n pred key)))))

(defun %sort-list-n (l n pred key)
  "Sort the first N (> 0) conses of L; returns the sorted list and the rest of L."
  (if (eql n 1)
      (let ((rest (cdr l))) (%setcdr l nil) (values l rest))
      (let ((h (ash n -1)))
        (multiple-value-bind (a rest) (%sort-list-n l h pred key)
          (multiple-value-bind (b rest2) (%sort-list-n rest (- n h) pred key)
            (values (%merge-lists a b pred key) rest2))))))

(defun %sort-simple-vector (v keys lo hi pred tmp ktmp)
  "Sorts the elements [LO, HI) of the simple vector V, stably, by the keys in
the simple vector KEYS (which is V itself when there is no key function; the
keys are moved with their elements).  TMP and KTMP are scratch vectors of at
least half the length (KTMP is TMP when KEYS is V)."
  (declare (fixnum lo hi))
  (if (< (- hi lo) 10)
      ;; insertion sort
      (do ((i (+ lo 1) (+ i 1))) ((>= i hi))
        (declare (fixnum i))
        (let ((x (%svref v i)) (kx (%svref keys i)) (j i))
          (declare (fixnum j))
          (do () ((or (<= j lo) (not (funcall pred kx (%svref keys (- j 1))))))
            (%set-svref v j (%svref v (- j 1)))
            (%set-svref keys j (%svref keys (- j 1)))
            (setq j (- j 1)))
          (%set-svref v j x)
          (%set-svref keys j kx)))
      (let ((mid (+ lo (ash (- hi lo) -1))))
        (declare (fixnum mid))
        (%sort-simple-vector v keys lo mid pred tmp ktmp)
        (%sort-simple-vector v keys mid hi pred tmp ktmp)
        ;; merge, unless the halves are in order already
        (when (funcall pred (%svref keys mid) (%svref keys (- mid 1)))
          (let ((n1 (- mid lo)) (same (eq v keys)))
            (declare (fixnum n1))
            (dotimes (i n1)
              (%set-svref tmp i (%svref v (+ lo i)))
              (unless same (%set-svref ktmp i (%svref keys (+ lo i)))))
            (let ((i 0) (j mid) (k lo))
              (declare (fixnum i j k))
              (do () ((or (>= i n1) (>= j hi)))
                (if (funcall pred (%svref keys j) (%svref ktmp i))
                    (progn (%set-svref v k (%svref v j))
                           (unless same (%set-svref keys k (%svref keys j)))
                           (setq j (+ j 1)))
                    (progn (%set-svref v k (%svref tmp i))
                           (unless same (%set-svref keys k (%svref ktmp i)))
                           (setq i (+ i 1))))
                (setq k (+ k 1)))
              ;; what is left of the first half (the rest of the second is in place)
              (do () ((>= i n1))
                (%set-svref v k (%svref tmp i))
                (unless same (%set-svref keys k (%svref ktmp i)))
                (setq i (+ i 1) k (+ k 1)))))))))

(defun %sort-vector (seq pred key)
  (let* ((n (length seq)) (d (%array-storage seq)) (off (%array-total-offset seq)))
    (declare (fixnum n off))
    (when (> n 1)
      (let* ((direct (%simple-vector-p d))
             ;; other storage (strings, bits, ...) is sorted in a copy
             (v (if direct d (let ((c (%make-simple-vector n nil)))
                               (dotimes (i n c) (%set-svref c i (%vref d (+ i off)))))))
             (lo (if direct off 0))
             (half (+ 1 (ash n -1)))
             (tmp (%make-simple-vector half nil)))
        (declare (fixnum lo half))
        (if key
            (let ((keys (%make-simple-vector (+ lo n) nil)))
              (dotimes (i n) (%set-svref keys (+ lo i) (funcall key (%svref v (+ lo i)))))
              (%sort-simple-vector v keys lo (+ lo n) pred tmp (%make-simple-vector half nil)))
            (%sort-simple-vector v v lo (+ lo n) pred tmp tmp))
        (unless direct
          (dotimes (i n) (%vset d (+ i off) (%svref v i))))))
    seq))

(defun sort (seq pred &key key)
  (let ((pred (%two-arg-fn (%fn pred))) (key (%keyfn key)))
    (cond ((listp seq) (%sort-list seq pred key))
          ((vectorp seq) (%sort-vector seq pred key))
          (t (%type-error seq 'sequence)))))
(defun stable-sort (seq pred &key key)
  (let ((pred (%two-arg-fn (%fn pred))) (key (%keyfn key)))
    (cond ((listp seq) (%sort-list seq pred key))
          ((vectorp seq) (%sort-vector seq pred key))
          (t (%type-error seq 'sequence)))))

(defun merge (result-type s1 s2 pred &key key)
  (let ((pred (%two-arg-fn (%fn pred))) (key (%keyfn key)))
    (%seq-type-spec result-type)
    (unless (or (listp s1) (vectorp s1)) (%type-error s1 'sequence))
    (unless (or (listp s2) (vectorp s2)) (%type-error s2 'sequence))
    (%make-sequence-from-list
     result-type
     (%merge-lists (copy-list (%seq-to-list s1)) (copy-list (%seq-to-list s2)) pred key))))

;;; ------------------------------------------------------------
;;; strings
;;; ------------------------------------------------------------

(defun make-string (n &key (initial-element (code-char 32)) (element-type 'character))
  (unless (and (fixnump n) (>= n 0)) (%type-error n '(integer 0 *)))
  (unless (characterp initial-element) (%type-error initial-element 'character))
  (let ((et (%normalize-element-type element-type)))
    (unless (member et '(character nil))
      (error "MAKE-STRING: ~S is not a subtype of CHARACTER" element-type)))
  (%make-string n initial-element))

(defun %copy-simple-string (s)
  (let* ((n (length s)) (r (%make-string n #\Space)))
    (if (%simple-string-p s)
        (%string-copy r 0 s 0 n)
        (dotimes (i n r) (%set-schar r i (char s i))))))

(defun %string-hash (s)
  ;; FNV-1a 32 bit, reduced to 29 bits (must match the compiler)
  (let ((h1 #x811C) (h0 #x9DC5))
    ;; represent the 32-bit hash as two 16-bit halves to stay in fixnum range
    (dotimes (i (length s))
      (let ((c (char-code (char s i))))
        (setq h0 (%fxlogxor h0 (%fxlogand c #xFFFF)))
        (setq h1 (%fxlogxor h1 (%fxash-right c 16)))
        ;; multiply (h1:h0) by 16777619 = 0x01000193 mod 2^32
        (let* ((lo (%fx* h0 #x193))
               (hi (%fx+ (%fx+ (%fx* h1 #x193) (%fxash-left (%fxlogand h0 #xFF) 8)) (%fxash-right lo 16))))
          (setq h0 (%fxlogand lo #xFFFF))
          (setq h1 (%fxlogand hi #xFFFF)))))
    (%fxlogior (%fxash-left (%fxlogand h1 #x1FFF) 16) h0)))

(defun string (x)
  (cond ((stringp x) x)
        ((symbolp x) (symbol-name x))
        ((characterp x) (%make-string 1 x))
        (t (%type-error x 'string-designator))))

(defmacro %with-string-data (((d off len) s) &body body)
  "D: the simple string holding the characters of the string S, OFF: where
they start in it, LEN: the length of S."
  (let ((v (gensym)))
    `(let* ((,v ,s)
            (,d (if (%simple-string-p ,v) ,v (%array-storage ,v)))
            (,off (if (%simple-string-p ,v) 0 (%array-total-offset ,v)))
            (,len (if (%simple-string-p ,v) (%string-length ,v) (length ,v))))
       (declare (fixnum ,off ,len))
       ,@body)))

(defun %string-compare (s1 s2 start1 end1 start2 end2 ci)
  "Compares two string regions.  Returns 4 * the index of the first
difference in S1 + how S1 compares with S2 there: 0 equal, 1 less, 2 greater."
  (let ((s1 (if (%simple-string-p s1) s1 (string s1)))
        (s2 (if (%simple-string-p s2) s2 (string s2))))
    (%with-string-data ((d1 o1 l1) s1)
      (%with-string-data ((d2 o2 l2) s2)
        (let* ((b1 (or start1 0)) (e1 (%check-bounds b1 end1 l1))
               (b2 (or start2 0)) (e2 (%check-bounds b2 end2 l2)))
          (declare (fixnum b1 e1 b2 e2))
          (do ((i b1 (+ i 1)) (j b2 (+ j 1)))
              ((or (>= i e1) (>= j e2))
               (+ (* i 4) (cond ((and (>= i e1) (>= j e2)) 0) ((>= i e1) 1) (t 2))))
            (declare (fixnum i j))
            (let ((c1 (%schar d1 (+ i o1))) (c2 (%schar d2 (+ j o2))))
              (unless (eq c1 c2)
                (when ci (setq c1 (char-upcase c1) c2 (char-upcase c2)))
                (unless (eq c1 c2)
                  (return (+ (* i 4) (if (< (char-code c1) (char-code c2)) 1 2))))))))))))

(defun %string-eq (s1 s2 start1 end1 start2 end2 ci)
  "True when the two string regions have the same characters (ignoring case when CI)."
  (let ((s1 (if (%simple-string-p s1) s1 (string s1)))
        (s2 (if (%simple-string-p s2) s2 (string s2))))
    (%with-string-data ((d1 o1 l1) s1)
      (%with-string-data ((d2 o2 l2) s2)
        (let* ((b1 (or start1 0)) (e1 (%check-bounds b1 end1 l1))
               (b2 (or start2 0)) (e2 (%check-bounds b2 end2 l2)))
          (declare (fixnum b1 e1 b2 e2))
          (and (eql (- e1 b1) (- e2 b2))
               (do ((i (+ b1 o1) (+ i 1)) (j (+ b2 o2) (+ j 1)) (lim (+ e1 o1))) ((>= i lim) t)
                 (declare (fixnum i j lim))
                 (let ((c1 (%schar d1 i)) (c2 (%schar d2 j)))
                   (unless (or (eq c1 c2) (and ci (%char-ci-eq c1 c2)))
                     (return nil))))))))))

(defun %string=-2 (s1 s2)
  (if (and (%simple-string-p s1) (%simple-string-p s2))
      (%simple-string= s1 s2)
      (%string-eq s1 s2 0 nil 0 nil nil)))
(define-compiler-macro string= (&whole form s1 s2 &rest keys)
  (if keys form `(%string=-2 ,s1 ,s2)))
(defun string= (s1 s2 &key (start1 0) end1 (start2 0) end2)
  (%string-eq s1 s2 start1 end1 start2 end2 nil))
(defun string-equal (s1 s2 &key (start1 0) end1 (start2 0) end2)
  (%string-eq s1 s2 start1 end1 start2 end2 t))
(macrolet ((def (name name-2 ci &rest codes)
             ;; CODES: the results of %STRING-COMPARE for which NAME is true
             `(progn
                (defun ,name (s1 s2 &key (start1 0) end1 (start2 0) end2)
                  (let* ((r (%string-compare s1 s2 start1 end1 start2 end2 ,ci))
                         (code (logand r 3)))
                    (declare (fixnum r code))
                    (if (or ,@(mapcar (lambda (c) `(eql code ,c)) codes)) (ash r -2) nil)))
                ;; the function of two strings (see %TWO-ARG-FN)
                (defun ,name-2 (s1 s2)
                  (let* ((r (%string-compare s1 s2 0 nil 0 nil ,ci))
                         (code (logand r 3)))
                    (declare (fixnum r code))
                    (if (or ,@(mapcar (lambda (c) `(eql code ,c)) codes)) (ash r -2) nil))))))
  (def string< %string<-2 nil 1) (def string> %string>-2 nil 2)
  (def string<= %string<=-2 nil 1 0) (def string>= %string>=-2 nil 2 0)
  (def string/= %string/=-2 nil 1 2)
  (def string-lessp %string-lessp-2 t 1) (def string-greaterp %string-greaterp-2 t 2)
  (def string-not-greaterp %string-not-greaterp-2 t 1 0)
  (def string-not-lessp %string-not-lessp-2 t 2 0) (def string-not-equal %string-not-equal-2 t 1 2))

(defun %string-equal-2 (s1 s2) (%string-eq s1 s2 0 nil 0 nil t))
(defun %char=-2 (a b) (char= a b))
(defun %char/=-2 (a b) (not (char= a b)))
(defun %char-not-equal-2 (a b) (not (%char-equal-2 a b)))

(defun %two-arg-fn (fn)
  "FN, or for one of the string and character comparison functions (which
take keyword or any number of arguments) the function of two arguments that
does the same: a test or predicate is called with two."
  (cond ((eq fn #'string=) #'%string=-2)
        ((eq fn #'string<) #'%string<-2)
        ((eq fn #'string-equal) #'%string-equal-2)
        ((eq fn #'char=) #'%char=-2)
        ((eq fn #'char-equal) #'%char-equal-2)
        ((eq fn #'string>) #'%string>-2)
        ((eq fn #'string-lessp) #'%string-lessp-2)
        ((eq fn #'char<) #'%char<-2)
        ((eq fn #'char>) #'%char>-2)
        ((eq fn #'string<=) #'%string<=-2)
        ((eq fn #'string>=) #'%string>=-2)
        ((eq fn #'string/=) #'%string/=-2)
        ((eq fn #'string-greaterp) #'%string-greaterp-2)
        ((eq fn #'string-not-greaterp) #'%string-not-greaterp-2)
        ((eq fn #'string-not-lessp) #'%string-not-lessp-2)
        ((eq fn #'string-not-equal) #'%string-not-equal-2)
        ((eq fn #'char/=) #'%char/=-2)
        ((eq fn #'char<=) #'%char<=-2)
        ((eq fn #'char>=) #'%char>=-2)
        ((eq fn #'char-lessp) #'%char-lessp-2)
        ((eq fn #'char-greaterp) #'%char-greaterp-2)
        ((eq fn #'char-not-equal) #'%char-not-equal-2)
        ((eq fn #'char-not-greaterp) #'%char-not-greaterp-2)
        ((eq fn #'char-not-lessp) #'%char-not-lessp-2)
        (t fn)))

(defun %string-case (s start end upcasep)
  (let* ((s (string s)) (r (%copy-simple-string s)) (end (%check-bounds start end (length r))))
    (declare (fixnum end) (simple-string r))
    (if upcasep
        (do ((i start (+ i 1))) ((>= i end) r)
          (declare (fixnum i))
          (let ((code (char-code (%schar r i))))
            (cond ((< code 97))
                  ((<= code 122) (%set-schar r i (code-char (- code 32))))
                  ((> code 127) (%set-schar r i (char-upcase (%schar r i)))))))
        (do ((i start (+ i 1))) ((>= i end) r)
          (declare (fixnum i))
          (let ((code (char-code (%schar r i))))
            (cond ((< code 65))
                  ((<= code 90) (%set-schar r i (code-char (+ code 32))))
                  ((> code 127) (%set-schar r i (char-downcase (%schar r i))))))))))
(defun string-upcase (s &key (start 0) end) (%string-case s start end t))
(defun string-downcase (s &key (start 0) end) (%string-case s start end nil))
(defun string-capitalize (s &key (start 0) end)
  (let* ((r (%copy-simple-string (string s))) (end (%check-bounds start end (length r))) (in-word nil))
    (declare (fixnum start end))
    (do ((i start (+ i 1))) ((>= i end) r)
      (declare (fixnum i))
      (let ((c (%schar r i)))
        (if (alphanumericp c)
            (progn (%set-schar r i (if in-word (char-downcase c) (char-upcase c))) (setq in-word t))
            (setq in-word nil))))))
(defun nstring-upcase (s &key (start 0) end) (replace s (string-upcase s :start start :end end)))
(defun nstring-downcase (s &key (start 0) end) (replace s (string-downcase s :start start :end end)))
(defun nstring-capitalize (s &key (start 0) end) (replace s (string-capitalize s :start start :end end)))

(defun %string-trim (bag s left right)
  (let* ((s (string s)) (n (length s)) (i 0))
    (declare (fixnum n i))
    (when left
      (do () ((or (>= i n) (not (find (char s i) bag)))) (setq i (+ i 1))))
    (when right
      (do () ((or (<= n i) (not (find (char s (- n 1)) bag)))) (setq n (- n 1))))
    (subseq s i n)))
(defun string-left-trim (bag s) (%string-trim bag s t nil))
(defun string-right-trim (bag s) (%string-trim bag s nil t))
(defun string-trim (bag s) (%string-trim bag s t t))

;;; ------------------------------------------------------------
;;; coerce
;;; ------------------------------------------------------------

(defun %coerce-error (x type)
  (error 'simple-type-error :datum x :expected-type type
                            :format-control "Cannot coerce ~S to ~S"
                            :format-arguments (list x type)))

(defun %coerce-to-list (x)
  (cond ((listp x) x) ((vectorp x) (%seq-to-list x)) (t (%coerce-error x 'list))))

(defun %coerce-to-storage (x et type)
  "A fresh simple vector of element type ET with the elements of the sequence X."
  (cond ((listp x)
         (let ((v (%make-storage (length-of-list x) et)) (i 0))
           (declare (fixnum i))
           (dolist (e x v) (%vset v i e) (setq i (+ i 1)))))
        ((vectorp x)
         (let ((n (length x)))
           (%copy-elements (%make-storage n et) 0 (%array-storage x) (%array-total-offset x) n)))
        (t (%coerce-error x type))))

(defun %coerce-to-vector (x) (if (vectorp x) x (%coerce-to-storage x t 'vector)))
(defun %coerce-to-simple-vector (x) (if (%simple-vector-p x) x (%coerce-to-storage x t 'simple-vector)))
(defun %coerce-to-string (x) (if (stringp x) x (%coerce-to-storage x 'character 'string)))
(defun %coerce-to-simple-string (x)
  (if (simple-string-p x) x (%coerce-to-storage x 'character 'simple-string)))
(defun %coerce-to-double (x)
  (cond ((%double-float-p x) x) ((realp x) (%to-double x)) (t (%coerce-error x 'double-float))))
(defun %coerce-to-single (x)
  (cond ((%single-float-p x) x) ((realp x) (%to-single x)) (t (%coerce-error x 'single-float))))
(defun %coerce-to-float (x)
  (cond ((floatp x) x) ((realp x) (%to-single x)) (t (%coerce-error x 'float))))
(defun %coerce-to-function (x)
  (cond ((functionp x) x)
        ((and (consp x) (eq (car x) 'lambda)) (eval (list 'function x)))
        ((and (symbolp x) (fboundp x) (not (macro-function x)) (not (special-operator-p x)))
         (fdefinition x))
        (t (%coerce-error x 'function))))

(defun coerce (x type)
  ;; the usual result types first
  (cond ((eq type 'list) (%coerce-to-list x))
        ((eq type 'vector) (%coerce-to-vector x))
        ((eq type 'simple-vector) (%coerce-to-simple-vector x))
        ((eq type 'string) (%coerce-to-string x))
        ((eq type 'simple-string) (%coerce-to-simple-string x))
        ((eq type 'double-float) (%coerce-to-double x))
        ((eq type 'single-float) (%coerce-to-single x))
        ((eq type 'float) (%coerce-to-float x))
        ((eq type 'character) (character x))
        ((eq type 'function) (%coerce-to-function x))
        ((eq type t) x)
        (t (%coerce-general x type))))

(defun %coerce-general (x type)
  (let* ((type (if (%class-p type) (%class-name type) type))
         (ty (if (consp type) (car type) type)))
    (cond ((eq type t) x)
          ((eq type 'list) (%coerce-to-list x))
          ((member ty '(float single-float short-float double-float long-float))
           (cond ((typep x type) x)
                 ((not (realp x)) (%coerce-error x type))
                 ((member ty '(double-float long-float)) (%to-double x))
                 ((and (eq ty 'float) (floatp x)) x)
                 (t (%to-single x))))
          ((eq ty 'complex)
           (cond ((not (numberp x)) (%coerce-error x type))
                 ((or (atom type) (null (cdr type)) (eq (cadr type) '*))
                  (if (complexp x) x (complex x 0)))
                 (t (complex (coerce (realpart x) (cadr type)) (coerce (imagpart x) (cadr type))))))
          ((eq ty 'character) (character x))
          ((eq ty 'function) (%coerce-to-function x))
          ((typep x type) x)
          ((or (listp x) (vectorp x))
           (%make-sequence-from-list type (copy-list (%seq-to-list x))))
          (t (%coerce-error x type)))))

;;; (coerce x 'TYPE) with one of the usual constant types calls the function
;;; for that type.
(define-compiler-macro coerce (&whole form x type)
  (let ((fn (and (consp type) (eq (car type) 'quote) (consp (cdr type)) (null (cddr type))
                 (symbolp (cadr type))
                 (cdr (assoc (cadr type)
                             '((list . %coerce-to-list) (vector . %coerce-to-vector)
                               (simple-vector . %coerce-to-simple-vector) (string . %coerce-to-string)
                               (simple-string . %coerce-to-simple-string)
                               (double-float . %coerce-to-double) (long-float . %coerce-to-double)
                               (single-float . %coerce-to-single) (short-float . %coerce-to-single)
                               (float . %coerce-to-float) (character . character)
                               (function . %coerce-to-function)))))))
    (cond (fn `(,fn ,x))
          ((equal type ''t) `(values ,x))
          (t form))))

;;; setf functions, for (setf (apply #'aref ...)) and #'(setf aref)
(defun (setf aref) (value array &rest subscripts) (apply #'%aset array (append subscripts (list value))))
(defun (setf bit) (value array &rest subscripts) (apply #'%aset array (append subscripts (list value))))
(defun (setf sbit) (value array &rest subscripts) (apply #'%aset array (append subscripts (list value))))
(defun (setf char) (value string index) (%charset string index value))
(defun (setf schar) (value string index) (%scharset string index value))
(defun (setf svref) (value vector index) (%svset vector index value))
(defun (setf elt) (value seq index) (%setelt seq index value))
