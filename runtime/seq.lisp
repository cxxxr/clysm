;;;; seq.lisp — characters, arrays, strings, sequences

;;; ------------------------------------------------------------
;;; characters
;;; ------------------------------------------------------------

(defconstant char-code-limit 1114112)

(defun %check-char (c) (if (characterp c) c (%type-error c 'character)))

(defun char-int (c) (char-code c))
(defun char-upcase (c)
  (let ((n (char-code c)))
    (if (or (<= 97 n 122) (<= 224 n 254 ) (<= 945 n 969) (<= 1072 n 1103))
        (if (or (= n 247)) c (code-char (- n (if (<= 1072 n 1103) 32 32))))
        c)))
(defun char-downcase (c)
  (let ((n (char-code c)))
    (if (or (<= 65 n 90) (<= 192 n 222) (<= 913 n 937) (<= 1040 n 1071))
        (if (= n 215) c (code-char (+ n 32)))
        c)))
(defun upper-case-p (c) (let ((n (char-code c))) (and (not (eql (char-downcase c) c)) (> n 0))))
(defun lower-case-p (c) (let ((n (char-code c))) (and (not (eql (char-upcase c) c)) (> n 0))))
(defun both-case-p (c) (or (upper-case-p c) (lower-case-p c)))
(defun alpha-char-p (c)
  (let ((n (char-code c)))
    (or (<= 65 n 90) (<= 97 n 122) (and (>= n 170) (both-case-p c))
        (<= #x3040 n #x30FF) (<= #x4E00 n #x9FFF))))
(defun digit-char-p (c &optional (radix 10))
  (let* ((n (char-code c))
         (d (cond ((<= 48 n 57) (- n 48))
                  ((<= 65 n 90) (- n 55))
                  ((<= 97 n 122) (- n 87))
                  (t nil))))
    (if (and d (< d radix)) d nil)))
(defun alphanumericp (c) (or (alpha-char-p c) (not (null (digit-char-p c)))))
(defun graphic-char-p (c) (let ((n (char-code c))) (or (<= 32 n 126) (> n 159))))
(defun standard-char-p (c) (let ((n (char-code c))) (or (<= 32 n 126) (= n 10))))
(defun digit-char (weight &optional (radix 10))
  (if (and (>= weight 0) (< weight radix)) (%digit-char weight) nil))

(defun %char-compare (chars fn)
  (do ((l chars (cdr l))) ((null (cdr l)) t)
    (unless (funcall fn (char-code (car l)) (char-code (cadr l))) (return nil))))
(defun %char-ci-compare (chars fn)
  (do ((l chars (cdr l))) ((null (cdr l)) t)
    (unless (funcall fn (char-code (char-upcase (car l))) (char-code (char-upcase (cadr l)))) (return nil))))
(defun char= (c &rest more) (if (and more (null (cdr more))) (char= c (car more)) (%char-compare (cons c more) #'=)))
(defun char< (c &rest more) (%char-compare (cons c more) #'<))
(defun char> (c &rest more) (%char-compare (cons c more) #'>))
(defun char<= (c &rest more) (%char-compare (cons c more) #'<=))
(defun char>= (c &rest more) (%char-compare (cons c more) #'>=))
(defun char/= (c &rest more)
  (do ((l (cons c more) (cdr l))) ((null l) t)
    (when (member (car l) (cdr l)) (return nil))))
(defun char-equal (c &rest more) (%char-ci-compare (cons c more) #'=))
(defun char-lessp (c &rest more) (%char-ci-compare (cons c more) #'<))
(defun char-greaterp (c &rest more) (%char-ci-compare (cons c more) #'>))
(defun char-not-greaterp (c &rest more) (%char-ci-compare (cons c more) #'<=))
(defun char-not-lessp (c &rest more) (%char-ci-compare (cons c more) #'>=))
(defun char-not-equal (c &rest more)
  (do ((l (cons c more) (cdr l))) ((null l) t)
    (when (member (car l) (cdr l) :test #'char-equal) (return nil))))

(defparameter *char-names*
  '((0 . "Nul") (7 . "Bell") (8 . "Backspace") (9 . "Tab") (10 . "Newline") (12 . "Page")
    (13 . "Return") (27 . "Escape") (32 . "Space") (127 . "Rubout")))

(defun char-name (c)
  (let ((e (assoc (char-code c) *char-names*)))
    (cond (e (cdr e))
          ((not (graphic-char-p c)) (concatenate 'string "U+" (%integer-to-string (char-code c) 16)))
          (t nil))))

(defun name-char (name)
  (let ((name (string name)))
    (dolist (e *char-names*
               (cond ((string-equal name "Linefeed") (code-char 10))
                     ((string-equal name "Null") (code-char 0))
                     ((string-equal name "Del") (code-char 127))
                     ((string-equal name "Esc") (code-char 27))
                     ((and (> (length name) 2) (char-equal (char name 0) #\U) (char= (char name 1) #\+))
                      (code-char (parse-integer name :start 2 :radix 16)))
                     (t nil)))
      (when (string-equal (cdr e) name) (return (code-char (car e)))))))

(defun character (x)
  (cond ((characterp x) x)
        ((and (stringp x) (= (length x) 1)) (char x 0))
        ((and (symbolp x) (= (length (symbol-name x)) 1)) (char (symbol-name x) 0))
        (t (%type-error x 'character))))

;;; ------------------------------------------------------------
;;; arrays
;;; ------------------------------------------------------------

(defun %simple-array-p (x)
  (or (%simple-vector-p x) (%simple-string-p x) (%bytes-p x) (%bits-p x) (%f64vec-p x)))

(defun arrayp (x) (or (%simple-array-p x) (%mdarray-p x)))
(defun simple-vector-p (x) (%simple-vector-p x))
(defun vectorp (x)
  (or (%simple-array-p x) (and (%mdarray-p x) (consp (%mdarray-dims x)) (null (cdr (%mdarray-dims x))))))
(defun stringp (x)
  (or (%simple-string-p x) (and (%mdarray-p x) (consp (%mdarray-dims x)) (null (cdr (%mdarray-dims x)))
                                (%simple-string-p (%array-storage x)))))
(defun simple-string-p (x) (%simple-string-p x))
(defun bit-vector-p (x)
  (or (%bits-p x) (and (%mdarray-p x) (consp (%mdarray-dims x)) (null (cdr (%mdarray-dims x))) (%bits-p (%array-storage x)))))
(defun simple-bit-vector-p (x) (%bits-p x))

(defun %array-storage (a)
  ;; the innermost simple storage of an array
  (if (%mdarray-p a) (%array-storage (%mdarray-data a)) a))

(defun %simple-length (v)
  (cond ((%simple-vector-p v) (%svlength v))
        ((%simple-string-p v) (%string-length v))
        ((%bytes-p v) (%bytes-length v))
        ((%bits-p v) (%bits-length v))
        ((%f64vec-p v) (%f64vec-length v))
        (t (%type-error v 'vector))))

(defun %simple-ref (v i)
  (cond ((%simple-vector-p v) (%svref v i))
        ((%simple-string-p v) (%schar v i))
        ((%bytes-p v) (%bytes-ref v i))
        ((%bits-p v) (%bits-ref v i))
        ((%f64vec-p v) (%f64vec-ref v i))
        (t (%type-error v 'array))))

(defun %simple-set (v i x)
  (cond ((%simple-vector-p v) (%set-svref v i x))
        ((%simple-string-p v) (%set-schar v i x))
        ((%bytes-p v) (%set-bytes-ref v i x))
        ((%bits-p v) (%set-bits-ref v i x))
        ((%f64vec-p v) (%set-f64vec-ref v i x))
        (t (%type-error v 'array))))

(defun %make-simple-array (n element-type initial-element initp)
  (let ((et (%normalize-element-type element-type)))
    (cond ((eq et 'character) (%make-string n (if initp initial-element (code-char 0))))
          ((eq et 'bit) (let ((v (%make-bits n))) (when (and initp (eql initial-element 1)) (dotimes (i n) (%set-bits-ref v i 1))) v))
          ((eq et '(unsigned-byte 8)) (let ((v (%make-bytes n))) (when (and initp (not (eql initial-element 0))) (dotimes (i n) (%set-bytes-ref v i initial-element))) v))
          ((eq et 'double-float) (let ((v (%make-f64vec n))) (when initp (dotimes (i n) (%set-f64vec-ref v i initial-element))) v))
          (t (%make-simple-vector n (if initp initial-element 0))))))

(defun %normalize-element-type (et)
  (cond ((member et '(character base-char standard-char extended-character)) 'character)
        ;; (array nil) is a subtype of STRING: store such arrays as strings
        ((null et) 'character)
        ((eq et 'bit) 'bit)
        ((and (consp et) (member (car et) '(unsigned-byte mod)) (integerp (cadr et))
              (<= (cadr et) (if (eq (car et) 'mod) 256 8)))
         (if (and (eq (car et) 'unsigned-byte) (= (cadr et) 1)) 'bit '(unsigned-byte 8)))
        ((eq et 'double-float) 'double-float)
        (t t)))

(defconstant array-rank-limit 8)
(defconstant array-dimension-limit 536870911)
(defconstant array-total-size-limit 536870911)

(defun make-array (dimensions &key (element-type t) (initial-element nil initp)
                                   (initial-contents nil contentsp) adjustable fill-pointer
                                   displaced-to (displaced-index-offset 0))
  (let* ((dims (if (listp dimensions) dimensions (list dimensions)))
         (total (let ((p 1)) (dolist (d dims p) (setq p (* p d)))))
         (et (%normalize-element-type element-type)))
    (when (eq et '(unsigned-byte 8)) (setq et '(unsigned-byte 8)))
    (cond
      (displaced-to
       (%make-mdarray displaced-to (if (eq fill-pointer t) (car dims) fill-pointer) dims
                      displaced-index-offset (cons et (cons adjustable t))))
      (t
       (let ((data (%make-simple-array total et (if initp initial-element
                                                    (cond ((eq et 'character) (code-char 0))
                                                          ((eq et t) nil) (t 0)))
                                       t)))
         (when contentsp (%fill-from-contents data dims initial-contents))
         (if (and (null adjustable) (null fill-pointer) (= (length-of-list dims) 1))
             data
             (%make-mdarray data (if (eq fill-pointer t) (car dims) fill-pointer) dims 0
                            (cons et (cons adjustable nil)))))))))

(defun %fill-from-contents (data dims contents)
  (let ((i 0))
    (labels ((walk (c ds)
               (if (null ds)
                   (progn (%simple-set data i c) (setq i (+ i 1)))
                   (map nil (lambda (x) (walk x (cdr ds))) c))))
      (walk contents dims))))

(defun %array-info-type (a) (car (%mdarray-info a)))
(defun adjustable-array-p (a) (and (%mdarray-p a) (not (null (cadr (%mdarray-info a))))))
(defun array-has-fill-pointer-p (a) (and (%mdarray-p a) (not (null (%mdarray-fill a)))))
(defun fill-pointer (a)
  (if (array-has-fill-pointer-p a) (%mdarray-fill a)
      (error 'type-error :datum a :expected-type '(and vector (satisfies array-has-fill-pointer-p)))))
(defun %set-fill-pointer (a n) (%set-mdarray-fill a n) n)
(defun %displaced-p (a) (cddr (%mdarray-info a)))

(defun array-dimensions (a)
  (if (%mdarray-p a) (copy-list (%mdarray-dims a)) (list (%simple-length a))))
(defun array-dimension (a axis)
  (if (%mdarray-p a) (nth axis (%mdarray-dims a)) (%simple-length a)))
(defun array-rank (a) (if (%mdarray-p a) (length-of-list (%mdarray-dims a)) 1))
(defun array-total-size (a)
  (if (%mdarray-p a) (let ((p 1)) (dolist (d (%mdarray-dims a) p) (setq p (* p d)))) (%simple-length a)))
(defun array-element-type (a)
  (let ((s (if (%mdarray-p a) (%array-info-type a) a)))
    (cond ((eq s 'character) 'character)
          ((eq s 'bit) 'bit)
          ((equal s '(unsigned-byte 8)) '(unsigned-byte 8))
          ((eq s 'double-float) 'double-float)
          ((%mdarray-p a) s)
          ((%simple-string-p a) 'character)
          ((%bits-p a) 'bit)
          ((%bytes-p a) '(unsigned-byte 8))
          ((%f64vec-p a) 'double-float)
          (t t))))
(defun array-displacement (a)
  (if (and (%mdarray-p a) (%displaced-p a))
      (values (%mdarray-data a) (%mdarray-offset a))
      (values nil 0)))

(defun row-major-aref (a i)
  (if (%mdarray-p a)
      (let ((d (%mdarray-data a)))
        (if (%mdarray-p d) (row-major-aref d (+ i (%mdarray-offset a)))
            (%simple-ref d (+ i (%mdarray-offset a)))))
      (%simple-ref a i)))
(defun %row-major-aset (a i v)
  (if (%mdarray-p a)
      (let ((d (%mdarray-data a)))
        (if (%mdarray-p d) (%row-major-aset d (+ i (%mdarray-offset a)) v)
            (%simple-set d (+ i (%mdarray-offset a)) v)))
      (%simple-set a i v)))

(defun array-row-major-index (a &rest subscripts)
  (if (%mdarray-p a)
      (let ((idx 0))
        (do ((d (%mdarray-dims a) (cdr d)) (s subscripts (cdr s))) ((null d) idx)
          (let ((sub (car s)))
            (unless (and (fixnump sub) (< -1 sub (car d)))
              (error "Index ~S out of bounds for array ~S" subscripts a))
            (setq idx (+ (* idx (car d)) sub)))))
      (let ((i (car subscripts)))
        (unless (and (fixnump i) (< -1 i (%simple-length a)))
          (error 'index-out-of-bounds :datum i :expected-type `(integer 0 (,(%simple-length a)))))
        i)))

(defun array-in-bounds-p (a &rest subscripts)
  (do ((d (array-dimensions a) (cdr d)) (s subscripts (cdr s))) ((null d) t)
    (unless (< -1 (car s) (car d)) (return nil))))

(defun %aref1-slow (a i)
  (cond ((%simple-vector-p a) (%svref a (%check-index a i (%svlength a))))
        ((%simple-string-p a) (%schar a (%check-index a i (%string-length a))))
        ((and (%mdarray-p a) (null (cdr (%mdarray-dims a))))
         (row-major-aref a (%check-index a i (car (%mdarray-dims a)))))
        ((%mdarray-p a) (aref a i))
        (t (%simple-ref a (%check-index a i (%simple-length a))))))

(defun %aset1-slow (a i v)
  (cond ((%simple-vector-p a) (%set-svref a (%check-index a i (%svlength a)) v))
        ((%simple-string-p a) (%set-schar a (%check-index a i (%string-length a)) v))
        ((and (%mdarray-p a) (null (cdr (%mdarray-dims a))))
         (%row-major-aset a (%check-index a i (car (%mdarray-dims a))) v))
        (t (%simple-set a (%check-index a i (%simple-length a)) v)))
  v)

(define-compiler-macro aref (&whole form a &rest subs)
  (if (and subs (null (cdr subs))) `(%aref1 ,a ,(car subs)) form))

(defun aref (a &rest subscripts)
  (if (and (%simple-vector-p a) subscripts (null (cdr subscripts)))
      (svref a (car subscripts))
      (row-major-aref a (apply #'array-row-major-index a subscripts))))
(defun %aset (a &rest subscripts-and-value)
  (let ((v (car (last subscripts-and-value)))
        (subs (butlast subscripts-and-value)))
    (%row-major-aset a (apply #'array-row-major-index a subs) v)
    v))

(defun %check-index (v i len)
  (unless (and (fixnump i) (< -1 i len))
    (error 'index-out-of-bounds :datum i :expected-type `(integer 0 (,len)) :sequence v))
  i)

(defun svref (v i)
  (unless (%simple-vector-p v) (%type-error v 'simple-vector))
  (%svref v (%check-index v i (%svlength v))))
(defun %aref1 (a i) (%aref1 a i))
(defun %aset1 (a i v) (%aset1 a i v))
(defun %svset (v i x)
  (unless (%simple-vector-p v) (%type-error v 'simple-vector))
  (%set-svref v (%check-index v i (%svlength v)) x))
(defun schar (s i)
  (unless (%simple-string-p s) (%type-error s 'simple-string))
  (%schar s (%check-index s i (%string-length s))))
(defun %scharset (s i c)
  (unless (%simple-string-p s) (%type-error s 'simple-string))
  (%set-schar s (%check-index s i (%string-length s)) c))
(defun char (s i)
  (if (%simple-string-p s) (%schar s (%check-index s i (%string-length s)))
      (row-major-aref s i)))
(defun %charset (s i c)
  (if (%simple-string-p s) (%set-schar s (%check-index s i (%string-length s)) c)
      (%row-major-aset s i c)))
(defun bit (a &rest subs) (apply #'aref a subs))
(defun sbit (a &rest subs) (apply #'aref a subs))

(defun vector (&rest items)
  (let ((v (%make-simple-vector (length-of-list items) nil)) (i 0))
    (dolist (x items v) (%set-svref v i x) (setq i (+ i 1)))))

(defun vector-push (x v)
  (let ((fp (fill-pointer v)))
    (if (< fp (array-dimension v 0))
        (progn (%row-major-aset v fp x) (%set-mdarray-fill v (+ fp 1)) fp)
        nil)))

(defun vector-push-extend (x v &optional (extension 16))
  (let ((fp (fill-pointer v)))
    (when (>= fp (array-dimension v 0))
      (%adjust-vector-storage v (+ fp (max extension fp 4))))
    (%row-major-aset v fp x)
    (%set-mdarray-fill v (+ fp 1))
    fp))

(defun vector-pop (v)
  (let ((fp (fill-pointer v)))
    (when (= fp 0) (error "VECTOR-POP: empty vector ~S" v))
    (%set-mdarray-fill v (- fp 1))
    (row-major-aref v (- fp 1))))

(defun %adjust-vector-storage (v new-size)
  (let* ((old (%mdarray-data v))
         (et (%array-info-type v))
         (new (%make-simple-array new-size et nil nil))
         (n (min new-size (array-total-size v))))
    (dotimes (i n) (%simple-set new i (row-major-aref v i)))
    (%set-mdarray-data v new)
    (%set-mdarray-offset v 0)
    (%set-mdarray-dims v (list new-size))
    (%set-mdarray-info v (cons et (cons (cadr (%mdarray-info v)) nil)))
    v))

(defun adjust-array (a new-dims &key (element-type nil) (initial-element nil initp)
                                     (initial-contents nil contentsp) (fill-pointer nil fpp)
                                     displaced-to displaced-index-offset)
  (declare (ignore element-type displaced-index-offset))
  (let* ((dims (if (listp new-dims) new-dims (list new-dims)))
         (et (array-element-type a))
         (new (make-array dims :element-type et
                               :initial-element (if initp initial-element
                                                    (cond ((eq et 'character) (code-char 0)) ((eq et t) nil) (t 0))))))
    (cond (displaced-to (setq new (make-array dims :element-type et :displaced-to displaced-to)))
          (contentsp (%fill-from-contents (%array-storage new) dims initial-contents))
          ((= (length-of-list dims) 1)
           (dotimes (i (min (car dims) (array-total-size a)))
             (%row-major-aset new i (row-major-aref a i))))
          (t ;; copy common subscripts
           (labels ((walk (prefix ds olds)
                      (if (null ds)
                          (%row-major-aset new (apply #'array-row-major-index new prefix)
                                           (row-major-aref a (apply #'array-row-major-index a prefix)))
                          (dotimes (i (min (car ds) (car olds)))
                            (walk (append prefix (list i)) (cdr ds) (cdr olds))))))
             (walk nil dims (array-dimensions a)))))
    (if (%mdarray-p a)
        (let ((src (if (%mdarray-p new) new (%make-mdarray new nil dims 0 (cons et (cons t nil))))))
          (%set-mdarray-data a (%mdarray-data src))
          (%set-mdarray-dims a (%mdarray-dims src))
          (%set-mdarray-offset a (%mdarray-offset src))
          (%set-mdarray-info a (cons (%normalize-element-type et) (cons t (%displaced-p src))))
          (when fpp (%set-mdarray-fill a (if (eq fill-pointer t) (car dims) fill-pointer)))
          (when (and (%mdarray-fill a) (> (%mdarray-fill a) (car dims)))
            (%set-mdarray-fill a (car dims)))
          a)
        (if fpp
            (%make-mdarray (%array-storage new) (if (eq fill-pointer t) (car dims) fill-pointer) dims 0
                           (cons (%normalize-element-type et) (cons t nil)))
            new))))

;;; ------------------------------------------------------------
;;; sequences: generic accessors
;;; ------------------------------------------------------------

(defun length (seq)
  (cond ((listp seq) (length-of-list seq))
        ((%simple-string-p seq) (%string-length seq))
        ((%simple-vector-p seq) (%svlength seq))
        ((%mdarray-p seq) (or (%mdarray-fill seq) (car (%mdarray-dims seq))))
        ((%simple-array-p seq) (%simple-length seq))
        (t (%type-error seq 'sequence))))

(defun sequencep (x) (or (listp x) (vectorp x)))

(defun elt (seq i)
  (if (listp seq)
      (let ((l (nthcdr i seq)))
        (if (consp l) (car l) (error 'index-out-of-bounds :datum i :expected-type 'index :sequence seq)))
      (progn (%check-index seq i (length seq)) (row-major-aref seq i))))
(defun %setelt (seq i v)
  (if (listp seq) (%setcar (nthcdr i seq) v)
      (progn (%check-index seq i (length seq)) (%row-major-aset seq i v))))

(defun %vector-like (seq n)
  "A fresh simple vector of the same kind as SEQ with N elements."
  (let ((s (if (%mdarray-p seq) (%array-storage seq) seq)))
    (cond ((%simple-string-p s) (%make-string n (code-char 0)))
          ((%bits-p s) (%make-bits n))
          ((%bytes-p s) (%make-bytes n))
          ((%f64vec-p s) (%make-f64vec n))
          (t (%make-simple-vector n nil)))))

(defun %list-to-vector-like (list proto)
  (let* ((n (length-of-list list)) (v (%vector-like proto n)) (i 0))
    (dolist (x list v) (%simple-set v i x) (setq i (+ i 1)))))

(defun subseq (seq start &optional end)
  (if (listp seq)
      (let ((l (nthcdr start seq)))
        (if end
            (let ((r nil)) (dotimes (i (- end start) (nreverse-list r))
                             (when (atom l) (error "SUBSEQ: end ~S out of bounds" end))
                             (push (car l) r) (setq l (cdr l))))
            (copy-list l)))
      (let* ((len (length seq)) (end (or end len)))
        (unless (<= 0 start end len) (error "SUBSEQ: bad bounds ~S ~S for length ~S" start end len))
        (let ((v (%vector-like seq (- end start))))
          (if (and (%simple-string-p seq) (%simple-string-p v))
              (dotimes (i (- end start) v) (%set-schar v i (%schar seq (+ start i))))
              (dotimes (i (- end start) v) (%simple-set v i (row-major-aref seq (+ start i)))))))))

(defun %set-subseq (seq start &rest rest)
  (let ((new (car (last rest))) (end (if (cdr rest) (car rest) nil)))
    (replace seq new :start1 start :end1 end)
    new))

(defun copy-seq (seq) (if (listp seq) (copy-list seq) (subseq seq 0)))

(defun reverse (seq)
  (if (listp seq) (reverse-list seq)
      (let* ((n (length seq)) (v (%vector-like seq n)))
        (dotimes (i n v) (%simple-set v i (row-major-aref seq (- n i 1)))))))

(defun nreverse (seq)
  (if (listp seq) (nreverse-list seq)
      (let ((n (length seq)))
        (dotimes (i (floor n 2) seq)
          (let ((tmp (row-major-aref seq i)))
            (%row-major-aset seq i (row-major-aref seq (- n i 1)))
            (%row-major-aset seq (- n i 1) tmp))))))

(defun %seq-to-list (seq &optional (start 0) end)
  (if (listp seq)
      (if (or (> start 0) end) (subseq seq start end) seq)
      (let ((r nil) (end (or end (length seq))))
        (do ((i (- end 1) (- i 1))) ((< i start) r) (push (row-major-aref seq i) r)))))

(defun %list-to-seq-like (list proto)
  (if (listp proto) list (%list-to-vector-like list proto)))

(defun make-sequence (type size &key (initial-element nil initp))
  (let ((ty (if (consp type) (car type) type)))
    (cond ((member ty '(list cons null)) (make-list size :initial-element initial-element))
          ((member ty '(string simple-string base-string simple-base-string))
           (make-string size :initial-element (if initp initial-element (code-char 32))))
          ((member ty '(bit-vector simple-bit-vector)) (make-array size :element-type 'bit :initial-element (if initp initial-element 0)))
          ((and (member ty '(vector simple-array array)) (consp type) (cadr type) (not (eq (cadr type) '*)))
           (make-array size :element-type (cadr type) :initial-element initial-element))
          (t (make-array size :initial-element initial-element)))))

(defun concatenate (result-type &rest seqs)
  (let ((ty (if (consp result-type) (car result-type) result-type)))
    (if (member ty '(list cons null))
        (let ((r nil)) (dolist (s seqs (nreverse-list r))
                         (if (listp s) (dolist (x s) (push x r))
                             (dotimes (i (length s)) (push (row-major-aref s i) r)))))
        (let* ((total (let ((n 0)) (dolist (s seqs n) (setq n (+ n (length s))))))
               (v (make-sequence result-type total))
               (i 0))
          (dolist (s seqs v)
            (if (listp s)
                (dolist (x s) (%row-major-aset v i x) (setq i (+ i 1)))
                (dotimes (j (length s)) (%row-major-aset v i (row-major-aref s j)) (setq i (+ i 1)))))))))

(defun map (result-type f seq &rest more)
  (let* ((seqs (cons seq more))
         (n (let ((m nil)) (dolist (s seqs m) (let ((l (length s))) (when (or (null m) (< l m)) (setq m l))))))
         (results nil))
    (dotimes (i n)
      (let ((v (apply f (mapcar (lambda (s) (elt s i)) seqs))))
        (when result-type (push v results))))
    (if result-type
        (coerce (nreverse-list results) result-type)
        nil)))

(defun map-into (result f &rest seqs)
  (let ((n (length result)))
    (dolist (s seqs) (setq n (min n (length s))))
    (dotimes (i n result)
      (%setelt result i (apply f (mapcar (lambda (s) (elt s i)) seqs))))))

(defun %apply-key (key x) (if key (funcall key x) x))

(defun reduce (f seq &key key from-end (start 0) end (initial-value nil ivp))
  (let ((l (%seq-to-list seq start end)))
    (when key (setq l (mapcar key l)))
    (when from-end (setq l (reverse-list l)))
    (cond ((null l) (if ivp initial-value (funcall f)))
          (t (let ((acc (if ivp initial-value (car l)))
                   (rest (if ivp l (cdr l))))
               (dolist (x rest acc)
                 (setq acc (if from-end (funcall f x acc) (funcall f acc x)))))))))

(defun fill (seq item &key (start 0) end)
  (if (listp seq)
      (let ((l (nthcdr start seq)))
        (do ((i start (+ i 1)) (x l (cdr x))) ((or (atom x) (and end (>= i end))) seq)
          (%setcar x item)))
      (let ((end (or end (length seq))))
        (do ((i start (+ i 1))) ((>= i end) seq) (%row-major-aset seq i item)))))

(defun replace (seq1 seq2 &key (start1 0) end1 (start2 0) end2)
  (let* ((end1 (or end1 (length seq1))) (end2 (or end2 (length seq2)))
         (n (min (- end1 start1) (- end2 start2))))
    (if (and (eq seq1 seq2) (> start1 start2))
        (do ((i (- n 1) (- i 1))) ((< i 0))
          (%setelt seq1 (+ start1 i) (elt seq2 (+ start2 i))))
        (if (and (listp seq1) (listp seq2))
            (let ((a (nthcdr start1 seq1)) (b (nthcdr start2 seq2)))
              (dotimes (i n) (%setcar a (car b)) (setq a (cdr a) b (cdr b))))
            (let ((src (if (listp seq2) (%seq-to-list seq2 start2 end2) nil)))
              (dotimes (i n)
                (%setelt seq1 (+ start1 i)
                         (if (listp seq2) (pop src) (row-major-aref seq2 (+ start2 i))))))))
    seq1))

;;; searching
(defun %seq-test (test test-not)
  (cond (test test) (test-not (lambda (a b) (not (funcall test-not a b)))) (t #'eql)))

(defun find-if (pred seq &key key from-end (start 0) end)
  (let ((pos (position-if pred seq :key key :from-end from-end :start start :end end)))
    (if pos (elt seq pos) nil)))
(defun find-if-not (pred seq &rest keys) (apply #'find-if (complement pred) seq keys))
(defun find (item seq &key key test test-not from-end (start 0) end)
  (if (and (listp seq) (null key) (null test) (null test-not) (null from-end) (eql start 0) (null end))
      (dolist (x seq nil) (when (eql item x) (return x)))
      (let ((tf (%seq-test test test-not)))
        (find-if (lambda (x) (funcall tf item x)) seq :key key :from-end from-end :start start :end end))))

(defun position-if (pred seq &key key from-end (start 0) end)
  (if (listp seq)
      (let ((result nil) (i 0))
        (dolist (x seq result)
          (when (and end (>= i end)) (return result))
          (when (and (>= i start) (funcall pred (%apply-key key x)))
            (if from-end (setq result i) (return i)))
          (setq i (+ i 1))))
      (let ((end (or end (length seq))))
        (if from-end
            (do ((i (- end 1) (- i 1))) ((< i start) nil)
              (when (funcall pred (%apply-key key (row-major-aref seq i))) (return i)))
            (do ((i start (+ i 1))) ((>= i end) nil)
              (when (funcall pred (%apply-key key (row-major-aref seq i))) (return i)))))))
(defun position-if-not (pred seq &rest keys) (apply #'position-if (complement pred) seq keys))
(defun position (item seq &key key test test-not from-end (start 0) end)
  (let ((tf (%seq-test test test-not)))
    (position-if (lambda (x) (funcall tf item x)) seq :key key :from-end from-end :start start :end end)))

(defun count-if (pred seq &key key from-end (start 0) end)
  (declare (ignore from-end))
  (let ((n 0))
    (dolist (x (%seq-to-list seq start end) n)
      (when (funcall pred (%apply-key key x)) (setq n (+ n 1))))))
(defun count-if-not (pred seq &rest keys) (apply #'count-if (complement pred) seq keys))
(defun count (item seq &key key test test-not from-end (start 0) end)
  (let ((tf (%seq-test test test-not)))
    (count-if (lambda (x) (funcall tf item x)) seq :key key :from-end from-end :start start :end end)))

(defun remove-if (pred seq &key key from-end (start 0) end count)
  (let ((result nil) (i 0) (removed 0)
        (items (if (and from-end count) (reverse (%seq-to-list seq)) (%seq-to-list seq)))
        (len (length seq)))
    (dolist (x items)
      (let ((idx (if (and from-end count) (- len i 1) i)))
        (if (and (>= idx start) (or (null end) (< idx end))
                 (or (null count) (< removed count))
                 (funcall pred (%apply-key key x)))
            (setq removed (+ removed 1))
            (push x result)))
      (setq i (+ i 1)))
    (%list-to-seq-like (if (and from-end count) result (nreverse-list result)) seq)))
(defun remove-if-not (pred seq &rest keys) (apply #'remove-if (complement pred) seq keys))
(defun remove (item seq &key key test test-not from-end (start 0) end count)
  (let ((tf (%seq-test test test-not)))
    (remove-if (lambda (x) (funcall tf item x)) seq :key key :from-end from-end :start start :end end :count count)))
(defun delete-if (pred seq &rest keys) (apply #'remove-if pred seq keys))
(defun delete-if-not (pred seq &rest keys) (apply #'remove-if-not pred seq keys))
(defun delete (item seq &rest keys) (apply #'remove item seq keys))

(defun remove-duplicates (seq &key key test test-not from-end (start 0) end)
  (let* ((tf (%seq-test test test-not))
         (l (%seq-to-list seq))
         (result nil) (i 0))
    (if from-end
        (dolist (x l)
          (if (and (>= i start) (or (null end) (< i end))
                   (member (%apply-key key x) result :test tf :key (lambda (y) (%apply-key key y))))
              nil
              (push x result))
          (setq i (+ i 1)))
        (do ((rest l (cdr rest))) ((null rest))
          (let ((x (car rest)))
            (unless (and (>= i start) (or (null end) (< i end))
                         (member (%apply-key key x) (cdr rest) :test tf
                                 :key (lambda (y) (%apply-key key y))))
              (push x result)))
          (setq i (+ i 1))))
    (%list-to-seq-like (nreverse-list result) seq)))
(defun delete-duplicates (seq &rest keys) (apply #'remove-duplicates seq keys))

(defun substitute-if (new pred seq &key key from-end (start 0) end count)
  (declare (ignore from-end))
  (let ((n 0) (i 0))
    (%list-to-seq-like
     (mapcar (lambda (x)
               (prog1 (if (and (>= i start) (or (null end) (< i end)) (or (null count) (< n count))
                               (funcall pred (%apply-key key x)))
                          (progn (setq n (+ n 1)) new)
                          x)
                 (setq i (+ i 1))))
             (%seq-to-list seq))
     seq)))
(defun substitute-if-not (new pred seq &rest keys) (apply #'substitute-if new (complement pred) seq keys))
(defun substitute (new old seq &key key test test-not from-end (start 0) end count)
  (let ((tf (%seq-test test test-not)))
    (substitute-if new (lambda (x) (funcall tf old x)) seq :key key :from-end from-end :start start :end end :count count)))
(defun nsubstitute (new old seq &rest keys)
  (let ((r (apply #'substitute new old seq keys)))
    (if (listp seq) r (replace seq r))))
(defun nsubstitute-if (new pred seq &rest keys)
  (let ((r (apply #'substitute-if new pred seq keys))) (if (listp seq) r (replace seq r))))
(defun nsubstitute-if-not (new pred seq &rest keys)
  (let ((r (apply #'substitute-if-not new pred seq keys))) (if (listp seq) r (replace seq r))))

(defun mismatch (s1 s2 &key key test test-not from-end (start1 0) end1 (start2 0) end2)
  (let* ((tf (%seq-test test test-not))
         (end1 (or end1 (length s1))) (end2 (or end2 (length s2))))
    (if from-end
        (do ((i (- end1 1) (- i 1)) (j (- end2 1) (- j 1)))
            ((or (< i start1) (< j start2))
             (if (and (< i start1) (< j start2)) nil (+ i 1)))
          (unless (funcall tf (%apply-key key (elt s1 i)) (%apply-key key (elt s2 j)))
            (return (+ i 1))))
        (do ((i start1 (+ i 1)) (j start2 (+ j 1)))
            ((or (>= i end1) (>= j end2))
             (if (and (>= i end1) (>= j end2)) nil i))
          (unless (funcall tf (%apply-key key (elt s1 i)) (%apply-key key (elt s2 j)))
            (return i))))))

(defun search (s1 s2 &key key test test-not from-end (start1 0) end1 (start2 0) end2)
  (let* ((tf (%seq-test test test-not))
         (end1 (or end1 (length s1))) (end2 (or end2 (length s2)))
         (n (- end1 start1)) (result nil))
    (do ((i start2 (+ i 1))) ((> (+ i n) end2) result)
      (when (do ((k 0 (+ k 1))) ((>= k n) t)
              (unless (funcall tf (%apply-key key (elt s1 (+ start1 k))) (%apply-key key (elt s2 (+ i k))))
                (return nil)))
        (if from-end (setq result i) (return i))))))

(defun every (pred seq &rest more)
  (if (and (null more) (listp seq))
      (dolist (x seq t) (unless (funcall pred x) (return nil)))
      (let ((n (apply #'min (length seq) (mapcar #'length more))))
        (dotimes (i n t)
          (unless (apply pred (elt seq i) (mapcar (lambda (s) (elt s i)) more)) (return nil))))))
(defun some (pred seq &rest more)
  (if (and (null more) (listp seq))
      (dolist (x seq nil) (let ((v (funcall pred x))) (when v (return v))))
      (let ((n (apply #'min (length seq) (mapcar #'length more))))
        (dotimes (i n nil)
          (let ((v (apply pred (elt seq i) (mapcar (lambda (s) (elt s i)) more)))) (when v (return v)))))))
(defun notany (pred seq &rest more) (not (apply #'some pred seq more)))
(defun notevery (pred seq &rest more) (not (apply #'every pred seq more)))

;;; sorting (merge sort on lists)
(defun %merge-lists (a b pred key)
  (let* ((head (cons nil nil)) (tail head))
    (do () ((or (null a) (null b)))
      (if (funcall pred (%apply-key key (car b)) (%apply-key key (car a)))
          (progn (%setcdr tail b) (setq tail b b (cdr b)))
          (progn (%setcdr tail a) (setq tail a a (cdr a)))))
    (%setcdr tail (if a a b))
    (cdr head)))

(defun %sort-list (l pred key)
  (let ((n (length-of-list l)))
    (if (< n 2) l
        (let* ((mid (nthcdr (- (floor n 2) 1) l)) (b (cdr mid)))
          (%setcdr mid nil)
          (%merge-lists (%sort-list l pred key) (%sort-list b pred key) pred key)))))

(defun sort (seq pred &key key)
  (if (listp seq)
      (%sort-list seq pred key)
      (let ((sorted (%sort-list (%seq-to-list seq) pred key)) (i 0))
        (dolist (x sorted seq) (%row-major-aset seq i x) (setq i (+ i 1))))))
(defun stable-sort (seq pred &key key) (sort seq pred :key key))

(defun merge (result-type s1 s2 pred &key key)
  (coerce (%merge-lists (copy-list (%seq-to-list s1)) (copy-list (%seq-to-list s2)) pred key) result-type))

;;; ------------------------------------------------------------
;;; strings
;;; ------------------------------------------------------------

(defun make-string (n &key (initial-element (code-char 32)) element-type)
  (declare (ignore element-type))
  (%make-string n initial-element))

(defun %copy-simple-string (s)
  (let* ((n (length s)) (r (%make-string n #\Space)))
    (dotimes (i n r) (%set-schar r i (char s i)))))

(defun %string-hash (s)
  ;; FNV-1a 32 bit, reduced to 29 bits (must match the compiler)
  (let ((h1 #x811C) (h0 #x9DC5))
    ;; represent the 32-bit hash as two 16-bit halves to stay in fixnum range
    (dotimes (i (length s))
      (let ((c (char-code (char s i))))
        (setq h0 (%fxlogxor h0 (%fxlogand c #xFFFF)))
        (setq h1 (%fxlogxor h1 (%fxash-right c 16)))
        ;; multiply (h1:h0) by 16777619 = 0x01000193 mod 2^32
        (let* ((lo (%fx* h0 #x193))
               (hi (%fx+ (%fx+ (%fx* h1 #x193) (%fxash-left (%fxlogand h0 #xFF) 8)) (%fxash-right lo 16))))
          (setq h0 (%fxlogand lo #xFFFF))
          (setq h1 (%fxlogand hi #xFFFF)))))
    (%fxlogior (%fxash-left (%fxlogand h1 #x1FFF) 16) h0)))

(defun string (x)
  (cond ((stringp x) x)
        ((symbolp x) (symbol-name x))
        ((characterp x) (%make-string 1 x))
        (t (%type-error x 'string-designator))))

(defun %string-bounds (s start end)
  (let ((len (length s)))
    (values (or start 0) (or end len))))

(defun %string-compare (s1 s2 start1 end1 start2 end2 ci)
  "Returns (values index-of-mismatch result) where result is :lt :eq :gt"
  (let ((s1 (string s1)) (s2 (string s2)))
    (multiple-value-bind (b1 e1) (%string-bounds s1 start1 end1)
      (multiple-value-bind (b2 e2) (%string-bounds s2 start2 end2)
        (do ((i b1 (+ i 1)) (j b2 (+ j 1)))
            ((or (>= i e1) (>= j e2))
             (values i (cond ((and (>= i e1) (>= j e2)) :eq) ((>= i e1) :lt) (t :gt))))
          (let ((c1 (char s1 i)) (c2 (char s2 j)))
            (when ci (setq c1 (char-upcase c1) c2 (char-upcase c2)))
            (unless (char= c1 c2)
              (return (values i (if (char< c1 c2) :lt :gt))))))))))

(defun string= (s1 s2 &key (start1 0) end1 (start2 0) end2)
  (eq (nth-value 1 (%string-compare s1 s2 start1 end1 start2 end2 nil)) :eq))
(defun string-equal (s1 s2 &key (start1 0) end1 (start2 0) end2)
  (eq (nth-value 1 (%string-compare s1 s2 start1 end1 start2 end2 t)) :eq))
(macrolet ((def (name ci results)
             `(defun ,name (s1 s2 &key (start1 0) end1 (start2 0) end2)
                (multiple-value-bind (i r) (%string-compare s1 s2 start1 end1 start2 end2 ,ci)
                  (if (member r ',results) i nil)))))
  (def string< nil (:lt)) (def string> nil (:gt)) (def string<= nil (:lt :eq)) (def string>= nil (:gt :eq))
  (def string/= nil (:lt :gt))
  (def string-lessp t (:lt)) (def string-greaterp t (:gt)) (def string-not-greaterp t (:lt :eq))
  (def string-not-lessp t (:gt :eq)) (def string-not-equal t (:lt :gt)))

(defun %string-case (s start end fn)
  (let* ((s (string s)) (r (%copy-simple-string s)) (end (or end (length r))))
    (do ((i start (+ i 1))) ((>= i end) r) (%set-schar r i (funcall fn (%schar r i))))))
(defun string-upcase (s &key (start 0) end) (%string-case s start end #'char-upcase))
(defun string-downcase (s &key (start 0) end) (%string-case s start end #'char-downcase))
(defun string-capitalize (s &key (start 0) end)
  (let* ((r (%copy-simple-string (string s))) (end (or end (length r))) (in-word nil))
    (do ((i start (+ i 1))) ((>= i end) r)
      (let ((c (%schar r i)))
        (if (alphanumericp c)
            (progn (%set-schar r i (if in-word (char-downcase c) (char-upcase c))) (setq in-word t))
            (setq in-word nil))))))
(defun nstring-upcase (s &key (start 0) end) (replace s (string-upcase s :start start :end end)))
(defun nstring-downcase (s &key (start 0) end) (replace s (string-downcase s :start start :end end)))
(defun nstring-capitalize (s &key (start 0) end) (replace s (string-capitalize s :start start :end end)))

(defun string-left-trim (bag s)
  (let* ((s (string s)) (n (length s)) (i 0))
    (do () ((or (>= i n) (not (find (char s i) bag)))) (setq i (+ i 1)))
    (subseq s i)))
(defun string-right-trim (bag s)
  (let* ((s (string s)) (n (length s)))
    (do () ((or (<= n 0) (not (find (char s (- n 1)) bag)))) (setq n (- n 1)))
    (subseq s 0 n)))
(defun string-trim (bag s) (string-right-trim bag (string-left-trim bag s)))

;;; ------------------------------------------------------------
;;; coerce
;;; ------------------------------------------------------------

(defun coerce (x type)
  (let ((ty (if (consp type) (car type) type)))
    (cond ((eq type t) x)
          ((member ty '(list cons))
           (if (listp x) x (%seq-to-list x)))
          ((member ty '(vector simple-vector array simple-array))
           (if (and (vectorp x) (or (not (eq ty 'simple-vector)) (%simple-vector-p x))
                    (or (not (consp type)) (member (cadr type) '(* t)) (null (cdr type))
                        (equal (array-element-type x) (%normalize-element-type (cadr type)))))
               x
               (let* ((l (%seq-to-list x))
                      (et (if (and (consp type) (cdr type) (not (eq (cadr type) '*))) (cadr type) t))
                      (v (make-array (length-of-list l) :element-type et)) (i 0))
                 (dolist (e l v) (%row-major-aset v i e) (setq i (+ i 1))))))
          ((member ty '(string simple-string base-string simple-base-string))
           (if (stringp x) x
               (let* ((l (%seq-to-list x)) (v (%make-string (length-of-list l) #\Space)) (i 0))
                 (dolist (e l v) (%set-schar v i e) (setq i (+ i 1))))))
          ((member ty '(bit-vector simple-bit-vector))
           (if (bit-vector-p x) x
               (let* ((l (%seq-to-list x)) (v (%make-bits (length-of-list l))) (i 0))
                 (dolist (e l v) (%set-bits-ref v i e) (setq i (+ i 1))))))
          ((eq ty 'character) (character x))
          ((member ty '(float single-float short-float)) (%to-single x))
          ((member ty '(double-float long-float)) (%to-double x))
          ((eq ty 'complex) (if (complexp x) x (complex x 0)))
          ((eq ty 'function) (if (functionp x) x (fdefinition x)))
          ((typep x type) x)
          (t (error 'simple-type-error :datum x :expected-type type
                                       :format-control "Cannot coerce ~S to ~S"
                                       :format-arguments (list x type))))))

;;; setf functions, for (setf (apply #'aref ...)) and #'(setf aref)
(defun (setf aref) (value array &rest subscripts) (apply #'%aset array (append subscripts (list value))))
(defun (setf bit) (value array &rest subscripts) (apply #'%aset array (append subscripts (list value))))
(defun (setf sbit) (value array &rest subscripts) (apply #'%aset array (append subscripts (list value))))
(defun (setf char) (value string index) (%charset string index value))
(defun (setf schar) (value string index) (%scharset string index value))
(defun (setf svref) (value vector index) (%svset vector index value))
(defun (setf elt) (value seq index) (%setelt seq index value))
