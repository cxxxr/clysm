;;;; seq.lisp — characters, arrays, strings, sequences

;;; ------------------------------------------------------------
;;; characters
;;; ------------------------------------------------------------

(defconstant char-code-limit 1114112)

(defun %check-char (c) (if (characterp c) c (%type-error c 'character)))

(defun char-int (c) (char-code c))
(defun char-upcase (c)
  (let ((n (char-code c)))
    (if (or (<= 97 n 122) (<= 224 n 254 ) (<= 945 n 969) (<= 1072 n 1103))
        (if (or (= n 247)) c (code-char (- n (if (<= 1072 n 1103) 32 32))))
        c)))
(defun char-downcase (c)
  (let ((n (char-code c)))
    (if (or (<= 65 n 90) (<= 192 n 222) (<= 913 n 937) (<= 1040 n 1071))
        (if (= n 215) c (code-char (+ n 32)))
        c)))
(defun upper-case-p (c) (let ((n (char-code c))) (and (not (eql (char-downcase c) c)) (> n 0))))
(defun lower-case-p (c) (let ((n (char-code c))) (and (not (eql (char-upcase c) c)) (> n 0))))
(defun both-case-p (c) (or (upper-case-p c) (lower-case-p c)))
(defun alpha-char-p (c)
  (let ((n (char-code c)))
    (or (<= 65 n 90) (<= 97 n 122) (and (>= n 170) (both-case-p c))
        (<= #x3040 n #x30FF) (<= #x4E00 n #x9FFF))))
(defun digit-char-p (c &optional (radix 10))
  (let* ((n (char-code c))
         (d (cond ((<= 48 n 57) (- n 48))
                  ((<= 65 n 90) (- n 55))
                  ((<= 97 n 122) (- n 87))
                  (t nil))))
    (if (and d (< d radix)) d nil)))
(defun alphanumericp (c) (or (alpha-char-p c) (not (null (digit-char-p c)))))
(defun graphic-char-p (c) (let ((n (char-code c))) (or (<= 32 n 126) (> n 159))))
(defun standard-char-p (c) (let ((n (char-code c))) (or (<= 32 n 126) (= n 10))))
(defun digit-char (weight &optional (radix 10))
  (if (and (>= weight 0) (< weight radix)) (%digit-char weight) nil))

(defun %char-compare (chars fn)
  (do ((l chars (cdr l))) ((null (cdr l)) t)
    (unless (funcall fn (char-code (car l)) (char-code (cadr l))) (return nil))))
(defun %char-ci-compare (chars fn)
  (do ((l chars (cdr l))) ((null (cdr l)) t)
    (unless (funcall fn (char-code (char-upcase (car l))) (char-code (char-upcase (cadr l)))) (return nil))))
(defun char= (c &rest more) (if (and more (null (cdr more))) (char= c (car more)) (%char-compare (cons c more) #'=)))
(defun char< (c &rest more) (%char-compare (cons c more) #'<))
(defun char> (c &rest more) (%char-compare (cons c more) #'>))
(defun char<= (c &rest more) (%char-compare (cons c more) #'<=))
(defun char>= (c &rest more) (%char-compare (cons c more) #'>=))
(defun char/= (c &rest more)
  (do ((l (cons c more) (cdr l))) ((null l) t)
    (when (member (car l) (cdr l)) (return nil))))
(defun char-equal (c &rest more) (%char-ci-compare (cons c more) #'=))
(defun char-lessp (c &rest more) (%char-ci-compare (cons c more) #'<))
(defun char-greaterp (c &rest more) (%char-ci-compare (cons c more) #'>))
(defun char-not-greaterp (c &rest more) (%char-ci-compare (cons c more) #'<=))
(defun char-not-lessp (c &rest more) (%char-ci-compare (cons c more) #'>=))
(defun char-not-equal (c &rest more)
  (do ((l (cons c more) (cdr l))) ((null l) t)
    (when (member (car l) (cdr l) :test #'char-equal) (return nil))))

