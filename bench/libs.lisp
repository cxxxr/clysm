;;; Benchmarks with real libraries, loaded from Quicklisp (~/quicklisp) by
;;; ASDF on both implementations: tools/bench-libs.sh.  Only the work is
;;; timed, not loading and compiling the libraries.
#+sbcl (load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
#+clysm (require :quicklisp)
(let ((*standard-output* (make-broadcast-stream)) (*error-output* (make-broadcast-stream)))
  (ql:quickload '(:cl-ppcre :alexandria :alexandria/tests :split-sequence :babel) :silent t))

(defun run-bench (name reps fn)
  (funcall fn)
  (let ((start (get-internal-real-time)) (r nil))
    (dotimes (i reps) (setq r (funcall fn)))
    (let ((ms (round (* 1000 (- (get-internal-real-time) start)) internal-time-units-per-second)))
      (format t "~(~A~) ~D ~A~%" name ms
              (let ((s (prin1-to-string r))) (if (> (length s) 40) (subseq s 0 40) s))))))
(defmacro defbench (name (&optional (reps 1)) &body body)
  `(progn (defun ,name () ,@body) (run-bench ',name ,reps #',name)))

(defparameter *text*
  (with-output-to-string (o)
    (dotimes (i 3000)
      (format o "On ~D-~2,'0D-~2,'0D user~D@example~D.org was running, jumping and singing ~D times; cost: $~D.~2,'0D~%"
              (+ 1990 (mod i 40)) (1+ (mod i 12)) (1+ (mod i 28)) i (mod i 7) (mod (* i 37) 100)
              (mod (* i 13) 1000) (mod i 100)))))

;;; cl-ppcre: scanning, register groups, replacing, splitting
(defbench l-ppcre-scan (5)
  (+ (length (ppcre:all-matches-as-strings "\\b[a-z]+ing\\b" *text*))
     (ppcre:count-matches "\\d{4}-\\d{2}-\\d{2}" *text*)
     (ppcre:count-matches "[a-z0-9]+@[a-z0-9]+\\.org" *text*)
     (let ((n 0))
       (ppcre:do-register-groups ((#'parse-integer dollars cents)) ("\\$(\\d+)\\.(\\d\\d)" *text*)
         (incf n (+ (* 100 dollars) cents)))
       n)))
(defbench l-ppcre-replace (5)
  (+ (length (ppcre:regex-replace-all "(\\w+)@(\\w+)\\.org" *text* "\\2:\\1"))
     (length (ppcre:split "\\s*[,;:]\\s*" *text*))
     (length (ppcre:regex-replace-all "(?i)\\bRUNNING\\b|\\bjumping\\b" *text* "moving"))))

;;; Alexandria: its own test suite, and a mix of its utilities
(defbench l-alexandria-tests (3)
  (let ((*standard-output* (make-broadcast-stream)))
    (#+sbcl sb-rt:do-tests #-sbcl rt:do-tests)))
(defbench l-alexandria-utils (100)
  (let ((n 0) (h (make-hash-table)))
    (dotimes (i 2000) (setf (gethash i h) (* i i)))
    (dotimes (k 20)
      (incf n (length (alexandria:flatten (list 1 (list 2 (list 3 (alexandria:iota 50))) (list 4 5)))))
      (incf n (length (alexandria:hash-table-alist h)))
      (incf n (length (alexandria:hash-table-keys h)))
      (alexandria:map-iota (lambda (i) (incf n (* 2 i))) 100)
      (incf n (round (alexandria:mean (alexandria:iota 200))))
      (incf n (alexandria:median (alexandria:iota 201)))
      (incf n (length (alexandria:remove-from-plist (list :a 1 :b 2 :c 3 :d 4) :b :d)))
      (incf n (length (alexandria:rotate (alexandria:iota 300) 7)))
      (incf n (funcall (alexandria:compose #'1+ (alexandria:curry #'* 3)) k))
      (incf n (length (symbol-name (alexandria:symbolicate 'foo "-" 'bar (alexandria:make-keyword "X")))))
      (alexandria:map-permutations (lambda (p) (incf n (first p))) '(1 2 3 4 5))
      (alexandria:map-combinations (lambda (c) (incf n (length c))) (alexandria:iota 12) :length 3)
      (incf n (length (alexandria:alist-plist (alexandria:plist-alist (alexandria:iota 200)))))
      (incf n (alexandria:lastcar (alexandria:ensure-list (alexandria:clamp k 3 9))))
      (alexandria:when-let ((x (alexandria:assoc-value '((a . 1) (b . 2)) 'b))) (incf n x))
      (incf n (array-total-size (alexandria:copy-array (make-array '(20 20) :initial-element k))))
      (when (alexandria:length= '(1 2 3) #(1 2 3)) (incf n)))
    n))

;;; split-sequence and Babel
(defbench l-split-sequence (30)
  (let ((n 0))
    (dolist (line (split-sequence:split-sequence #\Newline *text*))
      (incf n (length (split-sequence:split-sequence #\Space line :remove-empty-subseqs t)))
      (incf n (length (split-sequence:split-sequence-if (lambda (c) (find c ",;:@")) line))))
    n))
(defbench l-babel (50)
  (let* ((s (concatenate 'string *text* "日本語のテキスト éèà"))
         (octets (babel:string-to-octets s :encoding :utf-8))
         (back (babel:octets-to-string octets :encoding :utf-8)))
    (+ (length octets) (length back)
       (length (babel:string-to-octets s :encoding :utf-16le))
       (if (string= s back) 1 0))))
