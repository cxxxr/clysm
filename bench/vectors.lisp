;;; Clysm benchmarks -- algorithmic code over simple vectors and lists written
;;; without declarations: permutations, in-place algorithms, sorting with
;;; keys, heaps over adjustable vectors, sieves, matrices as vectors of
;;; vectors.  Run with tools/bench.sh bench/vectors.lisp.

(defmacro defbench (name (&optional (reps 1)) &body body)
  `(progn
     (defun ,name () ,@body)
     (run-bench ',name ,reps #',name)))

(defun run-bench (name reps fn)
  (funcall fn)                          ; warm up
  (let ((start (get-internal-real-time)) (r nil))
    (dotimes (i reps) (setq r (funcall fn)))
    (let ((ms (round (* 1000 (- (get-internal-real-time) start))
                     internal-time-units-per-second)))
      (format t "~(~A~) ~D ~A~%" name ms
              (let ((s (prin1-to-string r))) (if (> (length s) 40) (subseq s 0 40) s))))))

;;; ------------------------------------------------------------ permutations

(defun fannkuch (n)
  (let ((perm (make-array n)) (perm1 (make-array n)) (count (make-array n))
        (max-flips 0) (checksum 0) (r n) (sign 1))
    (dotimes (i n) (setf (aref perm1 i) i))
    (loop
      (loop while (/= r 1) do (setf (aref count (1- r)) r) (decf r))
      (replace perm perm1)
      (let ((flips 0))
        (loop for k = (aref perm 0) until (= k 0)
              do (let ((i 0) (j k))
                   (loop while (< i j)
                         do (rotatef (aref perm i) (aref perm j)) (incf i) (decf j)))
                 (incf flips))
        (setq max-flips (max max-flips flips))
        (incf checksum (* sign flips)))
      (setq sign (- sign))
      (loop
        (when (= r n) (return-from fannkuch (list checksum max-flips)))
        (let ((perm0 (aref perm1 0)))
          (loop for i from 0 below r do (setf (aref perm1 i) (aref perm1 (1+ i))))
          (setf (aref perm1 r) perm0))
        (decf (aref count r))
        (when (> (aref count r) 0) (return))
        (incf r)))))
(defbench x-fannkuch (5) (fannkuch 8))

(defun next-permutation (v)
  ;; lexicographic next permutation in place; NIL after the last
  (let ((n (length v)) (i (- (length v) 2)))
    (loop while (and (>= i 0) (>= (aref v i) (aref v (1+ i)))) do (decf i))
    (when (< i 0) (return-from next-permutation nil))
    (let ((j (1- n)))
      (loop while (<= (aref v j) (aref v i)) do (decf j))
      (rotatef (aref v i) (aref v j))
      (let ((a (1+ i)) (b (1- n)))
        (loop while (< a b) do (rotatef (aref v a) (aref v b)) (incf a) (decf b))))
    t))
(defbench x-permutations (5)
  (let ((v (vector 0 1 2 3 4 5 6 7 8)) (n 0) (s 0))
    (loop (incf n) (incf s (aref v 0)) (unless (next-permutation v) (return)))
    (list n s)))

;;; ------------------------------------------------------------ sorting by hand

(defun partition (v lo hi)
  (let ((pivot (aref v hi)) (i lo))
    (loop for j from lo below hi
          do (when (< (aref v j) pivot) (rotatef (aref v i) (aref v j)) (incf i)))
    (rotatef (aref v i) (aref v hi))
    i))
(defun quicksort (v lo hi)
  (when (< lo hi)
    (let ((p (partition v lo hi)))
      (quicksort v lo (1- p))
      (quicksort v (1+ p) hi)))
  v)
(defun merge-sort (v tmp lo hi)
  (when (< (- hi lo) 2) (return-from merge-sort v))
  (let ((mid (floor (+ lo hi) 2)))
    (merge-sort v tmp lo mid)
    (merge-sort v tmp mid hi)
    (let ((i lo) (j mid) (k lo))
      (loop while (and (< i mid) (< j hi))
            do (if (<= (aref v i) (aref v j))
                   (progn (setf (aref tmp k) (aref v i)) (incf i))
                   (progn (setf (aref tmp k) (aref v j)) (incf j)))
               (incf k))
      (loop while (< i mid) do (setf (aref tmp k) (aref v i)) (incf i) (incf k))
      (loop while (< j hi) do (setf (aref tmp k) (aref v j)) (incf j) (incf k))
      (replace v tmp :start1 lo :end1 hi :start2 lo)))
  v)
(defun random-vector (n seed)
  (let ((v (make-array n)) (x seed))
    (dotimes (i n v) (setq x (mod (+ (* x 1103515245) 12345) 2147483648)) (setf (aref v i) (mod x 100000)))))
(defbench x-quicksort (10)
  (let ((v (random-vector 20000 7))) (quicksort v 0 (1- (length v))) (aref v 10000)))
(defbench x-mergesort (10)
  (let* ((v (random-vector 20000 9)) (tmp (make-array (length v)))) (merge-sort v tmp 0 (length v)) (aref v 10000)))

(defun insertion-sort (v)
  (loop for i from 1 below (length v)
        do (let ((x (aref v i)) (j (1- i)))
             (loop while (and (>= j 0) (> (aref v j) x)) do (setf (aref v (1+ j)) (aref v j)) (decf j))
             (setf (aref v (1+ j)) x)))
  v)
(defbench x-insertion-sort (10)
  (let ((s 0)) (dotimes (k 20) (incf s (aref (insertion-sort (random-vector 300 k)) 150))) s))

;;; ------------------------------------------------------------ SORT with keys

(defbench x-sort-key (10)
  (let* ((recs (loop for i below 5000 collect (list (mod (* i 7919) 1009) (format nil "k~D" (mod (* i 31) 997)) i)))
         (v (coerce recs 'vector)))
    (+ (first (first (sort (copy-list recs) #'< :key #'first)))
       (third (aref (stable-sort (copy-seq v) #'string< :key #'second) 0))
       (third (first (stable-sort (copy-list recs) (lambda (a b) (> (car a) (car b))))))
       (first (aref (stable-sort (copy-seq v) #'< :key #'third) 0)))))

;;; ------------------------------------------------------------ heaps

(defun heap-push (heap x)
  (vector-push-extend x heap)
  (let ((i (1- (fill-pointer heap))))
    (loop while (> i 0)
          do (let ((p (floor (1- i) 2)))
               (if (< (aref heap i) (aref heap p))
                   (progn (rotatef (aref heap i) (aref heap p)) (setq i p))
                   (return))))))
(defun heap-pop (heap)
  (let ((top (aref heap 0)) (last (vector-pop heap)))
    (when (> (fill-pointer heap) 0)
      (setf (aref heap 0) last)
      (let ((i 0) (n (fill-pointer heap)))
        (loop
          (let* ((l (+ (* 2 i) 1)) (r (+ l 1)) (m i))
            (when (and (< l n) (< (aref heap l) (aref heap m))) (setq m l))
            (when (and (< r n) (< (aref heap r) (aref heap m))) (setq m r))
            (when (= m i) (return))
            (rotatef (aref heap i) (aref heap m))
            (setq i m)))))
    top))
(defbench x-heap (10)
  (let ((h (make-array 16 :adjustable t :fill-pointer 0)) (x 1) (s 0))
    (dotimes (i 20000) (setq x (mod (* x 48271) 2147483647)) (heap-push h (mod x 100000)))
    (dotimes (i 20000) (setq s (logand (+ (* s 31) (heap-pop h)) #xFFFFFF)))
    s))

;;; ------------------------------------------------------------ sieve, shuffles, counters

(defbench x-sieve (10)
  (let* ((n 200000) (v (make-array (1+ n) :initial-element t)) (c 0))
    (setf (aref v 0) nil (aref v 1) nil)
    (loop for i from 2 to n
          when (aref v i)
            do (incf c) (loop for j from (* i i) to n by i do (setf (aref v j) nil)))
    c))
(defbench x-shuffle-count (10)
  (let ((v (make-array 1000)) (counts (make-array 1000 :initial-element 0)) (x 42))
    (dotimes (i 1000) (setf (aref v i) i))
    (dotimes (round 100)
      (loop for i from (1- (length v)) downto 1
            do (setq x (mod (+ (* x 1103515245) 12345) 2147483648))
               (rotatef (aref v i) (aref v (mod x (1+ i)))))
      (dotimes (i (length v)) (incf (aref counts (aref v i)) i)))
    (reduce #'+ counts)))
(defun reverse-range (v start end)
  (loop for i from start for j downfrom (1- end) while (< i j) do (rotatef (aref v i) (aref v j)))
  v)
(defbench x-rotate-ranges (10)
  (let ((v (make-array 5000)) (s 0))
    (dotimes (i 5000) (setf (aref v i) i))
    (dotimes (k 200)
      ;; rotate left by k with three reversals
      (let ((m (mod (* k 37) 5000)))
        (reverse-range v 0 m) (reverse-range v m 5000) (reverse-range v 0 5000))
      (incf s (aref v 0)))
    s))

;;; ------------------------------------------------------------ matrices as vectors of vectors

(defun make-matrix (n m init)
  (let ((rows (make-array n)))
    (dotimes (i n rows) (setf (aref rows i) (make-array m :initial-element init)))))
(defun mat-mul (a b)
  (let* ((n (length a)) (m (length (aref b 0))) (k (length b)) (c (make-matrix n m 0)))
    (dotimes (i n c)
      (let ((ai (aref a i)) (ci (aref c i)))
        (dotimes (j m)
          (let ((s 0))
            (dotimes (p k) (incf s (* (aref ai p) (aref (aref b p) j))))
            (setf (aref ci j) s)))))))
(defbench x-matrix (10)
  (let ((a (make-matrix 60 60 2)) (b (make-matrix 60 60 3)))
    (dotimes (i 60) (setf (aref (aref a i) i) 5))
    (aref (aref (mat-mul a b) 7) 9)))

;;; ------------------------------------------------------------ copies and subsequences

(defbench x-copy-subseq (10)
  (let ((v (make-array 1000)) (s 0))
    (dotimes (i 1000) (setf (aref v i) i))
    (dotimes (k 2000)
      (let ((c (copy-seq v)) (sub (subseq v (mod k 500) (+ 500 (mod k 500)))))
        (fill c 0 :start 10 :end 20)
        (incf s (+ (aref c 5) (aref sub 3) (length sub)))))
    s))
(defbench x-list-to-vector (10)
  (let ((s 0))
    (dotimes (k 200)
      (let* ((l (loop for i below 1000 collect (mod (* i k) 97)))
             (v (coerce l 'vector)))
        (incf s (+ (length (remove-duplicates v)) (count 3 v) (or (position 5 v :from-end t) 0)))))
    s))
