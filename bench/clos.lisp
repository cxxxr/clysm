;;; Clysm benchmarks, CLOS -- generic function dispatch (one to four arguments,
;;; built-in classes, EQL specializers, many classes), call-next-method, method
;;; combinations, accessors, slot access, make-instance.
;;; Run with tools/bench.sh bench/clos.lisp.
(defmacro defbench (name (&optional (reps 1)) &body body)
  `(progn
     (defun ,name () ,@body)
     (run-bench ',name ,reps #',name)))

(defun run-bench (name reps fn)
  (funcall fn)                          ; warm up
  (let ((start (get-internal-real-time)) (r nil))
    (dotimes (i reps) (setq r (funcall fn)))
    (let ((ms (round (* 1000 (- (get-internal-real-time) start))
                     internal-time-units-per-second)))
      (format t "~(~A~) ~D ~A~%" name ms
              (let ((s (prin1-to-string r))) (if (> (length s) 40) (subseq s 0 40) s))))))

;;; --- three and four required arguments, multiple dispatch
(defclass node () ((val :initarg :val :accessor val)))
(defclass leaf (node) ())
(defclass branch (node) ((kids :initarg :kids :initform nil :accessor kids)))
(defclass special-leaf (leaf) ((extra :initform 3 :accessor extra)))

(defgeneric combine3 (a b c))
(defmethod combine3 ((a node) (b node) c) (+ (val a) (val b) c))
(defmethod combine3 ((a leaf) (b branch) c) (- (val a) (val b) c))
(defmethod combine3 ((a branch) (b leaf) (c integer)) (* 2 c))
(defmethod combine3 ((a leaf) (b leaf) (c symbol)) 7)
(defbench c-gf3 (10)
  (let ((l (make-instance 'leaf :val 1)) (b (make-instance 'branch :val 2))
        (s (make-instance 'special-leaf :val 3)) (n 0))
    (dotimes (i 200000)
      (setq n (logand (+ n (combine3 l b i) (combine3 b l i) (combine3 l s 'x) (combine3 b b 1) (combine3 s b 2))
                      #xFFFFF)))
    n))

(defgeneric combine4 (a b c d))
(defmethod combine4 ((a node) b (c node) d) (+ (val a) b (val c) d))
(defmethod combine4 ((a leaf) b (c leaf) d) (+ 1 (call-next-method)))
(defmethod combine4 :before ((a special-leaf) b c d) (setf (extra a) (logand (+ b d) 7)))
(defbench c-gf4 (10)
  (let ((l (make-instance 'leaf :val 1)) (b (make-instance 'branch :val 2))
        (s (make-instance 'special-leaf :val 3)) (n 0))
    (dotimes (i 200000)
      (setq n (logand (+ n (combine4 l i b 1) (combine4 l 2 l i) (combine4 s i s 3) (combine4 b 1 s 1)) #xFFFFF)))
    (+ n (extra s))))

;;; --- call-next-method chains four deep
(defclass c1 () ((n :initform 0 :accessor n-of)))
(defclass c2 (c1) ())
(defclass c3 (c2) ())
(defclass c4 (c3) ())
(defgeneric depth (x y))
(defmethod depth ((x c1) y) y)
(defmethod depth ((x c2) y) (1+ (call-next-method)))
(defmethod depth ((x c3) y) (1+ (call-next-method)))
(defmethod depth ((x c4) y) (if (next-method-p) (1+ (call-next-method)) 0))
(defbench c-cnm4 (10)
  (let ((objs (list (make-instance 'c4) (make-instance 'c3) (make-instance 'c1))) (s 0))
    (dotimes (i 200000) (dolist (o objs) (setq s (logand (+ s (depth o i)) #xFFFFF))))
    s))

(defgeneric scale (x y z))
(defmethod scale ((x c1) y z) (+ y z))
(defmethod scale ((x c2) y z) (call-next-method x (* y 2) z))
(defmethod scale ((x c3) y z) (call-next-method x y (+ z 1)))
(defmethod scale ((x c4) y z) (call-next-method x (+ y 1) (+ z 1)))
(defbench c-cnm4-args (10)
  (let ((objs (list (make-instance 'c4) (make-instance 'c3) (make-instance 'c2))) (s 0))
    (dotimes (i 200000) (dolist (o objs) (setq s (logand (+ s (scale o i 1)) #xFFFFF))))
    s))

;; the class of an argument changes (NIL -> cons, fixnum -> float)
(defgeneric collect (x acc))
(defmethod collect ((x c1) acc) (length acc))
(defmethod collect ((x c2) acc) (call-next-method x (cons 1 acc)))
(defmethod collect ((x c3) acc) (call-next-method x (cons 2 acc)))
(defbench c-cnm-class-change (10)
  (let ((o (make-instance 'c3)) (s 0))
    (dotimes (i 200000) (setq s (logand (+ s (collect o nil) (collect o '(a))) #xFFFFF)))
    s))

;; call-next-method as a function object
(defgeneric total (x list))
(defmethod total ((x c1) list) (reduce #'+ list))
(defmethod total ((x c2) list) (apply #'call-next-method x (list (cons 1 list))))
(defmethod total ((x c3) list) (funcall #'call-next-method))
(defbench c-cnm-function (10)
  (let ((o (make-instance 'c3)) (s 0) (l (list 1 2 3)))
    (dotimes (i 100000) (setq s (logand (+ s (total o l)) #xFFFFF)))
    s))

;;; --- :around + :before + :after together, three arguments
(defvar *trace* 0)
(defgeneric visit (x depth acc))
(defmethod visit ((x c1) depth acc) (+ depth acc))
(defmethod visit :before ((x c2) depth acc) (incf *trace*))
(defmethod visit :before ((x c1) depth acc) (incf *trace* 2))
(defmethod visit :after ((x c3) depth acc) (incf *trace* 3))
(defmethod visit :after ((x c1) depth acc) (incf *trace* 4))
(defmethod visit :around ((x c4) depth acc) (if (evenp depth) (call-next-method) (call-next-method x 0 acc)))
(defmethod visit :around ((x c2) depth acc) (1+ (call-next-method)))
(defbench c-comb-all (10)
  (let ((objs (list (make-instance 'c4) (make-instance 'c3) (make-instance 'c2) (make-instance 'c1))) (s 0))
    (setq *trace* 0)
    (dotimes (i 100000) (dolist (o objs) (setq s (logand (+ s (visit o i 1)) #xFFFFF))))
    (+ s (logand *trace* #xFFFF))))

;;; --- built-in classes and EQL specializers
(defgeneric kind (x y))
(defmethod kind ((x integer) (y integer)) 1)
(defmethod kind ((x integer) (y (eql 0))) 2)
(defmethod kind ((x (eql :zero)) y) 3)
(defmethod kind ((x symbol) (y string)) 4)
(defmethod kind ((x string) y) 5)
(defmethod kind ((x list) (y list)) 6)
(defmethod kind ((x null) (y null)) 7)
(defmethod kind ((x float) (y number)) 8)
(defmethod kind ((x character) (y character)) 9)
(defmethod kind ((x vector) (y (eql 'len))) 10)
(defmethod kind (x y) 0)
(defbench c-builtin-eql (10)
  (let ((pairs (list (cons 1 2) (cons 3 0) (cons :zero 1) (cons 'a "s") (cons "s" 1) (cons '(1) nil)
                     (cons nil nil) (cons 1.5 2) (cons #\a #\b) (cons (vector 1) 'len) (cons 2.5d0 1/2)
                     (cons (expt 10 20) 5) (cons #\a 1)))
        (s 0))
    (dotimes (i 50000) (dolist (p pairs) (incf s (kind (car p) (cdr p)))))
    s))

(defgeneric op (code x))
(defmethod op ((code (eql :add)) x) (+ x 1))
(defmethod op ((code (eql :sub)) x) (- x 1))
(defmethod op ((code (eql :dbl)) x) (logand (* x 2) #xFFFF))
(defmethod op ((code (eql 7)) x) 7)
(defmethod op ((code symbol) x) x)
(defbench c-eql-dispatch (10)
  (let ((codes '(:add :dbl :sub :add 7 :nop :dbl)) (x 1))
    (dotimes (i 100000) (dolist (c codes) (setq x (op c x))))
    x))

;;; --- a generic function called with many classes
(defmacro define-shapes (&rest names)
  `(progn ,@(loop for n in names for i from 1
                  collect `(defclass ,n () ((size :initform ,i :reader size)))
                  collect `(defmethod weight ((x ,n)) (* ,i (size x))))))
(defgeneric weight (x))
(define-shapes s01 s02 s03 s04 s05 s06 s07 s08 s09 s10 s11 s12 s13 s14 s15 s16 s17 s18 s19 s20)
(defbench c-megamorphic (10)
  (let ((objs (mapcar #'make-instance '(s01 s02 s03 s04 s05 s06 s07 s08 s09 s10 s11 s12 s13 s14 s15 s16 s17 s18 s19 s20)))
        (s 0))
    (dotimes (i 50000) (dolist (o objs) (setq s (logand (+ s (weight o)) #xFFFFF))))
    s))

;;; --- accessors through inheritance, setf accessors, with-slots, with-accessors
(defclass base () ((a :initarg :a :initform 1 :accessor a-of) (b :initform 2 :accessor b-of)))
(defclass mid (base) ((c :initform 3 :accessor c-of)))
(defclass top (mid) ((d :initform 4 :accessor d-of) (e :initform 5 :reader e-of :writer set-e)))
(defbench c-accessors (10)
  (let ((objs (list (make-instance 'top) (make-instance 'mid) (make-instance 'base))) (s 0))
    (dotimes (i 300000)
      (dolist (o objs)
        (setf (a-of o) (logand (+ (a-of o) (b-of o)) 255))
        (incf s (a-of o)))
      (let ((o (car objs)))
        (setf (d-of o) (logand i 3))
        (set-e (+ (d-of o) (c-of o)) o)
        (incf s (e-of o))))
    s))

(defbench c-with-slots (10)
  (let ((objs (list (make-instance 'top) (make-instance 'mid :a 5) (make-instance 'base))) (s 0))
    (dotimes (i 300000)
      (dolist (o objs)
        (with-slots (a b) o
          (setq a (logand (+ a b i) 255))
          (incf s a)))
      (with-accessors ((c c-of) (d d-of)) (car objs)
        (setq c (logand (+ c d) 15))
        (incf s c))
      (when (slot-boundp (car objs) 'e) (incf s)))
    s))

;;; --- slot-value on a class redefined in the middle of the run
(defclass config () ((x :initform 1 :initarg :x) (y :initform 2 :initarg :y)))
(defun config-sum (c n)
  (let ((s 0))
    (dotimes (i n) (incf s (+ (slot-value c 'x) (slot-value c 'y))) (setf (slot-value c 'x) (logand i 7)))
    s))
(defbench c-slot-redef (5)
  (let ((s (config-sum (make-instance 'config) 300000)))
    (eval '(defclass config () ((w :initform 0) (y :initform 5 :initarg :y) (x :initform 1 :initarg :x) (z :initform 9))))
    (incf s (config-sum (make-instance 'config :y 3) 300000))
    (eval '(defclass config () ((x :initform 1 :initarg :x) (y :initform 2 :initarg :y))))
    (+ s (config-sum (make-instance 'config) 300000))))

;;; --- make-instance: initforms, default initargs, :after and :around methods
(defclass widget ()
  ((id :initarg :id :reader widget-id)
   (name :initarg :name :initform "w" :reader widget-name)
   (children :initform (list 1 2) :accessor widget-children)
   (size :initarg :size :accessor widget-size))
  (:default-initargs :size 10))
(defclass button (widget) ((label :initarg :label :initform "ok" :reader button-label))
  (:default-initargs :name "button"))
(defmethod initialize-instance :after ((w widget) &key (scale 1) &allow-other-keys)
  (setf (widget-size w) (* scale (widget-size w))))
(defmethod initialize-instance :around ((b button) &rest initargs &key label)
  (if label (call-next-method) (apply #'call-next-method b :label "none" initargs)))
(defmethod shared-initialize :after ((b button) slot-names &key)
  (push 0 (widget-children b)))
(defbench c-make-instance (10)
  (let ((s 0))
    (dotimes (i 20000)
      (let ((w (make-instance 'widget :id i :scale 2))
            (b (make-instance 'button :id i :label "go" :size (logand i 7)))
            (c (make-instance 'button :id i)))
        (incf s (+ (widget-size w) (widget-size b) (length (widget-children b)) (length (button-label c))
                   (length (widget-name c)) (widget-id w)))))
    s))

;; classes without user methods, dynamic class argument
(defclass plain () ((p :initarg :p :initform 1) (q :initarg :q :initform (list 1)) (r :initform 0)))
(defclass plain2 (plain) ((s :initarg :s)) (:default-initargs :s 4))
(defbench c-make-instance-plain (10)
  (let ((n 0) (classes (list 'plain (find-class 'plain2))))
    (dotimes (i 50000)
      (dolist (c classes)
        (incf n (slot-value (make-instance c :p i) 'p)))
      (incf n (slot-value (make-instance 'plain2 :q 1 :p 2) 's)))
    n))

;;; --- generic functions with &optional, &key and &rest parameters
(defgeneric render (x &optional indent))
(defmethod render ((x base) &optional (indent 0)) (+ indent (a-of x)))
(defmethod render ((x mid) &optional (indent 0)) (+ 1 indent (call-next-method)))
(defgeneric configure (x &key size color &allow-other-keys))
(defmethod configure ((x base) &key (size 1) color) (if color (+ size 1) size))
(defmethod configure :before ((x mid) &key size &allow-other-keys) (when size (setf (c-of x) size)))
(defgeneric gather (x &rest things))
(defmethod gather ((x base) &rest things) (length things))
(defmethod gather ((x top) &rest things) (+ (car things) (call-next-method)))
(defbench c-gf-lambda-lists (10)
  (let ((objs (list (make-instance 'top) (make-instance 'mid) (make-instance 'base))) (s 0))
    (dotimes (i 50000)
      (dolist (o objs)
        (incf s (+ (render o) (render o 2) (configure o) (configure o :size 3) (configure o :color t :size 2)))
        (incf s (gather o 1 2 3))))
    s))

;;; --- short-form method combinations
(defgeneric cost (x) (:method-combination +))
(defmethod cost + ((x base)) 1)
(defmethod cost + ((x mid)) 10)
(defmethod cost + ((x top)) 100)
(defgeneric parts (x y) (:method-combination append :most-specific-last))
(defmethod parts append ((x base) y) (list y))
(defmethod parts append ((x mid) y) (list 2 y))
(defmethod parts :around ((x top) y) (cdr (call-next-method)))
(defbench c-short-combination (10)
  (let ((objs (list (make-instance 'top) (make-instance 'mid) (make-instance 'base))) (s 0))
    (dotimes (i 50000)
      (dolist (o objs) (incf s (+ (cost o) (length (parts o i))))))
    s))

;;; --- structures and conditions as arguments
(defstruct point x y)
(defstruct (point3 (:include point)) z)
(define-condition my-error (error) ((code :initarg :code :reader my-error-code)))
(defgeneric norm1 (p))
(defmethod norm1 ((p point)) (+ (point-x p) (point-y p)))
(defmethod norm1 ((p point3)) (+ (point3-z p) (call-next-method)))
(defmethod norm1 ((p my-error)) (my-error-code p))
(defmethod norm1 ((p condition)) -1)
(defbench c-struct-dispatch (10)
  (let ((objs (list (make-point :x 1 :y 2) (make-point3 :x 1 :y 2 :z 3)
                    (make-condition 'my-error :code 5) (make-condition 'simple-error)))
        (s 0))
    (dotimes (i 200000) (dolist (o objs) (setq s (logand (+ s (norm1 o)) #xFFFFF))))
    s))
