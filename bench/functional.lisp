;;; Functional-style code written after bench/closures.lisp (2026-11-21), to
;;; find what combinator code still pays for: a matcher of closures over
;;; lists with backtracking, parser combinators returning two values, CPS
;;; walks, an interpreter compiled to closures, generators, memoization with
;;; EQUAL tables keyed by argument lists, compose/curry pipelines,
;;; EVERY/SOME/MAPCAR of lambdas over several sequences, exits out of MAPHASH,
;;; a PAIP-style pattern matcher with segment variables, a rule-based
;;; simplifier, regular expressions over strings compiled to closures
;;; (tools/bench.sh bench/functional.lisp). Results must be single tokens.
(defmacro defbench (name (&optional (reps 1)) &body body)
  `(progn (defun ,name () ,@body) (run-bench ',name ,reps #',name)))
(defun run-bench (name reps fn)
  (funcall fn)
  (let ((start (get-internal-real-time)) (r nil))
    (dotimes (i reps) (setq r (funcall fn)))
    (let ((ms (round (* 1000 (- (get-internal-real-time) start))
                     internal-time-units-per-second)))
      (format t "~(~A~) ~D ~A~%" name ms
              (let ((s (prin1-to-string r))) (if (> (length s) 40) (subseq s 0 40) s))))))

;;; regex-like matcher of closures over lists with backtracking
(defun m-lit (x next) (lambda (in k) (and (consp in) (eql (car in) x) (funcall next (cdr in) k))))
(defun m-any (next) (lambda (in k) (and (consp in) (funcall next (cdr in) k))))
(defun m-alt (a b) (lambda (in k) (or (funcall a in k) (funcall b in k))))
(defun m-star (sub next)
  (let (self)
    (setq self (lambda (in k)
                 (or (funcall sub in (lambda (rest) (and (not (eq rest in)) (funcall self rest k))))
                     (funcall next in k))))
    self))
(defun m-end () (lambda (in k) (funcall k in)))
(defun rx->m (rx next)
  (cond ((null rx) next)
        ((eq (car rx) '*) (m-star (rx->m (list (cadr rx)) (lambda (in k) (funcall k in))) (rx->m (cddr rx) next)))
        ((eq (car rx) '_) (m-any (rx->m (cdr rx) next)))
        ((consp (car rx)) (m-alt (rx->m (list (car (car rx))) (rx->m (cdr rx) next))
                                 (rx->m (list (cadr (car rx))) (rx->m (cdr rx) next))))
        (t (m-lit (car rx) (rx->m (cdr rx) next)))))
(defun rx-match (m in) (funcall m in (lambda (rest) (null rest))))
(defbench f-rx-match (10)
  (let ((m1 (rx->m '(a * _ b (c d) * a) (m-end)))
        (m2 (rx->m '(* (a b) c * _) (m-end)))
        (inputs (list '(a x y b c a a) '(a b b b c d a) '(a b a b c) '(c c c) '(a x x x x x x x x b d)
                      '(b a b a b a c x x)))
        (s 0))
    (dotimes (i 40000)
      (dolist (in inputs)
        (when (rx-match m1 in) (incf s))
        (when (rx-match m2 in) (incf s))))
    s))

;;; parser combinators returning (values result pos) via closures
(defun pc-char (c) (lambda (s i) (if (and (< i (length s)) (char= (char s i) c)) (values c (1+ i)) (values nil nil))))
(defun pc-digit () (lambda (s i) (if (and (< i (length s)) (digit-char-p (char s i))) (values (digit-char-p (char s i)) (1+ i)) (values nil nil))))
(defun pc-or (&rest ps) (lambda (s i) (dolist (p ps (values nil nil)) (multiple-value-bind (r j) (funcall p s i) (when j (return (values r j)))))))
(defun pc-many (p) (lambda (s i) (let ((acc '())) (loop (multiple-value-bind (r j) (funcall p s i) (if j (progn (push r acc) (setq i j)) (return (values (nreverse acc) i))))))))
(defun pc-bind (p f) (lambda (s i) (multiple-value-bind (r j) (funcall p s i) (if j (funcall (funcall f r) s j) (values nil nil)))))
(defun pc-ret (x) (lambda (s i) (declare (ignore s)) (values x i)))
(defun pc-num () (pc-bind (pc-digit) (lambda (d) (pc-bind (pc-many (pc-digit)) (lambda (ds) (pc-ret (reduce (lambda (a b) (+ (* a 10) b)) ds :initial-value d)))))))
(defun pc-sum ()
  (pc-bind (pc-num) (lambda (a) (pc-bind (pc-many (pc-bind (pc-or (pc-char #\+) (pc-char #\-)) (lambda (op) (pc-bind (pc-num) (lambda (b) (pc-ret (if (char= op #\+) b (- b))))))))
                                          (lambda (rest) (pc-ret (apply #'+ a rest)))))))
(defbench f-parse-comb (10)
  (let ((p (pc-sum)) (str (with-output-to-string (o) (dotimes (i 300) (format o "~D~A" (* i 37) (if (evenp i) "+" "-")))  (write-string "1" o))) (s 0))
    (dotimes (i 30) (incf s (funcall p str 0)))
    s))

;;; CPS walks
(defun cps-count (tree k) (if (atom tree) (funcall k (if tree 1 0)) (cps-count (car tree) (lambda (a) (cps-count (cdr tree) (lambda (b) (funcall k (+ a b))))))))
(defun mk-tree (d) (if (= d 0) 'x (cons (mk-tree (1- d)) (mk-tree (1- d)))))
(defbench f-cps-count (20) (let ((tr (mk-tree 16)) (s 0)) (dotimes (i 2) (incf s (cps-count tr #'identity))) s))
(defun cps-ack (m n k) (cond ((= m 0) (funcall k (1+ n))) ((= n 0) (cps-ack (1- m) 1 k)) (t (cps-ack m (1- n) (lambda (v) (cps-ack (1- m) v k))))))
(defbench f-cps-ack (10) (cps-ack 2 300 #'identity))

;;; closure-compiled interpreter of a small language with environments as vectors
(defun cc (x)
  (cond ((integerp x) (lambda (env) (declare (ignore env)) x))
        ((symbolp x) (let ((i (position x '(a b c d)))) (lambda (env) (svref env i))))
        (t (case (car x)
             (+ (let ((f (cc (second x))) (g (cc (third x)))) (lambda (env) (+ (funcall f env) (funcall g env)))))
             (- (let ((f (cc (second x))) (g (cc (third x)))) (lambda (env) (- (funcall f env) (funcall g env)))))
             (< (let ((f (cc (second x))) (g (cc (third x)))) (lambda (env) (< (funcall f env) (funcall g env)))))
             (if (let ((c (cc (second x))) (a (cc (third x))) (b (cc (fourth x)))) (lambda (env) (if (funcall c env) (funcall a env) (funcall b env)))))
             (set (let ((i (position (second x) '(a b c d))) (f (cc (third x)))) (lambda (env) (setf (svref env i) (funcall f env)))))
             (while (let ((c (cc (second x))) (b (mapcar #'cc (cddr x)))) (lambda (env) (loop while (funcall c env) do (dolist (f b) (funcall f env))) nil)))
             (seq (let ((b (mapcar #'cc (cdr x)))) (lambda (env) (let (r) (dolist (f b r) (setq r (funcall f env)))))))))))
(defbench f-cc-interp (10)
  (let ((prog (cc '(seq (set a 0) (set b 0) (while (< a 100000) (set b (+ b (if (< (- a 3) b) 1 2))) (set a (+ a 1))) b))))
    (funcall prog (vector 0 0 0 0))))

;;; generators via closures
(defun g-range (n) (let ((i 0)) (lambda () (if (< i n) (values (prog1 i (incf i)) t) (values nil nil)))))
(defun g-mapf (f g) (lambda () (multiple-value-bind (v ok) (funcall g) (if ok (values (funcall f v) t) (values nil nil)))))
(defun g-filt (p g) (lambda () (loop (multiple-value-bind (v ok) (funcall g) (cond ((not ok) (return (values nil nil))) ((funcall p v) (return (values v t))))))))
(defun g-sum (g) (let ((s 0)) (loop (multiple-value-bind (v ok) (funcall g) (if ok (incf s v) (return s))))))
(defbench f-generators (10) (g-sum (g-filt #'evenp (g-mapf (lambda (x) (* x x)) (g-range 300000)))))

;;; memoize with EQUAL tables keyed by argument lists
(defun memo (fn) (let ((h (make-hash-table :test #'equal))) (lambda (&rest args) (multiple-value-bind (v f) (gethash args h) (if f v (setf (gethash args h) (apply fn args)))))))
(defvar *paths*)
(defun paths (x y) (if (or (= x 0) (= y 0)) 1 (mod (+ (funcall *paths* (1- x) y) (funcall *paths* x (1- y))) 1000007)))
(defbench f-memo-grid (10) (let ((s 0)) (dotimes (i 4) (setq *paths* (memo #'paths)) (incf s (funcall *paths* 120 120))) s))
(defvar *edit*)
(defun edit (a b) (cond ((null a) (length b)) ((null b) (length a))
                        ((eql (car a) (car b)) (funcall *edit* (cdr a) (cdr b)))
                        (t (1+ (min (funcall *edit* (cdr a) b) (funcall *edit* a (cdr b)) (funcall *edit* (cdr a) (cdr b)))))))
(defbench f-memo-lists (10) (let ((s 0)) (dotimes (i 3) (setq *edit* (memo #'edit)) (incf s (funcall *edit* (coerce "kitten sitting on the mat today" 'list) (coerce "sitting kitten at the mall today" 'list)))) s))
(defbench f-equal-hash (10)
  (let ((h (make-hash-table :test 'equal)) (s 0))
    (dotimes (i 2000) (setf (gethash (list (mod i 50) 'foo (floor i 50)) h) i))
    (dotimes (r 50) (dotimes (i 2000) (incf s (gethash (list (mod i 50) 'foo (floor i 50)) h 0))))
    s))

;;; compose / curry / reduce pipelines
(defun compose2 (&rest fs) (reduce (lambda (f g) (lambda (x) (funcall f (funcall g x)))) fs))
(defun curry1 (f &rest a) (lambda (&rest b) (apply f (append a b))))
(defun rcurry1 (f &rest a) (lambda (&rest b) (apply f (append b a))))
(defbench f-pipeline (10)
  (let ((l (loop for i below 1000 collect i)) (s 0))
    (dotimes (r 100)
      (let ((f (compose2 (curry1 #'+ r) (rcurry1 #'mod 1000) (lambda (x) (* x 3)) #'1+)))
        (incf s (reduce #'+ (remove-if-not (lambda (x) (evenp x)) (mapcar f l))))
        (setq s (logand s #xFFFFFF))))
    s))

;;; every/some/mapcar with lambdas over several lists
(defbench f-multi-seq (10)
  (let ((a (loop for i below 1000 collect i)) (b (loop for i below 1000 collect (* 2 i))) (c (loop for i below 1000 collect (- i))) (s 0))
    (dotimes (r 100)
      (when (every (lambda (x y) (< x (1+ y))) a b) (incf s))
      (when (some (lambda (x y z) (> (+ x y z) 2990)) a b c) (incf s))
      (when (notany (lambda (x y) (= x y 7)) a c) (incf s))
      (incf s (reduce #'+ (mapcar (lambda (x y z) (+ x y z)) a b c)))
      (incf s (count-if #'evenp (mapcar #'+ a b)))
      (mapc (lambda (x y) (when (= x y) (incf s))) a c)
      (setq s (logand s #xFFFFFF)))
    s))
(defbench f-every-vec (10)
  (let* ((v (coerce (loop for i below 1000 collect i) 'vector)) (w (map 'vector #'1+ v)) (s 0))
    (dotimes (r 200)
      (when (every #'< v w) (incf s))
      (when (some (lambda (x y) (= (+ x y) 1999)) v w) (incf s))
      (incf s (reduce #'+ (map 'list #'- w v))))
    s))

;;; maphash / dolist with return-from out of closures
(defbench f-find-in-hash (10)
  (let ((h (make-hash-table)) (s 0))
    (dotimes (i 64) (setf (gethash i h) (* i 3)))
    (dotimes (i 20000)
      (incf s (block nil (maphash (lambda (k v) (when (= k (logand i 63)) (return v))) h) 0)))
    s))
(defun find-first (pred list) (dolist (x list) (when (funcall pred x) (return-from find-first x))))
(defbench f-early-exit (10)
  (let ((l (loop for i below 100 collect i)) (s 0))
    (dotimes (i 20000) (incf s (or (find-first (lambda (x) (> x (mod i 100))) l) 0)) (incf s (or (find-if (lambda (x) (> x (mod i 90))) l) 0)))
    s))
;;; tail-position boolean predicates through funcall
(defun all-of (preds) (lambda (x) (every (lambda (p) (funcall p x)) preds)))
(defun any-of (preds) (lambda (x) (some (lambda (p) (funcall p x)) preds)))
(defbench f-predicates (10)
  (let ((p (all-of (list #'integerp (lambda (x) (> x 10)) (any-of (list #'evenp (lambda (x) (zerop (mod x 3)))))))) (s 0))
    (dotimes (i 300000) (when (funcall p i) (incf s)))
    s))

;;; PAIP-style pattern matcher compiled to closures, with segment variables
;;; (?*x), single variables (?x), predicates (?is ?x pred), alternatives
;;; (?or p1 p2), and backtracking through success continuations.
(defun var-p (x) (and (symbolp x) (> (length (symbol-name x)) 1) (char= (char (symbol-name x) 0) #\?)))
(defun seg-p (x) (and (consp x) (symbolp (car x)) (string= (symbol-name (car x)) "?*")))
(defun bind (var val b) (cons (cons var val) b))
(defun lookup (var b) (assoc var b :test #'eq))

(defun pm-compile (pat)
  (cond ((var-p pat)
         (lambda (in b k)
           (let ((old (lookup pat b)))
             (cond ((null old) (funcall k (bind pat in b)))
                   ((equal (cdr old) in) (funcall k b))
                   (t nil)))))
        ((atom pat) (lambda (in b k) (and (eql in pat) (funcall k b))))
        ((and (consp (car pat)) (eq (caar pat) '?is))
         (let ((var (second (car pat))) (pred (third (car pat))) (rest (pm-compile (cdr pat))))
           (lambda (in b k)
             (and (consp in) (funcall pred (car in))
                  (let ((old (lookup var b)))
                    (if (or (null old) (equal (cdr old) (car in)))
                        (funcall rest (cdr in) (if old b (bind var (car in) b)) k)
                        nil))))))
        ((and (consp (car pat)) (eq (caar pat) '?or))
         (let ((alts (mapcar #'pm-compile (cdar pat))) (rest (pm-compile (cdr pat))))
           (lambda (in b k)
             (and (consp in)
                  (some (lambda (alt) (funcall alt (car in) b (lambda (b2) (funcall rest (cdr in) b2 k)))) alts)))))
        ((seg-p (car pat))
         (let ((var (second (car pat))) (rest (pm-compile (cdr pat))))
           (lambda (in b k)
             (let ((old (lookup var b)))
               (if old
                   (let ((seg (cdr old)))
                     (let ((tail (nthcdr (length seg) in)))
                       (and (equal seg (ldiff in tail)) (funcall rest tail b k))))
                   (loop for tail on (cons nil in)
                         for start = in then (cdr start)
                         thereis (funcall rest start (bind var (ldiff in start) b) k)
                         while start))))))
        (t (let ((car-m (pm-compile (car pat))) (cdr-m (pm-compile (cdr pat))))
             (lambda (in b k)
               (and (consp in)
                    (funcall car-m (car in) b (lambda (b2) (funcall cdr-m (cdr in) b2 k)))))))))
(defun pm-matcher (pat) (let ((m (pm-compile pat))) (lambda (in) (funcall m in '() (lambda (b) (or b t))))))

(defbench p-pm-segments (10)
  (let ((ms (mapcar #'pm-matcher
                    '(((?* ?x) a (?* ?y) b (?* ?z))
                      (?x (?* ?y) ?x)
                      ((?* ?a) (?or c d) (?* ?b) (?is ?n numberp))
                      (if (?* ?c) then (?* ?t) else (?* ?e))
                      ((?* ?p) (?* ?p)))))
        (data '((x y a z z b q) (1 2 3 4 1) (a b c d e 7) (if x y then z else w v)
                (a b a b) (p q r s t u v) (a a a a b b b b) (1 2 3 1 2 3)))
        (s 0))
    (dotimes (i 3000)
      (dolist (d data)
        (dolist (m ms)
          (let ((r (funcall m d))) (when r (incf s (if (consp r) (length r) 1)))))))
    s))

;;; A rule-based simplifier with the matcher: rules as (pattern . builder)
(defun simp-rules ()
  (list (cons (pm-matcher '(+ ?x 0)) (lambda (b) (cdr (lookup '?x b))))
        (cons (pm-matcher '(+ 0 ?x)) (lambda (b) (cdr (lookup '?x b))))
        (cons (pm-matcher '(* ?x 1)) (lambda (b) (cdr (lookup '?x b))))
        (cons (pm-matcher '(* 1 ?x)) (lambda (b) (cdr (lookup '?x b))))
        (cons (pm-matcher '(* ?x 0)) (lambda (b) (declare (ignore b)) 0))
        (cons (pm-matcher '(- ?x ?x)) (lambda (b) (declare (ignore b)) 0))
        (cons (pm-matcher '(+ (?is ?x numberp) (?is ?y numberp))) (lambda (b) (+ (cdr (lookup '?x b)) (cdr (lookup '?y b)))))))
(defun simp (e rules)
  (if (atom e) e
      (let ((e (mapcar (lambda (x) (simp x rules)) e)))
        (dolist (r rules e)
          (let ((b (funcall (car r) e)))
            (when b (return (simp (funcall (cdr r) (if (eq b t) nil b)) rules))))))))
(defun gen-e (seed d)
  (if (= d 0) (if (evenp seed) (mod seed 3) 'x)
      (list (nth (mod seed 3) '(+ * -)) (gen-e (+ (* seed 7) 1) (1- d)) (gen-e (+ (* seed 13) 5) (1- d)))))
(defbench p-simplify (10)
  (let ((rules (simp-rules)) (s 0))
    (dotimes (i 200) (let ((r (simp (gen-e i 6) rules))) (incf s (if (consp r) (length r) 1))))
    s))

;;; regular expressions over strings compiled to closures (char, class, star, alt, seq)
(defun rc (re k)
  (etypecase re
    (character (lambda (s i) (and (< i (length s)) (char= (char s i) re) (funcall k s (1+ i)))))
    ((eql :any) (lambda (s i) (and (< i (length s)) (funcall k s (1+ i)))))
    ((eql :digit) (lambda (s i) (and (< i (length s)) (digit-char-p (char s i)) (funcall k s (1+ i)))))
    (cons (ecase (car re)
            (:seq (reduce (lambda (r k) (rc r k)) (cdr re) :from-end t :initial-value k))
            (:alt (let ((ms (mapcar (lambda (r) (rc r k)) (cdr re)))) (lambda (s i) (some (lambda (m) (funcall m s i)) ms))))
            (:star (let (self) (setq self (lambda (s i) (or (funcall (rc (second re) (lambda (s j) (and (> j i) (funcall self s j)))) s i)
                                                            (funcall k s i))))
                     self))
            (:plus (rc `(:seq ,(second re) (:star ,(second re))) k))))))
(defun rx-search (re s)
  (let ((m (rc re (lambda (s i) (declare (ignore s)) i))))
    (loop for start from 0 to (length s) thereis (let ((e (funcall m s start))) (and e (cons start e))))))
(defbench p-rx-strings (10)
  (let ((lines (loop for i below 200 collect (format nil "id=~D name=item~D value=~D.~D ok" i (* i 7) (* i 13) (mod i 10))))
        (s 0))
    (dolist (l lines)
      (let ((r (rx-search '(:seq #\v #\a #\l #\u #\e #\= (:plus :digit) #\. (:plus :digit)) l)))
        (when r (incf s (cdr r))))
      (let ((r (rx-search '(:seq (:alt #\n #\i) (:star :any) #\k) l)))
        (when r (incf s (car r)))))
    s))
