;;; Clysm benchmarks — arrays, vectors, strings and structures in code without
;;; type declarations: the vectors and structures arrive as parameters of
;;; unknown type. Run with tools/bench.sh bench/arrays.lisp.

(defmacro defbench (name (&optional (reps 1)) &body body)
  `(progn
     (defun ,name () ,@body)
     (run-bench ',name ,reps #',name)))

(defun run-bench (name reps fn)
  (funcall fn)                          ; warm up
  (let ((start (get-internal-real-time)) (r nil))
    (dotimes (i reps) (setq r (funcall fn)))
    (let ((ms (round (* 1000 (- (get-internal-real-time) start))
                     internal-time-units-per-second)))
      (format t "~(~A~) ~D ~A~%" name ms
              (let ((s (prin1-to-string r))) (if (> (length s) 40) (subseq s 0 40) s))))))

;;; ------------------------------------------------- simple vectors of T

;; fannkuch: permutations by counting, flips by reversing a prefix
(defun flip-count (perm work n)
  (replace work perm)
  (let ((flips 0))
    (loop for k = (aref work 0)
          until (zerop k)
          do (let ((i 0) (j k))
               (loop while (< i j)
                     do (rotatef (aref work i) (aref work j))
                        (incf i) (decf j)))
             (incf flips))
    (when (> n 100) (print n))
    flips))

(defun fannkuch (n)
  (let ((perm (make-array n)) (work (make-array n)) (count (make-array n))
        (best 0) (checksum 0) (sign 1))
    (dotimes (i n) (setf (aref perm i) i (aref count i) i))
    (loop
      (let ((f (flip-count perm work n)))
        (setq best (max best f))
        (setq checksum (+ checksum (* sign f))))
      (setq sign (- sign))
      ;; next permutation
      (let ((r 1))
        (loop
          (when (= r n) (return-from fannkuch (list best checksum)))
          (let ((p0 (aref perm 0)))
            (dotimes (i r) (setf (aref perm i) (aref perm (1+ i))))
            (setf (aref perm r) p0))
          (decf (aref count r))
          (if (plusp (aref count r))
              (return)
              (progn (setf (aref count r) r) (incf r))))))))
(defbench a-fannkuch (2) (fannkuch 10))

;; quicksort and insertion sort written by hand on a vector parameter
(defun insertion-sort (v lo hi)
  (loop for i from (1+ lo) to hi
        do (let ((x (svref v i)) (j (1- i)))
             (loop while (and (>= j lo) (> (svref v j) x))
                   do (setf (svref v (1+ j)) (svref v j)) (decf j))
             (setf (svref v (1+ j)) x)))
  v)
(defun qsort (v lo hi)
  (if (< (- hi lo) 12)
      (insertion-sort v lo hi)
      (let ((pivot (aref v (ash (+ lo hi) -1))) (i lo) (j hi))
        (loop while (<= i j)
              do (loop while (< (aref v i) pivot) do (incf i))
                 (loop while (> (aref v j) pivot) do (decf j))
                 (when (<= i j) (rotatef (aref v i) (aref v j)) (incf i) (decf j)))
        (qsort v lo j)
        (qsort v i hi)))
  v)
(defun fill-random (v seed)
  (dotimes (i (length v) seed)
    (setq seed (mod (+ (* seed 1103515245) 12345) 2147483648))
    (setf (aref v i) (mod seed 1000000))))
(defbench a-qsort (5)
  (let ((v (make-array 200000)))
    (fill-random v 42)
    (qsort v 0 (1- (length v)))
    (+ (aref v 0) (aref v 100000) (aref v 199999))))

;; sieve with a vector of T/NIL, counting through a helper
(defun mark-multiples (v p n)
  (loop for j from (* p p) below n by p do (setf (aref v j) nil)))
(defun count-true (v)
  (let ((c 0)) (dotimes (i (length v) c) (when (aref v i) (incf c)))))
(defbench a-sieve (10)
  (let* ((n 1000000) (v (make-array n :initial-element t)))
    (setf (aref v 0) nil (aref v 1) nil)
    (loop for p from 2 while (< (* p p) n)
          when (aref v p) do (mark-multiples v p n))
    (count-true v)))

;; vector of vectors (rows of a jagged table)
(defun row-sums (rows)
  (map 'vector (lambda (r) (let ((s 0)) (dotimes (i (length r) s) (incf s (aref r i))))) rows))
(defun pascal (n)
  (let ((rows (make-array n)))
    (dotimes (i n rows)
      (let ((r (make-array (1+ i) :initial-element 1)))
        (loop for j from 1 below i
              do (setf (aref r j) (logand (+ (aref (aref rows (1- i)) (1- j))
                                             (aref (aref rows (1- i)) j))
                                          #xFFFFF)))
        (setf (aref rows i) r)))))
(defbench a-jagged (30)
  (let ((s 0))
    (dotimes (k 5) (setq s (logand (+ s (reduce #'+ (row-sums (pascal 400)))) #xFFFFFFF)))
    s))

;;; ------------------------------------------- vectors with fill pointers

(defun stack-push (x s) (vector-push-extend x s))
(defun stack-pop (s) (vector-pop s))
(defun stack-empty-p (s) (zerop (length s)))
;; depth-first walk of an implicit tree with an explicit stack
(defbench a-fp-stack (40)
  (let ((s (make-array 16 :adjustable t :fill-pointer 0)) (sum 0))
    (dotimes (k 20)
      (stack-push 1 s)
      (loop until (stack-empty-p s)
            do (let ((n (stack-pop s)))
                 (incf sum n)
                 (when (< n 5000)
                   (stack-push (* 2 n) s)
                   (stack-push (1+ (* 2 n)) s)))))
    sum))

;; a growing buffer read and rewritten in place with AREF / (SETF AREF)
(defun smooth (buf)
  (loop for i from 1 below (1- (length buf))
        do (setf (aref buf i) (floor (+ (aref buf (1- i)) (aref buf i) (aref buf (1+ i))) 3)))
  buf)
(defbench a-fp-buffer (10)
  (let ((buf (make-array 0 :adjustable t :fill-pointer t)))
    (dotimes (i 100000) (vector-push-extend (mod (* i 37) 1000) buf))
    (dotimes (k 5) (smooth buf))
    (setf (fill-pointer buf) 50000)
    (+ (length buf) (reduce #'+ buf))))

;; binary heap of structures in an adjustable vector: event simulation
(defstruct event time id kind)
(defun heap-insert (heap ev)
  (vector-push-extend ev heap)
  (let ((i (1- (length heap))))
    (loop while (> i 0)
          do (let ((p (floor (1- i) 2)))
               (if (< (event-time (aref heap i)) (event-time (aref heap p)))
                   (progn (rotatef (aref heap i) (aref heap p)) (setq i p))
                   (return)))))
  heap)
(defun heap-pop (heap)
  (let ((top (aref heap 0)) (last (vector-pop heap)) (n (length heap)))
    (when (> n 0)
      (setf (aref heap 0) last)
      (let ((i 0))
        (loop
          (let* ((l (1+ (* 2 i))) (r (1+ l)) (m i))
            (when (and (< l n) (< (event-time (aref heap l)) (event-time (aref heap m)))) (setq m l))
            (when (and (< r n) (< (event-time (aref heap r)) (event-time (aref heap m)))) (setq m r))
            (when (= m i) (return))
            (rotatef (aref heap i) (aref heap m))
            (setq i m)))))
    top))
(defbench a-heap-sim (5)
  (let ((heap (make-array 0 :adjustable t :fill-pointer 0)) (seed 7) (done 0) (sum 0d0))
    (dotimes (i 2000)
      (setq seed (mod (+ (* seed 69069) 1) 4294967296))
      (heap-insert heap (make-event :time (/ seed 4294967296d0) :id i :kind (mod i 3))))
    (loop while (< done 200000)
          do (let ((ev (heap-pop heap)))
               (incf done)
               (incf sum (event-time ev))
               (setq seed (mod (+ (* seed 69069) 1) 4294967296))
               (setf (event-time ev) (+ (event-time ev) (/ seed 4294967296d0) (event-kind ev)))
               (heap-insert heap ev)))
    (round sum)))

;;; ------------------------------------------------------------ strings

(defun caesar (s k)
  (let ((r (make-string (length s))))
    (dotimes (i (length s) r)
      (let ((c (char s i)))
        (setf (char r i)
              (if (alpha-char-p c)
                  (code-char (+ 97 (mod (+ (- (char-code (char-downcase c)) 97) k) 26)))
                  c))))))
(defun count-char (s ch)
  (let ((n 0)) (dotimes (i (length s) n) (when (char= (char s i) ch) (incf n)))))
(defun reverse-words (s)
  (let ((r (copy-seq s)) (n (length s)))
    (let ((start 0))
      (loop for i from 0 to n
            do (when (or (= i n) (char= (char s i) #\Space))
                 (loop for a from start for b downfrom (1- i) while (< a b)
                       do (rotatef (char r a) (char r b)))
                 (setq start (1+ i)))))
    r))
(defbench a-strings (10)
  (let ((s (make-string 50000)) (n 0))
    (dotimes (i 50000) (setf (char s i) (if (zerop (mod i 7)) #\Space (code-char (+ 97 (mod (* i 13) 26))))))
    (dotimes (k 10)
      (let ((e (caesar s k)))
        (incf n (count-char e #\e))
        (incf n (count-char (reverse-words e) #\Space))))
    n))

;;; ---------------------------------------------- two-dimensional arrays

(defun life-step (from to h w)
  (dotimes (i h)
    (dotimes (j w)
      (let ((n 0))
        (loop for di from -1 to 1
              do (loop for dj from -1 to 1
                       do (unless (and (zerop di) (zerop dj))
                            (incf n (aref from (mod (+ i di) h) (mod (+ j dj) w))))))
        (setf (aref to i j)
              (if (or (= n 3) (and (= n 2) (= (aref from i j) 1))) 1 0))))))
(defbench a-life (20)
  (let* ((h 64) (w 64) (a (make-array (list h w) :initial-element 0)) (b (make-array (list h w) :initial-element 0)))
    (dotimes (i h) (dotimes (j w) (setf (aref a i j) (if (zerop (mod (+ (* i 7) (* j 11)) 5)) 1 0))))
    (dotimes (k 20) (life-step a b h w) (rotatef a b))
    (let ((c 0)) (dotimes (i h c) (dotimes (j w) (incf c (aref a i j)))))))

(defun mat-mul (a b)
  (let* ((n (array-dimension a 0)) (m (array-dimension b 1)) (p (array-dimension a 1))
         (c (make-array (list n m) :initial-element 0)))
    (dotimes (i n c)
      (dotimes (j m)
        (let ((s 0))
          (dotimes (k p) (incf s (* (aref a i k) (aref b k j))))
          (setf (aref c i j) (logand s #xFFFFFF)))))))
(defbench a-matmul (5)
  (let ((a (make-array '(80 80))) (b (make-array '(80 80))))
    (dotimes (i 80) (dotimes (j 80) (setf (aref a i j) (mod (+ i j) 10) (aref b i j) (mod (* i j) 10))))
    (let ((c (mat-mul (mat-mul a b) a))) (aref c 79 79))))

;;; --------------------------------------------------------- structures

(defstruct body x y z vx vy vz mass)
(defun advance (bodies dt)
  (let ((n (length bodies)))
    (dotimes (i n)
      (let ((a (aref bodies i)))
        (loop for j from (1+ i) below n
              do (let* ((b (aref bodies j))
                        (dx (- (body-x a) (body-x b)))
                        (dy (- (body-y a) (body-y b)))
                        (dz (- (body-z a) (body-z b)))
                        (d2 (+ (* dx dx) (* dy dy) (* dz dz) 0.01d0))
                        (mag (/ dt (* d2 (sqrt d2)))))
                   (decf (body-vx a) (* dx (body-mass b) mag))
                   (decf (body-vy a) (* dy (body-mass b) mag))
                   (decf (body-vz a) (* dz (body-mass b) mag))
                   (incf (body-vx b) (* dx (body-mass a) mag))
                   (incf (body-vy b) (* dy (body-mass a) mag))
                   (incf (body-vz b) (* dz (body-mass a) mag))))))
    (dotimes (i n)
      (let ((b (aref bodies i)))
        (incf (body-x b) (* dt (body-vx b)))
        (incf (body-y b) (* dt (body-vy b)))
        (incf (body-z b) (* dt (body-vz b)))))))
(defun energy (bodies)
  (let ((e 0d0))
    (dotimes (i (length bodies) e)
      (let ((b (aref bodies i)))
        (incf e (* 0.5d0 (body-mass b) (+ (* (body-vx b) (body-vx b)) (* (body-vy b) (body-vy b)) (* (body-vz b) (body-vz b)))))))))
(defbench a-nbody (5)
  (let ((bodies (make-array 12)))
    (dotimes (i 12)
      (setf (aref bodies i)
            (make-body :x (float i 1d0) :y (float (* i i) 1d0) :z (float (mod i 3) 1d0)
                       :vx 0d0 :vy 0d0 :vz 0d0 :mass (+ 1d0 (* 0.1d0 i)))))
    (dotimes (k 20000) (advance bodies 0.001d0))
    (round (* 1000 (energy bodies)))))

;; the same with the slots declared double floats
(defstruct dbody (x 0d0 :type double-float) (y 0d0 :type double-float) (z 0d0 :type double-float)
  (vx 0d0 :type double-float) (vy 0d0 :type double-float) (vz 0d0 :type double-float)
  (mass 1d0 :type double-float))
(defun dadvance (bodies dt)
  (let ((n (length bodies)))
    (dotimes (i n)
      (let ((a (aref bodies i)))
        (loop for j from (1+ i) below n
              do (let* ((b (aref bodies j))
                        (dx (- (dbody-x a) (dbody-x b)))
                        (dy (- (dbody-y a) (dbody-y b)))
                        (dz (- (dbody-z a) (dbody-z b)))
                        (d2 (+ (* dx dx) (* dy dy) (* dz dz) 0.01d0))
                        (mag (/ dt (* d2 (sqrt d2)))))
                   (decf (dbody-vx a) (* dx (dbody-mass b) mag))
                   (decf (dbody-vy a) (* dy (dbody-mass b) mag))
                   (decf (dbody-vz a) (* dz (dbody-mass b) mag))
                   (incf (dbody-vx b) (* dx (dbody-mass a) mag))
                   (incf (dbody-vy b) (* dy (dbody-mass a) mag))
                   (incf (dbody-vz b) (* dz (dbody-mass a) mag))))))
    (dotimes (i n)
      (let ((b (aref bodies i)))
        (incf (dbody-x b) (* dt (dbody-vx b)))
        (incf (dbody-y b) (* dt (dbody-vy b)))
        (incf (dbody-z b) (* dt (dbody-vz b)))))))
(defbench a-nbody-typed (20)
  (let ((bodies (make-array 12)))
    (dotimes (i 12)
      (setf (aref bodies i)
            (make-dbody :x (float i 1d0) :y (float (* i i) 1d0) :z (float (mod i 3) 1d0)
                        :mass (+ 1d0 (* 0.1d0 i)))))
    (dotimes (k 20000) (dadvance bodies 0.001d0))
    (let ((e 0d0))
      (dotimes (i 12 (round (* 1000 e)))
        (let ((b (aref bodies i)))
          (incf e (* 0.5d0 (dbody-mass b) (+ (* (dbody-vx b) (dbody-vx b)) (* (dbody-vy b) (dbody-vy b))
                                              (* (dbody-vz b) (dbody-vz b))))))))))

(defstruct counter (hits 0) (misses 0) name)
(defstruct (big-counter (:include counter)) (total 0))
(defun tally (c x)
  (if (evenp x) (incf (counter-hits c)) (incf (counter-misses c)))
  (when (big-counter-p c) (incf (big-counter-total c) x))
  c)
(defbench a-struct-int (100)
  (let ((cs (vector (make-counter :name "a") (make-big-counter :name "b") (make-counter :name "c")))
        (s 0))
    (dotimes (i 300000) (tally (svref cs (mod i 3)) i))
    (dotimes (i 3) (let ((c (copy-structure (svref cs i))))
                     (incf s (+ (counter-hits c) (counter-misses c)))
                     (when (typep c 'big-counter) (incf s (big-counter-total c)))))
    s))

(defstruct pt x y)
(defun pt-dist2 (a b) (let ((dx (- (pt-x a) (pt-x b))) (dy (- (pt-y a) (pt-y b)))) (+ (* dx dx) (* dy dy))))
(defun closest (pts)
  (let ((best most-positive-fixnum) (n (length pts)))
    (dotimes (i n best)
      (loop for j from (1+ i) below n
            do (setq best (min best (pt-dist2 (aref pts i) (aref pts j))))))))
(defbench a-struct-points (5)
  (let ((pts (make-array 1500)) (seed 3))
    (dotimes (i 1500)
      (setq seed (mod (+ (* seed 1103515245) 12345) 2147483648))
      (setf (aref pts i) (make-pt :x (mod seed 10000) :y (mod (ash seed -10) 10000))))
    (closest pts)))

(defstruct shape name)
(defstruct (circle (:include shape)) r)
(defstruct (rect (:include shape)) w h)
(defun area (s)
  (etypecase s
    (circle (* 3 (circle-r s) (circle-r s)))
    (rect (* (rect-w s) (rect-h s)))))
(defbench a-struct-dispatch (100)
  (let ((shapes (make-array 1000)) (s 0))
    (dotimes (i 1000)
      (setf (aref shapes i) (if (evenp i) (make-circle :name "c" :r (mod i 17)) (make-rect :name "r" :w (mod i 13) :h (mod i 7)))))
    (dotimes (k 200) (dotimes (i 1000) (incf s (area (aref shapes i)))))
    (dotimes (i 1000) (let ((c (copy-shape (aref shapes i)))) (when (circle-p c) (incf s))))
    s))
