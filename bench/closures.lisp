;;; Closures and calls of functions the compiler does not know: programs in
;;; combinator style (continuation passing, parser combinators, an
;;; interpreter compiled to closures, memoization, generators), written to
;;; measure how fast closures are made and called through FUNCALL and APPLY
;;; (tools/bench.sh bench/closures.lisp). Results must be single tokens.
(defmacro defbench (name (&optional (reps 1)) &body body)
  `(progn (defun ,name () ,@body) (run-bench ',name ,reps #',name)))

(defun run-bench (name reps fn)
  (funcall fn)
  (let ((start (get-internal-real-time)) (r nil))
    (dotimes (i reps) (setq r (funcall fn)))
    (let ((ms (round (* 1000 (- (get-internal-real-time) start))
                     internal-time-units-per-second)))
      (format t "~(~A~) ~D ~A~%" name ms
              (let ((s (prin1-to-string r))) (if (> (length s) 40) (subseq s 0 40) s))))))

;;; ---------- continuation-passing style ----------
(defun cps-fib (n k)
  (if (< n 2)
      (funcall k n)
      (cps-fib (- n 1) (lambda (a) (cps-fib (- n 2) (lambda (b) (funcall k (+ a b))))))))
(defbench k-cps-fib (40) (cps-fib 25 #'identity))

(defun cps-tree-sum (tree k)
  (cond ((null tree) (funcall k 0))
        ((atom tree) (funcall k tree))
        (t (cps-tree-sum (car tree)
                         (lambda (a) (cps-tree-sum (cdr tree)
                                                   (lambda (b) (funcall k (+ a b)))))))))
(defun build-tree (d) (if (= d 0) 1 (cons (build-tree (1- d)) (build-tree (1- d)))))
(defbench k-cps-tree (40)
  (let ((tree (build-tree 16)) (s 0))
    (dotimes (i 2) (incf s (cps-tree-sum tree (lambda (x) (+ x i)))))
    s))

;;; ---------- parser combinators ----------
;; A parser is a function of (string pos) returning the value and the new
;; position, or NIL and NIL on failure.
(defun p-char (pred)
  (lambda (s pos)
    (if (and (< pos (length s)) (funcall pred (char s pos)))
        (values (char s pos) (1+ pos))
        (values nil nil))))
(defun p-seq (f &rest parsers)
  (lambda (s pos)
    (let ((vals '()))
      (dolist (p parsers (values (apply f (nreverse vals)) pos))
        (multiple-value-bind (v np) (funcall p s pos)
          (unless np (return (values nil nil)))
          (push v vals) (setq pos np))))))
(defun p-alt (&rest parsers)
  (lambda (s pos)
    (dolist (p parsers (values nil nil))
      (multiple-value-bind (v np) (funcall p s pos)
        (when np (return (values v np)))))))
(defun p-many1 (p f init)
  (lambda (s pos)
    (multiple-value-bind (v np) (funcall p s pos)
      (if (null np)
          (values nil nil)
          (let ((acc (funcall f init v)))
            (loop (multiple-value-bind (v2 np2) (funcall p s np)
                    (unless np2 (return (values acc np)))
                    (setq acc (funcall f acc v2) np np2))))))))
(defun p-lazy (thunk) (lambda (s pos) (funcall (funcall thunk) s pos)))
(defun p-chainl (term op)
  (lambda (s pos)
    (multiple-value-bind (v np) (funcall term s pos)
      (if (null np)
          (values nil nil)
          (loop (multiple-value-bind (f np2) (funcall op s np)
                  (unless np2 (return (values v np)))
                  (multiple-value-bind (v2 np3) (funcall term s np2)
                    (unless np3 (return (values v np)))
                    (setq v (funcall f v v2) np np3))))))))
(defun make-expr-parser ()
  (let (expr)
    (let* ((num (p-many1 (p-char #'digit-char-p)
                         (lambda (acc c) (+ (* acc 10) (digit-char-p c))) 0))
           (paren (p-seq (lambda (l e r) (declare (ignore l r)) e)
                         (p-char (lambda (c) (char= c #\()))
                         (p-lazy (lambda () expr))
                         (p-char (lambda (c) (char= c #\))))))
           (atom (p-alt num paren))
           (mulop (p-seq (lambda (c) (if (char= c #\*) #'* (lambda (a b) (mod a (max b 1)))))
                         (p-char (lambda (c) (or (char= c #\*) (char= c #\%))))))
           (addop (p-seq (lambda (c) (if (char= c #\+) #'+ #'-))
                         (p-char (lambda (c) (or (char= c #\+) (char= c #\-))))))
           (term (p-chainl atom mulop)))
      (setq expr (p-chainl term addop))
      expr)))
(defun gen-expr (seed depth)
  (with-output-to-string (o)
    (labels ((rnd () (setq seed (mod (+ (* seed 1103515245) 12345) 2147483648)) (ash seed -16))
             (gen (d)
               (if (or (= d 0) (< (mod (rnd) 10) 3))
                   (format o "~D" (mod (rnd) 1000))
                   (progn
                     (when (oddp (rnd)) (write-char #\( o))
                     (gen (1- d))
                     (write-char (char "+-*%" (mod (rnd) 4)) o)
                     (gen (1- d))
                     (when (evenp seed) nil)
                     (write-char #\) o)))))
      (write-char #\( o)
      (gen depth))))
(defbench k-parser (25)
  (let ((parser (make-expr-parser))
        (inputs (loop for i below 40 collect (let ((s (gen-expr (+ i 7) 9)))
                                               ;; balance the parentheses
                                               (let ((open (count #\( s)) (close (count #\) s)))
                                                 (concatenate 'string (make-string (max 0 (- close open)) :initial-element #\()
                                                              s (make-string (max 0 (- open close)) :initial-element #\)))))))
        (s 0))
    (dotimes (r 20)
      (dolist (in inputs)
        (multiple-value-bind (v np) (funcall parser in 0)
          (setq s (logand (+ s (if np (+ np (logand v #xFFFF)) 1)) #xFFFFFFF)))))
    s))

;;; ---------- an interpreter compiled to closures ----------
;; Expressions: numbers, symbols (variables in a vector environment), and
;; (op args...) with + - * < if let lambda call.
(defun cc-compile (x env)
  (cond ((integerp x) (lambda (frame) (declare (ignore frame)) x))
        ((symbolp x)
         (let ((depth 0) (index nil))
           (dolist (scope env (error "unbound ~S" x))
             (let ((p (position x scope)))
               (when p (setq index p) (return)))
             (incf depth))
           (case depth
             (0 (lambda (frame) (svref (car frame) index)))
             (1 (lambda (frame) (svref (cadr frame) index)))
             (t (lambda (frame) (svref (nth depth frame) index))))))
        (t
         (case (car x)
           (+ (let ((a (cc-compile (second x) env)) (b (cc-compile (third x) env)))
                (lambda (f) (+ (funcall a f) (funcall b f)))))
           (- (let ((a (cc-compile (second x) env)) (b (cc-compile (third x) env)))
                (lambda (f) (- (funcall a f) (funcall b f)))))
           (* (let ((a (cc-compile (second x) env)) (b (cc-compile (third x) env)))
                (lambda (f) (* (funcall a f) (funcall b f)))))
           (< (let ((a (cc-compile (second x) env)) (b (cc-compile (third x) env)))
                (lambda (f) (< (funcall a f) (funcall b f)))))
           (if (let ((c (cc-compile (second x) env)) (a (cc-compile (third x) env))
                     (b (cc-compile (fourth x) env)))
                 (lambda (f) (if (funcall c f) (funcall a f) (funcall b f)))))
           (lambda (let* ((params (second x))
                          (body (cc-compile (third x) (cons (coerce params 'vector) env)))
                          (n (length params)))
                     (lambda (f)
                       (lambda (&rest args)
                         (let ((v (make-array n)))
                           (loop for a in args for i from 0 do (setf (svref v i) a))
                           (funcall body (cons v f)))))))
           (letrec (let* ((name (second x))
                          (inner (cons (vector name) env))
                          (val (cc-compile (third x) inner))
                          (body (cc-compile (fourth x) inner)))
                     (lambda (f)
                       (let* ((v (vector nil)) (f2 (cons v f)))
                         (setf (svref v 0) (funcall val f2))
                         (funcall body f2)))))
           (t (let ((fn (cc-compile (car x) env))
                    (args (mapcar (lambda (a) (cc-compile a env)) (cdr x))))
                (case (length args)
                  (1 (let ((a (first args)))
                       (lambda (f) (funcall (funcall fn f) (funcall a f)))))
                  (2 (let ((a (first args)) (b (second args)))
                       (lambda (f) (funcall (funcall fn f) (funcall a f) (funcall b f)))))
                  (t (lambda (f) (apply (funcall fn f)
                                        (mapcar (lambda (a) (funcall a f)) args)))))))))))
(defbench k-closure-interp (40)
  (let ((code (cc-compile '(letrec fib (lambda (n) (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))
                            (letrec ack (lambda (m n acc) (if (< m 1) (+ n acc) (ack (- m 1) (+ n 1) (+ acc m))))
                             (+ (fib 22) (ack 30 2 0))))
                          '())))
    (funcall code '())))

;;; ---------- memoization ----------
(defun memoize (fn)
  (let ((table (make-hash-table :test 'equal)))
    (lambda (&rest args)
      (multiple-value-bind (v found) (gethash args table)
        (if found v (setf (gethash args table) (apply fn args)))))))
(defvar *lcs*)
(defun lcs-len (a b i j)
  (cond ((or (= i (length a)) (= j (length b))) 0)
        ((char= (char a i) (char b j)) (1+ (funcall *lcs* a b (1+ i) (1+ j))))
        (t (max (funcall *lcs* a b (1+ i) j) (funcall *lcs* a b i (1+ j))))))
(defbench k-memoize (60)
  (let ((s 0))
    (dotimes (r 3)
      (setq *lcs* (memoize #'lcs-len))
      (incf s (funcall *lcs* "the quick brown fox jumps over the lazy dog again"
                       "a lazy dog sleeps while the quick brown fox runs on" 0 0)))
    s))

;;; ---------- generators and boxed variables ----------
(defun make-gen (from step)
  (let ((n from)) (lambda () (prog1 n (incf n step)))))
(defun gen-map (f g) (lambda () (funcall f (funcall g))))
(defun gen-filter (pred g) (lambda () (loop (let ((x (funcall g))) (when (funcall pred x) (return x))))))
(defun gen-zip (f g h) (lambda () (funcall f (funcall g) (funcall h))))
(defbench k-generators (5)
  (let* ((g (gen-zip #'+ (gen-filter #'oddp (gen-map (lambda (x) (* x 3)) (make-gen 0 1)))
                     (gen-map #'1+ (make-gen 100 7))))
         (s 0))
    (dotimes (i 1000000) (setq s (logand (+ s (funcall g)) #xFFFFFF)))
    s))

;;; ---------- Church numerals and combinators ----------
(defun church (n) (lambda (f) (lambda (x) (dotimes (i n x) (setq x (funcall f x))))))
(defun c-add (m n) (lambda (f) (lambda (x) (funcall (funcall m f) (funcall (funcall n f) x)))))
(defun c-mul (m n) (lambda (f) (funcall m (funcall n f))))
(defun unchurch (c) (funcall (funcall c #'1+) 0))
(defbench k-church (40)
  (let ((s 0))
    (dotimes (i 3000)
      (incf s (unchurch (c-mul (c-add (church 3) (church (mod i 7))) (church 20)))))
    s))

;;; ---------- a pattern matcher compiled to closures ----------
;; Patterns: ?x binds, _ matches anything, (a . b), literals with EQL. A
;; compiled pattern is a function of the datum, the bindings and the success
;; continuation.
(defun compile-pattern (pat)
  (cond ((eq pat '_) (lambda (x b k) (declare (ignore x)) (funcall k b)))
        ((and (symbolp pat) (char= (char (symbol-name pat) 0) #\?))
         (lambda (x b k)
           (let ((old (assoc pat b)))
             (cond ((null old) (funcall k (acons pat x b)))
                   ((equal (cdr old) x) (funcall k b))
                   (t nil)))))
        ((consp pat)
         (let ((car-m (compile-pattern (car pat))) (cdr-m (compile-pattern (cdr pat))))
           (lambda (x b k)
             (and (consp x)
                  (funcall car-m (car x) b (lambda (b2) (funcall cdr-m (cdr x) b2 k)))))))
        (t (lambda (x b k) (and (eql x pat) (funcall k b))))))
(defun make-matcher (pat)
  (let ((m (compile-pattern pat)))
    (lambda (x) (funcall m x '() (lambda (b) (or b t))))))
(defbench k-matcher (10)
  (let ((ms (list (make-matcher '(+ ?a ?b))
                  (make-matcher '(* ?a (+ ?b ?c)))
                  (make-matcher '(f ?a ?a _))
                  (make-matcher '(let ((?v ?e)) ?body))))
        (data (list '(+ 1 2) '(* 3 (+ 4 5)) '(f x x y) '(f x z y) '(let ((a 1)) a)
                    '(- 1 2) '(* 3 (- 4 5)) '(let ((a 1) (b 2)) a)))
        (s 0))
    (dotimes (i 20000)
      (dolist (d data)
        (dolist (m ms)
          (when (funcall m d) (incf s)))))
    s))

;;; ---------- higher-order list functions written by the user ----------
(defun my-fold (f init list) (if (null list) init (my-fold f (funcall f init (car list)) (cdr list))))
(defun my-map (f list) (if (null list) nil (cons (funcall f (car list)) (my-map f (cdr list)))))
(defun my-filter (p list) (cond ((null list) nil)
                                ((funcall p (car list)) (cons (car list) (my-filter p (cdr list))))
                                (t (my-filter p (cdr list)))))
(defun compose (&rest fns)
  (if (null fns) #'identity
      (let ((f (car fns)) (g (apply #'compose (cdr fns))))
        (lambda (x) (funcall f (funcall g x))))))
(defun curry (f &rest args) (lambda (&rest more) (apply f (append args more))))
(defbench k-higher-order (20)
  (let ((list (loop for i below 200 collect i)) (s 0))
    (dotimes (r 1000)
      (let ((step (compose (curry #'+ r) (lambda (x) (* x 2)) #'1+)))
        (setq s (logand (+ s (my-fold #'+ 0 (my-filter (lambda (x) (zerop (mod x 3)))
                                                     (my-map step list))))
                        #xFFFFFF))))
    s))

;;; ---------- labels functions passed as values ----------
(defun tree-walk (tree)
  (let ((count 0) (sum 0))
    (labels ((visit (x) (incf count) (incf sum x))
             (walk (x fn) (cond ((null x)) ((atom x) (funcall fn x))
                                (t (walk (car x) fn) (walk (cdr x) fn)))))
      (walk tree #'visit)
      (+ count sum))))
(defbench k-labels-escape (60) (tree-walk (build-tree 17)))

;;; ---------- funcall of closures with optional and rest arguments ----------
(defun make-adder (n) (lambda (x &optional (y 0)) (+ x y n)))
(defun make-summer (n) (lambda (&rest xs) (let ((s n)) (dolist (x xs s) (incf s x)))))
(defbench k-funcall-args (5)
  (let ((fs (list (make-adder 1) (make-adder 2))) (gs (list (make-summer 1) (make-summer 2))) (s 0))
    (dotimes (i 500000)
      (dolist (f fs) (incf s (funcall f i)) (incf s (funcall f i 1)))
      (dolist (g gs) (incf s (funcall g i 1 2)) (incf s (apply g i '(3 4))))
      (setq s (logand s #xFFFFFF)))
    s))
