;;; Clysm benchmarks, fourth file -- library functions: type tests, sequences,
;;; lists, strings, hash tables, symbols.  Each program was written after an
;;; optimization of the runtime library, to differ from the benchmark that
;;; motivated it (other types, other arguments, other functions of the same
;;; family); none was tuned on.  Run with tools/bench.sh bench/library.lisp.

(defmacro defbench (name (&optional (reps 1)) &body body)
  `(progn
     (defun ,name () ,@body)
     (run-bench ',name ,reps #',name)))

(defun run-bench (name reps fn)
  (funcall fn)                          ; warm up
  (let ((start (get-internal-real-time)) (r nil))
    (dotimes (i reps) (setq r (funcall fn)))
    (let ((ms (round (* 1000 (- (get-internal-real-time) start))
                     internal-time-units-per-second)))
      (format t "~(~A~) ~D ~A~%" name ms
              (let ((s (prin1-to-string r))) (if (> (length s) 40) (subseq s 0 40) s))))))


;;; ------------------------------------------------------------ type tests

(deftype octet () '(unsigned-byte 8))
(deftype index (&optional (max 1000)) `(integer 0 ,max))
(deftype name () '(or string symbol))
(defstruct shape2 id)
(defstruct (circle2 (:include shape2)) r)
(defstruct (square2 (:include shape2)) side)
(defclass vehicle () ())
(defclass car2 (vehicle) ())
(defclass truck (car2) ())
(define-condition oops (error) ())
(defun kind (x)
  (typecase x
    (octet 1) ((index 5000) 2) (name 3) (circle2 4) (square2 5) (shape2 6) (truck 7) (vehicle 8)
    (oops 9) ((cons integer) 10) ((member :a :b :c) 11) (float 12) (t 13)))
(defun checked-add (a b)
  (check-type a (integer 0 100000))
  (check-type b fixnum)
  (+ a b))
(defbench v-typecase-deftype (10)
  (let ((things (list 7 300 3000 70000 "s" 'a (make-circle2 :r 1) (make-square2) (make-shape2)
                      (make-instance 'truck) (make-instance 'vehicle) (make-condition 'oops)
                      (list 1 2) (list "a") :b 1.5 #\c))
        (s 0))
    (dotimes (i 100000) (dolist (x things) (incf s (kind x))))
    s))
(defbench v-typep-class (10)
  (let ((things (list 1 "s" (make-circle2) (make-shape2) (make-instance 'truck) (make-instance 'car2)
                      (make-condition 'oops) (make-hash-table) #'car))
        (s 0))
    (dotimes (i 100000)
      (dolist (x things)
        (when (typep x 'vehicle) (incf s))
        (when (typep x 'shape2) (incf s 2))
        (when (typep x 'error) (incf s 3))
        (when (typep x '(or car2 circle2 hash-table)) (incf s 4))
        (when (typep x 'function) (incf s 5))
        (when (typep x '(and vehicle (not truck))) (incf s 6))))
    s))
(defbench v-check-type (10)
  (let ((s 0))
    (dotimes (i 1000000) (setq s (logand (checked-add (logand i 1023) s) 65535)))
    s))
(defbench v-typep-runtime (10)
  (let ((things (list 1 "s" (make-circle2) 'a 2.5 (make-instance 'truck)))
        (types (list 'integer 'string 'shape2 'symbol '(or float symbol) 'vehicle 'octet '(integer 0 10)))
        (s 0))
    (dotimes (i 20000)
      (dolist (x things) (dolist (ty types) (when (typep x ty) (incf s)))))
    s))

;;; ------------------------------------------------------------ coerce

(defbench v-coerce-seq (10)
  (let* ((l (loop for i below 50 collect i)) (v (coerce l 'simple-vector)) (chars (coerce "hello, world" 'list))
         (adj (make-array 50 :adjustable t :fill-pointer 30 :initial-element 7)) (n 0))
    (dotimes (i 20000)
      (incf n (length (coerce v 'list)))
      (incf n (length (coerce l 'simple-vector)))
      (incf n (length (coerce chars 'string)))
      (incf n (length (coerce "hello" 'simple-vector)))
      (incf n (length (coerce adj 'simple-vector)))
      (incf n (length (coerce adj 'list)))
      (incf n (length (coerce chars 'simple-string)))
      (when (eq (coerce v 'vector) v) (incf n)))
    n))
(defbench v-coerce-num (10)
  (let ((s 0d0) (types '(double-float single-float float)))
    (dotimes (i 200000)
      (incf s (coerce (- i) 'double-float))
      (incf s (coerce (* i 1.5) 'double-float))
      (incf s (coerce i 'float))
      (incf s (coerce (coerce i 'single-float) 'double-float))
      (incf s (coerce i (car types))))
    (round s)))
(defbench v-coerce-general (10)
  (let ((l (list 1 2 3 4 5 6 7 8)) (n 0) (ty (list 'vector 'list 'simple-vector)))
    (dotimes (i 50000)
      (incf n (length (coerce l '(vector t))))
      (incf n (length (coerce l '(simple-array t (*)))))
      (incf n (length (coerce "abc" '(simple-array character (*)))))
      (dolist (type ty) (incf n (length (coerce l type))))
      (incf n (char-code (coerce #\a 'character)))
      (incf n (funcall (coerce 'car 'function) l)))
    n))

;;; ------------------------------------------------------------ equal, strings, characters

(defstruct pnt x y)
(defbench v-equal-trees (10)
  (let* ((a (loop for i below 200 collect (list i (format nil "s~D" i) (code-char (+ 65 (mod i 26))) (* i 1.5d0) 'sym)))
         (b (copy-tree a)) (c (copy-tree a)) (n 0))
    (setf (second (nth 150 c)) "other")
    (dotimes (i 2000)
      (when (equal a b) (incf n))
      (when (equal a c) (incf n 2))
      (when (equal (car a) (car b)) (incf n))
      (when (tree-equal a b :test #'equal) (incf n)))
    n))
(defbench v-equalp-mixed (10)
  (let* ((a (list (vector 1 2.0 "Three" #\f) (make-pnt :x 1 :y "abc") "Hello World" 42 (list 1 2 (vector 'a 'b))
                  (make-array 4 :fill-pointer 3 :initial-element 9)))
         (b (list (vector 1.0 2 "THREE" #\F) (make-pnt :x 1.0 :y "ABC") "hello world" 42.0 (list 1 2 (vector 'a 'b))
                  (vector 9 9 9)))
         (n 0))
    (dotimes (i 100000)
      (when (equalp a b) (incf n))
      (when (equalp (third a) (third b)) (incf n))
      (when (equalp (second a) (second b)) (incf n))
      (when (equal (third a) (third b)) (incf n)))
    n))
(defbench v-string-compare (10)
  (let* ((words (loop for i below 200 collect (format nil "word~4,'0D-~A" (mod (* i 37) 200) (if (evenp i) "x" "Y"))))
         (buf (make-array 20 :element-type 'character :fill-pointer 0 :adjustable t)) (n 0))
    (loop for c across "word0100-x" do (vector-push-extend c buf))
    (dotimes (i 300)
      (dolist (w words)
        (when (string< w "word0100") (incf n))
        (when (string-equal w "WORD0100-X") (incf n 2))
        (when (string= w buf) (incf n 3))
        (when (string>= w buf :start1 4 :start2 4) (incf n))
        (when (string-lessp w "WORD0050-y" :end1 8 :end2 8) (incf n))
        (when (char-equal (char w 9) #\X) (incf n))
        (when (char< (char w 5) #\1) (incf n))
        (incf n (or (string/= w buf) 0))))
    n))
(defbench v-string-case (10)
  (let ((words (loop for i below 100 collect (format nil "  the Quick brown-fox ~D jumps  " i))) (n 0))
    (dotimes (i 200)
      (dolist (w words)
        (incf n (length (string-upcase w)))
        (incf n (length (string-downcase w :start 5)))
        (incf n (length (string-capitalize w)))
        (incf n (length (string-trim " " w)))
        (incf n (length (string-left-trim " t" w)))
        (incf n (count-if #'upper-case-p w))
        (incf n (count-if #'alphanumericp w))
        (incf n (or (position #\j w) 0))))
    n))

;;; ------------------------------------------------------------ hash tables

(defbench v-hash-equalp (10)
  (let ((h (make-hash-table :test 'equalp)) (n 0)
        (keys (loop for i below 2000 collect (if (evenp i) (format nil "Key~D" i) (vector i "x" (float i))))))
    (dotimes (r 10)
      (dolist (k keys) (setf (gethash k h) r))
      (dolist (k keys) (incf n (gethash (if (stringp k) (string-upcase k) (copy-seq k)) h 0))))
    (+ n (hash-table-count h))))
(defbench v-hash-churn (10)
  (let ((h (make-hash-table :test 'eql)) (n 0))
    (dotimes (i 200000)
      (setf (gethash i h) i)
      (when (>= i 100) (remhash (- i 100) h))
      (when (gethash (- i 50) h) (incf n)))
    (+ n (hash-table-count h))))
(defbench v-hash-iterate (10)
  (let ((h (make-hash-table :test 'eq)) (n 0) (syms (loop for i below 3000 collect (make-symbol (format nil "S~D" i)))))
    (dolist (s syms) (setf (gethash s h) (length (symbol-name s))))
    (dotimes (r 30)
      (maphash (lambda (k v) (declare (ignore k)) (incf n v)) h)
      (with-hash-table-iterator (next h)
        (loop (multiple-value-bind (more k v) (next) (declare (ignore k)) (unless more (return)) (incf n v))))
      (loop for k being the hash-keys of h using (hash-value v) do (incf n v))
      (loop for v being the hash-values of h do (incf n v)))
    n))
(defbench v-hash-mixed-keys (10)
  (let ((h (make-hash-table)) (h2 (make-hash-table :test 'equal)) (n 0))
    (dotimes (i 50000)
      (setf (gethash (* i 24) h) i)
      (setf (gethash (code-char (+ 32 (mod i 5000))) h) i)
      (setf (gethash (cons (mod i 100) (mod i 7)) h2) i))
    (dotimes (i 50000)
      (incf n (gethash (* i 24) h 0))
      (incf n (gethash (cons (mod i 100) (mod i 7)) h2 0)))
    (+ (logand n #xFFFFFF) (hash-table-count h) (hash-table-count h2))))
(defbench v-hash-double-keys (10)
  (let ((h (make-hash-table)) (h2 (make-hash-table :test 'equal)) (n 0))
    (dotimes (i 2000)
      (setf (gethash (* i 0.5d0) h) i)
      (setf (gethash (/ i 3.0) h2) i))
    (dotimes (k 20)
      (dotimes (i 2000)
        (incf n (gethash (* i 0.5d0) h 0))
        (incf n (gethash (/ i 3.0) h2 0))))
    (+ n (hash-table-count h) (hash-table-count h2))))
(defbench v-sxhash (10)
  (let ((things (list "a string" 'sym 12345 (list 1 2 (list 3 "x")) 1.5d0 #\c (expt 10 20) 2/3 "another, longer string here")) (n 0))
    (dotimes (i 200000) (dolist (x things) (setq n (logxor n (sxhash x)))))
    n))

;;; ------------------------------------------------------------ lists, sorting, vectors with fill pointers

(defbench v-assoc-member (10)
  (let* ((al (loop for i below 300 collect (cons (format nil "k~D" i) i)))
         (syms (loop for i below 300 collect (intern (format nil "S~D" i))))
         (sal (loop for s in syms for i from 0 collect (cons s i)))
         (pl (loop for s in syms for i from 0 append (list s i)))
         (n 0))
    (dotimes (k 30)
      (dolist (s syms)
        (incf n (cdr (assoc s sal)))
        (incf n (cdr (assoc s sal :test #'eq)))
        (incf n (cdr (rassoc (cdr (assoc s sal)) sal)))
        (incf n (getf pl s))
        (incf n (length (member s syms)))
        (incf n (length (member s syms :test #'eq :key #'identity))))
      (dolist (e al)
        (incf n (cdr (assoc (car e) al :test #'string=)))
        (incf n (cdr (assoc (car e) al :test #'equal)))
        (incf n (cdr (assoc-if (lambda (k) (eq k (car e))) al)))
        (when (member (car e) al :key #'car :test #'string-equal) (incf n))
        (when (rassoc-if #'minusp al) (incf n))))
    n))
(defbench v-set-ops (10)
  (let* ((a (loop for i below 1500 collect (* i 3))) (b (loop for i below 1500 collect (* i 5)))
         (sa (loop for i below 400 collect (format nil "s~D" (* i 3)))) (sb (loop for i below 400 collect (format nil "s~D" (* i 5))))
         (pa (loop for i below 300 collect (cons (* i 2) i))) (pb (loop for i below 300 collect (cons (* i 3) i)))
         (small-a '(1 2 3 4 5 6)) (small-b '(4 5 6 7 8))
         (n 0))
    (dotimes (k 3)
      (incf n (length (union a b)))
      (incf n (length (intersection a b)))
      (incf n (length (set-difference a b)))
      (incf n (length (set-exclusive-or a b)))
      (when (subsetp (intersection a b) a) (incf n))
      (incf n (length (union sa sb :test #'equal)))
      (incf n (length (intersection sa sb :test #'string=)))
      (incf n (length (set-difference pa pb :key #'car)))
      (incf n (length (nunion (copy-list pa) (copy-list pb) :key #'car :test #'=)))
      (dotimes (j 2000)
        (incf n (length (union small-a small-b)))
        (incf n (length (intersection small-a small-b)))
        (when (subsetp small-b small-a) (incf n))
        (incf n (length (adjoin j small-a)))))
    n))
(defbench v-mapping (10)
  (let* ((a (loop for i below 5000 collect i)) (b (reverse a)) (n 0))
    (dotimes (k 20)
      (incf n (length (mapcar #'+ a b)))
      (incf n (car (car (mapcar #'cons a b))))
      (mapc (lambda (x y) (incf n (logand (logxor x y) 1))) a b)
      (incf n (length (mapcan (lambda (x) (if (evenp x) (list x) nil)) a)))
      (incf n (length (mapcan (lambda (x y) (if (< x y) (list x y) nil)) a b)))
      (incf n (length (mapcar (lambda (x y z) (+ x y z)) a b a))))
    n))
(defbench v-sort (10)
  (let* ((recs (loop for i below 5000 collect (list (mod (* i 7919) 1009) (format nil "name~D" (mod (* i 31) 500)) (* i 1.5d0))))
         (v (coerce recs 'vector))
         (nums (coerce (loop for i below 20000 collect (mod (* i 7919) 10007)) 'vector))
         (str (coerce (loop for i below 5000 collect (code-char (+ 97 (mod (* i 7) 26)))) 'string))
         (adj (make-array 5000 :adjustable t :fill-pointer 5000 :initial-contents (loop for i below 5000 collect (mod (* i 37) 1000))))
         (n 0))
    (incf n (aref (sort (copy-seq nums) #'<) 100))
    (incf n (aref (sort (copy-seq nums) #'>) 100))
    (incf n (aref (stable-sort (copy-seq nums) (lambda (a b) (< (mod a 100) (mod b 100)))) 100))
    (incf n (first (aref (sort (copy-seq v) #'< :key #'first) 10)))
    (incf n (first (aref (stable-sort (copy-seq v) #'string< :key #'second) 10)))
    (incf n (first (first (sort (copy-list recs) #'string> :key #'second))))
    (incf n (first (first (sort (copy-list recs) #'> :key #'third))))
    (incf n (char-code (char (sort (copy-seq str) #'char<) 2500)))
    (incf n (aref (sort adj #'<) 2500))
    (incf n (length (merge 'vector (sort (subseq nums 0 5000) #'<) (sort (subseq nums 5000 10000) #'<) #'<)))
    (incf n (length (merge 'list (sort (subseq recs 0 100) #'< :key #'first) (sort (subseq recs 100 300) #'< :key #'first) #'< :key #'first)))
    n))
(defbench v-vector-push (10)
  (let ((n 0))
    (dotimes (k 20)
      (let ((v (make-array 0 :adjustable t :fill-pointer t))
            (s (make-array 0 :element-type 'character :adjustable t :fill-pointer 0))
            (fixed (make-array 3000 :fill-pointer 0)))
        (dotimes (i 3000) (vector-push-extend (cons i k) v) (vector-push i fixed)
          (vector-push-extend (code-char (+ 65 (mod i 26))) s 64))
        (dotimes (i 1000) (incf n (car (vector-pop v))) (incf n (vector-pop fixed)))
        (setf (fill-pointer v) 500)
        (adjust-array v 4000)
        (incf n (+ (length v) (fill-pointer fixed) (length s) (array-dimension v 0)))
        (incf n (count #\A s))
        (incf n (reduce #'+ fixed))))
    n))

;;; ------------------------------------------------------------ symbols and packages

(defpackage :vp1 (:use :cl) (:export #:alpha #:beta))
(defpackage :vp2 (:use :cl :vp1))
(defbench v-intern-packages (10)
  (let ((names (loop for i below 500 collect (format nil "NAME-~D" i))) (n 0)
        (p2 (find-package "VP2")))
    (dotimes (k 200)
      (dolist (nm names)
        (multiple-value-bind (s status) (intern nm p2) (when status (incf n)) (incf n (length (symbol-name s))))
        (when (find-symbol nm "VP2") (incf n))
        (unless (find-symbol nm :vp1) (incf n))
        (when (eq (symbol-package (intern nm :keyword)) (find-package :keyword)) (incf n)))
      (when (eq (find-symbol "ALPHA" :vp2) 'vp1:alpha) (incf n))
      (when (eq (nth-value 1 (find-symbol "CAR" p2)) :inherited) (incf n))
      (incf n (length (package-name (find-package "COMMON-LISP")))))
    n))
(defbench v-plist (10)
  (let ((syms (loop for i below 100 collect (make-symbol (format nil "G~D" i)))) (n 0))
    (dotimes (k 2000)
      (dolist (s syms)
        (setf (get s 'color) k (get s 'size) (+ k 1) (get s :weight) (* k 2))
        (incf n (+ (get s 'color) (get s 'size) (get s :weight 0) (get s 'missing 1)))
        (incf n (length (symbol-plist s)))
        (when (remprop s 'size) (incf n))
        (incf n (getf (symbol-plist s) :weight))
        (multiple-value-bind (ind val) (get-properties (symbol-plist s) '(:weight color)) (declare (ignore ind)) (incf n val))))
    n))

;;; ------------------------------------------------------------ sequences

(defstruct rec id name tags)
(defun make-recs (n)
  (loop for i below n collect (make-rec :id (mod (* i 7919) 1000) :name (format nil "n~D" (mod i 300))
                                        :tags (list (mod i 5) (mod i 3)))))

;; find/position/count on LISTS with :key, :from-end, :test, :start/:end
(defbench v-find-list-key (10)
  (let ((l (make-recs 5000)) (s 0))
    (dotimes (k 40)
      (incf s (or (position (+ 400 k) l :key #'rec-id) 0))
      (incf s (or (position (+ 400 k) l :key #'rec-id :from-end t) 0))
      (incf s (rec-id (find "n299" l :key #'rec-name :test #'string=)))
      (incf s (count k l :key #'rec-id :start 100 :end 4000))
      (incf s (count-if-not #'evenp l :key #'rec-id :from-end t))
      (incf s (length (rec-tags (find-if (lambda (tg) (equal tg '(4 2))) l :key #'rec-tags :from-end t))))
      (incf s (or (position '(3 1) l :key #'rec-tags :test-not #'equal) 0)))
    s))

;; the same on adjustable vectors and strings
(defbench v-find-adjustable (10)
  (let ((v (make-array 10 :adjustable t :fill-pointer 0))
        (str (make-array 10 :element-type 'character :adjustable t :fill-pointer 0))
        (s 0))
    (dotimes (i 20000) (vector-push-extend (mod (* i 31) 997) v)
      (vector-push-extend (code-char (+ 97 (mod (* i 7) 26))) str))
    (dotimes (k 30)
      (incf s (or (position (+ 900 k) v :from-end t) 0))
      (incf s (count-if #'oddp v :start 10))
      (incf s (or (find 996 v :test #'<) 0))
      (incf s (count #\e str))
      (incf s (or (position #\z str :from-end t :end 15000) 0))
      (incf s (or (position-if #'upper-case-p str) 0))
      (incf s (count #\A str :test #'char-equal)))
    s))

;; remove/delete on vectors, strings and lists with :key/:count/:from-end/:start
(defbench v-remove (10)
  (let ((v (coerce (loop for i below 20000 collect (mod (* i 37) 100)) 'vector))
        (l (loop for i below 20000 collect (cons (mod i 10) i)))
        (str (make-string 20000 :initial-element #\a))
        (s 0))
    (dotimes (i 20000) (when (zerop (mod i 3)) (setf (char str i) #\b)))
    (dotimes (k 10)
      (incf s (length (remove 50 v)))
      (incf s (length (remove 50 v :test #'<)))
      (incf s (length (remove-if #'evenp v :count 100 :from-end t)))
      (incf s (length (remove 3 l :key #'car)))
      (incf s (length (remove-if-not #'zerop l :key #'car :start 5000)))
      (incf s (length (delete 7 (copy-list l) :key #'car :count 500)))
      (incf s (length (remove #\b str)))
      (incf s (length (delete #\a (copy-seq str) :start 100 :end 10000))))
    s))

;; remove-duplicates/delete-duplicates on vectors, strings, lists; equal/equalp/key/from-end
(defbench v-dedup (10)
  (let ((v (coerce (loop for i below 3000 collect (mod (* i 37) 700)) 'vector))
        (names (loop for i below 3000 collect (format nil "k~D" (mod (* i 13) 500))))
        (pairs (loop for i below 3000 collect (cons (mod (* i 11) 400) i)))
        (str (coerce (loop for i below 3000 collect (code-char (+ 32 (mod (* i 17) 90)))) 'string))
        (s 0))
    (dotimes (k 5)
      (incf s (length (remove-duplicates v)))
      (incf s (length (remove-duplicates v :from-end t)))
      (incf s (length (remove-duplicates names :test #'equal)))
      (incf s (length (remove-duplicates (coerce names 'vector) :test #'equalp :from-end t)))
      (incf s (cdr (first (remove-duplicates pairs :key #'car))))
      (incf s (cdr (first (delete-duplicates (copy-list pairs) :key #'car :from-end t))))
      (incf s (length (remove-duplicates str)))
      (incf s (length (remove-duplicates str :test #'char-equal)))
      (incf s (length (remove-duplicates v :start 100 :end 2500))))
    s))

;; substitute/nsubstitute
(defbench v-substitute (10)
  (let ((v (coerce (loop for i below 20000 collect (mod (* i 37) 100)) 'vector))
        (l (loop for i below 20000 collect (mod i 10)))
        (str (make-string 20000 :initial-element #\a))
        (s 0))
    (dotimes (k 10)
      (incf s (aref (substitute -1 50 v) 100))
      (incf s (length (substitute-if 0 #'oddp v :count 50)))
      (incf s (car (substitute 99 3 l)))
      (incf s (length (substitute 99 3 l :test #'<)))
      (incf s (length (nsubstitute-if-not 1 #'plusp (copy-list l) :start 10)))
      (incf s (length (substitute #\_ #\a str :start 100)))
      (incf s (length (nsubstitute #\x #\_ (copy-seq str) :from-end t :count 5))))
    s))

;; search/mismatch on lists, vectors, strings with tests
(defbench v-search-mismatch (10)
  (let* ((l (loop for i below 4000 collect (mod (* i 7) 50)))
         (v (coerce l 'vector))
         (l2 (copy-list l)) (v2 (copy-seq v))
         (text (coerce (loop for i below 4000 collect (code-char (+ 97 (mod (* i i) 26)))) 'string))
         (s 0))
    (setf (nth 3900 l2) -1 (aref v2 3900) -1)
    (dotimes (k 20)
      (incf s (or (search '(49 6 13 99) l) 4000))
      (incf s (or (search #(49 6 13 20) v) 0))
      (incf s (or (search '(49 6 13 20) v :from-end t) 0))
      (incf s (or (search "ZZZ" text :test #'char-equal) 0))
      (incf s (or (search "qqq" text) 0))
      (incf s (or (search "ab" text :from-end t) 0))
      (incf s (mismatch l l2))
      (incf s (mismatch v v2))
      (incf s (mismatch l v2 :from-end t))
      (incf s (or (mismatch text text :start1 1 :test #'char/=) 0)))
    s))

;; map, map-into, every/some with one and two sequences of mixed kinds
(defbench v-map-every (10)
  (let* ((l (loop for i below 10000 collect i))
         (v (coerce l 'vector))
         (out (make-array 10000))
         (str (make-string 10000 :initial-element #\k))
         (s 0))
    (dotimes (k 10)
      (incf s (aref (map 'vector #'+ l v) 77))
      (incf s (length (map 'list #'1+ v)))
      (incf s (length (map 'string #'char-upcase str)))
      (incf s (car (car (last (map 'list #'cons l str)))))
      (map nil (lambda (x) (incf s (logand x 1))) v)
      (incf s (aref (map-into out #'* v l) 9))
      (incf s (aref (map-into out #'1- out) 9))
      (when (every #'<= l v) (incf s))
      (when (some #'> v l) (incf s))
      (when (every #'integerp v) (incf s))
      (when (notany #'char= str "abcdefgh") (incf s)))
    (logand s #xFFFFFF)))

;; fill/replace/reverse/subseq/concatenate/copy-seq on simple and adjustable vectors
(defbench v-seq-copying (10)
  (let* ((v (make-array 20000 :initial-element 1))
         (a (make-array 20000 :adjustable t :fill-pointer 20000 :initial-element 2))
         (l (make-list 20000 :initial-element 3))
         (s 0))
    (dotimes (k 10)
      (fill v k :start 10) (fill a k :end 1000) (fill l k :start 5)
      (replace v a :start1 100) (replace a l :start2 50) (replace v v :start1 50 :start2 0)
      (incf s (aref (reverse v) 0)) (incf s (aref (nreverse a) 0)) (incf s (aref (reverse a) 5))
      (incf s (length (subseq a 100 15000))) (incf s (length (copy-seq v)))
      (incf s (length (concatenate 'vector v l a)))
      (incf s (length (concatenate 'list v a)))
      (incf s (reduce #'+ a :start 1000 :from-end t))
      (incf s (reduce #'max l :key #'1+ :initial-value 0)))
    s))
