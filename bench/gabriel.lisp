;;; Gabriel-style benchmarks (after "Performance and Evaluation of Lisp
;;; Systems"), run by tools/bench.sh like suite.lisp.

(defmacro defbench (name (&optional (reps 1)) &body body)
  `(progn
     (defun ,name () ,@body)
     (run-bench ',name ,reps #',name)))

(defun run-bench (name reps fn)
  (funcall fn)
  (let ((start (get-internal-real-time)) (r nil))
    (dotimes (i reps) (setq r (funcall fn)))
    (let ((ms (round (* 1000 (- (get-internal-real-time) start)) internal-time-units-per-second)))
      (format t "~(~A~) ~D ~A~%" name ms
              (let ((s (prin1-to-string r))) (if (> (length s) 40) (subseq s 0 40) s))))))

;;; TAKL: tak with lists
(defun listn (n) (if (not (= 0 n)) (cons n (listn (1- n)))))
(defun mas (x y z) (if (not (shorterp y x)) z (mas (mas (cdr x) y z) (mas (cdr y) z x) (mas (cdr z) x y))))
(defun shorterp (x y) (and y (or (null x) (shorterp (cdr x) (cdr y)))))
(defvar *l18* (listn 18)) (defvar *l12* (listn 12)) (defvar *l6* (listn 6))
(defbench g-takl (100) (length (mas *l18* *l12* *l6*)))

;;; CTAK: tak with catch/throw
(defun ctak (x y z) (catch 'ctak (ctak-aux x y z)))
(defun ctak-aux (x y z)
  (cond ((not (< y x)) (throw 'ctak z))
        (t (ctak-aux (catch 'ctak (ctak-aux (1- x) y z))
                     (catch 'ctak (ctak-aux (1- y) z x))
                     (catch 'ctak (ctak-aux (1- z) x y))))))
(defbench g-ctak (100) (ctak 18 12 6))

;;; STAK: tak with special variables
(defvar *x*) (defvar *y*) (defvar *z*)
(defun stak (*x* *y* *z*) (stak-aux))
(defun stak-aux ()
  (if (not (< *y* *x*)) *z*
      (let ((*x* (let ((*x* (1- *x*)) (*y* *y*) (*z* *z*)) (stak-aux)))
            (*y* (let ((*x* (1- *y*)) (*y* *z*) (*z* *x*)) (stak-aux)))
            (*z* (let ((*x* (1- *z*)) (*y* *x*) (*z* *y*)) (stak-aux))))
        (stak-aux))))
(defbench g-stak (100) (stak 18 12 6))

;;; DIV2: dividing lists by two, iteratively and recursively
(defun create-n (n) (do ((n n (1- n)) (a () (push () a))) ((= n 0) a)))
(defvar *ll* (create-n 200))
(defun iterative-div2 (l) (do ((l l (cddr l)) (a () (push (car l) a))) ((null l) a)))
(defun recursive-div2 (l) (cond ((null l) ()) (t (cons (car l) (recursive-div2 (cddr l))))))
(defbench g-div2 (30)
  (let ((n 0)) (dotimes (i 3000) (incf n (length (iterative-div2 *ll*))) (incf n (length (recursive-div2 *ll*)))) n))

;;; DESTRU: destructive list operations
(defun destructive (n m)
  (let ((l (do ((i 10 (1- i)) (a () (cons () a))) ((= i 0) a))))
    (do ((i n (1- i))) ((= i 0))
      (cond ((null (car l))
             (do ((l l (cdr l))) ((null l))
               (or (car l) (rplaca l (cons () ())))
               (nconc (car l) (do ((j m (1- j)) (a () (cons () a))) ((= j 0) a)))))
            (t (do ((l1 l (cdr l1)) (l2 (cdr l) (cdr l2))) ((null l2))
                 (rplacd (do ((j (floor (length (car l2)) 2) (1- j)) (a (car l2) (cdr a)))
                             ((zerop j) a) (rplaca a i))
                         (let ((n (floor (length (car l1)) 2)))
                           (cond ((= n 0) (rplaca l1 ()) (car l1))
                                 (t (do ((j n (1- j)) (a (car l1) (cdr a)))
                                        ((= j 1) (prog1 (cdr a) (rplacd a ())))
                                      (rplaca a i))))))))))
    (length (car l))))
(defbench g-destru (240) (destructive 600 50))

;;; FFT on double-float arrays
(defun fft (areal aimag)
  (let* ((n (1- (length areal))) (m (round (log n 2))) (nv2 (floor n 2)) (nm1 (1- n)) (j 1))
    (do ((i 1 (1+ i))) ((> i nm1))
      (when (< i j)
        (rotatef (aref areal j) (aref areal i))
        (rotatef (aref aimag j) (aref aimag i)))
      (let ((k nv2))
        (loop while (< k j) do (setq j (- j k) k (floor k 2)))
        (setq j (+ j k))))
    (do ((l 1 (1+ l))) ((> l m))
      (let* ((le (expt 2 l)) (le1 (floor le 2)) (ur 1d0) (ui 0d0)
             (wr (cos (/ pi le1))) (wi (sin (/ pi le1))))
        (do ((j 1 (1+ j))) ((> j le1))
          (do ((i j (+ i le))) ((> i n))
            (let* ((ip (+ i le1))
                   (tr (- (* (aref areal ip) ur) (* (aref aimag ip) ui)))
                   (ti (+ (* (aref areal ip) ui) (* (aref aimag ip) ur))))
              (setf (aref areal ip) (- (aref areal i) tr) (aref aimag ip) (- (aref aimag i) ti)
                    (aref areal i) (+ (aref areal i) tr) (aref aimag i) (+ (aref aimag i) ti))))
          (psetq ur (- (* ur wr) (* ui wi)) ui (+ (* ur wi) (* ui wr))))))
    (aref areal 1)))
(defbench g-fft (20)
  (let ((re (make-array 1025 :initial-element 0d0)) (im (make-array 1025 :initial-element 0d0)) (r 0d0))
    (dotimes (k 10) (fill re 0d0) (fill im 0d0) (setf (aref re 1) 1d0) (setq r (fft re im)))
    (round (* r 1000))))

;;; TRIANG: triangle peg solitaire (board of 15)
(defvar *board* (make-array 16 :initial-element 1))
(defvar *sequence* (make-array 14 :initial-element 0))
(defvar *a* (make-array 37 :initial-contents '(1 2 4 3 5 6 1 3 6 2 5 4 11 12 13 7 8 4 4 7 11 8 12 13 6 10 15 9 14 13 13 14 15 9 10 6 6)))
(defvar *b* (make-array 37 :initial-contents '(2 4 7 5 8 9 3 6 10 5 9 8 12 13 14 8 9 5 2 4 7 5 8 9 3 6 10 5 9 8 12 13 14 8 9 5 5)))
(defvar *c* (make-array 37 :initial-contents '(4 7 11 8 12 13 6 10 15 9 14 13 13 14 15 9 10 6 1 2 4 3 5 6 1 3 6 2 5 4 11 12 13 7 8 4 4)))
(defvar *answer* nil) (defvar *final* nil)
(defun last-position ()
  (do ((i 1 (1+ i))) ((= i 16) 0) (if (= 1 (aref *board* i)) (return i))))
(defun try (i depth)
  (cond ((= depth 14) (let ((lp (last-position)))
                        (unless (member lp *final*) (push lp *final*)))
         (push (cdr (coerce *sequence* 'list)) *answer*) t)
        ((and (= 1 (aref *board* (aref *a* i))) (= 1 (aref *board* (aref *b* i))) (= 0 (aref *board* (aref *c* i))))
         (setf (aref *board* (aref *a* i)) 0 (aref *board* (aref *b* i)) 0 (aref *board* (aref *c* i)) 1)
         (setf (aref *sequence* depth) i)
         (do ((j 0 (1+ j)) (depth (1+ depth))) ((or (= j 36) (try j depth)) ()))
         (setf (aref *board* (aref *a* i)) 1 (aref *board* (aref *b* i)) 1 (aref *board* (aref *c* i)) 0)
         ())))
(defun gogogo (i) (let ((*answer* ()) (*final* ())) (try i 1) (length *answer*)))
(defbench g-triang () (setf (aref *board* 5) 0) (prog1 (gogogo 22) (setf (aref *board* 5) 1)))

;;; DERIV with symbol property dispatch (DDERIV)
(defun dderiv-aux (a) (list '/ (dderiv a) a))
(defun f+ (a) (cons '+ (mapcar #'dderiv a)))
(defun f- (a) (cons '- (mapcar #'dderiv a)))
(defun f* (a) (list '* (cons '* a) (cons '+ (mapcar #'dderiv-aux a))))
(defun f/ (a) (list '- (list '/ (dderiv (car a)) (cadr a))
                    (list '/ (car a) (list '* (cadr a) (cadr a) (dderiv (cadr a))))))
(setf (get '+ 'dderiv) #'f+ (get '- 'dderiv) #'f- (get '* 'dderiv) #'f* (get '/ 'dderiv) #'f/)
(defun dderiv (a)
  (if (not (consp a)) (if (eq a 'x) 1 0)
      (let ((d (get (car a) 'dderiv))) (if d (funcall d (cdr a)) 'error))))
(defbench g-dderiv (15)
  (let ((r nil)) (dotimes (i 100000) (setq r (dderiv '(+ (* 3 x x) (* a x x) (* b x) 5)))) (length r)))

;;; BROWSE-like: property lists, symbol creation, pattern matching
(defun browse-match (pat dat alist)
  (cond ((null pat) (null dat))
        ((null dat) ())
        ((or (eq (car pat) '?) (eq (car pat) (car dat))) (browse-match (cdr pat) (cdr dat) alist))
        ((eq (car pat) '*)
         (or (browse-match (cdr pat) dat alist) (browse-match (cdr pat) (cdr dat) alist)
             (browse-match pat (cdr dat) alist)))
        (t nil)))
(defbench g-browse (50)
  (let ((data (loop for i below 200 collect (loop for j below 10 collect (if (= 0 (mod (+ i j) 3)) 'a (if (oddp j) 'b 'c)))))
        (pats '((a * b ? c) (* a * a) (c ? ? * b) (* * a b c *))) (n 0))
    (dotimes (k 50) (dolist (d data) (dolist (p pats) (when (browse-match p d nil) (incf n)))))
    n))

;;; TRAVERSE-like: a graph of structures, mark and count
(defstruct node (parents ()) (sons ()) (sn 0) (mark nil))
(defun build-graph (n)
  (let ((nodes (coerce (loop for i below n collect (make-node :sn i)) 'vector)) (seed 21))
    (dotimes (i n)
      (dotimes (k 3)
        (setq seed (mod (+ (* seed 1103) 12345) 65536))
        (let ((j (mod seed n)))
          (push (aref nodes j) (node-sons (aref nodes i)))
          (push (aref nodes i) (node-parents (aref nodes j))))))
    nodes))
(defvar *graph* (build-graph 500))
(defun travers (node mark)
  (if (eq (node-mark node) mark) 0
      (progn (setf (node-mark node) mark)
             (let ((c 1)) (dolist (s (node-sons node) c) (incf c (travers s mark)))))))
(defbench g-traverse (200)
  (let ((n 0)) (dotimes (i 200) (incf n (travers (aref *graph* (mod i 500)) (cons i nil)))) n))
