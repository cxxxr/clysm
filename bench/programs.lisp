;;; Clysm benchmarks, third file — 63 more ordinary programs (CLOS, sequences,
;;; specialized arrays, FORMAT, conditions, strings, numbers, small applications).
;;; Run with tools/bench.sh bench/programs.lisp.

(defmacro defbench (name (&optional (reps 1)) &body body)
  `(progn
     (defun ,name () ,@body)
     (run-bench ',name ,reps #',name)))

(defun run-bench (name reps fn)
  (funcall fn)                          ; warm up
  (let ((start (get-internal-real-time)) (r nil))
    (dotimes (i reps) (setq r (funcall fn)))
    (let ((ms (round (* 1000 (- (get-internal-real-time) start))
                     internal-time-units-per-second)))
      (format t "~(~A~) ~D ~A~%" name ms
              (let ((s (prin1-to-string r))) (if (> (length s) 40) (subseq s 0 40) s))))))

;;; ------------------------------------------------------------------ CLOS

(defclass animal ()
  ((name :initarg :name :accessor animal-name)
   (legs :initarg :legs :initform 4 :accessor animal-legs)
   (weight :initarg :weight :initform 10 :accessor animal-weight)))
(defclass dog (animal) ((tricks :initform nil :accessor dog-tricks)))
(defclass puppy (dog) ((age :initarg :age :initform 1 :reader puppy-age)))

(defgeneric feed (a amount))
(defmethod feed ((a animal) amount) (incf (animal-weight a) amount))
(defmethod feed ((a dog) amount) (call-next-method a (* 2 amount)))
(defmethod feed ((a puppy) amount) (call-next-method a (1+ amount)))

(defbench p-cnm-args (20)
  (let ((p (make-instance 'puppy :name "rex")) (d (make-instance 'dog :name "old")))
    (dotimes (i 100000)
      (feed p 1) (feed d 1)
      (when (> (animal-weight p) 100000) (setf (animal-weight p) 0 (animal-weight d) 0)))
    (+ (animal-weight p) (animal-weight d))))

(defgeneric speak (a))
(defmethod speak ((a animal)) 1)
(defmethod speak ((a dog)) (+ 2 (call-next-method)))
(defmethod speak ((a puppy)) (+ 3 (call-next-method)))
(defbench p-cnm (10)
  (let ((p (make-instance 'puppy :name "rex")) (d (make-instance 'dog :name "old")) (s 0))
    (dotimes (i 300000) (setq s (logand (+ s (speak p) (speak d)) #xFFFFF)))
    s))

(defvar *log-count* 0)
(defgeneric walk (a steps))
(defmethod walk ((a animal) steps) (* steps (animal-legs a)))
(defmethod walk :before ((a dog) steps) (declare (ignore steps)) (incf *log-count*))
(defmethod walk :after ((a animal) steps) (declare (ignore steps)) (incf *log-count*))
(defmethod walk :around ((a puppy) steps) (if (> steps 0) (1+ (call-next-method)) 0))
(defbench p-method-comb (10)
  (let ((p (make-instance 'puppy :name "rex")) (d (make-instance 'dog :name "old")) (s 0))
    (setq *log-count* 0)
    (dotimes (i 200000) (setq s (logand (+ s (walk p (logand i 7)) (walk d 3)) #xFFFFF)))
    (+ s (logand *log-count* #xFFFF))))

(defbench p-accessor (10)
  (let ((p (make-instance 'puppy :name "rex" :age 3)) (s 0))
    (dotimes (i 1000000)
      (setf (animal-legs p) (logand i 7))
      (incf s (+ (animal-legs p) (puppy-age p) (slot-value p 'weight)))
      (setf (slot-value p 'weight) (logand s 15)))
    s))

(defclass account ()
  ((id :initarg :id :reader account-id)
   (balance :initarg :balance :initform 0 :accessor balance)
   (history :initform nil :accessor history)))
(defmethod initialize-instance :after ((a account) &key (bonus 0))
  (incf (balance a) bonus))
(defgeneric deposit (a n))
(defmethod deposit ((a account) (n integer))
  (push n (history a)) (incf (balance a) n))
(defmethod deposit ((a account) (n (eql 0))) 0)
(defmethod deposit ((a account) (n float)) (deposit a (round n)))
(defbench p-clos-app (20)
  (let ((total 0))
    (dotimes (i 20000)
      (let ((a (make-instance 'account :id i :balance 10 :bonus 5)))
        (deposit a 1) (deposit a 0) (deposit a 2.6) (deposit a (logand i 3))
        (incf total (+ (balance a) (length (history a)) (account-id a)))))
    total))

(defgeneric describe-thing (x))
(defmethod describe-thing ((x integer)) 1)
(defmethod describe-thing ((x string)) 2)
(defmethod describe-thing ((x symbol)) 3)
(defmethod describe-thing ((x cons)) 4)
(defmethod describe-thing ((x float)) 5)
(defmethod describe-thing ((x t)) 6)
(defbench p-builtin-dispatch (20)
  (let ((things (list 1 "a" 'b '(c) 1.5 #\d 2 "e" nil (vector 1))) (s 0))
    (dotimes (i 100000) (dolist (x things) (incf s (describe-thing x))))
    s))

(defmethod print-object ((a account) stream)
  (print-unreadable-object (a stream :type t) (format stream "~D: ~D" (account-id a) (balance a))))
(defbench p-print-object (10)
  (let ((a (make-instance 'account :id 7 :balance 100)) (n 0))
    (dotimes (i 20000) (incf n (length (princ-to-string a))))
    n))

;;; ------------------------------------------------------------- sequences

(defbench p-remove-duplicates (10)
  (let* ((l (loop for i below 2000 collect (mod (* i 7919) 1500)))
         (v (coerce l 'vector))
         (strs (loop for i below 500 collect (format nil "s~D" (mod i 300)))))
    (+ (length (remove-duplicates l))
       (length (remove-duplicates v))
       (length (delete-duplicates (copy-list l) :from-end t))
       (length (remove-duplicates strs :test #'equal))
       (length (remove-duplicates l :key (lambda (x) (ash x -1)))))))

(defbench p-seq-vector (10)
  (let ((v (make-array 20000)) (n 0))
    (dotimes (i 20000) (setf (svref v i) (mod (* i 31) 1009)))
    (dotimes (k 10)
      (incf n (position 1008 v))
      (incf n (count-if #'evenp v))
      (incf n (length (remove 5 v)))
      (incf n (reduce #'+ (map 'vector #'1+ v)))
      (incf n (length (substitute 0 7 v)))
      (incf n (or (find-if (lambda (x) (> x 1007)) v :from-end t) 0))
      (incf n (aref (reverse v) 0))
      (incf n (reduce #'max v :start 100 :end 5000))
      (incf n (length (subseq v 10 1000)))
      (when (every #'integerp v) (incf n))
      (when (some #'minusp v) (incf n)))
    n))

(defbench p-sort-key (10)
  (let* ((recs (loop for i below 20000 collect (cons (mod (* i 7919) 10007) (format nil "n~D" (mod i 97)))))
         (a (sort (copy-list recs) #'< :key #'car))
         (b (stable-sort (copy-list recs) #'string< :key #'cdr))
         (c (sort (coerce recs 'vector) #'> :key #'car)))
    (+ (car (first a)) (car (first b)) (car (aref c 0))
       (length (merge 'list (subseq a 0 100) (subseq a 100 200) #'< :key #'car)))))

(defbench p-alist-plist (20)
  (let ((al nil) (pl nil) (s 0))
    (dotimes (i 200) (push (cons i (* i i)) al) (setf (getf pl i) (* 2 i)))
    (dotimes (k 20)
      (dotimes (i 200)
        (incf s (cdr (assoc i al)))
        (incf s (getf pl i))
        (incf s (car (rassoc (* i i) al)))))
    (let ((sa (loop for i below 100 collect (cons (format nil "k~D" i) i))))
      (dotimes (k 20) (dotimes (i 100) (incf s (cdr (assoc (car (nth i sa)) sa :test #'string=))))))
