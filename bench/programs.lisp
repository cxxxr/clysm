            do (cond ((alpha-char-p c) (incf n (if (upper-case-p c) 1 2)))
                     ((digit-char-p c) (incf n (digit-char-p c)))
                     ((char= c #\Space) (incf n 3))
                     ((alphanumericp c) (incf n 100))
                     (t (incf n (logand (char-code (char-downcase c)) 1))))))
    n))

(defbench p-parse-number (20)
