;;; ------------------------------------------------------------- conditions

(define-condition my-error (error) ((code :initarg :code :reader my-error-code)))
(defun risky (i) (if (zerop (mod i 3)) (error 'my-error :code i) i))
(defbench p-handler-case (50)
  (let ((s 0))
    (dotimes (i 30000)
      (incf s (handler-case (risky i)
                (my-error (e) (- (my-error-code e)))
                (type-error () 0))))
    s))

(defbench p-handler-case-noerror (10)
  (let ((s 0))
    (dotimes (i 1000000)
      (incf s (handler-case (if (< i 0) (error "neg") (logand i 7))
                (error () 0))))
    s))

(defbench p-handler-bind (20)
  (let ((s 0))
    (dotimes (i 20000)
      (incf s (restart-case
                  (handler-bind ((my-error (lambda (e) (invoke-restart 'use-value (my-error-code e)))))
                    (risky (* 3 i)))
                (use-value (v) (1+ v)))))
    s))

(defun bad-car (x) (car x))
(defbench p-simple-error (20)
  (let ((s 0))
    (dotimes (i 20000)
      (incf s (handler-case (if (oddp i) (error "bad thing ~D" i) i)
                (simple-error (e) (length (simple-condition-format-arguments e)))))
      (incf s (multiple-value-bind (v c) (ignore-errors (if (evenp i) (bad-car i) i)) (if c 1 v))))
    s))

(defbench p-signal-warn (10)
  (let ((s 0))
    (dotimes (i 30000)
      (handler-bind ((warning (lambda (w) (incf s) (muffle-warning w))))
        (when (oddp i) (warn "w ~D" i)))
      (handler-bind ((condition (lambda (c) (declare (ignore c)) (incf s 2))))
        (signal 'my-error :code i)))
    s))

;;; ---------------------------------------------------------------- strings

(defun split-string (s ch)
  (loop with start = 0
        for pos = (position ch s :start start)
        collect (subseq s start pos)
        while pos do (setq start (1+ pos))))
(defbench p-string-split (10)
  (let ((line "alpha,beta,gamma,delta,epsilon,zeta,eta,theta,iota,kappa") (n 0))
    (dotimes (i 20000)
      (let ((parts (split-string line #\,)))
        (incf n (length parts))
        (incf n (length (string-upcase (third parts))))
        (when (string= (first parts) "alpha") (incf n))
        (when (string< (second parts) (fourth parts)) (incf n))))
    n))

(defbench p-string-build (20)
  (let ((n 0))
    (dotimes (i 5000)
      (let ((s (concatenate 'string "abc" (string-trim " " "  padded  ") "-" (princ-to-string i))))
        (incf n (length s))
        (incf n (length (string-capitalize s)))
        (incf n (length (substitute #\_ #\- s)))
        (incf n (length (remove #\a s)))
        (incf n (if (string-equal s "ABCPADDED-7") 1 0))
        (incf n (or (search "ded" s) 0))
        (incf n (length (reverse s)))
        (incf n (length (with-output-to-string (o)
                          (loop for c across s do (write-char (char-upcase c) o)))))))
    n))

(defbench p-char-class (30)
  (let ((text (make-string 10000)) (n 0))
    (dotimes (i 10000) (setf (char text i) (code-char (+ 32 (mod (* i 7) 95)))))
    (dotimes (k 20)
