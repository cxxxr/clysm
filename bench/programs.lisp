(defbench p-list-ops (2)
  (let ((s 0))
    (dotimes (k 100)
      (let* ((a (loop for i below 1000 collect i))
             (b (loop for i from 500 below 1500 collect i)))
        (incf s (length (intersection a b)))
        (incf s (length (union (subseq a 0 100) (subseq b 0 100))))
        (incf s (length (set-difference (subseq a 400 600) b)))
        (incf s (length (nreverse (copy-list a))))
        (incf s (length (last a 10)))
        (incf s (length (butlast a 10)))
        (incf s (nth 500 a))
        (incf s (length (mapcan (lambda (x) (if (oddp x) (list x x) nil)) a)))
        (incf s (apply #'+ (subseq a 0 50)))
        (incf s (length (member 900 a)))
        (incf s (length (nconc (copy-list b) (list 1 2))))))
    s))

(defbench p-vector-push (10)
  (let ((s 0))
    (dotimes (k 20)
      (let ((v (make-array 4 :adjustable t :fill-pointer 0)))
        (dotimes (i 50000) (vector-push-extend i v))
        (dotimes (i (length v)) (incf s (aref v i)))
        (loop while (> (fill-pointer v) 40000) do (incf s (vector-pop v)))
        (incf s (length v))))
    (logand s #xFFFFFFF)))

;;; ----------------------------------------------------- specialized arrays

(defun bit-sieve (n)
  (let ((bits (make-array (1+ n) :element-type 'bit :initial-element 1)) (count 0))
    (loop for i from 2 to n
          when (= 1 (sbit bits i))
            do (incf count)
               (loop for j from (* i i) to n by i do (setf (sbit bits j) 0)))
    count))
(defbench p-bit-vector (20) (bit-sieve 1000000))

(defun byte-checksum (n)
  (let ((buf (make-array n :element-type '(unsigned-byte 8))) (a 1) (b 0))
    (dotimes (i n) (setf (aref buf i) (logand (* i 131) 255)))
    (dotimes (i n)
      (setq a (mod (+ a (aref buf i)) 65521))
      (setq b (mod (+ a b) 65521)))
    (logior (ash b 16) a)))
(defbench p-byte-vector (10) (byte-checksum 1000000))

(defun u32-mix (n)
  (let ((v (make-array n :element-type '(unsigned-byte 32) :initial-element 0)) (h 0))
    (dotimes (i n) (setf (aref v i) (logand (* i 2654435761) #xFFFFFFFF)))
    (dotimes (i n) (setq h (logand (logxor (* h 31) (aref v i)) #xFFFFFFFF)))
    h))
(defbench p-u32-vector (50) (u32-mix 500000))

(defun fixnum-vec-sum (n)
  (let ((v (make-array n :element-type 'fixnum :initial-element 0)) (s 0))
    (dotimes (i n) (setf (aref v i) (- (logand (* i 17) 1023) 500)))
    (dotimes (k 5) (dotimes (i n) (incf s (aref v i))))
    (dotimes (i (1- n)) (setf (aref v (1+ i)) (logand (+ (aref v i) (aref v (1+ i))) 4095)))
    (+ s (aref v (1- n)))))
(defbench p-fixnum-vector (20) (fixnum-vec-sum 500000))

(defun df-matmul (n)
  (let ((a (make-array (list n n) :element-type 'double-float :initial-element 1.5d0))
        (b (make-array (list n n) :element-type 'double-float :initial-element 2d0))
        (c (make-array (list n n) :element-type 'double-float :initial-element 0d0)))
    (dotimes (i n)
      (dotimes (j n)
        (let ((s 0d0))
          (dotimes (k n) (incf s (* (aref a i k) (aref b k j))))
          (setf (aref c i j) s))))
    (aref c (1- n) (1- n))))
(defbench p-double-2d (50) (df-matmul 100))

(defun df-vec (n)
  (let ((x (make-array n :element-type 'double-float :initial-element 0d0))
        (y (make-array n :element-type 'double-float :initial-element 0d0)) (dot 0d0))
    (dotimes (i n) (setf (aref x i) (* 0.5d0 i) (aref y i) (/ 1d0 (1+ i))))
    (dotimes (k 10) (dotimes (i n) (incf dot (* (aref x i) (aref y i)))))
    dot))
(defbench p-double-vector (40) (df-vec 200000))

(defun sf-loop (n)
  (let ((x 0.0) (v (make-array 100 :element-type 'single-float :initial-element 0.5)))
    (dotimes (i n)
      (setq x (+ (* x 0.5) (aref v (mod i 100)) (float (logand i 3)))))
    x))
(defbench p-single-float (10) (sf-loop 1000000))

(defun complex-mandel (size)
  (let ((count 0))
    (dotimes (py size)
      (dotimes (px size)
        (let ((c (complex (- (/ (* 3.0d0 px) size) 2.0d0) (- (/ (* 2.0d0 py) size) 1.0d0)))
              (z #c(0d0 0d0)) (i 0))
          (loop while (and (< i 30) (< (abs z) 2d0))
                do (setq z (+ (* z z) c)) (incf i))
          (when (= i 30) (incf count)))))
    count))
(defbench p-complex (50) (complex-mandel 100))

(defbench p-generic-2d (300)
  (let ((grid (make-array '(100 100) :initial-element 0)) (s 0))
    (dotimes (k 5)
      (dotimes (i 100) (dotimes (j 100) (setf (aref grid i j) (+ i j k))))
      (dotimes (i 98)
        (dotimes (j 98)
          (incf s (+ (aref grid i j) (aref grid (1+ i) (1+ j)) (aref grid (+ i 2) j)))))
      (incf s (array-total-size grid))
      (dotimes (i (array-total-size grid)) (incf s (row-major-aref grid i))))
    s))

