;;; -------------------------------------------------- small "applications"

;; a tokenizer and an evaluator for arithmetic expressions
(defun tokenize (str)
  (let ((tokens nil) (i 0) (n (length str)))
    (loop while (< i n)
          do (let ((c (char str i)))
               (cond ((char= c #\Space) (incf i))
                     ((digit-char-p c)
                      (let ((j i) (v 0))
                        (loop while (and (< j n) (digit-char-p (char str j)))
                              do (setq v (+ (* v 10) (digit-char-p (char str j)))) (incf j))
                        (push v tokens) (setq i j)))
                     (t (push (intern (string c) :keyword) tokens) (incf i)))))
    (nreverse tokens)))
(defvar *tokens* nil)
(defun parse-expr ()
  (let ((v (parse-term)))
    (loop while (member (car *tokens*) '(:+ :-))
          do (let ((op (pop *tokens*))) (setq v (list op v (parse-term)))))
    v))
(defun parse-term ()
  (let ((v (parse-factor)))
    (loop while (member (car *tokens*) '(:* :/))
          do (let ((op (pop *tokens*))) (setq v (list op v (parse-factor)))))
    v))
(defun parse-factor ()
  (let ((tok (pop *tokens*)))
    (cond ((numberp tok) tok)
          ((eq tok :|(|) (prog1 (parse-expr) (pop *tokens*)))
          ((eq tok :-) (list :neg (parse-factor)))
          (t (error "unexpected ~S" tok)))))
(defun eval-expr (e)
  (if (numberp e) e
      (ecase (car e)
        (:+ (+ (eval-expr (second e)) (eval-expr (third e))))
        (:- (- (eval-expr (second e)) (eval-expr (third e))))
        (:* (* (eval-expr (second e)) (eval-expr (third e))))
        (:/ (/ (eval-expr (second e)) (eval-expr (third e))))
        (:neg (- (eval-expr (second e)))))))
(defbench p-calc (10)
  (let ((s 0))
    (dotimes (i 10000)
      (let ((*tokens* (tokenize "12 * (3 + 45) - 678 / (9 - -3) + 2 * 2 * (1 + 1)")))
        (incf s (eval-expr (parse-expr)))))
    s))

;; a JSON-like serializer
(defun write-json (x out)
  (cond ((null x) (write-string "null" out))
        ((eq x t) (write-string "true" out))
        ((integerp x) (format out "~D" x))
        ((floatp x) (format out "~,3F" x))
        ((stringp x)
         (write-char #\" out)
         (loop for c across x do (when (member c '(#\" #\\)) (write-char #\\ out)) (write-char c out))
         (write-char #\" out))
        ((symbolp x) (write-json (string-downcase (symbol-name x)) out))
        ((hash-table-p x)
         (write-char #\{ out)
         (let ((first t))
           (maphash (lambda (k v)
                      (if first (setq first nil) (write-char #\, out))
                      (write-json k out) (write-char #\: out) (write-json v out))
                    x))
         (write-char #\} out))
        ((listp x)
         (write-char #\[ out)
         (loop for (e . rest) on x do (write-json e out) (when rest (write-char #\, out)))
         (write-char #\] out))
        ((vectorp x) (write-json (coerce x 'list) out))
        (t (error "cannot serialize ~S" x))))
(defbench p-json (10)
  (let ((h (make-hash-table :test 'equal)) (n 0))
    (setf (gethash "name" h) "clysm" (gethash "tags" h) '(lisp wasm "g\"c") (gethash "n" h) 42
          (gethash "pi" h) 3.14159d0 (gethash "ok" h) t (gethash "v" h) (vector 1 2 (list 3 nil)))
    (dotimes (i 3000)
      (incf n (length (with-output-to-string (o) (write-json (list h i "x" h) o)))))
    n))

;; Conway's game of life on a small torus
(defun life-step (grid new w h)
  (dotimes (y h)
    (dotimes (x w)
      (let ((n 0))
        (loop for dy from -1 to 1
              do (loop for dx from -1 to 1
                       unless (and (zerop dx) (zerop dy))
                         do (incf n (aref grid (mod (+ y dy) h) (mod (+ x dx) w)))))
        (setf (aref new y x)
              (if (or (= n 3) (and (= n 2) (= 1 (aref grid y x)))) 1 0)))))
  new)
(defbench p-life (30)
  (let* ((w 40) (h 40) (a (make-array (list h w) :initial-element 0)) (b (make-array (list h w) :initial-element 0)))
    (dotimes (i (* w h)) (setf (row-major-aref a i) (if (< (mod (* i i 7) 11) 4) 1 0)))
    (dotimes (gen 30) (life-step a b w h) (rotatef a b))
    (let ((alive 0)) (dotimes (i (* w h)) (incf alive (row-major-aref a i))) alive)))

;; Dijkstra on a grid graph with a binary heap in an adjustable vector
(defun heap-push (heap item)
  (vector-push-extend item heap)
  (let ((i (1- (length heap))))
    (loop while (> i 0)
          do (let ((p (floor (1- i) 2)))
               (if (< (car (aref heap i)) (car (aref heap p)))
                   (progn (rotatef (aref heap i) (aref heap p)) (setq i p))
                   (return))))))
(defun heap-pop (heap)
  (let ((top (aref heap 0)) (last (vector-pop heap)) (n (length heap)))
    (when (> n 0)
      (setf (aref heap 0) last)
      (let ((i 0))
        (loop
          (let ((l (+ (* 2 i) 1)) (r (+ (* 2 i) 2)) (m i))
            (when (and (< l n) (< (car (aref heap l)) (car (aref heap m)))) (setq m l))
            (when (and (< r n) (< (car (aref heap r)) (car (aref heap m)))) (setq m r))
            (if (= m i) (return) (progn (rotatef (aref heap i) (aref heap m)) (setq i m)))))))
    top))
(defun grid-dijkstra (n)
  (let ((dist (make-hash-table)) (heap (make-array 16 :adjustable t :fill-pointer 0)))
    (heap-push heap (cons 0 0))
    (setf (gethash 0 dist) 0)
    (loop while (> (length heap) 0)
          do (destructuring-bind (d . u) (heap-pop heap)
               (when (= d (gethash u dist))
                 (multiple-value-bind (y x) (floor u n)
                   (dolist (delta '((0 . 1) (1 . 0) (0 . -1) (-1 . 0)))
                     (let ((ny (+ y (car delta))) (nx (+ x (cdr delta))))
                       (when (and (< -1 ny n) (< -1 nx n))
                         (let* ((v (+ (* ny n) nx)) (w (1+ (mod (* v 7) 5))) (nd (+ d w)))
                           (when (< nd (gethash v dist most-positive-fixnum))
                             (setf (gethash v dist) nd)
                             (heap-push heap (cons nd v)))))))))))
    (gethash (1- (* n n)) dist)))
(defbench p-dijkstra (60) (grid-dijkstra 60))

;; text processing: word wrap and justification
(defun wrap-text (words width)
  (let ((lines nil) (cur nil) (len 0))
    (dolist (w words)
      (when (and cur (> (+ len 1 (length w)) width))
        (push (format nil "~{~A~^ ~}" (reverse cur)) lines)
        (setq cur nil len 0))
      (push w cur)
      (incf len (+ (length w) (if (cdr cur) 1 0))))
    (when cur (push (format nil "~{~A~^ ~}" (reverse cur)) lines))
    (nreverse lines)))
(defbench p-wrap (30)
  (let ((words (loop for i below 300 collect (subseq "supercalifragilistic" 0 (1+ (mod (* i 7) 11))))) (n 0))
    (dotimes (i 100)
      (let ((lines (wrap-text words 60)))
        (incf n (length lines))
        (incf n (reduce #'max (mapcar #'length lines)))
        (incf n (length (string-right-trim " " (format nil "~60A|" (first lines)))))))
    n))
