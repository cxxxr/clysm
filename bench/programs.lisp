;;; ---------------------------------------------------- hash tables / data

(defbench p-word-count (20)
  (let ((words '("the" "quick" "brown" "fox" "jumps" "over" "the" "lazy" "dog" "and" "the" "cat"))
        (h (make-hash-table :test 'equal)) (n 0))
    (dotimes (i 20000) (dolist (w words) (incf (gethash w h 0))))
    (maphash (lambda (k v) (incf n (+ (length k) v))) h)
    (let ((keys (loop for k being the hash-keys of h collect k)))
      (incf n (length (sort keys #'string<))))
    (+ n (hash-table-count h))))

(defbench p-hash-misc (30)
  (let ((h (make-hash-table :test 'eq)) (h2 (make-hash-table :test 'equal)) (h3 (make-hash-table :test 'equalp))
        (syms '(a b c d e f g h i j k l m n o p)) (n 0))
    (dotimes (k 5000)
      (dolist (s syms) (push k (gethash s h)))
      (when (zerop (mod k 100)) (dolist (s syms) (remhash s h))))
    (dotimes (i 20000)
      (setf (gethash (list (logand i 63) (logand i 7)) h2) i)
      (setf (gethash (if (oddp i) "Key" "KEY") h3) i)
      (incf n (gethash (list (logand i 31) (logand i 7)) h2 0)))
    (+ n (hash-table-count h) (hash-table-count h2) (hash-table-count h3)
       (length (gethash 'a h)))))

(defstruct node key (left nil) (right nil))
(defun tree-insert (tree key)
  (cond ((null tree) (make-node :key key))
        ((< key (node-key tree)) (setf (node-left tree) (tree-insert (node-left tree) key)) tree)
        ((> key (node-key tree)) (setf (node-right tree) (tree-insert (node-right tree) key)) tree)
        (t tree)))
(defun tree-depth (tree)
  (if (null tree) 0 (1+ (max (tree-depth (node-left tree)) (tree-depth (node-right tree))))))
(defun tree-count (tree)
  (if (null tree) 0 (+ 1 (tree-count (node-left tree)) (tree-count (node-right tree)))))
(defbench p-struct-tree (10)
  (let ((tree nil) (x 12345))
    (dotimes (i 50000)
      (setq x (mod (+ (* x 1103515245) 12345) 2147483648))
      (setq tree (tree-insert tree (mod x 100000))))
    (+ (tree-depth tree) (tree-count tree))))

(defstruct (vec3 (:constructor vec3 (x y z))) (x 0d0 :type double-float) (y 0d0 :type double-float) (z 0d0 :type double-float))
(defstruct (particle (:include vec3)) (mass 1d0 :type double-float) (id 0 :type fixnum))
(defun v+ (a b) (vec3 (+ (vec3-x a) (vec3-x b)) (+ (vec3-y a) (vec3-y b)) (+ (vec3-z a) (vec3-z b))))
(defun v-dot (a b) (+ (* (vec3-x a) (vec3-x b)) (* (vec3-y a) (vec3-y b)) (* (vec3-z a) (vec3-z b))))
(defbench p-struct-float (10)
  (let ((acc (vec3 0d0 0d0 0d0)) (p (make-particle :x 1d0 :y 2d0 :z 3d0 :mass 2d0 :id 7)) (s 0d0))
    (dotimes (i 300000)
      (setq acc (v+ acc p))
      (incf s (* (particle-mass p) (v-dot acc p)))
      (when (vec3-p p) (incf s 1d0))
      (when (> (vec3-x acc) 1000d0) (setq acc (vec3 0d0 0d0 0d0))))
    (+ s (particle-id (copy-particle p)))))

(defbench p-equal (10)
  (let ((a (list 1 "two" #\3 '(4 5) 6.0 (vector 7 8))) (b (list 1 "two" #\3 '(4 5) 6.0 (vector 7 8))) (n 0))
    (dotimes (i 200000)
