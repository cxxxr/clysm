(defun queens (n)
  (let ((count 0) (cols (make-array n :initial-element nil))
        (d1 (make-array (* 2 n) :initial-element nil)) (d2 (make-array (* 2 n) :initial-element nil)))
    (labels ((place (row)
               (if (= row n)
                   (incf count)
                   (dotimes (c n)
                     (unless (or (aref cols c) (aref d1 (+ row c)) (aref d2 (+ (- row c) n)))
                       (setf (aref cols c) t (aref d1 (+ row c)) t (aref d2 (+ (- row c) n)) t)
                       (place (1+ row))
                       (setf (aref cols c) nil (aref d1 (+ row c)) nil (aref d2 (+ (- row c) n)) nil))))))
      (place 0))
    count))
(defbench p-queens (300) (queens 9))

(defun even-odd-sum (n)
  (labels ((ev (k) (if (= k 0) 1 (od (1- k))))
           (od (k) (if (= k 0) 0 (ev (1- k)))))
    (flet ((both (k) (+ (ev k) (od k))))
      (let ((s 0)) (dotimes (i n) (incf s (both (logand i 255)))) s))))
