;;;; tests/asdf/run.lisp — load a small system with the bundled ASDF
;;;;   bin/clysm script tests/asdf/run.lisp
(require :asdf)
(format t "~&ASDF ~A~%" (asdf:asdf-version))
(push (merge-pathnames "greet/" (uiop:pathname-directory-pathname *load-truename*))
      asdf:*central-registry*)
(asdf:load-system "greet" :force t)
(format t "~A~%" (greet:greet "world"))
(format t "version ~A~%" (asdf:component-version (asdf:find-system "greet")))
(asdf:test-system "greet")
(format t "~{~A~^ ~}~%" (mapcar #'pathname-name (directory (merge-pathnames "greet/**/*.lisp" (uiop:pathname-directory-pathname *load-truename*)))))

;;; a system of two files: loaded again, from its system fasl (one module);
;;; the calls between its files still see a redefinition
(push (merge-pathnames "twofiles/" (uiop:pathname-directory-pathname *load-truename*))
      asdf:*central-registry*)
(setf asdf::*clysm-system-fasls* t)           ; (opt-in)
(asdf:load-system "twofiles" :force t)
(format t "~A ~A~%" (twofiles:total 10) (symbol-value (find-symbol "*LOADS*" "TWOFILES")))
(asdf:clear-system "twofiles")
(asdf:load-system "twofiles")
(format t "system fasl: ~A~%" (and (member "twofiles" asdf::*clysm-system-fasls-loaded* :test #'string=) t))
(format t "~A ~A~%" (twofiles:total 10) (symbol-value (find-symbol "*LOADS*" "TWOFILES")))
(eval '(defun twofiles:g (x) (- x)))
(eval '(defun twofiles:h (x) (* x 100)))
(format t "~A ~A~%" (twofiles:total 10) (twofiles:f 3))
(setf asdf::*clysm-system-fasls* nil)

;;; a system fasl made as the files are compiled and loaded: the compile-time
;;; side effects of each file happen once, a macro of one file calls a
;;; function of the file before; a file changed makes it again
(defvar *sysfasl-ct* 0)
;; (the files of the first build are loaded by modules, not their source forms)
(defvar *sysfasl-sources* 0)
(let ((load-file #'sys::%system-load-file))
  (setf (fdefinition 'sys::%system-load-file)
        (lambda (su k)
          (dolist (l (car (nth k (reverse (sys::%su-files su)))))
            (unless (consp l) (incf *sysfasl-sources*)))
          (funcall load-file su k))))
(defun sysfasl-copy (from to &optional (replace nil))
  (let ((text (uiop:read-file-string from)))
    (when replace (setq text (uiop:frob-substrings text (list (car replace)) (cdr replace))))
    (with-open-file (o to :direction :output :if-exists :supersede) (write-string text o))))
(let* ((src (merge-pathnames "sysfasl/" (uiop:pathname-directory-pathname *load-truename*)))
       (dir (merge-pathnames "../../build/asdf-sysfasl/" (uiop:pathname-directory-pathname *load-truename*))))
  (ensure-directories-exist dir)
  (dolist (f '("sysfasl.asd" "p.lisp" "m.lisp" "u.lisp"))
    (sysfasl-copy (merge-pathnames f src) (merge-pathnames f dir)))
  (push dir asdf:*central-registry*)
  (setf asdf::*clysm-system-fasls* t)
  (asdf:load-system "sysfasl")
  (format t "~S ~A ~A sources ~A~%" (funcall (find-symbol "USE" "SYSFASL")) *sysfasl-ct*
          (symbol-value (find-symbol "*LOADS*" "SYSFASL")) *sysfasl-sources*)
  (asdf:clear-system "sysfasl")
  (setq asdf::*clysm-system-fasls-loaded* nil)
  (asdf:load-system "sysfasl")
  (format t "~S ~A ~A ~A~%" (funcall (find-symbol "USE" "SYSFASL")) *sysfasl-ct* (symbol-value (find-symbol "*LOADS*" "SYSFASL"))
          (and (member "sysfasl" asdf::*clysm-system-fasls-loaded* :test #'string=) t))
  ;; (a later write date)
  (sleep 1.1)
  (sysfasl-copy (merge-pathnames "u.lisp" src) (merge-pathnames "u.lisp" dir) '("(scale 2)" . "(scale 5)"))
  (asdf:clear-system "sysfasl")
  (setq asdf::*clysm-system-fasls-loaded* nil)
  (asdf:load-system "sysfasl")
  (format t "~S ~A ~A ~A~%" (funcall (find-symbol "USE" "SYSFASL")) *sysfasl-ct* (symbol-value (find-symbol "*LOADS*" "SYSFASL"))
          (and (member "sysfasl" asdf::*clysm-system-fasls-loaded* :test #'string=) t))
  (asdf:clear-system "sysfasl")
  (asdf:load-system "sysfasl")
  (format t "~S ~A ~A ~A~%" (funcall (find-symbol "USE" "SYSFASL")) *sysfasl-ct* (symbol-value (find-symbol "*LOADS*" "SYSFASL"))
          (and (member "sysfasl" asdf::*clysm-system-fasls-loaded* :test #'string=) t))
  (setf asdf::*clysm-system-fasls* nil))

;;; :AUTO: a system whose file changes after its system fasl was made is
;;; being developed: compiled file by file from then on (only the changed
;;; file again), until CLYSM-SYSTEM-FASL-RESET
(defvar *sysdev-ct* 0)
(let* ((src (merge-pathnames "sysdev/" (uiop:pathname-directory-pathname *load-truename*)))
       (dir (merge-pathnames "../../build/asdf-sysdev/" (uiop:pathname-directory-pathname *load-truename*))))
  (ensure-directories-exist dir)
  (dolist (f '("sysdev.asd" "a.lisp" "b.lisp"))
    (sysfasl-copy (merge-pathnames f src) (merge-pathnames f dir)))
  (push dir asdf:*central-registry*)
  (setf asdf::*clysm-system-fasls* :auto)
  ;; (as the earlier runs of the test left it)
  (asdf::clysm-system-fasl-reset "sysdev")
  (flet ((build (what)
           (asdf:clear-system "sysdev")
           (setq asdf::*clysm-system-fasls-loaded* nil)
           (asdf:load-system "sysdev")
           (format t "~A: ~A ~A system fasl ~A~%" what (funcall (find-symbol "G" "SYSDEV") 2) *sysdev-ct*
                   (and (member "sysdev" asdf::*clysm-system-fasls-loaded* :test #'string=) t)))
         (edit (old new)
           (sleep 1.1)
           (sysfasl-copy (merge-pathnames "b.lisp" dir) (merge-pathnames "b.lisp" dir) (cons old new))))
    (build "first")
    (build "again")
    (edit "1)" "2)")
    (build "edited")
    (edit "2)" "3)")
    (build "edited again")
    (asdf::clysm-system-fasl-reset "sysdev")
    (build "reset")
    (build "again"))
  (setf asdf::*clysm-system-fasls* nil))
