

(defun sys::%type-error (d e) (sys::%exit 10))
(defun sys::%arg-count-error (f n) (sys::%exit 11))
(defun sys::%undefined-function-error (s) (sys::%exit 12))
(defun sys::%unbound-variable-error (s) (sys::%exit 13))
(defun sys::%generic-add (a b) (sys::%exit 14))
(defun sys::%generic-sub (a b) (sys::%exit 14))
(defun sys::%generic-mul (a b) (sys::%exit 14))
(defun sys::%generic-lt (a b) (sys::%exit 14))
(defun sys::%generic-num-eq (a b) (sys::%exit 14))
(defun write-fixnum (n)
  (if (< n 10)
      (sys::%write-char (code-char (+ n 48)) 1)
      (progn (write-fixnum (sys::%fxtruncate n 10))
             (sys::%write-char (code-char (+ (sys::%fxrem n 10) 48)) 1))))
(defun fact (n) (if (< n 2) 1 (* n (fact (- n 1)))))
(write-fixnum (fact 10))
(sys::%write-char #\Newline 1)
