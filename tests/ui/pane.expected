
== interface
(:ROOT NIL
 (:DIV (:CLASS "ui-pane ui-interface" :STYLE "flex:1 1 0;")
  (:DIV (:STYLE "flex:1 1 0;" :CLASS "ui-pane ui-column-layout")
   (:DIV (:STYLE "flex:1 1 0;gap:8px;" :CLASS "ui-pane ui-row-layout")
    (:INPUT
     (:PLACEHOLDER "Your name" :VALUE "" :CLASS "ui-pane ui-text-input-pane"
      :TYPE "text"))
    (:BUTTON (:CLASS "ui-pane ui-push-button" :TYPE "button") "Greet"))
   (:DIV (:ROLE "separator" :CLASS "ui-separator"))
   (:SPAN (:CLASS "ui-pane ui-title-pane") "Hello, ! (0)")
   (:SPAN (:CLASS "ui-pane ui-title-pane") "plain text"))))
-- displayed
   (:CREATE "div")
   (:SET :DIV :STYLE "flex:1 1 0;")
   (:SET :DIV :CLASS "ui-pane ui-interface")
   (:CREATE "div")
   (:SET :DIV :CLASS "ui-pane ui-column-layout")
   (:SET :DIV :STYLE "flex:1 1 0;")
   (:CREATE "div")
   (:SET :DIV :CLASS "ui-pane ui-row-layout")
   (:SET :DIV :STYLE "flex:1 1 0;gap:8px;")
   (:CREATE "input")
   (:SET :INPUT :TYPE "text")
   (:SET :INPUT :CLASS "ui-pane ui-text-input-pane")
   (:SET :INPUT :VALUE "")
   (:SET :INPUT :PLACEHOLDER "Your name")
   (:INSERT :INPUT :IN :DIV)
   (:CREATE "button")
   (:SET :BUTTON :TYPE "button")
   (:SET :BUTTON :CLASS "ui-pane ui-push-button")
   (:CREATE-TEXT "Greet")
   (:INSERT "Greet" :IN :BUTTON)
   (:INSERT :BUTTON :IN :DIV)
   (:INSERT :DIV :IN :DIV)
   (:CREATE "div")
   (:SET :DIV :CLASS "ui-separator")
   (:SET :DIV :ROLE "separator")
   (:INSERT :DIV :IN :DIV)
   (:CREATE "span")
   (:SET :SPAN :CLASS "ui-pane ui-title-pane")
   (:CREATE-TEXT "Hello, ! (0)")
   (:INSERT "Hello, ! (0)" :IN :SPAN)
   (:INSERT :SPAN :IN :DIV)
   (:CREATE "span")
   (:SET :SPAN :CLASS "ui-pane ui-title-pane")
   (:CREATE-TEXT "plain text")
   (:INSERT "plain text" :IN :SPAN)
   (:INSERT :SPAN :IN :DIV)
   (:INSERT :DIV :IN :DIV)
   (:INSERT :DIV :IN :ROOT)
   (:TITLE "Greeter")
-- typed
   (:TEXT "Hello, ! (0)" "Hello, Lisp! (0)")
   (:SET :INPUT :VALUE "Lisp")
enter: "Lisp" GREETER
callback: "Greet"
-- clicked
   (:TEXT "Hello, Lisp! (0)" "Hello, Lisp! (1)")
-- setf
   (:SET :INPUT :HIDDEN T)
   (:SET :BUTTON :DISABLED T)
   (:TEXT "Greet" "Again")
   (:TITLE "Greeter 2")
find-pane: TOP NIL T

