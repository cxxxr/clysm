;;; MULTIPLE-VALUE-CALL of forms whose number of values is known (bound to
;;; variables, a direct call) and of others (a vector of the values); THE FIXNUM
;;; of a value read from data.
(defun mv-fn (x) (values x (1+ x) (* x 2)))
(defvar *f* #'mv-fn)
(defun unk (x) (funcall *f* x))
(print (multiple-value-list (unk 1)))
(print (multiple-value-call #'list (unk 1) (unk 2) (values) 7))
(print (multiple-value-call #'+))
(print (multiple-value-call #'list (values)))
(print (multiple-value-list (mv-fn 4)))
(print (multiple-value-call #'list (mv-fn 4) (floor 7 2) (values) (values 1 2) 'a))
(print (multiple-value-list (if (unk 1) (values 1 2) (values 3 4))))
(defun g (x) (if x (values 1 2) 3))
(print (multiple-value-list (g nil)))
(print (multiple-value-list (g t)))
(defun h (x) (block b (mapc (lambda (y) (when (eql y x) (return-from b (values 1 2 3)))) '(1 2)) 5))
(print (multiple-value-list (h 1)))
(print (multiple-value-list (h 9)))
(print (let ((n 0)) (multiple-value-call (progn (incf n) #'list) (incf n) n)))
(print (nth-value 1 (mv-fn 10)))
(print (multiple-value-call (lambda (&rest r) r) (mv-fn 1) (unk 2)))
(print (multiple-value-call #'list (floor 17 5) (truncate -7 2) (gethash 1 (make-hash-table))))
(defun mvl3 (x) (multiple-value-list (values x (list x) (values-list (list x x)))))
(print (mvl3 4))
(let ((v (vector 1 (expt 2 40) 7)))
  (print (list (+ 1 (the fixnum (svref v 0))) (+ 1 (the fixnum (svref v 2))))))
