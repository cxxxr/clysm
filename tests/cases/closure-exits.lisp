;;; Mapping functions with a function written in place: exits out of it,
;;; and the results (they are loops at the call site).
(let ((h (make-hash-table)))
  (dotimes (i 10) (setf (gethash i h) (* i i)))
  (print (block found (maphash (lambda (k v) (when (> v 20) (return-from found k))) h) :none))
  (let ((sum 0)) (maphash (lambda (k v) (declare (ignore k)) (incf sum v)) h) (print sum))
  (maphash (lambda (k v) (declare (ignore v)) (when (evenp k) (remhash k h))) h)
  (print (hash-table-count h)))
(print (let ((s 0))
         (dotimes (i 20 s)
           (tagbody
              (map nil (lambda (x) (when (> x (mod i 7)) (incf s x) (go done))) #(5 3 8 1 9 2))
              (incf s 100)
            done))))
(print (map 'list #'1+ '(1 2 3)))
(print (map 'list (lambda (c) (char-upcase c)) "abc"))
(print (map nil #'identity (make-array 3 :fill-pointer 2 :initial-contents '(1 2 3))))
(print (list (every #'evenp '(2 4 6)) (every (lambda (x) (> x 1)) #(2 3 1))
             (some (lambda (x) (and (> x 2) (* x 10))) '(1 2 3 4))
             (notany #'zerop #(1 2)) (notevery #'zerop '(0 0)) (every #'evenp "")
             (some #'upper-case-p "abC")))
(print (block b (dolist (row '((1 2) (3 4) (5 6))) (when (some (lambda (x) (when (= x 4) (return-from b (list :at x)))) row) nil)) :none))
(print (handler-case (map nil (lambda (x) x) 42) (type-error () :type-error)))
(terpri)
