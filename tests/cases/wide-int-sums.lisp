;;; Integers around the borders of 64 and 128 bits (the paths without a loop of sums, differences, products)
;; small integers around the 64- and 128-bit borders: sums, differences, products
(defvar *vals*
  (let ((l nil))
    (dolist (e '(0 1 28 29 30 31 32 33 61 62 63 64 65 95 96 97 126 127 128 129 160))
      (dolist (d '(-2 -1 0 1 2 12345))
        (let ((v (+ (ash 1 e) d)))
          (push v l) (push (- v) l))))
    (push 0 l) (push 536870911 l) (push -536870912 l) (push 268435455 l) (push -268435456 l)
    (push (1- (ash 1 128)) l) (push (- (ash 1 128)) l)
    (push #xFFFFFFFFFFFFFFFF0000000000000000 l) (push #x100000000FFFFFFFFFFFFFFFF l)
    l))
(defvar *h* 0)
(defun mix (x) (setq *h* (mod (+ (* *h* 1000003) (mod x 2147483629) (integer-length x) (if (minusp x) 7 0)) 4294967291)))
(dolist (a *vals*)
  (dolist (b *vals*)
    (mix (+ a b)) (mix (- a b)) (mix (* a b))
    (mix (if (< a b) 1 0)) (mix (if (= a b) 1 0))
    (unless (zerop b) (multiple-value-bind (q r) (floor a b) (mix q) (mix r))
            (multiple-value-bind (q r) (truncate a b) (mix q) (mix r)))
    (mix (gcd a b)) (mix (logand a b)) (mix (logior a b)) (mix (logxor a b))
    (mix (max a b)) (mix (min a b))))
(let ((s 0) (q 0) (d 0))
  (dotimes (i 100000) (incf s (* i i)) (incf q (* i i i i)) (decf d (* i i i (- i 7))))
  (mix s) (mix q) (mix d))
(let ((x 1)) (dotimes (i 200) (setq x (+ (* x 3) i)) (mix x)) (dotimes (i 200) (setq x (- (floor x 3) i)) (mix x)))
(format t "small ~D~%" *h*)
