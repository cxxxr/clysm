;; special forms and basic evaluation
(print (if t 1 2))
(print (if nil 1 2))
(print (let ((x 1) (y 2)) (+ x y)))
(print (let* ((x 1) (y (+ x 1))) (* x y)))
(print (progn 1 2 3))
(defvar *v* 10)
(defun get-v () *v*)
(print (let ((*v* 20)) (get-v)))
(print (get-v))
(print (block foo (return-from foo 42) 1))
(print (tagbody (go a) (print 'skipped) a (print 'here)))
(print (catch 'tag (throw 'tag 'thrown) 'not))
(print (unwind-protect 'value (print 'cleanup)))
(print (multiple-value-list (values 1 2 3)))
(print (multiple-value-call #'list (values 1 2) (values 3 4)))
(multiple-value-bind (a b c) (values 1 2) (print (list a b c)))
(print (multiple-value-list (floor 7 2)))
(print (multiple-value-prog1 (values 1 2) (values 3 4)))
(print (nth-value 1 (truncate 10 3)))
(print (funcall #'+ 1 2 3))
(print (apply #'list 1 2 '(3 4)))
(print (flet ((f (x) (* x 2))) (f 21)))
(print (labels ((even (n) (if (= n 0) t (odd (- n 1))))
                (odd (n) (if (= n 0) nil (even (- n 1)))))
         (list (even 10) (odd 7) (even 3))))
(print (let ((count 0)) (dotimes (i 10) (setq count (+ count i))) count))
(print (let ((r nil)) (dolist (x '(a b c)) (push x r)) r))
(print (do ((i 0 (1+ i)) (acc nil (cons i acc))) ((= i 5) acc)))
(print (case 3 (1 'one) ((2 3) 'two-or-three) (t 'other)))
(print (cond ((= 1 2) 'a) ((= 1 1) 'b) (t 'c)))
(print (and 1 2 3))
(print (or nil nil 4))
(print (when t 1 2))
(print (unless t 1 2))
(print (symbol-macrolet ((x 42)) (+ x 1)))
(print (macrolet ((twice (f) `(progn ,f ,f))) (let ((n 0)) (twice (incf n)) n)))
(print (eq 'a 'a))
(print (eql 1.0 1.0))
(print (equal '(1 (2 "x")) '(1 (2 "x"))))
(print (equalp "ABC" "abc"))
(terpri)
