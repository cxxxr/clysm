;; hash tables against an alist model: every test, keys of every kind (the
;; helpers that find fixnums, symbols, instances, strings and lists inline)
(defvar *fails* 0)
(defun check (what got want)
  (unless (equal got want) (incf *fails*) (format t "FAIL ~a: got ~s want ~s~%" what got want)))
(defstruct sk a)
(defun run-model (test keys n seed)
  (let ((h (make-hash-table :test test)) (model nil) (x seed))
    (dotimes (i n)
      (setq x (mod (+ (* x 1103515245) 12345) 2147483648))
      (let* ((k (nth (mod x (length keys)) keys)) (op (mod (ash x -8) 5))
             (cell (assoc k model :test test)))
        (case op
          ((0 1) (setf (gethash k h) i) (if cell (setf (cdr cell) i) (push (cons k i) model)))
          (2 (check (list test 'get k) (multiple-value-list (gethash k h)) (if cell (list (cdr cell) t) (list nil nil))))
          (3 (check (list test 'rem k) (remhash k h) (and cell t)) (setq model (remove k model :key #'car :test test)))
          (4 (incf (gethash k h 0)) (if cell (incf (cdr cell)) (push (cons k 1) model))))))
    (check (list test 'count) (hash-table-count h) (length model))
    (dolist (c model) (check (list test 'final (car c)) (gethash (car c) h) (cdr c)))
    (let ((n 0)) (maphash (lambda (k v) (incf n) (check (list test 'maphash k) v (cdr (assoc k model :test test)))) h)
      (check (list test 'mapcount) n (length model)))
    (clrhash h)
    (check (list test 'clr) (hash-table-count h) 0)
    (dolist (c model) (check (list test 'after-clr) (gethash (car c) h) nil))
    (setf (gethash (car keys) h) 'again)
    (check (list test 'again) (gethash (car keys) h) 'again)))
(let* ((conses (loop for i below 30 collect (list i)))
       (structs (loop for i below 30 collect (make-sk :a i)))
       (strings (loop for i below 30 collect (format nil "Key~d" i)))
       (upstrings (loop for i below 30 collect (format nil "KEY~d" i)))
       (syms (loop for i below 30 collect (intern (format nil "S~d" i))))
       (nums (append (loop for i below 30 collect i) (list 1.5d0 2.5d0 (expt 2 70) 1/3 -4 #\a #\B #\b)))
       (mixed (append conses structs strings syms nums (list "é" "É" (list 1 2) (list 1 2) "x" (copy-seq "x") (vector 1 2) #(1 2)))))
  (dolist (test '(eq eql equal equalp))
    (dolist (keys (list conses structs strings upstrings syms nums mixed (append strings upstrings)))
      (dotimes (seed 2) (run-model test keys 3000 (+ seed 17))))))
(let ((h (make-hash-table :test 'equalp)))
  (setf (gethash "abc" h) 1)
  (check 'eqp1 (gethash "ABC" h) 1)
  (check 'eqp2 (gethash (vector #\a #\B #\c) h) 1)
  (setf (gethash "Ä" h) 2)
  (check 'eqp3 (gethash "ä" h) 2)
  (setf (gethash (vector #\x #\y) h) 3)
  (check 'eqp4 (gethash "XY" h) 3)
  (check 'eqp5 (gethash "xy" h) 3))
(let ((h (make-hash-table :test 'equal)))
  (setf (gethash (list "a" 1 #\c) h) 1)
  (check 'eql1 (gethash (list "a" 1 #\c) h) 1)
  (let ((s (make-array 3 :element-type 'character :fill-pointer 1 :initial-element #\a)))
    (setf (gethash "a" h) 2)
    (check 'eql2 (gethash s h) 2)
    (setf (gethash s h) 3)
    (check 'eql3 (gethash "a" h) 3)))
(let ((h (make-hash-table :test 'eq :size 1)))
  (check 'size (>= (hash-table-size h) 1) t)
  (check 'empty-get (gethash 'x h) nil)
  (check 'empty-rem (remhash 'x h) nil)
  (check 'empty-count (hash-table-count h) 0)
  (maphash (lambda (k v) (check 'empty-map (list k v) nil)) h))
(format t "fails: ~d~%" *fails*)
