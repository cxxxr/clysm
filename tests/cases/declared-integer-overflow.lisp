;; A value past the declared integer type of a variable is a TYPE-ERROR (compiled code)
;; or kept as it is (the evaluator, which declares nothing): never another number.
(defun f2 (s)
  (let ((v 0))
    (declare (fixnum v))
    (dotimes (i (length s)) (setf v (+ (* v 10) (digit-char-p (char s i)))))
    v))
(print (f2 "12345"))
(print (and (member (handler-case (f2 "99999999999999999999999") (type-error () :type-error))
                    '(:type-error 99999999999999999999999))
            t))
(defun h (n) (let ((s 0)) (declare (type (integer 0 100) s)) (dotimes (i n) (setq s (+ s i))) s))
(print (h 5))
(print (and (member (handler-case (h 50) (type-error () :type-error)) '(:type-error 1225)) t))
(defun g (x) (let* ((d (* x x x x x x x x))) (declare (fixnum d)) (< d 10)))
(print (g 1))
(print (and (member (handler-case (g 1000000000) (type-error () :type-error)) '(:type-error nil)) t))
;; the variable of DOLIST may be declared: it is NIL only for the result form
(print (let ((n 0)) (dolist (x '(1 2 3) n) (declare (fixnum x)) (incf n x))))
