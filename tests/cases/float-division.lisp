;;; Division family of floats against SBCL: prints exact results.  (No
;;; quotient whose remainder overflows: compiled code that uses only the
;;; quotient does not compute it, as SBCL, but a full call or the interpreter
;;; does and signals.)
(defvar *seed* 12345)
(defun rnd ()
  (setq *seed* (mod (+ (* *seed* 6364136223846793005) 1442695040888963407) (expt 2 64)))
  (ash *seed* -11))
(defun rnd-double ()
  (let ((k (rnd)))
    (case (mod k 11)
      (0 (* (- (mod k 2000001) 1000000) 0.5d0))           ; halfway values
      (1 (scale-float (float (- (mod k 2000001) 1000000) 1d0) (- (mod (ash k -20) 140) 70)))
      (2 (* (if (oddp (ash k -3)) -1 1) (+ 4503599627370496d0 (mod k 4000))))   ; near 2^52
      (3 (* (if (oddp (ash k -3)) -1 1) (scale-float (+ 1d0 (* (mod k 1000) 1d-10)) (+ 50 (mod (ash k -9) 20)))))
      (4 (* (if (oddp (ash k -3)) -1 1) (scale-float 1d0 (+ 60 (mod (ash k -5) 8)))))
      (5 (if (oddp k) 0d0 -0d0))
      (6 (* (- (mod k 2001) 1000) 0.1d0))
      (7 (* (if (oddp (ash k -3)) -1 1) (+ 2251799813685248d0 (- (mod k 7) 3))))   ; near 2^51
      (8 (float (- (mod k 200001) 100000) 1d0))
      (9 (* (if (oddp (ash k -3)) -1 1) (scale-float 1d0 (- (mod (ash k -5) 40) 1070))))   ; tiny
      (t (* (- (mod k 2000001) 1000000) 0.001d0)))))
(defun rnd-div ()
  (let ((k (rnd)))
    (case (mod k 8)
      (0 (- (mod k 21) 10))
      (1 (* (- (mod k 21) 10) 0.5d0))
      (2 (* (- (mod k 2001) 1000) 0.37d0))
      (3 1d0)
      (4 -1d0)
      (5 (rnd-double))
      (6 (float (- (mod k 21) 10) 1f0))
      (t (* (if (oddp k) 1 -1) (1+ (mod k 1000)))))))

(defun ex (x)
  (cond ((floatp x) (list (if (typep x 'double-float) 'd 's) (rational x) (if (minusp (float-sign x)) '- '+)))
        ((consp x) (mapcar #'ex x))
        ((and (symbolp x) (not (keywordp x)) x) (if (subtypep x 'arithmetic-error) 'arith x))
        (t x)))
(defmacro try (form)
  `(handler-case (multiple-value-list ,form)
     (error (c) (list :error (type-of c)))))
(defun out (&rest xs) (let ((*print-pretty* nil)) (format t "~S~%" (ex xs))))

(declaim (notinline g-floor g-ceiling g-truncate g-round g-ffloor g-fround g-mod g-rem))
(defun g-floor (x y) (floor x y))
(defun g-ceiling (x y) (ceiling x y))
(defun g-truncate (x y) (truncate x y))
(defun g-round (x y) (round x y))
(defun g-ffloor (x y) (ffloor x y))
(defun g-fround (x y) (fround x y))
(defun g-mod (x y) (mod x y))
(defun g-rem (x y) (rem x y))
(defun d-all (x y)
  (declare (double-float x y))
  (list (try (floor x y)) (try (ceiling x y)) (try (truncate x y)) (try (round x y))
        (try (ffloor x y)) (try (fceiling x y)) (try (ftruncate x y)) (try (fround x y))
        (try (mod x y)) (try (rem x y))
        (try (+ 1 (floor x y))) (try (+ 1 (round x y))) (try (- (ceiling x y) 1)) (try (+ 1 (truncate x y)))
        (try (multiple-value-bind (q r) (round x y) (list (+ q 1) r)))
        (try (multiple-value-bind (q r) (floor x y) (list (+ q 1) r)))
        (try (let ((q (ceiling x y))) (+ q 1)))))
(defun d1-all (x)
  (declare (double-float x))
  (list (try (floor x)) (try (ceiling x)) (try (truncate x)) (try (round x))
        (try (ffloor x)) (try (fceiling x)) (try (ftruncate x)) (try (fround x))
        (try (+ 1 (floor x))) (try (+ 1 (round x))) (try (- (ceiling x) 1)) (try (+ 1 (truncate x)))
        (try (multiple-value-bind (q r) (round x) (list (+ q 1) r)))
        (try (let ((q (truncate x))) (+ q 1)))
        (try (let ((s 0)) (incf s (floor x)) (incf s (round x)) s))))
(defun dfx-all (x y)
  (declare (double-float x) (fixnum y))
  (list (try (floor x y)) (try (ceiling x y)) (try (truncate x y)) (try (round x y))
        (try (fround x y)) (try (mod x y)) (try (rem x y))
        (try (let ((s 0)) (incf s (round x y)) (incf s (floor x y)) s))))
(defun u-all (x y)
  (list (try (g-floor x y)) (try (g-ceiling x y)) (try (g-truncate x y)) (try (g-round x y))
        (try (g-ffloor x y)) (try (g-fround x y)) (try (g-mod x y)) (try (g-rem x y))))
(defun s-all (x y)
  (declare (single-float x y))
  (list (try (floor x y)) (try (ceiling x y)) (try (truncate x y)) (try (round x y))
        (try (fround x y)) (try (mod x y)) (try (round x)) (try (floor x)) (try (ftruncate x))))
(defun conv-all (x)
  (list (try (float x 1d0)) (try (coerce x 'single-float)) (try (rational x)) (try (rationalize x))
        (try (integer-decode-float x)) (try (decode-float x)) (try (scale-float x 3))
        (try (float-sign x)) (try (truncate x)) (try (round x))))

(defun main ()
  (dotimes (i 300)
    (let ((x (rnd-double)) (y (rnd-div)))
      (out :u x y (u-all x y))
      (when (typep y 'double-float) (out :d x y (d-all x y)))
      (when (typep y 'fixnum) (out :dfx x y (dfx-all x y)))
      (out :d1 x (d1-all x))
      (when (< (abs x) 1d38)
        (let ((xs (coerce x 'single-float)) (ys (coerce y 'single-float)))
          (out :s xs ys (s-all xs ys))
          (out :us xs (truncate (rnd-double)) (u-all xs (let ((k (mod (rnd) 41))) (if (= k 20) 0 (- k 20)))))
          (out :cs xs (conv-all xs))))
      (out :c x (conv-all x))
      (out :ui (u-all (truncate (rnd-double)) y))))
  ;; edge cases
  (dolist (x (list 0d0 -0d0 0.5d0 -0.5d0 1.5d0 -1.5d0 2.5d0 -2.5d0 4503599627370495.5d0 -4503599627370495.5d0
                   9.223372036854775807d18 -9.223372036854775808d18 9.223372036854777d18 1d300 -1d300
                   2251799813685247.5d0 2251799813685248d0 -2251799813685248d0 2251799813685249d0
                   least-positive-double-float
                   536870911.5d0 536870912.5d0 -536870912.5d0 -536870913.5d0 1073741823.5d0))
    (dolist (y (list 1d0 -1d0 2d0 -2d0 0.5d0 3 -3 1d-300 0d0 1d300 most-positive-double-float 1.75d308))
      (out :e x y (u-all x y))
      (when (typep y 'double-float) (out :ed x y (d-all x y))))
    (out :e1 x (d1-all x))
    (out :ec x (conv-all x)))
  (out :big (u-all (expt 10 30) 2.5d0) (u-all (- (expt 10 30)) 3d0) (u-all 7 2.5d0) (u-all 1/3 0.25d0)
       (u-all 0.75d0 1/4) (u-all (expt 2 70) 1d0) (u-all 1.5f0 2d0) (u-all 7/2 2)))
(main)
;; accumulators updated around divisions, MULTIPLE-VALUE-BIND for effect
(defvar *sp* 0)
(defun acc-test (n)
  (let ((s 0) (k 0) (big 0))
    (dotimes (i n)
      (let ((x (* i 0.37d0)))
        (multiple-value-bind (q r) (truncate x 2.5d0)
          (incf s q) (when (> r 1d0) (incf s)) (incf big (* q 1000000000000)))
        (multiple-value-bind (*sp* r) (floor i 7) (incf k (+ *sp* r)))
        (incf k (round x 3))
        (let ((q (ceiling x 0.7d0))) (incf s (- q 1)))))
    (list s k big *sp*)))
(print (acc-test 2000))
(print (let ((s (expt 2 70))) (dotimes (i 10) (incf s (floor (* i 1.5d0)))) s))
(print (let ((s 0)) (dotimes (i 10) (incf s (round (* i 2.5d0)))) s))
(print (let ((s 536870911)) (dotimes (i 100) (incf s (truncate (* i 1d17)))) s))
