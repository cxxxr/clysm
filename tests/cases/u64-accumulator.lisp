;;; Unsigned accumulator state across materialization and generic fallbacks.
(declaim (notinline opaque))
(defun opaque (x) x)
(defun unsigned-transitions (seed step mode)
  (let ((x seed) (sum 0))
    (dotimes (i 40)
      (setq x (logand (+ x #x9e3779b97f4a7c15) #xffffffffffffffff))
      (setq x (logxor x (ash x -7)))
      (setq x (logand (logxor x (ash x 17)) #xffffffffffffffff))
      (case mode
        (0 (incf x step))
        (1 (setq x (+ (* x 3) step)))
        (2 (setq x (opaque x)))
        (3 (incf sum (if (< x step) 1 2)))
        (4 (setq x (- x step)))
        (5 (setq x (logand (ash x -1) #xffffffffffffffff)))
        (6 (setq x (logand (+ (logand x #xffffffffffffffff) step) #xffffffffffffffff))))
      (setq sum (logxor sum (logand (truncate x) #xffffffffffffffff))))
    (list x sum)))
(dolist (seed '(0 -1 9223372036854775807 9223372036854775808 18446744073709551615))
  (dolist (step '(1 -1 9223372036854775808 18446744073709551616))
    (dotimes (mode 7) (print (unsigned-transitions seed step mode)))))
(defun unsigned-to-double (step)
  (let ((x 0))
    (dotimes (i 4)
      (setq x (logand (+ (truncate x) #x8000000000000001) #xffffffffffffffff))
      (incf x step))
    x))
(print (unsigned-to-double (opaque 0.5d0)))
(defun unsigned-used-setq (seed)
  (let ((x seed) (acc nil))
    (dotimes (i 4)
      (push (setq x (logand (+ x #x8000000000000001) #xffffffffffffffff)) acc))
    acc))
(print (unsigned-used-setq 0))
(terpri)
