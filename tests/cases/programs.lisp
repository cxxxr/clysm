;; 9. tail recursion with accumulators and big numbers
(defun sum-to (n &optional (acc 0)) (if (zerop n) acc (sum-to (1- n) (+ acc n))))
(print (sum-to 100000))
(defun digits (n) (if (< n 10) (list n) (append (digits (floor n 10)) (list (mod n 10)))))
(print (reduce #'+ (digits (expt 2 1000))))
;; 10. character manipulation (caesar cipher)
(defun caesar (s k)
  (map 'string (lambda (c)
                 (cond ((upper-case-p c) (code-char (+ 65 (mod (+ (- (char-code c) 65) k) 26))))
                       ((lower-case-p c) (code-char (+ 97 (mod (+ (- (char-code c) 97) k) 26))))
                       (t c)))
       s))
(print (caesar "Hello, World!" 3))
(print (caesar (caesar "Hello, World!" 3) -3))
;; 11. deep recursion
(defun depth (n) (if (= n 0) 0 (+ 1 (depth (- n 1)))))
(print (depth 10000))
;; 12. multiple values and nested functions
(defun stats (list)
  (let ((n (length list)) (sum (reduce #'+ list)))
    (values n sum (/ sum n) (reduce #'max list) (reduce #'min list))))
(multiple-value-bind (n sum mean mx mn) (stats '(4 8 15 16 23 42))
  (format t "~%n=~D sum=~D mean=~A max=~D min=~D~%" n sum mean mx mn))
