;;; small realistic programs
;; 1. a tiny stack-based calculator
(defun rpn (tokens)
  (let ((stack nil))
    (dolist (tok tokens (car stack))
      (if (numberp tok)
          (push tok stack)
          (let ((b (pop stack)) (a (pop stack)))
            (push (ecase tok (+ (+ a b)) (- (- a b)) (* (* a b)) (/ (/ a b))) stack))))))
(print (rpn '(3 4 + 2 * 7 /)))
;; 2. quicksort on lists
(defun qsort (l)
  (if (null l) nil
      (let ((p (car l)))
        (append (qsort (remove-if-not (lambda (x) (< x p)) (cdr l)))
                (list p)
                (qsort (remove-if-not (lambda (x) (>= x p)) (cdr l)))))))
(print (qsort '(3 1 4 1 5 9 2 6 5 3 5)))
;; 3. word frequency
(defun split-words (s)
  (let ((words nil) (cur nil))
    (loop for c across s
          do (if (alpha-char-p c)
                 (push (char-downcase c) cur)
                 (when cur (push (coerce (reverse cur) 'string) words) (setf cur nil))))
    (when cur (push (coerce (reverse cur) 'string) words))
    (nreverse words)))
(let ((counts (make-hash-table :test 'equal)))
  (dolist (w (split-words "The quick brown fox jumps over the lazy dog. The dog sleeps."))
    (incf (gethash w counts 0)))
  (let ((pairs nil))
    (maphash (lambda (k v) (push (cons k v) pairs)) counts)
    (print (sort pairs (lambda (a b) (or (> (cdr a) (cdr b))
                                         (and (= (cdr a) (cdr b)) (string< (car a) (car b)))))))))
;; 4. matrix multiply with 2D arrays
(defun mat* (a b)
  (let* ((n (array-dimension a 0)) (m (array-dimension b 1)) (k (array-dimension a 1))
         (c (make-array (list n m) :initial-element 0)))
    (dotimes (i n c)
      (dotimes (j m)
        (dotimes (x k)
          (incf (aref c i j) (* (aref a i x) (aref b x j))))))))
(print (mat* #2A((1 2) (3 4)) #2A((5 6) (7 8))))
;; 5. tree structures with defstruct
(defstruct (tnode (:constructor make-tnode (key &optional left right))) key left right)
(defun tinsert (tree key)
  (cond ((null tree) (make-tnode key))
        ((< key (tnode-key tree)) (setf (tnode-left tree) (tinsert (tnode-left tree) key)) tree)
        (t (setf (tnode-right tree) (tinsert (tnode-right tree) key)) tree)))
(defun tinorder (tree)
  (when tree (append (tinorder (tnode-left tree)) (list (tnode-key tree)) (tinorder (tnode-right tree)))))
(let ((tr nil))
  (dolist (k '(50 30 70 20 40 60 80 35)) (setf tr (tinsert tr k)))
  (print (tinorder tr)))
;; 6. closures + generators
(defun make-gen (list) (lambda () (pop list)))
(let ((g (make-gen '(a b c))))
  (print (list (funcall g) (funcall g) (funcall g) (funcall g))))
