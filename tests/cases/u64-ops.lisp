;;; Shifts, logical operations and masked products of integers within 128 bits
(defvar *vals*
  (let ((l nil))
    (dolist (e '(0 1 28 29 30 31 32 33 61 62 63 64 65 95 96 97 126 127 128 129 160))
      (dolist (d '(-2 -1 0 1 2 12345))
        (let ((v (+ (ash 1 e) d)))
          (push v l) (push (- v) l))))
    (push 0 l) (push 536870911 l) (push -536870912 l) (push 268435455 l) (push -268435456 l)
    (push (1- (ash 1 128)) l) (push (- (ash 1 128)) l)
    (push #xFFFFFFFFFFFFFFFF0000000000000000 l) (push #x100000000FFFFFFFFFFFFFFFF l)
    (push #xFFFFFFFFFFFFFFFF l) (push #x8000000000000000 l) (push #xFFFFFFFF00000000 l)
    l))
(defmacro chk (name form)
  `(let ((h 0))
     (dolist (a *vals*) (dolist (b *vals*)
       (let ((x ,form)) (setq h (mod (+ (* h 1000003) (mod x 2147483629) (integer-length x) (if (minusp x) 7 0)) 4294967291)))))
     (format t "~A ~D~%" ,name h)))
(defmacro chk1 (name form)
  `(let ((h 0))
     (dolist (a *vals*) (dolist (c '(-200 -129 -128 -127 -100 -65 -64 -63 -33 -32 -31 -1 0 1 2 31 32 33 63 64 65 66 95 96 127 128 130))
       (let ((x ,form)) (setq h (mod (+ (* h 1000003) (mod x 2147483629) (integer-length x) (if (minusp x) 7 0)) 4294967291)))))
     (format t "~A ~D~%" ,name h)))
(chk1 "ash" (ash a c)) (chk1 "ash-mask" (logand (ash a c) #xFFFFFFFFFFFFFFFF))
(chk "*" (* a b)) (chk "and" (logand a b)) (chk "ior" (logior a b)) (chk "xor" (logxor a b))
(chk "mulmask" (logand (* a b) #xFFFFFFFFFFFFFFFF)) (chk "andc" (logandc2 a b)) (chk "eqv" (logeqv a b))
(defun fnv64 (n) (let ((h #xcbf29ce484222325)) (dotimes (i n) (setq h (logand (* (logxor h (logand i 255)) #x100000001b3) #xFFFFFFFFFFFFFFFF))) h))
(defun xorshift64 (n) (let ((x 88172645463325252))
  (dotimes (i n) (setq x (logand (logxor x (ash x 13)) #xFFFFFFFFFFFFFFFF)) (setq x (logxor x (ash x -7))) (setq x (logand (logxor x (ash x 17)) #xFFFFFFFFFFFFFFFF))) x))
(print (list (fnv64 5000) (xorshift64 5000)))
