(defun pp-list (list)
  (pprint-logical-block (*standard-output* list :prefix "[" :suffix "]")
    (pprint-exit-if-list-exhausted)
    (loop (write (pprint-pop))
          (pprint-exit-if-list-exhausted)
          (write-string ", ")
          (pprint-newline :fill))))
(pp-list '(1 2 3))
(terpri)
(pp-list (loop for i below 40 collect (* i 100)))
(terpri)
(pprint-logical-block (*standard-output* '(a b c d) :prefix "<" :suffix ">")
  (loop (pprint-exit-if-list-exhausted) (princ (pprint-pop)) (write-char #\Space) (pprint-newline :linear)))
(terpri)
(format t "~<(~;~@{~A~^ ~_~}~;)~:>~%" (loop for i below 3 collect i))
(format t "~@<[~;~@{~A~^, ~:_~}~;]~:>~%" 'alpha 'beta 'gamma)
(format t "~:<~@{~A~^ ~:_~}~:>~%" (loop for i below 30 collect (format nil "item~D" i)))
(pprint-fill *standard-output* '(a b c))
(terpri)
(pprint-linear *standard-output* (loop for i below 30 collect 'abcdef))
(terpri)
(let ((*print-pretty* nil)) (pp-list '(1 2 3)))
(terpri)
(format t "~a~%" (with-output-to-string (s) (pprint-logical-block (s '(1 2) :prefix "{" :suffix "}") (loop (pprint-exit-if-list-exhausted) (prin1 (pprint-pop) s) (pprint-exit-if-list-exhausted) (write-char #\Space s)))))
