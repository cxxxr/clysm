;;; Refinements of copies must not survive a change of either variable.
(defun copy-test (x)
  (let ((v x)) (if (consp v) (list (car x) (cdr x)) :atom)))
(defun original-test (x)
  (let ((v x)) (if (consp x) (list (car v) (cdr v)) :atom)))
(defun chain-test (x)
  (let* ((a x) (b a) (c x))
    (if (consp b) (list (car x) (car a) (car c)) :atom)))
(defun initializer-change (x)
  (let ((v x) (unused (setq x nil)))
    (declare (ignore unused))
    (if (consp v) (car x) :atom)))
(defun original-change (x)
  (let ((v x)) (setq x nil) (if (consp v) (car x) :atom)))
(defun copy-change (x)
  (let ((v x)) (setq v '(9)) (if (consp v) (car x) :atom)))
(defun closure-change (x)
  (let ((v x))
    (flet ((change () (setq x nil)))
      (change) (if (consp v) (car x) :atom))))
(defun cleanup-change (x)
  (let ((v x))
    (block done (unwind-protect (return-from done nil) (setq x nil)))
    (if (consp v) (car x) :atom)))
(defun endp-walk (x)
  (let ((s 0))
    (do ((l x (cdr l))) ((endp l) s) (incf s (car l)))))
(defun copied-walk (x)
  (let ((s 0))
    (do ((l x (cdr l))) ((let ((v l)) (null v)) s)
      (incf s (car l)))))
(defun exit-copy (x)
  (let ((v x))
    (block done
      (when (consp v) (return-from done (car x)))
      (car x))))
(dolist (x '(nil (1) (2 3)))
  (print (list (copy-test x) (original-test x) (chain-test x)
               (initializer-change x) (original-change x) (copy-change x)
               (closure-change x) (cleanup-change x)
               (endp-walk x) (copied-walk x) (exit-copy x))))
(print (handler-case (endp-walk '(1 . 2)) (type-error () :type-error)))
(print (handler-case (copied-walk '(1 . 2)) (type-error () :type-error)))
(print (handler-case (copy-test 7) (type-error () :type-error)))
(print (let ((x '(1)))
         (let ((v x))
           (tagbody again
             (when v (setq x nil v nil) (go again)))
           (car x))))
