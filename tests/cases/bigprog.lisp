;;; --- JSON parser and serializer
(define-condition json-error (error) ((pos :initarg :pos :reader json-error-pos))
  (:report (lambda (c s) (format s "JSON syntax error at ~D" (json-error-pos c)))))
(defstruct (jstate (:constructor make-jstate (text))) text (pos 0))
(defun jpeek (st) (when (< (jstate-pos st) (length (jstate-text st))) (char (jstate-text st) (jstate-pos st))))
(defun jnext (st) (prog1 (jpeek st) (incf (jstate-pos st))))
(defun jskip (st) (loop while (member (jpeek st) '(#\Space #\Newline #\Tab)) do (jnext st)))
(defun jexpect (st c) (unless (eql (jnext st) c) (error 'json-error :pos (jstate-pos st))))
(defun jparse (st)
  (jskip st)
  (let ((c (jpeek st)))
    (cond ((eql c #\{) (jnext st)
           (let ((pairs nil))
             (jskip st)
             (if (eql (jpeek st) #\}) (jnext st)
                 (loop (jskip st)
                       (let ((k (jparse st))) (jskip st) (jexpect st #\:)
                         (push (cons k (jparse st)) pairs))
                       (jskip st)
                       (case (jnext st) (#\, nil) (#\} (return)) (t (error 'json-error :pos (jstate-pos st))))))
             (nreverse pairs)))
          ((eql c #\[) (jnext st)
           (let ((items nil))
             (jskip st)
             (if (eql (jpeek st) #\]) (jnext st)
                 (loop (push (jparse st) items) (jskip st)
                       (case (jnext st) (#\, nil) (#\] (return)) (t (error 'json-error :pos (jstate-pos st))))))
             (coerce (nreverse items) 'vector)))
          ((eql c #\") (jnext st)
           (with-output-to-string (out)
             (loop for ch = (jnext st) until (eql ch #\")
                   do (write-char (if (eql ch #\\) (let ((e (jnext st))) (case e (#\n #\Newline) (t e))) ch) out))))
          ((or (digit-char-p c) (eql c #\-))
           (let ((start (jstate-pos st)))
             (loop while (and (jpeek st) (find (jpeek st) "-+0123456789.eE")) do (jnext st))
             (let ((tok (subseq (jstate-text st) start (jstate-pos st))))
               (if (find-if (lambda (x) (find x ".eE")) tok)
                   (let ((*read-default-float-format* 'double-float)) (read-from-string tok))
                   (parse-integer tok)))))
          ((string= "true" (jstate-text st) :start2 (jstate-pos st) :end2 (min (length (jstate-text st)) (+ 4 (jstate-pos st))))
           (incf (jstate-pos st) 4) t)
          ((string= "false" (jstate-text st) :start2 (jstate-pos st) :end2 (min (length (jstate-text st)) (+ 5 (jstate-pos st))))
           (incf (jstate-pos st) 5) :false)
          ((string= "null" (jstate-text st) :start2 (jstate-pos st) :end2 (min (length (jstate-text st)) (+ 4 (jstate-pos st))))
           (incf (jstate-pos st) 4) :null)
          (t (error 'json-error :pos (jstate-pos st))))))
(defgeneric to-json (x stream))
(defmethod to-json ((x integer) s) (format s "~D" x))
(defmethod to-json ((x float) s) (format s "~F" x))
(defmethod to-json ((x string) s) (format s "~S" x))
(defmethod to-json ((x vector) s)
  (write-char #\[ s)
  (loop for e across x for first = t then nil do (unless first (write-char #\, s)) (to-json e s))
  (write-char #\] s))
(defmethod to-json ((x list) s)
  (write-char #\{ s)
  (loop for (k . v) in x for first = t then nil
        do (unless first (write-char #\, s)) (to-json k s) (write-char #\: s) (to-json v s))
  (write-char #\} s))
(defmethod to-json ((x symbol) s)
  (write-string (case x ((t) "true") (:false "false") (:null "null") (t (string-downcase (symbol-name x)))) s))
(let ((doc (jparse (make-jstate "{\"name\": \"clysm\", \"tags\": [\"lisp\", \"wasm\", 3, 4.5], \"ok\": true, \"none\": null, \"nested\": {\"a\": [1, [2, []]]}}"))))
  (print doc)
  (print (with-output-to-string (s) (to-json doc s))))
(print (handler-case (jparse (make-jstate "[1, 2,, 3]")) (json-error (e) (princ-to-string e))))
;;; --- a metacircular evaluator
(defun m-eval (x env)
  (cond ((symbolp x) (cdr (assoc x env)))
        ((atom x) x)
        ((eq (car x) 'quote) (cadr x))
        ((eq (car x) 'if) (if (m-eval (cadr x) env) (m-eval (caddr x) env) (m-eval (cadddr x) env)))
        ((eq (car x) 'lambda) (list :closure (cadr x) (caddr x) env))
        ((eq (car x) 'let) (m-eval `((lambda ,(mapcar #'car (cadr x)) ,(caddr x)) ,@(mapcar #'cadr (cadr x))) env))
        (t (m-apply (m-eval (car x) env) (mapcar (lambda (a) (m-eval a env)) (cdr x))))))
(defun m-apply (f args)
  (if (functionp f) (apply f args)
      (destructuring-bind (tag params body env) f
        (declare (ignore tag))
        (m-eval body (append (mapcar #'cons params args) env)))))
(defparameter *m-global* (list (cons '+ #'+) (cons '* #'*) (cons '- #'-) (cons '= #'=) (cons 'list #'list)))
(print (m-eval '(let ((fact (lambda (f n) (if (= n 0) 1 (* n (f f (- n 1))))))) (fact fact 20)) *m-global*))
(print (m-eval '((lambda (x y) (list x y (+ x y))) 3 4) *m-global*))
;;; --- N queens
(defun queens (n)
  (let ((solutions 0) (cols (make-array n :initial-element nil)))
    (labels ((ok (row col)
               (loop for r below row for c = (aref cols r)
                     never (or (= c col) (= (abs (- c col)) (- row r)))))
             (place (row)
               (if (= row n) (incf solutions)
                   (dotimes (col n)
                     (when (ok row col)
                       (setf (aref cols row) col)
                       (place (1+ row)))))))
      (place 0))
    solutions))
(print (loop for n from 1 to 8 collect (queens n)))
;;; --- determinant with rationals
(defun det (m)
  (let* ((n (array-dimension m 0)) (a (make-array (list n n))) (d 1))
    (dotimes (i n) (dotimes (j n) (setf (aref a i j) (aref m i j))))
    (dotimes (k n d)
      (let ((p (loop for i from k below n when (/= 0 (aref a i k)) return i)))
        (unless p (return 0))
        (when (/= p k)
          (dotimes (j n) (rotatef (aref a k j) (aref a p j)))
          (setf d (- d)))
        (setf d (* d (aref a k k)))
        (loop for i from (1+ k) below n
              do (let ((f (/ (aref a i k) (aref a k k))))
                   (loop for j from k below n do (decf (aref a i j) (* f (aref a k j))))))))))
(print (det #2A((2 -3 1) (2 0 -1) (1 4 5))))
(print (det #2A((1 2) (3 4))))
(print (det #2A((1/2 1/3) (1/4 1/5))))
;;; --- text statistics
(let* ((text "It was the best of times, it was the worst of times, it was the age of wisdom")
       (words (loop with start = 0 for i from 0 to (length text)
                    when (or (= i (length text)) (not (alpha-char-p (char text i))))
                      when (> i start) collect (string-downcase (subseq text start i)) end
                      and do (setf start (1+ i))))
       (freq (make-hash-table :test 'equal)))
  (dolist (w words) (incf (gethash w freq 0)))
  (format t "~&~D words, ~D distinct~%" (length words) (hash-table-count freq))
  (format t "~{~A=~D~^, ~}~%"
          (loop for (w . n) in (sort (loop for k being the hash-keys of freq using (hash-value v) collect (cons k v))
                                     (lambda (a b) (or (> (cdr a) (cdr b)) (and (= (cdr a) (cdr b)) (string< (car a) (car b))))))
                repeat 5 append (list w n))))
