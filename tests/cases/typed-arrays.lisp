(defun show (x) (print x))
(dolist (et '(bit (unsigned-byte 8) (signed-byte 8) (unsigned-byte 16) (signed-byte 16) (unsigned-byte 32)
              (signed-byte 32) fixnum (unsigned-byte 64) (signed-byte 64) single-float double-float character t
              (unsigned-byte 4) (integer -3 3) (mod 1000) (unsigned-byte 100)))
  (let ((v (make-array 5 :element-type et)))
    (show (list et (length v) (arrayp v) (vectorp v) (typep v 'simple-array)))))
(let ((v (make-array 4 :element-type '(unsigned-byte 8) :initial-element 7)))
  (setf (aref v 1) 255) (show v) (show (reduce #'+ v))
  (show (handler-case (setf (aref v 0) 256) (type-error (e) (list :type-error (type-error-datum e)))))
  (show (handler-case (aref v 4) (error (e) :index-error))))
(let ((v (make-array 3 :element-type '(signed-byte 16) :initial-contents '(-5 0 32767))))
  (show v) (show (handler-case (setf (aref v 0) 40000) (type-error () :te))))
(let ((v (make-array 3 :element-type '(unsigned-byte 32) :initial-element 4294967295)))
  (show v) (setf (aref v 1) 0) (show (+ (aref v 0) (aref v 1) (aref v 2))))
(let ((v (make-array 3 :element-type '(signed-byte 32) :initial-element -2147483648)))
  (show v) (setf (aref v 1) 2147483647) (show (aref v 1)))
(let ((v (make-array 3 :element-type '(unsigned-byte 64) :initial-element 18446744073709551615)))
  (show v) (setf (aref v 1) (expt 2 60)) (setf (aref v 2) 5) (show v)
  (show (handler-case (setf (aref v 0) -1) (type-error () :te))))
(let ((v (make-array 3 :element-type '(signed-byte 64) :initial-element -9223372036854775808)))
  (show v) (setf (aref v 1) 9223372036854775807) (show v))
(let ((v (make-array 3 :element-type 'single-float :initial-element 1.5)))
  (setf (aref v 0) 2.25) (show v) (show (handler-case (setf (aref v 0) 1d0) (type-error () :te))))
(let ((v (make-array 3 :element-type 'double-float :initial-element 1.5d0)))
  (setf (aref v 0) 2.25d0) (show v) (show (* 2 (aref v 0))))
(let ((b (make-array 10 :element-type 'bit :initial-element 0)))
  (setf (sbit b 3) 1 (bit b 4) 1) (show b) (show (count 1 b)) (show (bit-not b)))
(let ((m (make-array '(2 3) :element-type 'double-float :initial-element 0.5d0)))
  (setf (aref m 1 2) 3d0) (show m) (show (row-major-aref m 5)) (show (array-element-type m))
  (show (handler-case (aref m 2 0) (error () :index))))
(let ((m (make-array (list 2 2) :element-type '(unsigned-byte 8) :initial-contents '((1 2) (3 4)))))
  (show m) (show (+ (aref m 0 0) (aref m 1 1))))
(let ((v (make-array 2 :element-type 'fixnum :adjustable t :fill-pointer 0)))
  (dotimes (i 10) (vector-push-extend (* i i) v)) (show v))
(show (subseq (make-array 5 :element-type 'double-float :initial-contents '(1d0 2d0 3d0 4d0 5d0)) 1 3))
(show (equalp (make-array 3 :element-type '(unsigned-byte 8) :initial-element 1) #(1 1 1)))
(show (copy-seq (make-array 3 :element-type 'single-float :initial-element 1.0)))
(show (fill (make-array 3 :element-type '(unsigned-byte 16)) 9))
(show (map '(vector double-float) #'sqrt '(1d0 4d0 9d0)))
(show (coerce '(1 2 3) '(simple-array (unsigned-byte 8) (*))))
(show (sort (make-array 4 :element-type '(signed-byte 8) :initial-contents '(3 -1 2 0)) #'<))
;;; typed code: arrays created and used in one function, declared arrays, loops
(defun ta-sum (n)
  (let ((v (make-array n :element-type '(unsigned-byte 16) :initial-element 3)) (s 0))
    (dotimes (i n) (setf (aref v i) (logand (* i 977) 65535)))
    (dotimes (k 3) (dotimes (i n) (setq s (logand (+ s (aref v i)) #xFFFFFFFFFF))))
    s))
(show (ta-sum 1000))
(defun ta-dot (x y) (declare (type (simple-array double-float (*)) x y))
  (let ((d 0d0)) (dotimes (i (length x)) (incf d (* (aref x i) (aref y i)))) d))
(show (ta-dot (make-array 4 :element-type 'double-float :initial-contents '(1d0 2d0 3d0 4d0))
              (make-array 4 :element-type 'double-float :initial-element 0.5d0)))
(defun ta-2d (n)
  (let ((a (make-array (list n n) :element-type '(signed-byte 32) :initial-element -1))
        (b (make-array (list n (1+ n)) :element-type 'single-float :initial-element 0.5)) (s 0))
    (dotimes (i n) (dotimes (j n) (setf (aref a i j) (- (* i j) 7)) (setf (aref b i (1+ j)) (float (+ i j)))))
    (dotimes (i n) (dotimes (j n) (incf s (+ (aref a i j) (truncate (aref b i j))))))
    (list s (aref a 1 2) (aref b 2 3) (row-major-aref a 5) (array-dimensions b)
          (handler-case (aref a n 0) (error () :bounds))
          (handler-case (setf (aref a 0 0) 1.5) (type-error () :type)))))
(show (ta-2d 6))
(defun ta-errors (v i x) (declare (type (simple-array (unsigned-byte 8) (*)) v))
  (list (handler-case (aref v i) (error () :bounds))
        (handler-case (setf (aref v 0) x) (type-error (e) (type-error-datum e)))))
(show (ta-errors (make-array 3 :element-type '(unsigned-byte 8) :initial-element 9) 3 256))
(show (ta-errors (make-array 3 :element-type '(unsigned-byte 8) :initial-element 9) -1 -1))
(show (ta-errors (make-array 3 :element-type '(unsigned-byte 8) :initial-element 9) 2 255))
(defun ta-bits (n)
  (let ((b (make-array n :element-type 'bit :initial-element 0)) (c 0))
    (loop for i from 0 below n by 3 do (setf (sbit b i) 1))
    (dotimes (i n) (when (= 1 (bit b i)) (incf c)))
    (list c (count 1 b) (aref b 0) (aref b 1))))
(show (ta-bits 100))
(defun ta-unknown-rank (dims)
  (let ((a (make-array dims :element-type 'double-float :initial-element 1.5d0)))
    (if (listp dims) (list (aref a 1 1) (row-major-aref a 2) (array-rank a)) (list (aref a 1) (row-major-aref a 2) (length a)))))
(show (ta-unknown-rank 4)) (show (ta-unknown-rank '(2 3)))
(defun ta-u64 (n)
  (let ((v (make-array n :element-type '(unsigned-byte 64) :initial-element 0)) (x 1))
    (dotimes (i n) (setf (aref v i) x) (setq x (logand (* x 6364136223846793005) #xFFFFFFFFFFFFFFFF)))
    (list (aref v (1- n)) (reduce #'logxor v))))
(show (ta-u64 20))
(show (mapcar #'upgraded-array-element-type
              '(bit (unsigned-byte 7) (unsigned-byte 8) (signed-byte 8) (unsigned-byte 16) (signed-byte 16)
                (unsigned-byte 32) (signed-byte 32) (unsigned-byte 64) (signed-byte 64) single-float double-float
                character t)))
