;;; Keyed constructor methods: narrow/wide ABI, supplied-p, duplicate and
;;; non-slot initargs, method order and invalidation, and list fallbacks.
(defvar *events* nil)
(defclass keyed () ((value :initarg :value :accessor value)))
(defmethod shared-initialize :after ((x keyed) slots &key (a 10 ap) b c d e f g)
  (push (list :shared slots a ap b c d e f g (value x)) *events*)
  (setf (value x) :changed))
(defmethod initialize-instance :after ((x keyed) &key (a 10 ap) (b (+ a 1) bp) c d e f g)
  (push (list :initialize a ap b bp c d e f g (value x)) *events*))
(defun exercise ()
  (make-instance 'keyed :value 1)
  (make-instance 'keyed :value 2 :a nil :b nil)
  (make-instance 'keyed :value 3 :a 20 :a 30 :b 40)
  (make-instance 'keyed :value 4 :a 1 :b 2 :c 3 :d 4 :e 5 :f 6 :g 7)
  (prog1 (reverse *events*) (setq *events* nil)))
(print (exercise))
(print (exercise))
(defmethod initialize-instance :after ((x keyed) &key (a 11) b c d e f g)
  (declare (ignore b c d e f g))
  (push (list :replacement a (value x)) *events*))
(print (exercise))
;; Defaults must be evaluated once and passed to both method sets.
(defvar *counter* 0)
(defclass defaulted (keyed) ()
  (:default-initargs :a (incf *counter*) :value 99))
(print (progn (make-instance 'defaulted) (list *counter* (reverse *events*))))
(setq *events* nil)
;; A method requiring the actual list keeps every initarg in order.
(defclass listed (keyed) ())
(defmethod initialize-instance :after ((x listed) &rest args &key &allow-other-keys)
  (push (list :list args) *events*))
(print (progn (make-instance 'listed :value 5 :a 6 :a 7) (reverse *events*)))
