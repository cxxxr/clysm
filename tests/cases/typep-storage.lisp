;;; TYPEP, TYPECASE and declarations of simple vectors of a kind of storage
(defun kinds (x)
  (list (typep x '(simple-array (unsigned-byte 8) (*)))
        (typep x '(simple-array (signed-byte 8) (*)))
        (typep x '(simple-array (unsigned-byte 16) (*)))
        (typep x '(simple-array (unsigned-byte 32) (*)))
        (typep x '(simple-array (signed-byte 32) (*)))
        (typep x '(simple-array (unsigned-byte 64) (*)))
        (typep x '(simple-array double-float (*)))
        (typep x '(simple-array single-float (*)))
        (typep x '(simple-array character (*)))
        (typep x '(simple-array bit (*)))
        (typep x '(simple-array t (*)))
        (typep x '(simple-array (unsigned-byte 8) (4)))
        (typep x '(simple-array (unsigned-byte 8) 1))
        (typep x '(simple-array (unsigned-byte 8)))
        (typep x '(array (unsigned-byte 8) (*)))))
(defun which (x)
  (typecase x
    ((simple-array (unsigned-byte 8) (*)) :octets)
    ((simple-array double-float (*)) :doubles)
    ((simple-array character (*)) :string)
    ((simple-array t (*)) :vector)
    ((simple-array bit (*)) :bits)
    (t :other)))
(defun sum-free (v)
  (let ((n (length v)) (s 0))
    (declare (type (simple-array (unsigned-byte 8) (*)) v) (fixnum n s))
    (dotimes (i n s) (setq s (+ s (aref v i))))))
(dolist (x (list (make-array 4 :element-type '(unsigned-byte 8) :initial-element 3)
                 (make-array 4 :element-type '(signed-byte 8) :initial-element 3)
                 (make-array 4 :element-type '(unsigned-byte 16) :initial-element 3)
                 (make-array 4 :element-type '(unsigned-byte 32) :initial-element 3)
                 (make-array 4 :element-type '(signed-byte 32) :initial-element 3)
                 (make-array 4 :element-type '(unsigned-byte 64) :initial-element 3)
                 (make-array 4 :element-type 'double-float :initial-element 1d0)
                 (make-array 4 :element-type 'single-float :initial-element 1f0)
                 (make-string 4 :initial-element #\a)
                 (make-array 4 :element-type 'bit :initial-element 1)
                 (vector 1 2 3 4)
                 (make-array 4 :element-type '(unsigned-byte 8) :adjustable t :initial-element 3)
                 (make-array 4 :element-type '(unsigned-byte 8) :fill-pointer 2 :initial-element 3)
                 (make-array '(2 2) :element-type '(unsigned-byte 8) :initial-element 3)
                 (make-array 3 :element-type '(unsigned-byte 8) :initial-element 3)
                 '(1 2) 'a 12 "abc" nil 1.5d0 #\a))
  (print (list (kinds x) (which x))))
(print (sum-free (make-array 5 :element-type '(unsigned-byte 8) :initial-element 7)))
