(defstruct point x y)
(let ((p (make-point :x 1 :y 2)))
  (print (point-x p))
  (setf (point-y p) 10)
  (print (point-y p))
  (print (point-p p))
  (print (point-p 5))
  (print p)
  (let ((q (copy-point p)))
    (setf (point-x q) 99)
    (print (list (point-x p) (point-x q)))))
(defstruct (point3 (:include point)) (z 0))
(let ((p (make-point3 :x 1 :y 2 :z 3)))
  (print (list (point-x p) (point3-z p) (point-p p) (point3-p p)))
  (print p))
(defstruct (node (:constructor new-node (value &optional next))) value next)
(print (new-node 1 (new-node 2)))
(defstruct (account (:conc-name acct-)) (balance 0 :type integer) owner)
(let ((a (make-account :owner "bob")))
  (incf (acct-balance a) 100)
  (print (acct-balance a))
  (print (acct-owner a)))
(defstruct (pt (:type list)) a b)
(print (make-pt :a 1 :b 2))
(defstruct (vpt (:type vector) :named) a b)
(print (make-vpt :a 1 :b 2))
(print (typep (make-point) 'point))
(print (typep (make-point3) 'point))
(print (type-of (make-point)))
(print (equalp (make-point :x 1) (make-point :x 1)))
(print (equal (make-point :x 1) (make-point :x 1)))
(defstruct counter (n 0))
(let ((c (make-counter)))
  (dotimes (i 5) (incf (counter-n c)))
  (print (counter-n c)))
(terpri)
