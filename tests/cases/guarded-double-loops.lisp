;;; Loops whose variables are doubles when the copies of functions of other
;;; forms they call are the functions' definitions (in the image): a version
;;; with those variables unboxed, entered when they hold doubles, left for the
;;; general loop when a function is redefined (from an interrupt check) or
;;; not entered at all for other values.
(defun decay (v) (* v 0.999d0))
(defun run-decay (v0 n)
  (let ((v v0) (s 0d0))
    (dotimes (i n) (setq v (+ (decay v) 0.001d0)) (incf s v))
    (list v s)))
(print (run-decay 1d0 1000))
(print (run-decay 1 10))
(print (run-decay 1/2 3))
(print (run-decay 2.5d0 0))
(defun damp (v k) (let ((w (* v k))) (- w (* 0.5d0 w))))
(defun run-damp (n)
  (let ((v 3d0) (best 0d0))
    (dotimes (i n)
      (let ((d (damp v 1.5d0)))
        (setq v (+ d 1d0))
        (when (> v best) (setq best v))))
    (list v best)))
(print (run-damp 100))
(defun early (n)
  (let ((v 1d0))
    (dotimes (i n v)
      (setq v (+ (decay v) 1d0))
      (when (> v 500d0) (return (list :early i v))))))
(print (early 100000))
(defun decay (v) (/ v 2))
(print (run-decay 1d0 5))
(print (run-decay 8 3))
(defun decay (v) (if (> v 100) v (* v 3)))
(print (run-decay 1 5))
