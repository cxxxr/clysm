;;; Calls through the fixed entries: keyword functions called with their keys as
;;; parameters (repeated, unknown, odd, :ALLOW-OTHER-KEYS), optional parameters,
;;; the entries of MAX, CHAR-EQUAL... for two arguments, APPLY of +, and
;;; MULTIPLE-VALUE-CALL with the values passed to the fixed entries.
(declaim (notinline k1 k2 k3 k4 k5))
(defun k1 (x &key (y 1) (z 2 zp)) (list x y z zp))
(defun k2 (&key a b) (list a b))
(defun k3 (x &optional (o 9) &key k) (list x o k))
(defun k4 (x &key a &allow-other-keys) (list x a))
(defun k5 (&key ((secret s) 7)) s)
(defmacro try (form) `(print (handler-case ,form (error () :err))))
(try (k1 1))
(try (k1 1 :y 5))
(try (k1 1 :z 5))
(try (k1 1 :z 5 :y 6))
(try (k1 1 :y 5 :y 6))
(try (k1 1 :q 5))
(try (k1 1 :y))
(try (k1 1 :q 5 :allow-other-keys t))
(try (k1 1 :allow-other-keys t :q 5))
(try (k1 1 :allow-other-keys nil :y 3))
(try (k1))
(try (k2))
(try (k2 :b 1))
(try (k2 :b 1 :a 2))
(try (k2 :a 1 :a 2))
(try (k2 :c 1))
(try (k3 1))
(try (k3 1 2))
(try (k3 1 2 :k 3))
(try (k3 1 2 :k))
(try (k4 1 :zz 3))
(try (k4 1 :zz 3 :a 4))
(try (k4 1 :allow-other-keys t))
(try (k5 'secret 3))
(try (k5))
(try (k5 :secret 3))
(try (funcall #'k1 1 :z 2))
(try (apply #'k2 '(:b 3)))
(try (funcall (lambda (&key (p 0)) p) :p 4))
(try (string= "ab" "ab"))
(try (funcall #'string= "abc" "xbc" :start1 1 :start2 1))
(try (mapcar #'k2 '(:a :b) '(1 2)))
(declaim (notinline o1 o2 o3))
(defun o1 (a &optional (b a bp) (c (list a b))) (list a b bp c))
(defun o2 (&optional x) x)
(defvar *sp* 0)
(defun o3 (&optional (*sp* 5)) (list *sp* (o4)))
(defun o4 () *sp*)
(try (o1 1))
(try (o1 1 2))
(try (o1 1 2 3))
(try (o1 1 2 3 4))
(try (o1))
(try (o2))
(try (o2 4))
(try (o3))
(try (o3 8))
(try *sp*)
(try (funcall #'o1 7 nil))
(print (multiple-value-call #'list (floor 7 2) 'a))
(print (multiple-value-call #'list 'x (values) 'a))
(print (multiple-value-call #'list 'x (values 1 2 3 4 5 6) 'a))
(print (multiple-value-call #'list (values 1 2 3 4)))
(print (multiple-value-call #'+ (values 1 2 3 4 5)))
(defun f (x) (multiple-value-call #'list x (truncate x 3)))
(print (f 10))
(defun g (x) (block b (multiple-value-call (lambda (&rest r) (return-from b r)) x (truncate x 3)) 'no))
(print (g 11))
(print (catch 'z (multiple-value-call (lambda (a b) (throw 'z (list b a))) (values 1 2))))
(defun h (x) (multiple-value-call #'list x (values-list x) x))
(print (h '(1 2)))
(print (h '(1 2 3 4)))
(print (multiple-value-call 'list (values)))
(defparameter *fns* (list 'max 'min 'char-equal 'string< 'string= 'append '+ '< 'gcd))
(print (list (funcall (fdefinition (first *fns*)) 3 7) (funcall (fdefinition (second *fns*)) 3 7)
             (funcall (fdefinition (third *fns*)) #\a #\A) (funcall (fdefinition (fourth *fns*)) "ab" "b")
             (funcall (fdefinition (fifth *fns*)) "ab" "ab") (funcall (fdefinition (sixth *fns*)) '(1) '(2))
             (reduce #'max '(3 1 4 1 5)) (apply (seventh *fns*) 1 '(2 3 4 5)) (apply (eighth *fns*) '(1 2 3))
             (funcall (ninth *fns*) 12 18) (find #\B "abc" :test #'char-equal)))
(print (handler-case (funcall (fdefinition (first *fns*)) 'a 1) (error () :err)))
