;;; the sequence functions taking a function, as loops at the call site
;;; (runtime/hof.lisp): lists, simple and non-simple vectors, strings, keys,
;;; tests, -NOT forms, functions as variables and symbols, and the errors
(defvar *l* (list 5 3 8 1 9 2 8))
(defvar *v* (vector 5 3 8 1 9 2 8))
(defvar *a* (make-array 7 :initial-contents '(5 3 8 1 9 2 8) :adjustable t :fill-pointer 6))
(defvar *d* (make-array 4 :displaced-to *v* :displaced-index-offset 2))
(defvar *s* "hello world")
(defvar *al* (list '(1 . a) nil '(2 . b) '(3 . c) '(2 . d)))
(defun big (x) (> x 4))
(let ((k 4) (f #'big) (g 'big))
  (print (list (find-if (lambda (x) (> x k)) *l*) (find-if (lambda (x) (> x k)) *v*)
               (find-if #'big *a*) (find-if f *d*) (find-if g *l*) (find-if-not #'big *l*)
               (find-if #'upper-case-p *s*) (find-if #'alpha-char-p *s* :key #'char-upcase)
               (find-if (lambda (x) (> x 100)) *v*) (find-if #'evenp *al* :key (lambda (p) (if p (car p) 1)))))
  (print (list (position-if (lambda (x) (> x k)) *l*) (position-if #'big *v*) (position-if #'big *d*)
               (position-if-not #'big *a*) (position-if (lambda (c) (char= c #\o)) *s*)
               (position-if #'oddp *l* :key #'1+) (position-if f nil)))
  (print (list (count-if (lambda (x) (> x k)) *l*) (count-if #'big *v*) (count-if #'big *a*) (count-if g *d*)
               (count-if-not #'big *l*) (count-if #'alpha-char-p *s*) (count-if #'oddp *al* :key (lambda (p) (if p (car p) 0)))))
  (print (list (remove-if (lambda (x) (> x k)) *l*) (remove-if #'big *v*) (remove-if-not #'big *a*)
               (remove-if f *d*) (remove-if #'alpha-char-p *s*) (remove-if-not #'oddp *l* :key #'1+)
               *l*))
  (print (list (delete-if (lambda (x) (> x k)) (copy-list *l*)) (delete-if #'big (copy-seq *v*))
               (delete-if-not #'big (list 1 2 3)) (delete-if #'big (list 9 9 1 9)) (delete-if #'big nil)))
  (print (list (member-if #'big '(1 2 5 3)) (member-if-not #'big '(5 6 1 2)) (member-if f '(1 2))
               (member-if #'zerop '(3 0 1) :key #'1-)))
  (print (list (assoc-if #'evenp *al*) (assoc-if-not #'oddp *al*) (assoc 2 *al* :test #'=)
               (assoc 2 *al* :test-not #'>) (assoc 4 *al* :key #'1+) (assoc 9 *al* :test (lambda (a b) (= a b)))))
  (print (list (find 3 '((1 . a) (3 . c)) :key #'car) (find 3 *v* :test #'<) (find 3 *v* :test-not #'<)
               (find #\O *s* :test #'char-equal) (find "b" '("a" "b") :test #'string=)
               (position 8 *l* :key (lambda (x) x)) (position 3 *d* :test #'<) (position #\w *s* :test #'char=)
               (count 8 *l* :test #'=) (count 2 *al* :key (lambda (p) (and p (car p))))
               (remove 8 *l* :test #'=) (remove 8 *v* :test #'=) (remove 2 *al* :key (lambda (p) (and p (car p))))
               (delete 8 (copy-list *l*) :test #'=) (delete 8 (copy-seq *v*) :test-not #'/=)))
  (print (list (reduce (lambda (a b) (+ a (* 2 b))) *l* :initial-value 1)
               (reduce (lambda (a b) (+ a (* 2 b))) *v* :initial-value 1)
               (reduce (lambda (a b) (+ a (* 2 b))) *d* :initial-value 0)
               (reduce (lambda (a b) (max a b)) *l*) (reduce #'max *v*) (reduce #'+ *l*)
               (reduce (lambda (a b) (list a b)) '(1 2 3) :key #'1+)
               (reduce (lambda (a b) (+ a b)) nil :initial-value 7)
               (reduce #'+ nil) (reduce (lambda (&optional (a 0) (b 0)) (+ a b)) #())
               (reduce (lambda (a b) (cons b a)) "abc" :initial-value nil)
               (reduce #'list '(1 2 3 4) :initial-value 0 :key #'-))))
;; errors: not a sequence, not a list
(print (list (handler-case (find-if #'big 5) (type-error () :type-error))
             (handler-case (count-if #'big 'x) (type-error () :type-error))
             (handler-case (member-if #'big #(1 2)) (type-error () :type-error))
             (handler-case (find-if #'big '(1 2 . 3)) (type-error () :type-error))
             (handler-case (reduce (lambda (a b) (+ a b)) 5 :initial-value 0) (type-error () :type-error))))
;; arguments evaluated once, in their order
(let ((log nil))
  (print (list (find-if (progn (push :f log) #'big) (progn (push :s log) *l*) :key (progn (push :k log) #'identity))
               (count 8 (progn (push :s2 log) *l*) :test (progn (push :t log) #'=) :key (progn (push :k2 log) nil))
               (reverse log))))
;; a non-local exit from the function and the value of RETURN in a loop
(print (block out (find-if (lambda (x) (when (= x 9) (return-from out :exit)) nil) *l*)))
(print (dolist (x '(1 2) :done) (find-if (lambda (y) (= x y)) *l*)))
;; nothing removed: the list itself
(let ((l (list 1 2 3 4)))
  (print (list (eq l (remove-if #'zerop l)) (eq l (remove 9 l :test #'=)) (equal l (remove-if #'evenp l :key #'1-)))))
;; keyword arguments evaluated in their order
(let ((log nil))
  (print (list (position 8 *l* :key (progn (push :k log) #'identity) :test (progn (push :t log) #'=))
               (assoc 2 *al* :key (progn (push :k2 log) #'identity) :test (progn (push :t2 log) #'eql))
               (reverse log))))
