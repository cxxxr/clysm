;;; single floats and complex numbers of floats in typed (unboxed) code
(defun show (x) (print x))
(defun sf-loop (n)
  (let ((x 0.0) (v (make-array 10 :element-type 'single-float :initial-element 0.5)))
    (dotimes (i n) (setq x (+ (* x 0.5) (aref v (mod i 10)) (float (logand i 3)))))
    x))
(show (sf-loop 1000))
(defun sf-ops (a b)
  (list (+ a b) (- a b) (* a b) (/ a b) (- a) (abs (- a)) (1+ a) (1- b) (< a b) (= a a) (zerop a) (plusp a)
        (minusp b) (max a b) (min a b) (float a) (float 3) (float 7 a) (* a 2) (+ 1 b) (/ a 4) (float a 1d0)
        (+ a 1d0) (< a 2) (> b 1.5d0)))
(show (sf-ops 1.5 2.25)) (show (sf-ops -0.0 1e10)) (show (sf-ops 16777216.0 3.0))
(defun sf-decl (x y) (declare (single-float x y))
  (let ((s 0.0)) (dotimes (i 10) (setq s (+ s (* x y) 0.1))) (list s (handler-case (/ x 0.0) (division-by-zero () :div0))
                                                                  (handler-case (* x x x x x x x x x x) (floating-point-overflow () :overflow)))))
(show (sf-decl 1.5 2.5)) (show (sf-decl 1e10 1e10))
(defun cx-mandel (cr ci n)
  (let ((c (complex cr ci)) (z #c(0d0 0d0)) (i 0))
    (loop while (and (< i n) (< (abs z) 2d0)) do (setq z (+ (* z z) c)) (incf i))
    (list i z)))
(show (cx-mandel 0.25d0 0.5d0 20)) (show (cx-mandel -1.5d0 0.75d0 20)) (show (cx-mandel 0d0 0d0 5))
(defun cx-single (cr ci n)
  (let ((c (complex cr ci)) (z #c(0.0 0.0)) (i 0))
    (loop while (and (< i n) (< (abs z) 2.0)) do (setq z (+ (* z z) c)) (incf i))
    (list i z (realpart z) (imagpart z))))
(show (cx-single 0.25 0.5 12)) (show (cx-single -1.0 0.25 12))
(defun cx-ops (a b) (declare (type (complex double-float) a b))
  (list (+ a b) (- a b) (* a b) (/ a b) (- a) (conjugate a) (realpart a) (imagpart b) (abs a) (* a 2d0) (+ a 1) (- 3 b)
        (* a 0.5) (= a b) (= a a) (* a a a)))
(show (cx-ops #c(1.5d0 2d0) #c(-0.5d0 4d0))) (show (cx-ops #c(0d0 0d0) #c(1d0 0d0))) (show (cx-ops #c(3d0 -4d0) #c(0d0 2d0)))
(defun cx-sops (a b) (declare (type (complex single-float) a b))
  (list (+ a b) (- a b) (* a b) (/ a b) (- a) (conjugate a) (realpart a) (imagpart b) (abs a) (* a 2.0) (+ a 1) (- 3 b)
        (+ a 1d0) (* a #c(1d0 1d0))))
(show (cx-sops #c(1.5 2.0) #c(-0.5 4.0))) (show (cx-sops #c(3.0 -4.0) #c(0.0 2.0)))
(defun cx-big (x) (declare (double-float x))
  (let ((z (complex x x)))
    (list (abs z) (handler-case (* z z) (floating-point-overflow () :overflow)))))
(show (cx-big 3d0)) (show (cx-big 1d200))
(defun cx-poly (coeffs z) (let ((r #c(0d0 0d0))) (dolist (c coeffs r) (setq r (+ (* r z) c)))))
(show (cx-poly (list #c(1d0 2d0) #c(-0.5d0 0.25d0) 3d0 #c(0d0 -1d0)) #c(0.5d0 0.5d0)))
(show (list (complex 1.5d0) (complex 1.5 2) (complex 1 2.5d0) (type-of (complex 1.0 2.0)) (type-of #c(1d0 2d0))
            (typep #c(1 2) '(complex double-float)) (eql #c(1.5 2.0) (complex 1.5 2.0)) (equal #c(1d0 0d0) 1d0)))
