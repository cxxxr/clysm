;;; small global functions and their callers across redefinition (in the image
;;; the callers contain a guarded copy of the callee)
(defvar *v* 10)
(defun small (x) (+ x *v*))
(defun early (x) (if (> x 5) (return-from early :big) x))
(defun caller (x) (list (small x) (early x) (early (* 2 x))))
(print (caller 3))
(defun small (x) (* x 100))
(print (caller 3))
(setf (symbol-function 'small) (lambda (x) (list :lambda x)))
(print (caller 4))
(defun shadow-v () (let ((*v* 1)) (small2 1)))
(defun small2 (x) (+ x *v*))
(print (shadow-v))
(defun lex (v) (let ((x 100) (*v* 2)) (declare (ignorable x)) (flet ((small2 (y) (list :local y))) (list (small2 v) (small3 v)))))
(defun small3 (x) (list x *v*))
(defun small3 (x) (list :second x *v*))
(print (lex 5))
(defun thrower (i) (if (oddp i) (throw 'tg i) 0))
(defun catcher (n) (let ((s 0)) (dotimes (i n) (incf s (catch 'tg (thrower i)))) s))
(print (catcher 10))
(defun thrower (i) (if (evenp i) (throw 'tg (- i)) 1))
(print (catcher 10))
