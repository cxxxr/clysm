;; handler-bind: order, declining, handlers below are disabled in a handler
(let ((log nil))
  (handler-case
      (handler-bind ((c1 (lambda (c) (declare (ignore c)) (push :outer log))))
        (handler-bind ((type-error (lambda (c) (declare (ignore c)) (push :wrong log)))
                       (c1 (lambda (c) (declare (ignore c)) (push :inner-1 log)))
                       (error (lambda (c) (declare (ignore c)) (push :inner-2 log))))
          (error 'c2)))
    (error () (push :case log)))
  (print (reverse log)))
(let ((log nil))
  (handler-bind ((n1 (lambda (c) (declare (ignore c)) (push :outer log))))
    (handler-bind ((n1 (lambda (c)
                         (push :inner log)
                         ;; signalling again here reaches only the outer handler
                         (signal c))))
      (signal 'n1)))
  (print (reverse log)))
(print (handler-bind ((n1 (lambda (c) (declare (ignore c)) nil))) (signal 'n1 :a 2)))
(print (block b (handler-bind ((c1 (lambda (c) (return-from b (c1-a c))))) (error 'c1 :a :returned))))
(print (catch 'k (handler-bind ((c1 (lambda (c) (throw 'k (c1-a c))))) (error 'c1 :a :thrown))))
