;; throw from a called function to a catch around the call
(defun thrower (tag x) (if (minusp x) (throw tag (values :thrown x)) x))
(defun thrower-rec (tag n) (if (= n 0) (throw tag :bottom) (list n (thrower-rec tag (1- n)))))
(defun catcher (x)
  (list (multiple-value-list (catch 'c1 (thrower 'c1 x)))
        (catch 'c1 (list :inner (catch 'c2 (thrower 'c1 x))))
        (catch 'c1 (thrower-rec 'c1 3))
        (let ((tag (list x))) (catch tag (unwind-protect (thrower tag x) (tr :catcher-cleanup))))))
(print (traced (catcher 1)))
(print (traced (catcher -1)))
(print (handler-case (thrower 'nobody -1) (control-error () :control-error)))
;; fixnum arguments (specialized copies), special parameters
(defun spec-signal (a b) (if (> a b) (error 'e1 :v (- a b)) (+ a b)))
(defun spec-caller (n)
  (let ((s 0))
    (dotimes (i n s)
      (incf s (handler-case (spec-signal i 3) (e1 (c) (- (e1-v c))))))))
(print (spec-caller 10))
