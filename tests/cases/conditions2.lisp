(print (princ-to-string (make-condition 'simple-error :format-control "x ~A" :format-arguments '(1))))

;; handler-case: clause choice, values, :no-error
(defun hc (thunk)
  (handler-case (funcall thunk)
    (c2 (c) (list :c2 (c2-c c)))
    (c1 (c) (list :c1 (c1-a c)))
    (type-error () :type-error)
    (warning (c) (list :warning (princ-to-string c)))
    ((or division-by-zero control-error) () :compound)))
(print (hc (lambda () (error 'c2))))
(print (hc (lambda () (error 'c1 :a 2))))
(print (hc (lambda () (car 1))))
(print (hc (lambda () (signal 'c3 :text "w"))))
(print (hc (lambda () (/ 1 0))))
(print (hc (lambda () (throw 'nowhere 1))))
(print (hc (lambda () (signal 'simple-condition) :not-handled)))
(print (multiple-value-list (hc (lambda () (values 1 2 3)))))
(print (multiple-value-list (handler-case (values 1 2) (error () 0) (:no-error (a b) (values b a 0)))))
(print (multiple-value-list (handler-case (error "x") (error () (values 5 6)) (:no-error (a b) (values b a 0)))))
(print (multiple-value-list (handler-case (values))))
