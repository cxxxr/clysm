;;; handlers, restarts and condition construction: order, extent, values

(define-condition c1 (error) ((a :initarg :a :initarg :alpha :initform 1 :reader c1-a)
                              (b :initarg :b :initform (list 'b) :reader c1-b)))
(define-condition c2 (c1) ((c :initarg :c :reader c2-c)) (:default-initargs :c 30 :a 10))
(define-condition c3 (warning) ((text :initarg :text :reader c3-text))
  (:report (lambda (c s) (format s "c3: ~A" (c3-text c)))))
(define-condition c4 (c1 c3) ())
(define-condition n1 (condition) ((a :initarg :a :initform 1 :reader n1-a)))
(define-condition n2 (n1) ())

