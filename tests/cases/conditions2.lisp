         (dotimes (i 1000) (incf n (handler-case (if (zerop (mod i 3)) (dive 3) 1) (c1 (c) (c1-a c)))))
         n))

;;; the signalling call and the handler-case in one function, or one call apart
(define-condition e1 (error) ((v :initarg :v :reader e1-v)))
(define-condition e2 (e1) ())
(defvar *trace* nil)
(defun tr (x) (push x *trace*) x)
(defmacro traced (&body body) `(progn (setq *trace* nil) (let ((r (multiple-value-list (progn ,@body)))) (list r (reverse *trace*)))))

(defun same-function (x)
  (handler-case (cond ((eql x 0) (error 'e1 :v x))
                      ((eql x 1) (error "simple ~A" x))
                      ((eql x 2) (signal 'e2 :v x) :signal-returned)
                      ((eql x 3) (warn "warned ~A" x) :warn-returned)
                      ((eql x 4) (cerror "go on" 'e2 :v x) :cerror-returned)
                      (t (values x :fine)))
    (e2 (c) (list :e2 (e1-v c)))
    (e1 (c) (list :e1 (e1-v c)))
    (simple-error (c) (list :simple (simple-condition-format-arguments c)))
    (warning (c) (list :warning (princ-to-string c)))))
(print (loop for x from 0 to 5 collect (multiple-value-list (same-function x))))

;; the handler is further out: cleanups and bindings on the way
(defun inner-signaller (x)
  (let ((*v* :inner-binding))
    (unwind-protect
         (handler-case (if (oddp x) (error 'e1 :v x) (error 'type-error :datum x :expected-type 'symbol))
           (type-error (c) (list :inner (type-error-datum c) *v*)))
      (tr (list :cleanup *v*)))))
(defun outer-handler (x)
  (handler-case (list :normal (inner-signaller x) *v*)
    (e1 (c) (list :outer (e1-v c) *v*))))
(print (traced (outer-handler 1)))
(print (traced (outer-handler 2)))

;; a called function signals: by its own calls, in tail position, recursively
(defun signal-if (x) (if (minusp x) (error 'e1 :v x) (* 2 x)))
(defun signal-tail (x) (when (zerop x) (error 'e2 :v :zero)) (signal-if (- x 10)))
(defun signal-rec (l) (cond ((null l) 0) ((symbolp (car l)) (error 'e1 :v (car l))) (t (+ (car l) (signal-rec (cdr l))))))
(defun signal-uwp (x) (unwind-protect (signal-if x) (tr (list :uwp x))))
(defun caller (f x) (handler-case (list :ok (funcall f x)) (e2 (c) (list :e2 (e1-v c))) (e1 (c) (list :e1 (e1-v c)))))
(defun direct-caller (x)
  (list (handler-case (signal-if x) (e1 (c) (list :e1 (e1-v c))))
        (handler-case (signal-tail x) (e2 (c) (list :e2 (e1-v c))) (e1 (c) (list :e1-tail (e1-v c))))
        (handler-case (signal-rec (list 1 2 x 3)) (e1 (c) (list :rec (e1-v c))))
        (handler-case (signal-uwp x) (e1 (c) (list :uwp (e1-v c))))
        (ignore-errors (signal-if x))
        (handler-case (signal-if x) (type-error () :wrong-clause) (e1 () :e1-clause) (:no-error (v) (list :no-error v)))))
(print (traced (direct-caller 5)))
(print (traced (direct-caller -5)))
(print (traced (direct-caller 0)))
(print (handler-case (direct-caller 'sym) (type-error (c) (list :type-error (type-error-datum c)))))
(print (list (caller #'signal-if -1) (caller #'signal-tail 0) (caller #'signal-rec '(1 a)) (caller 'signal-if 4)))
;; the handler-case that is not concerned lets it pass; handler-bind sees it first
(defun pass-through (x)
  (handler-case (handler-case (signal-if x) (type-error () :not-this))
    (e1 (c) (list :outer (e1-v c)))))
(print (list (pass-through 3) (pass-through -3)))
(print (traced (handler-bind ((e1 (lambda (c) (tr (list :bind (e1-v c))))))
                 (handler-case (signal-if -7) (e1 (c) (list :case (e1-v c)))))))
(print (traced (handler-case (handler-bind ((e1 (lambda (c) (tr (list :bind (e1-v c))))))
                               (signal-if -8))
                 (e1 (c) (list :case (e1-v c))))))
(print (block b (handler-bind ((e1 (lambda (c) (return-from b (list :bind-exit (e1-v c))))))
                  (handler-case (signal-if -9) (type-error () :no)))))
