;;; Generic function dispatch: the cache, methods as functions of the
;;; arguments, call-next-method, redefinition.

(defmacro show (form)
  `(format t "~S => ~S~%" ',form
           (handler-case ,form (error (e) (list :error (type-of e))))))
(defmacro signals-error (form)
  `(format t "~S => ~A~%" ',form (handler-case (progn ,form :no-error) (error () :error))))

(defclass a () ((x :initarg :x :initform 1 :accessor x-of)))
(defclass b (a) ((y :initarg :y :initform 2 :accessor y-of)))
(defclass c (b) ())
(defclass d (a) ())
(defvar *a* (make-instance 'a))
(defvar *b* (make-instance 'b))
(defvar *c* (make-instance 'c))
(defvar *d* (make-instance 'd))

;;; one to five required arguments
(defgeneric g1 (p))
(defmethod g1 ((p a)) (list 'a))
(defmethod g1 ((p b)) (cons 'b (call-next-method)))
(defmethod g1 ((p c)) (cons 'c (call-next-method)))
(defmethod g1 ((p integer)) (list 'integer p))
(defmethod g1 ((p null)) 'null)
(defmethod g1 ((p symbol)) (list 'symbol (next-method-p)))
(defmethod g1 ((p t)) 't)
(show (mapcar #'g1 (list *a* *b* *c* *d* 1 nil 'foo "s" 1.5 (expt 10 30) #\a :key '(1))))
(show (g1 *c*))

(defgeneric g2 (p q))
(defmethod g2 ((p a) (q a)) (list 'a 'a))
(defmethod g2 ((p b) (q a)) (cons 'b-a (call-next-method)))
(defmethod g2 ((p a) (q b)) (cons 'a-b (call-next-method)))
(defmethod g2 ((p b) (q b)) (cons 'b-b (call-next-method)))
(show (list (g2 *a* *a*) (g2 *b* *a*) (g2 *a* *b*) (g2 *b* *b*) (g2 *c* *c*) (g2 *d* *c*)))
(signals-error (g2 *a* 1))
(signals-error (g2 *a*))
(signals-error (g2 *a* *a* *a*))

(defgeneric g3 (p q r))
(defmethod g3 (p q r) (list p q r))
(defmethod g3 ((p a) q (r integer)) (list 'a (call-next-method p q (1+ r))))
(defmethod g3 ((p b) (q symbol) (r integer)) (list 'b (call-next-method)))
(show (list (g3 1 2 3) (cdr (second (g3 *a* 2 3))) (eq (car (second (g3 *a* 2 3))) *a*)
            (cdr (second (second (g3 *b* 'q 3))))))

(defgeneric g4 (p q r s))
(defmethod g4 (p q r s) (+ p q r s))
(defmethod g4 ((p integer) (q integer) (r integer) (s integer)) (* 2 (call-next-method)))
(defmethod g4 :around ((p integer) q r (s float)) (list :around (call-next-method p q r (* 2 s))))
(show (list (g4 1 2 3 4) (g4 1.0 2 3 4) (g4 1 2 3 4.0)))
(show (apply #'g4 '(1 2 3 4)))
(show (funcall 'g4 1 2 3 4))
(show (multiple-value-list (multiple-value-call #'g4 (values 1 2) (values 3 4))))

(defgeneric g5 (p q r s u))
(defmethod g5 (p q r s u) (list p q r s u))
(defmethod g5 ((p a) q r s (u integer)) (cons 'a (call-next-method p q r s (* u 2))))
(defmethod g5 :before ((p b) q r s u) (format t "before g5~%"))
(show (cdr (cdr (g5 *b* 1 2 3 4))))

;;; standard method combination
(defvar *log* nil)
(defgeneric comb (p q))
(defmethod comb ((p a) q) (push (list 'primary-a q) *log*) (values 1 2 3))
(defmethod comb ((p b) q) (push (list 'primary-b q) *log*) (call-next-method))
(defmethod comb :before ((p a) q) (push 'before-a *log*))
(defmethod comb :before ((p b) q) (push 'before-b *log*))
(defmethod comb :after ((p a) q) (push 'after-a *log*))
(defmethod comb :after ((p b) q) (push 'after-b *log*))
(defmethod comb :around ((p a) q) (push 'around-a *log*) (call-next-method))
(defmethod comb :around ((p c) q) (push 'around-c *log*) (call-next-method p (list q)))
(dolist (o (list *a* *b* *c*))
  (setq *log* nil)
  (show (multiple-value-list (comb o 0)))
  (show (reverse *log*)))

;;; next-method-p, no-next-method, no-applicable-method
(defgeneric nm (p q))
(defmethod nm ((p a) q) (list (next-method-p) (call-next-method)))
(defmethod no-next-method ((gf (eql #'nm)) method &rest args)
  (list :no-next-method (length args) (eq (car args) *a*)))
(show (nm *a* 2))
(defmethod no-applicable-method ((gf (eql #'nm)) &rest args) (list :no-applicable-method args))
(show (nm 1 2))
(defgeneric nm2 (p))
(defmethod nm2 ((p a)) (call-next-method))
(signals-error (nm2 *a*))
(signals-error (nm2 3))
(defgeneric only-before (p))
(defmethod only-before :before ((p a)) 1)
(signals-error (only-before *a*))

;;; call-next-method with other arguments
(defgeneric cn (p q))
(defmethod cn ((p a) q) (list 'a q))
(defmethod cn ((p b) q) (list 'b (call-next-method p (if (symbolp q) (list q) q))))
(defmethod cn ((p a) (q integer)) (list 'a-int (call-next-method)))
(defmethod cn ((p c) (q integer)) (list 'c-int (call-next-method p (1+ q))))
(show (list (cn *a* 'q) (cn *b* 'q) (cn *a* 1) (cn *c* 1)))
;; the set of applicable methods changes
(defgeneric cn2 (p q))
(defmethod cn2 (p q) (list p q))
(defmethod cn2 ((p integer) (q integer)) (call-next-method p 'not-an-integer))
(defmethod cn2 ((p symbol) (q integer)) (call-next-method p (+ q (expt 2 70))))
(defmethod cn2 ((p symbol) (q list)) (call-next-method p (cons 1 q)))
(show (cn2 'a 1))
(show (cn2 'a '(2)))
;; call-next-method as a function, captured in a closure, with setq'd parameters
(defgeneric cf (p q))
(defmethod cf (p q) (list p q))
(defmethod cf ((p integer) q) (setq p 100 q 200) (call-next-method))
(defmethod cf ((p symbol) q) (funcall #'call-next-method))
(defmethod cf ((p string) q) (apply #'call-next-method (list p (list q))))
(defmethod cf ((p float) q) (let ((f (lambda () (call-next-method)))) (funcall f)))
(defmethod cf ((p character) q) (mapcar (lambda (x) (call-next-method p x)) '(1 2)))
(show (list (cf 1 2) (cf 'a 2) (cf "s" 2) (cf 1.5 2) (cf #\a 0)))

;;; EQL specializers
(defgeneric e (p q))
(defmethod e (p q) 'default)
(defmethod e ((p (eql 1)) q) (list 'one (call-next-method)))
(defmethod e ((p integer) q) (list 'integer (call-next-method)))
(defmethod e ((p (eql 'sym)) (q (eql 2.5))) 'sym-2.5)
(defmethod e (p (q (eql 'sym))) 'q-sym)
(defmethod e ((p (eql 1)) (q (eql 1))) (list 'one-one (call-next-method)))
(show (list (e 1 1) (e 1 2) (e 2 1) (e 'sym 2.5) (e 'sym 2) (e 2 'sym) (e 1.0 1) (e "s" "s")))
(defmethod e ((p (eql 2)) q) 'two)
(show (list (e 1 1) (e 2 1) (e 3 1)))
(remove-method #'e (find-method #'e '() (list '(eql 1) (find-class t))))
(show (list (e 1 1) (e 1 2)))
(defgeneric e2 (p))
(defmethod e2 ((p (eql (expt 10 30)))) 'big)
(defmethod e2 ((p (eql 1.5d0))) 'double)
(defmethod e2 ((p (eql #\a))) 'char)
(defmethod e2 ((p number)) 'number)
(defmethod e2 (p) 'other)
(show (mapcar #'e2 (list (expt 10 30) (1+ (expt 10 30)) 1.5d0 1.5 #\a #\b)))

;;; argument precedence order
(defgeneric apo (p q) (:argument-precedence-order q p))
(defmethod apo ((p b) (q a)) (cons 'b-a (call-next-method)))
(defmethod apo ((p a) (q b)) (cons 'a-b (call-next-method)))
(defmethod apo ((p a) (q a)) (list 'a-a))
(show (apo *b* *b*))

;;; redefinition, add-method, remove-method
(defgeneric r (p))
(defmethod r ((p a)) 'a1)
(show (list (r *a*) (r *b*)))
(defmethod r ((p a)) 'a2)
(show (list (r *a*) (r *b*)))
(defmethod r ((p b)) (list 'b (call-next-method)))
(show (list (r *a*) (r *b*) (r *c*)))
(defmethod r :around ((p c)) (list 'around (call-next-method)))
(show (list (r *a*) (r *b*) (r *c*)))
(remove-method #'r (find-method #'r '(:around) (list (find-class 'c))))
(show (list (r *a*) (r *b*) (r *c*)))
(let ((m (find-method #'r '() (list (find-class 'b)))))
  (remove-method #'r m)
  (show (list (r *a*) (r *b*) (r *c*)))
  (add-method #'r m)
  (show (list (r *a*) (r *b*) (r *c*))))
(defmethod r ((p a)) (if (next-method-p) (call-next-method) 'a3))
(show (list (r *a*) (r *b*)))
(defmethod r ((p t)) 't)
(show (list (r *a*) (r *b*) (r 1)))
;; a method defined while the generic function is running
(defgeneric r2 (p))
(defmethod r2 ((p a)) (eval '(defmethod r2 ((p b)) 'new)) (list (r2 *b*) 'old))
(show (r2 *b*))
(show (r2 *b*))
;; a new subclass, change-class
(defclass e-class (c) ())
(show (r (make-instance 'e-class)))
(let ((o (make-instance 'd)))
  (show (g1 o))
  (change-class o 'c)
  (show (g1 o))
  (show (y-of o)))
;; a lambda list redefined by defgeneric
(defgeneric ll (p))
(defmethod ll ((p a)) 'one)
(show (ll *a*))
(fmakunbound 'll)
(defgeneric ll (p q))
(defmethod ll ((p a) q) (list 'two q))
(show (ll *a* 1))
(signals-error (ll *a*))

;;; more classes than the first cache entries
(defgeneric many (p q))
(defmethod many (p q) (list (type-of p) q))
(defmethod many ((p number) q) (list 'number q))
(defmethod many ((p sequence) (q integer)) (list 'sequence (call-next-method)))
(show (mapcar (lambda (x) (many x 1))
              (list 1 1.5 2.5d0 1/2 #c(1 2) (expt 10 30) "s" #(1) '(1) nil 'a :k #\a *a* *b* *c* *d* #'car
                    (make-hash-table) *package*)))
(show (mapcar (lambda (x) (car (many x 'q)))
              (list 1 1.5 2.5d0 1/2 #c(1 2) (expt 10 30) "s" #(1) '(1) nil 'a :k #\a *a* *b* *c* *d*)))
(dotimes (i 3)
  (show (mapcar (lambda (x) (car (many x i))) (list 1 "s" nil 'a *a* *d* 1.5 #(1) '(1) *c* 2.5d0 1/2))))

;;; accessors and slot access
(defclass s1 () ((p :initarg :p :accessor p-of) (q :initform 2 :reader q-of :writer set-q)
                 (shared :allocation :class :initform 10 :accessor shared-of)))
(defclass s2 (s1) ((r :initform 3 :accessor r-of) (p :initform 5)))
(defmethod p-of :around ((o s2)) (list 'around (call-next-method)))
(defmethod (setf p-of) :before (v (o s2)) (format t "set p ~S~%" v))
(let ((o1 (make-instance 's1 :p 1)) (o2 (make-instance 's2)) (o3 (make-instance 's1)))
  (show (list (p-of o1) (p-of o2) (q-of o1) (q-of o2) (r-of o2)))
  (show (list (setf (p-of o1) 7) (setf (p-of o2) 8) (p-of o1) (p-of o2)))
  (set-q 9 o2)
  (show (list (q-of o2) (slot-value o2 'q) (shared-of o1) (setf (shared-of o2) 11) (shared-of o1)))
  (signals-error (p-of o3))
  (show (slot-boundp o3 'p))
  (setf (slot-value o3 'p) 4)
  (show (list (p-of o3) (slot-boundp o3 'p) (slot-exists-p o3 'r) (slot-exists-p o2 'r)))
  (slot-makunbound o3 'p)
  (signals-error (slot-value o3 'p))
  (signals-error (slot-value o3 'nope))
  (signals-error (setf (slot-value o3 'nope) 1))
  (signals-error (p-of 3))
  (show (with-slots (p (qq q)) o1 (setq p (+ p qq)) (list p qq)))
  (show (with-accessors ((p p-of) (r r-of)) o2 (setq r 30) (list p r)))
  (flet ((get-p (o) (slot-value o 'p)) (get-shared (o) (slot-value o 'shared))
         (set-p (o v) (setf (slot-value o 'p) v)))
    (show (list (get-p o1) (get-p o2) (get-shared o1) (get-shared o2) (set-p o1 1) (set-p o2 2) (get-p o1) (get-p o2)))
    ;; the class is redefined: other locations for new instances
    (defclass s1 () ((z :initform 0) (q :initform 2 :reader q-of :writer set-q) (p :initarg :p :initform 6 :accessor p-of)
                     (shared :allocation :class :initform 10 :accessor shared-of)))
    (let ((n1 (make-instance 's1)) (n2 (make-instance 's2)))
      (show (list (get-p n1) (get-p n2) (p-of n1) (p-of n2) (q-of n1) (r-of n2) (set-p n1 60) (p-of n1)
                  (get-shared n1))))))
(defmethod slot-missing ((class t) (o s1) name op &optional new)
  (list :missing name op new))
(defmethod slot-unbound ((class t) (o s1) name) (list :unbound name))
(let ((o (make-instance 's1)))
  (slot-makunbound o 'p)
  (show (list (slot-value o 'nope) (p-of o) (slot-value o 'p) (not (null (slot-boundp o 'nope))))))

;;; structures and conditions
(defstruct st f)
(defstruct (st2 (:include st)) g)
(define-condition cond1 (error) ((v :initarg :v :reader cond1-v)))
(defgeneric sg (p))
(defmethod sg ((p st)) (list 'st (st-f p)))
(defmethod sg ((p st2)) (list 'st2 (call-next-method)))
(defmethod sg ((p condition)) 'condition)
(defmethod sg ((p cond1)) (list 'cond1 (cond1-v p) (call-next-method)))
(defmethod sg ((p structure-object)) 'structure)
(defmethod sg ((p function)) 'function)
(defmethod sg ((p generic-function)) (list 'gf (call-next-method)))
(defmethod sg ((p class)) 'class)
(show (mapcar #'sg (list (make-st :f 1) (make-st2 :f 2) (make-condition 'cond1 :v 3)
                         (make-condition 'simple-error) #'car #'sg (find-class 'a))))

;;; method combinations
(defgeneric plus (p q) (:method-combination +))
(defmethod plus + ((p a) q) q)
(defmethod plus + ((p b) q) (* 10 q))
(defmethod plus :around ((p c) q) (- (call-next-method)))
(show (list (plus *a* 1) (plus *b* 1) (plus *c* 1)))
(defgeneric lst (p) (:method-combination list :most-specific-last))
(defmethod lst list ((p a)) 'a)
(defmethod lst list ((p b)) 'b)
(show (list (lst *a*) (lst *c*)))
(define-method-combination my-and :operator and :identity-with-one-argument t)
(defgeneric all (p q r) (:method-combination my-and))
(defmethod all my-and ((p a) q r) (and q r))
(defmethod all my-and ((p b) q r) (eql q r))
(show (list (all *a* 1 2) (all *b* 1 2) (all *b* 2 2)))
(define-method-combination wrap ()
  ((primary () :required t) (around (:around)))
  (let ((form `(list :wrapped (call-method ,(first primary) ,(rest primary)))))
    (if around `(call-method ,(first around) (,@(rest around) (make-method ,form))) form)))
(defgeneric w (p q) (:method-combination wrap))
(defmethod w ((p a) q) (list 'a q))
(defmethod w ((p b) q) (list 'b (call-next-method p (1+ q))))
(defmethod w :around ((p c) q) (list 'around (call-next-method)))
(show (list (w *a* 1) (w *b* 1) (w *c* 1)))

;;; lambda lists with &optional, &key, &rest
(defgeneric o (p &optional q))
(defmethod o ((p a) &optional (q 5)) (list 'a q))
(defmethod o ((p b) &optional (q 6)) (list 'b q (call-next-method) (call-next-method p 7)))
(show (list (o *a*) (o *a* 1) (o *b*) (o *b* 1)))
(signals-error (o *a* 1 2))
(defgeneric k (p &key x y))
(defmethod k ((p a) &key (x 1) y) (list 'a x y))
(defmethod k ((p b) &key (x 2) y z) (list 'b x y z (call-next-method)))
(defmethod k :around ((p c) &rest args &key &allow-other-keys) (list (length args) (call-next-method)))
(show (list (k *a*) (k *a* :y 2) (k *b* :x 3) (k *b* :z 4 :y 5) (k *c* :z 4 :y 5)))
(signals-error (k *a* :z 1))
(show (k *a* :z 1 :allow-other-keys t))
(signals-error (k *a* :x))
(defgeneric rst (p &rest more))
(defmethod rst ((p a) &rest more) (list 'a more))
(defmethod rst ((p b) &rest more) (list 'b (apply #'call-next-method p 0 more)))
(show (list (rst *a*) (rst *a* 1 2) (rst *b* 1 2) (apply #'rst *c* '(1 2 3))))
(defgeneric zero ())
(defmethod zero () 'zero)
(show (zero))
(signals-error (zero 1))

;;; the generic function as an object
(show (functionp #'g2))
(show (typep #'g2 'generic-function))
(show (mapcar #'g1 (list *c* 1)))
(show (funcall (lambda (f) (funcall f *b* *a*)) #'g2))
(show (mapcar #'g2 (list *a* *b*) (list *b* *a*)))
(show (reduce #'g4 '(1 2 3 4) :key #'identity :initial-value 0 :end 0))

;;; EQL specializer objects and other arguments of their class, in both orders
(defgeneric eg (p q))
(defmethod eg (p q) (list 'default p q))
(defmethod eg ((p (eql :k)) q) (list 'k (call-next-method)))
(defmethod eg ((p symbol) q) (list 'symbol (call-next-method)))
(defmethod eg ((p (eql 5)) q) 'five)
(defmethod eg ((p (eql 2.5)) q) 'two-and-a-half)
(defmethod eg ((p (eql (expt 10 25))) q) 'big)
(dotimes (i 3)
  (show (list (eg :other 1) (eg :k 1) (eg :other 1) (eg 'x 1) (eg 6 1) (eg 5 1) (eg 6 1) (eg 2.5 1) (eg 3.5 1)
              (eg (expt 10 25) 1) (eg (1+ (expt 10 25)) 1) (eg 5.0 1))))
(defgeneric eg2 (p q))
(defmethod eg2 (p q) 'default)
(defmethod eg2 ((p (eql 1)) (q (eql 2))) 'one-two)
(defmethod eg2 ((p (eql 1)) (q integer)) 'one-int)
(defmethod eg2 ((p integer) (q (eql 2))) 'int-two)
(defmethod eg2 ((p integer) (q integer)) 'int-int)
(dotimes (i 2)
  (show (list (eg2 3 4) (eg2 1 2) (eg2 1 3) (eg2 3 2) (eg2 1 'a) (eg2 'a 2) (eg2 1 2) (eg2 3 4))))
(defmethod eg2 ((p (eql 3)) q) 'three)
(show (list (eg2 3 4) (eg2 1 2) (eg2 1 3) (eg2 3 2)))

;;; more classes than the cache holds before it becomes a table
(defmacro define-many (n)
  `(progn
     ,@(loop for i below n
             collect `(defclass ,(intern (format nil "MC~D" i)) () ())
             collect `(defmethod mg ((x ,(intern (format nil "MC~D" i))) y) (+ ,i y)))
     (defparameter *many* (list ,@(loop for i below n collect `(make-instance ',(intern (format nil "MC~D" i))))))))
(defgeneric mg (x y))
(define-many 45)
(show (loop for o in *many* sum (mg o 1)))
(show (loop for o in (reverse *many*) sum (mg o 'not-a-number-is-never-added-here-0) into s finally (return s)))
(show (loop repeat 3 sum (loop for o in *many* sum (mg o 2))))
(defmethod mg ((x mc7) y) (* 1000 (call-next-method)))
(defmethod mg (x y) y)
(show (loop for o in *many* sum (mg o 1)))

;;; make-instance
(defclass w ()
  ((id :initarg :id :reader w-id)
   (name :initarg :name :initform "w" :reader w-name)
   (kids :initform (list 1 2) :accessor w-kids)
   (size :initarg :size :initarg :sz :accessor w-size))
  (:default-initargs :size 10))
(defclass wb (w) ((label :initarg :label :initform "ok" :reader wb-label))
  (:default-initargs :name "button"))
(defun describe-w (x)
  (list (if (slot-boundp x 'id) (w-id x) :unbound) (w-name x) (w-kids x) (w-size x)
        (if (typep x 'wb) (wb-label x) :none)))
(show (describe-w (make-instance 'w)))
(show (describe-w (make-instance 'w :id 1 :sz 3 :size 4)))
(show (describe-w (make-instance 'wb :id 2 :label "go")))
(show (describe-w (make-instance (find-class 'wb) :name "n")))
(show (let ((c 'w)) (describe-w (make-instance c :id 3))))
(signals-error (make-instance 'w :bad 1))
(show (describe-w (make-instance 'w :bad 1 :allow-other-keys t)))
(signals-error (make-instance 'w :id))
(signals-error (let ((c 'w)) (make-instance c :bad 1)))
(defmethod initialize-instance :after ((x w) &key (scale 1) &allow-other-keys)
  (setf (w-size x) (* scale (w-size x))))
(show (describe-w (make-instance 'w :id 1)))
(show (describe-w (make-instance 'w :id 1 :scale 3)))
(show (describe-w (make-instance 'wb :scale 2 :size 4)))
(show (describe-w (make-instance 'w :anything 1)))
(defmethod initialize-instance :around ((x wb) &rest initargs &key label)
  (if label (call-next-method) (apply #'call-next-method x :label "none" initargs)))
(defmethod shared-initialize :after ((x wb) slot-names &key)
  (push 0 (w-kids x)))
(show (describe-w (make-instance 'wb)))
(show (describe-w (make-instance 'wb :label "l" :scale 2)))
(show (describe-w (make-instance 'w)))
(let ((x (make-instance 'wb)))
  (show (describe-w (reinitialize-instance x :size 1)))
  (show (describe-w (initialize-instance x :size 2 :name "again"))))
(defclass w () ((id :initarg :id :reader w-id) (name :initarg :name :initform "w2" :reader w-name)
                (kids :initform (list 3) :accessor w-kids) (extra :initform 'extra)
                (size :initarg :size :accessor w-size :initform 7)))
(show (describe-w (make-instance 'w)))
(show (describe-w (make-instance 'wb :id 9)))
(signals-error (make-instance 'w :sz 3))
(defmethod make-instance :around ((class (eql (find-class 'w))) &rest initargs)
  (declare (ignore initargs))
  (let ((x (call-next-method))) (setf (w-kids x) :made) x))
(show (describe-w (make-instance 'w)))
(show (describe-w (make-instance (find-class 'w) :id 4)))
(show (describe-w (make-instance 'wb)))
(defclass counted () ((n :initform 0 :allocation :class :accessor counted-n) (v :initarg :v :initform 1)))
(defmethod initialize-instance :before ((x counted) &key) (incf (counted-n x)))
(show (list (counted-n (make-instance 'counted)) (counted-n (make-instance 'counted :v 2))
            (slot-value (make-instance 'counted :v 5) 'v)))

;;; short-form combinations of two and three arguments
(defgeneric sc (p q) (:method-combination max))
(defmethod sc max ((p a) q) q)
(defmethod sc max ((p b) q) (* 2 q))
(defmethod sc max ((p c) q) (- q))
(defmethod sc :around ((p c) q) (list 'around (call-next-method p (1+ q))))
(show (list (sc *a* 1) (sc *b* 1) (sc *c* 1)))
(defgeneric sc2 (p q r) (:method-combination progn))
(defmethod sc2 progn ((p a) q r) (push (list 'a q r) *log*) 'a)
(defmethod sc2 progn ((p b) q r) (push (list 'b q r) *log*) 'b)
(setq *log* nil)
(show (list (sc2 *a* 1 2) (sc2 *b* 3 4) (reverse *log*)))
(defgeneric sc3 (p) (:method-combination or))
(defmethod sc3 or ((p a)) (x-of p))
(defmethod sc3 or ((p b)) nil)
(defgeneric sc4 (p) (:method-combination nconc :most-specific-last))
(defmethod sc4 nconc ((p a)) (list 'a))
(defmethod sc4 nconc ((p b)) (list 'b))
(show (list (sc3 *a*) (sc3 *b*) (sc4 *a*) (sc4 *c*)))
(signals-error (sc3 1))
