
(LET ((A 1))
  (PROGN (SETQ A (1+ A)) (SETQ A (1+ A)))) 
(IF (PROGN T T)
    '(TWICE 1)
    #'(LAMBDA (&OPTIONAL (X (PROGN 1 1)) &KEY ((:K Y) (PROGN 2 2)))
        (PROGN (LIST X Y) (LIST X Y)))) 
(LOCALLY (LIST (PROGN 1 1) (PROGN 1 1))) 
(LOCALLY
 (LIST (PROGN 3 3)
       (LET ((S 2))
         S))) 
(FLET ((TWICE (X)
         X))
  (TWICE (SETQ B (1+ B)))) 
(LABELS ((F (N)
           (PROGN N N)))
  (F 1)) 
(BLOCK B (TAGBODY TOP (PROGN (GO TOP) (GO TOP))) (RETURN-FROM B (PROGN 4 4))) 
(LET* ((X (PROGN 1 1)) (Y (PROGN X X)))
  (DECLARE (IGNORABLE Y))
  (THE FIXNUM (PROGN X X))) 