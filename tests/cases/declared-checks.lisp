;;; At (SAFETY 1), a value given to a variable declared of a type the code
;;; relies on (a parameter, a LET, a SETQ, the value of THE) is checked as
;;; SBCL checks it: a TYPE-ERROR, never a trap of the code that takes the
;;; variable to be of the type (an unboxed double, a vector of a kind of
;;; storage, an object of a structure class...).
(defstruct pt a b)
(defun opaque (x) x)
(declaim (notinline opaque))

(defun p-double (d) (declare (double-float d)) (+ d 1d0))
(defun p-single (d) (declare (single-float d)) (+ d 1f0))
(defun p-fixnum (x) (declare (fixnum x)) (+ x 1))
(defun p-range (x) (declare (type (integer 0 100) x)) (* x 2))
(defun p-ub32 (x) (declare (type (unsigned-byte 32) x)) (logand x 255))
(defun p-svec (v) (declare (simple-vector v)) (svref v 0))
(defun p-sstring (s) (declare (simple-string s)) (schar s 0))
(defun p-f64vec (v) (declare (type (simple-array double-float (*)) v)) (aref v 0))
(defun p-s32vec (v) (declare (type (simple-array (signed-byte 32) (*)) v)) (aref v 0))
(defun p-md2 (v) (declare (type (simple-array t (* *)) v)) (aref v 0 0))
(defun p-cons (c) (declare (cons c)) (car c))
(defun p-list (c) (declare (list c)) (car c))
(defun p-function (f) (declare (function f)) (funcall f))
(defun p-char (c) (declare (character c)) (char-code c))
(defun p-symbol (s) (declare (symbol s)) (symbol-name s))
(defun p-struct (p) (declare (pt p)) (pt-a p))
(defun p-struct-setf (p) (declare (pt p)) (setf (pt-a p) 3))
(defun p-opt (x &optional (y 1d0)) (declare (double-float y)) (+ x y))
(defun p-key (&key (y 1d0)) (declare (double-float y)) (* 2 y))
(defun p-rest (&rest r) (declare (list r)) (length r))
(defun l-let (x) (let ((d x)) (declare (double-float d)) (* d 2)))
(defun l-setq (x) (let ((d 1d0)) (declare (double-float d)) (setq d x) (* d 2)))
(defun l-the (x) (+ (the double-float x) 1d0))
(defun l-the-vec (x) (svref (the simple-vector x) 0))
(defun l-free (x) (locally (declare (simple-string x)) (schar x 0)))
(defvar *v* (vector 1 2))
(declaim (type simple-vector *v*))
(defun s-read () (svref *v* 0))
;; a small function copied into its callers
(defun tiny (d) (declare (double-float d)) (* d d))
(defun calls-tiny (x) (tiny x))

;; compiled code checks declarations (the evaluator of the image, INTERP=1
;; tools/run-tests.sh, does not)
(defun checks-declarations-p ()
  (handler-case (let ((x (car (list 'foo)))) (declare (fixnum x)) (and x nil))
    (type-error () t)))
(defun outcome (f arg &optional (type t))
  (let ((r (handler-case (funcall f (opaque arg))
             (type-error () :type-error)
             (error (e) (declare (ignore e)) :error))))
    (if (or (eq r :type-error) (checks-declarations-p) (typep arg type)) r :type-error)))

(dolist (f '((p-double double-float) (p-single single-float) (p-fixnum (signed-byte 30))
             (p-range (integer 0 100)) (p-ub32 (unsigned-byte 32)) (p-svec simple-vector)
             (p-sstring simple-string) (p-f64vec (simple-array double-float (*)))
             (p-s32vec (simple-array (signed-byte 32) (*))) (p-md2 (simple-array t (* *)))
             (p-cons cons) (p-list list) (p-function function) (p-char character) (p-symbol symbol)
             (p-struct pt) (p-struct-setf pt) (l-let double-float) (l-setq double-float)
             (l-the double-float) (l-the-vec simple-vector) (l-free simple-string) (calls-tiny double-float)))
  (print (list (car f) (mapcar (lambda (v) (outcome (car f) v (cadr f)))
                         (list 42 2.5d0 (make-pt) (list 1) "abc" (vector 1) #\a
                               (expt 2 70) -1)))))
;; values of the types
(print (list (p-double 1d0) (p-single 1f0) (p-fixnum 41) (p-range 50) (p-ub32 (1- (expt 2 32)))
             (p-svec (vector 7)) (p-sstring "xy")
             (p-f64vec (make-array 1 :element-type 'double-float :initial-element 2d0))
             (p-s32vec (make-array 1 :element-type '(signed-byte 32) :initial-element -3))
             (p-md2 (make-array '(1 1) :initial-element 'z))
             (p-cons (list 4)) (p-list nil) (p-function (lambda () 5)) (p-char #\A) (p-symbol 'abc)
             (p-struct (make-pt :a 6)) (p-struct-setf (make-pt)) (p-rest 1 2 3)
             (l-let 1d0) (l-setq 2d0) (l-the 3d0) (calls-tiny 3d0)))
(print (list (outcome 'p-ub32 (expt 2 33) '(unsigned-byte 32)) (outcome 'p-ub32 (- (expt 2 31)) '(unsigned-byte 32))
             (outcome (lambda (x) (p-opt 1 x)) 2 'double-float)
             (outcome (lambda (x) (p-key :y x)) 2 'double-float)
             (outcome (lambda (x) (p-opt x 2d0)) 'a 'number)
             (outcome (lambda (x) (setq *v* x) (s-read)) (list 1) 'simple-vector)))
(terpri)
