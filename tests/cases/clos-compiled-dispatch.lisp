;;; Dispatch compiled as code (the discriminating functions of a unit, see
;;; docs/INTERNALS.md): the trees must agree with the generic functions as
;;; methods and classes change while the program runs.
(defun show (&rest xs) (format t "~{~S~^ ~}~%" xs))
(defmacro errs (form) `(handler-case ,form (error () :error)))

;;; --- built-in classes and EQL specializers, two arguments
(defgeneric kind (x y))
(defmethod kind ((x integer) (y integer)) 1)
(defmethod kind ((x integer) (y (eql 0))) 2)
(defmethod kind ((x (eql :zero)) y) 3)
(defmethod kind ((x symbol) (y string)) 4)
(defmethod kind ((x string) y) 5)
(defmethod kind ((x list) (y list)) 6)
(defmethod kind ((x null) (y null)) 7)
(defmethod kind ((x float) (y number)) 8)
(defmethod kind ((x character) (y character)) 9)
(defmethod kind ((x vector) (y (eql 'len))) 10)
(defmethod kind (x y) 0)
(defun kinds ()
  (let ((r nil))
    (dolist (p (list (cons 1 2) (cons 3 0) (cons :zero 1) (cons 'a "s") (cons "s" 1) (cons '(1) nil)
                     (cons nil nil) (cons 1.5 2) (cons #\a #\b) (cons (vector 1) 'len) (cons 2.5d0 1/2)
                     (cons (expt 10 20) 5) (cons #\a 1) (cons nil "s") (cons :k "s") (cons :zero "s")
                     (cons (make-array 2 :element-type 'character :fill-pointer 1 :initial-element #\a) 1)
                     (cons "s" 'len) (cons (expt 10 20) 0) (cons 1 (expt 10 20)) (cons 1.5 #c(1 2))
                     (cons (make-hash-table) 1) (cons '(1) '(2)) (cons nil '(2)) (cons #'car #'car)))
      (push (kind (car p) (cdr p)) r))
    (nreverse r)))
(show (kinds) (kinds) (kinds))
(defmethod kind ((x integer) (y (eql 5))) 11)
(show (kinds))
(defmethod kind ((x integer) (y integer)) 12)
(show (kinds))
(remove-method #'kind (find-method #'kind '() (list (find-class 'integer) (find-class 'integer))))
(show (kinds) (kinds))

;;; --- one argument, EQL and classes; methods added and redefined
(defgeneric op (code x))
(defmethod op ((code (eql :add)) x) (+ x 1))
(defmethod op ((code (eql :sub)) x) (- x 1))
(defmethod op ((code (eql 7)) x) (values 7 x))
(defmethod op ((code symbol) x) (list code x))
(defun ops () (mapcar (lambda (c) (errs (multiple-value-list (op c 10)))) '(:add :sub 7 :nop nil t 8 "s")))
(show (ops) (ops) (ops))
(defmethod op ((code (eql :add)) x) (+ x 100))
(show (ops) (ops))
(defmethod op ((code integer) x) (* code x))
(show (ops) (ops))
(defmethod op :around ((code (eql :sub)) x) (list :around (call-next-method)))
(show (ops) (ops))

;;; --- classes: subclasses, a class defined later, a class redefined
(defclass shape () ((size :initarg :size :initform 1 :accessor size)))
(defclass circle (shape) ())
(defclass square (shape) ())
(defclass big-square (square) ())
(defgeneric area (s))
(defmethod area ((s shape)) (list :shape (size s)))
(defmethod area ((s circle)) (list :circle (* 3 (size s))))
(defmethod area ((s square)) (list :square (* (size s) (size s))))
(defvar *shapes* (list (make-instance 'shape) (make-instance 'circle :size 2) (make-instance 'square :size 3)
                       (make-instance 'big-square :size 4)))
(defun areas () (mapcar (lambda (s) (errs (area s))) (append *shapes* (list 1 nil "x"))))
(show (areas) (areas) (areas))
(defclass triangle (shape) ())
(push (make-instance 'triangle :size 5) *shapes*)
(show (areas) (areas))
(defmethod area ((s big-square)) (list :big (call-next-method)))
(show (areas) (areas))
(defmethod area ((s triangle)) (list :triangle (size s)))
(show (areas) (areas))
;; the precedence of a class changes
(defclass mixin () ())
(defmethod area ((s mixin)) (list :mixin (call-next-method)))
(defclass circle (mixin shape) ())
(show (areas) (areas))
(defclass circle (shape) ())
(show (areas) (areas))
(defmethod area ((s integer)) :integer)
(show (areas) (areas))

;;; --- :before, :after, :around and CALL-NEXT-METHOD chains
(defvar *log* nil)
(defclass c1 () ()) (defclass c2 (c1) ()) (defclass c3 (c2) ()) (defclass c4 (c3) ())
(defgeneric visit (x d))
(defmethod visit ((x c1) d) (push (list :c1 d) *log*) (values d :c1))
(defmethod visit ((x c2) d) (push :c2 *log*) (call-next-method x (+ d 1)))
(defmethod visit ((x c3) d) (push :c3 *log*) (if (next-method-p) (call-next-method) :none))
(defmethod visit :before ((x c2) d) (push :before-c2 *log*))
(defmethod visit :before ((x c1) d) (push :before-c1 *log*))
(defmethod visit :after ((x c3) d) (push :after-c3 *log*))
(defmethod visit :after ((x c1) d) (push :after-c1 *log*))
(defmethod visit :around ((x c4) d) (push :around-c4 *log*) (if (evenp d) (call-next-method) (call-next-method x 0)))
(defmethod visit :around ((x c2) d) (push :around-c2 *log*) (multiple-value-list (call-next-method)))
(defvar *cs* (list (make-instance 'c1) (make-instance 'c2) (make-instance 'c3) (make-instance 'c4)))
(defun visits ()
  (mapcar (lambda (o) (setq *log* nil) (list (multiple-value-list (visit o 1)) (reverse *log*))) *cs*))
(show (visits)) (show (visits)) (show (visits))
(remove-method #'visit (find-method #'visit '(:around) (list (find-class 'c2) (find-class t))))
(show (visits)) (show (visits))
(defmethod visit ((x c4) d) (push :c4 *log*) (funcall #'call-next-method))
(show (visits)) (show (visits))

;; CALL-NEXT-METHOD without a next method
(defgeneric lonely (x))
(defmethod lonely ((x c1)) (call-next-method))
(defmethod lonely ((x c2)) (if (next-method-p) (list :next (errs (call-next-method))) :no))
(show (errs (lonely (first *cs*))) (errs (lonely (second *cs*))) (errs (lonely (first *cs*))))

;;; --- three and four arguments
(defgeneric combine (a b c))
(defmethod combine ((a shape) (b shape) c) (list :ss c))
(defmethod combine ((a circle) (b square) c) (list :cs c))
(defmethod combine ((a square) (b circle) (c integer)) (list :sci (* 2 c)))
(defmethod combine ((a circle) (b circle) (c symbol)) (list :ccs c))
(defun combines ()
  (let ((c (second *shapes*)) (r nil))
    (dolist (a *shapes*)
      (dolist (b (list c (car (last *shapes*)) (third *shapes*)))
        (dolist (x '(1 x "s"))
          (push (errs (combine a b x)) r))))
    (nreverse r)))
(show (combines)) (show (equal (combines) (combines)))
(defgeneric four (a b c d))
(defmethod four ((a integer) b (c symbol) d) (list 1 a b c d))
(defmethod four ((a integer) (b integer) (c null) d) (list 2 (call-next-method)))
(defmethod four (a b c (d (eql :x))) (list 3 a))
(show (errs (four 1 2 'a 3)) (errs (four 1 2 nil 3)) (errs (four 1 2 nil :x)) (errs (four "s" 2 nil :x))
      (errs (four "s" 2 nil 3)) (errs (four 1 "s" nil :y)))

;;; --- a generic function redefined: another lambda list, a method combination
(defgeneric morph (x))
(defmethod morph ((x integer)) (list :int x))
(defmethod morph ((x symbol)) (list :sym x))
(defun morphs () (list (errs (morph 1)) (errs (morph 'a)) (errs (morph "s"))))
(show (morphs) (morphs))
(fmakunbound 'morph)
(defgeneric morph (x) (:method-combination list))
(defmethod morph list ((x integer)) :integer)
(defmethod morph list ((x number)) :number)
(show (morphs) (morphs))

;;; --- structures and conditions as arguments
(defstruct pt x)
(defstruct (pt3 (:include pt)) z)
(define-condition my-error (error) ())
(defgeneric describe-it (x))
(defmethod describe-it ((x pt)) :pt)
(defmethod describe-it ((x pt3)) (list :pt3 (call-next-method)))
(defmethod describe-it ((x error)) :error)
(defmethod describe-it ((x my-error)) (list :my (call-next-method)))
(defmethod describe-it ((x t)) :other)
(defun describes ()
  (mapcar #'describe-it (list (make-pt) (make-pt3) (make-condition 'my-error) (make-condition 'simple-error) 1 nil)))
(show (describes) (describes)
      (list (describe-it (make-pt)) (describe-it (make-pt3)) (describe-it (make-condition 'my-error))
            (describe-it (make-condition 'simple-error)) (describe-it 1) (describe-it nil)))

;;; --- recursion through the generic function, multiple values, a method that
;;; adds a method while it runs
(defgeneric gfib (n))
(defmethod gfib ((n integer)) (if (< n 2) n (+ (gfib (- n 1)) (gfib (- n 2)))))
(show (gfib 20))
;; the tree of GFIB is in use (no method or class changed since it was called)
#+clysm
(defmacro compiled-in-a-unit-p ()
  (let ((s (make-symbol "PROBE")))
    `(progn (sys::%static-lambda ,s (lambda () 1)) (sys::%static-known-p ,s))))
(show :trees #-clysm t
             #+clysm (let ((n 0))
                       (dolist (c sys::*gf-discs*) (when (eq (svref c 0) t) (incf n)))
                       ;; (not when this file is run by the evaluator)
                       (or (>= n 1)
                           (not (compiled-in-a-unit-p))
                           n)))
(defgeneric grow (x))
(defmethod grow ((x symbol)) (eval '(defmethod grow ((x (eql :new))) :new)) (list x (grow :new)))
(show (grow :a) (grow :new) (grow :b))


;;; --- short method combinations
(defgeneric cost (x) (:method-combination +))
(defmethod cost + ((x c1)) 1)
(defmethod cost + ((x c2)) 10)
(defmethod cost + ((x c4)) 1000)
(defgeneric parts (x y) (:method-combination append :most-specific-last))
(defmethod parts append ((x c1) y) (list y))
(defmethod parts append ((x c2) y) (list 2 y))
(defmethod parts :around ((x c4) y) (cdr (call-next-method)))
(defgeneric names (x) (:method-combination list))
(defmethod names list ((x c1)) :c1)
(defmethod names list ((x c3)) :c3)
(defgeneric all-ok (x) (:method-combination and))
(defmethod all-ok and ((x c1)) (push :c1 *log*) t)
(defmethod all-ok and ((x c2)) (push :c2 *log*) nil)
(defmethod all-ok and ((x c3)) (push :c3 *log*) t)
(defun shorts ()
  (setq *log* nil)
  (list (mapcar #'cost *cs*) (mapcar (lambda (o) (parts o 7)) *cs*) (mapcar #'names *cs*)
        (mapcar #'all-ok *cs*) (reverse *log*)
        (list (cost (car *cs*)) (cost (fourth *cs*)) (parts (fourth *cs*) 1) (names (third *cs*)) (errs (cost 1)))))
(show (shorts)) (show (equal (shorts) (shorts)) (shorts))
(defmethod cost + ((x c3)) 100)
(show (shorts)) (show (shorts))
