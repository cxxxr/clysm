(defvar *seed* 12345)
(defun rnd (n) (setq *seed* (mod (+ (* *seed* 1103515245) 12345) 2147483648)) (mod *seed* n))
(defun big (digits) (let ((x 0)) (dotimes (i digits x) (setq x (+ (* x 10) (rnd 10))))))
(defun sgn (x) (if (= (rnd 2) 0) x (- x)))
(defvar *checksum* 0)
(defun mix (x) (setq *checksum* (mod (+ (* *checksum* 31) (sxhash-number x)) 1000000007)))
(defun sxhash-number (x) (mod (abs (if (integerp x) x (+ (numerator x) (* 7 (denominator x))))) 1000000007))
;; bignum arithmetic
(dotimes (i 300)
  (let ((a (sgn (big (+ 1 (rnd 60))))) (b (sgn (+ 1 (big (+ 1 (rnd 40)))))))
    (mix (+ a b)) (mix (- a b)) (mix (* a b))
    (multiple-value-bind (q r) (truncate a b) (mix q) (mix r)
      (unless (= a (+ (* q b) r)) (print (list 'bad-truncate a b))))
    (multiple-value-bind (q r) (floor a b) (mix q) (mix r))
    (multiple-value-bind (q r) (ceiling a b) (mix q) (mix r))
    (multiple-value-bind (q r) (round a b) (mix q) (mix r))
    (mix (gcd a b)) (mix (/ a b))
    (mix (logand a b)) (mix (logior a b)) (mix (logxor a b))
    (mix (ash a (- (rnd 80) 40)))
    (when (< (abs b) 1000) (mix (expt b (rnd 20))))))
(print *checksum*)
(print (truncate (expt 10 50) 7))
(print (floor (- (expt 10 50)) 7))
(print (isqrt (expt 10 41)))
(print (gcd (expt 2 100) (expt 6 40)))
(print (/ (expt 2 100) (expt 6 40)))
(print (* 123456789012345678901234567890 98765432109876543210987654321))
(print (mod (- (expt 3 100)) (expt 7 20)))
(print (integer-length (expt 2 200)))
(print (logcount (1- (expt 2 100))))
(print (ash -12345678901234567890 -30))
(print (logand -12345678901234567890 (1- (expt 2 70))))
;; floats
(dolist (x '(0.1 0.2 0.3 1.1 2.5 3.14159 1e10 1.5e-7 123.456 9.999999 1e7 1e-3 0.000123 6.02e23))
  (print (list x (* x 3) (/ x 7) (round x) (floor x) (ceiling x) (truncate x))))
(dolist (x '(0.1d0 1d100 2.5d-10 3.141592653589793d0 2.2250738585072014d-308))
  (print (list x (* x 2) (sqrt x))))
(print (list (float 1/3) (float 2/3 1d0) (float (expt 2 70)) (float (- (expt 10 30)) 1d0)))
(print (list (exp 1.0) (log 10.0) (sin 1.0) (cos 1.0) (atan 1.0 2.0) (expt 2.0 0.5)))
(print (list (round 0.5) (round 1.5) (round 2.5) (round -0.5) (round -1.5)))
(print (list (ffloor 3.7) (fceiling 3.2) (ftruncate -3.7) (fround 2.5)))
(print (list (decode-float 1.5) (integer-decode-float 1.5) (scale-float 1.0 3) (float-sign -2.0)))
(print (rational 0.75))
(print (list (= 0.5 1/2) (< 1/3 0.34) (> 1d0 1) (max 1 2.0) (min 3 1/2)))
