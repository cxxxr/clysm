;;; Every short product size, carries, signs, GCD trailing-zero shifts across
;;; a word, and quotient/remainder signs for the four-digit division path.
(defun short-kernel-check ()
  (let ((hash 0) (seed 987654321))
    (labels ((record (x) (setq hash (mod (+ (* hash 31) x) 1000000007)))
             (next-word () (setq seed (mod (+ (* seed 1664525) 1013904223) 4294967296)))
             (integer-of (n) (let ((x 0)) (dotimes (i n x) (setq x (+ (ash x 32) (next-word)))))))
      (loop for n from 2 to 9 do
        (dotimes (iteration 40)
          (let ((a (integer-of n)) (b (integer-of n)))
            (dolist (sign '(1 -1))
              (record (* a (* sign b)))
              (record (* (- (ash 1 (* n 32)) 1) (* sign b))))
            (when (<= n 4)
              (record (gcd a b))
              (dolist (shift '(0 1 31 32 63 64 65 95 127))
                (record (gcd (ash (logand a #xffff) shift) (ash (logand b #xffff) shift)))))
            (dolist (d '(1 -1 2 -2 3 -3 65537 536870911 2147483648 4294967295))
              (dolist (x (list a (- a)))
                (multiple-value-bind (q r) (truncate x d) (record q) (record r))
                (multiple-value-bind (q r) (floor x d) (record q) (record r)))))))
      (dolist (a '(0 -1 1 9223372036854775808 -9223372036854775808 18446744073709551615))
        (dolist (b '(0 -1 1 9223372036854775808 -9223372036854775808 18446744073709551615))
          (record (gcd a b)))))
    hash))
(print (short-kernel-check))
(terpri)
