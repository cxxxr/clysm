;;; AREF and CHAR of arrays of unknown type that are no simple vectors or
;;; strings (the inline access takes the storage of a one-dimensional
;;; array header from a helper), and the checks of declared integer ranges.
(defun ref (a i) (aref a i))
(defun cref (s i) (char s i))
(defun put (a i v) (setf (aref a i) v))
(defun cput (s i c) (setf (char s i) c))
(defun sum (a) (let ((s 0)) (dotimes (i (length a) s) (incf s (aref a i)))))
(defun try (thunk) (handler-case (funcall thunk) (type-error () :type-error) (error () :error)))
(defun try-any (thunk) (handler-case (funcall thunk) (error () :error)))

(let ((adj (make-array 4 :adjustable t :fill-pointer 0))
      (simple (vector 10 20 30))
      (disp-base (vector 1 2 3 4 5 6)))
  (dotimes (i 10) (vector-push-extend (* i i) adj))
  (print (list (ref adj 0) (ref adj 9) (sum adj) (ref simple 1) (sum simple)))
  (put adj 3 :three)
  (print (list (ref adj 3) (aref adj 3) (length adj)))
  ;; beyond the fill pointer but within the storage: AREF reads it; beyond the dimension: an error
  (setf (fill-pointer adj) 5)
  (print (list (ref adj 7) (length adj) (>= (array-dimension adj 0) 10)))
  (print (try-any (lambda () (ref adj 1000))))
  (print (try-any (lambda () (ref adj -1))))
  (print (try-any (lambda () (ref simple 3))))
  ;; a displaced vector, with an offset
  (let ((d (make-array 3 :displaced-to disp-base :displaced-index-offset 2)))
    (print (list (ref d 0) (ref d 2) (sum d)))
    (put d 1 :x)
    (print (list (ref d 1) (aref disp-base 3)))
    (print (try-any (lambda () (ref d 3)))))
  ;; an adjusted array keeps its elements
  (let ((a (make-array 3 :adjustable t :initial-contents '(1 2 3))))
    (setq a (adjust-array a 6 :initial-element 0))
    (print (list (ref a 2) (ref a 5) (sum a))))
  ;; two dimensions and other element types go the general way
  (let ((m (make-array '(2 3) :initial-contents '((1 2 3) (4 5 6))))
        (bytes (make-array 4 :element-type '(unsigned-byte 8) :adjustable t :fill-pointer 2 :initial-element 7))
        (bits (make-array 5 :element-type 'bit :initial-element 1)))
    (print (list (aref m 1 2) (ref bytes 1) (ref bits 4) (try-any (lambda () (ref m 1)))))))

(let ((s (make-array 3 :element-type 'character :adjustable t :fill-pointer 0))
      (simple "hello"))
  (vector-push-extend #\a s) (vector-push-extend #\b s) (vector-push-extend #\c s) (vector-push-extend #\d s)
  (print (list (cref s 0) (cref s 3) (cref simple 4) (length s)))
  (cput s 1 #\Z)
  (print (list (cref s 1) (coerce s 'simple-string)))
  (print (try-any (lambda () (cref s 100))))
  (print (try-any (lambda () (cref simple 5))))
  (print (try-any (lambda () (cref (vector 1 2) 0))))
  (print (try-any (lambda () (cref 42 0))))
  (let ((d (make-array 2 :element-type 'character :displaced-to "abcdef" :displaced-index-offset 3)))
    (print (list (cref d 0) (cref d 1)))))
(print (try-any (lambda () (ref 'not-an-array 0))))
(print (try-any (lambda () (ref (vector 1 2) 'x))))
(print (try-any (lambda () (ref (vector 1 2 3) (expt 10 30)))))

;;; declared integer ranges
(defun in-0-100 (x) (declare (type (integer 0 100) x)) (* 2 x))
(defun in-m5-5 (x) (declare (type (integer -5 5) x)) (+ x 10))
(defun fix (x) (declare (fixnum x)) (1+ x))
(defun idx (x) (declare (type (integer 0 255) x)) (- 255 x))
(print (list (in-0-100 0) (in-0-100 100) (in-m5-5 -5) (in-m5-5 5) (in-m5-5 0) (fix -3) (idx 0) (idx 255)))
(print (mapcar (lambda (f v) (try (lambda () (funcall f v))))
               (list #'in-0-100 #'in-0-100 #'in-0-100 #'in-0-100 #'in-m5-5 #'in-m5-5 #'in-m5-5 #'fix #'fix #'idx #'idx #'idx)
               (list -1 101 #\a 1.0 -6 6 (expt 2 40) 'a 1.5 256 -1 (- (expt 2 31)))))
