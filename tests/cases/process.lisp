;;; Subprocesses (runtime/process.lisp); the expected output is in process.expected.
(multiple-value-bind (out err code)
    (sys::%run-program-sync '("sh" "-c" "echo out; echo err >&2; exit 3"))
  (print (list out err code)))
(print (nth-value 0 (sys::%run-program-sync "printf '%s' \"$X\"" :environment '(("X" . "from env")))))
(print (nth-value 0 (sys::%run-program-sync '("cat") :input "given to cat")))
(print (nth-value 0 (sys::%run-program-sync '("pwd") :directory "/tmp/")))
(print (handler-case (sys::%run-program-sync '("no-such-program-xyz")) (error () :cannot-run)))
;; a process with streams, like `git cat-file --batch`
(multiple-value-bind (process in out) (sys::%launch-program '("sh" "-c" "while read x; do echo \"got $x\"; done")
                                                            :input :stream :output :stream)
  (write-line "one" in) (finish-output in)
  (print (read-line out))
  (write-line "two" in) (write-line "日本" in) (finish-output in)
  (print (list (read-line out) (read-line out)))
  (close in)
  (print (read-line out nil :eof))
  (print (sys::%process-wait process)))
(terpri)
