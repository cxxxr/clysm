;; the upgraded element type of a type of no kind of storage is T; TYPEP,
;; SUBTYPEP and COERCE of array types of it use that (issue #136), and those
;; of other types the kind of storage that holds them
(defstruct abc)
(defclass kls () ())
(defun fixed-typep (x) (typep x '(simple-array abc (*))))
(defun runtime-typep (x ty) (typep x ty))
(let ((ty (list 'simple-array 'abc (list '*)))
      (v (make-array 4 :adjustable t :initial-contents '(:not-an-abc 42 nil #\a)))
      (nested (make-array 1 :adjustable t :initial-element #())))
  (print (list (fixed-typep #(:not-an-abc)) (runtime-typep #(:not-an-abc) ty)
               (runtime-typep "abc" ty) (runtime-typep v ty)))
  (print (multiple-value-list (subtypep ty 'simple-vector)))
  (print (multiple-value-list (subtypep 'simple-vector ty)))
  (print (multiple-value-list (subtypep '(simple-array kls (*)) '(simple-array abc (*)))))
  (print (multiple-value-list (subtypep '(simple-array (integer 0 200) (*)) '(simple-array (unsigned-byte 8) (*)))))
  (print (multiple-value-list (subtypep '(simple-array (integer 0 200) (*)) '(simple-array character (*)))))
  (print (coerce v '(simple-array abc (*))))
  (print (coerce v ty))
  (print (coerce nested '(simple-array (simple-array abc (*)) (*))))
  (print (array-element-type (coerce '(1 2 3) '(simple-array (integer 0 200) (*))))))
(dolist (et '(abc kls nil character (eql 1.0) (single-float 0.0 1.0)
              (double-float 0d0 1d0) (integer 0 200) (integer -100 100) (integer 0 60000)
              (integer -30000 30000) (unsigned-byte 32) (signed-byte 32) (unsigned-byte 64)
              (signed-byte 64) (integer 0 *) (or single-float double-float) (or abc kls)
              (simple-array abc (*)) (and (integer 0 200) (not (eql 5))) (member 1 #\a)))
  (print (list et (upgraded-array-element-type et))))
;; a type defined again
(deftype my-et () '(integer 0 200))
(print (upgraded-array-element-type 'my-et))
(deftype my-et () 'character)
(print (upgraded-array-element-type 'my-et))
(print (array-element-type (make-array 2 :element-type 'my-et)))
