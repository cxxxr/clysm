;;; The case of the characters that are not ASCII: Unicode's simple mappings.
(print (string-downcase "ÀÉ ĀŁ ΑΒΓ ДЖЁ Ǆǅ Ⴀ Ａ"))
(print (string-upcase "àé āł αβγ джё ǆǅ ა ａ ÿ"))
(print (string-upcase "ß İ ı ς"))
(print (string-downcase "ß İ ı Σ"))
(print (list (char-code (char-upcase (code-char #x10428))) (char-code (char-downcase (code-char #x10400)))))
(print (mapcar #'upper-case-p (list #\Ā #\ā #\ß #\Σ #\1 #\日)))
(print (mapcar #'lower-case-p (list #\Ā #\ā #\ß #\σ #\1 #\日)))
(print (mapcar #'both-case-p (list #\Ā #\ā #\ß #\ǅ #\日)))
(print (list (char-equal #\Ā #\ā) (char-equal #\Ж #\ж) (char-equal #\ß #\S)))
(print (list (string-equal "ŁÓDŹ" "łódź") (string-capitalize "łódź ĄĘ")))
;; every character: how many change, and a sum that tells one mapping from another
(let ((down 0) (up 0) (sum 0))
  (dotimes (code char-code-limit)
    (unless (<= #xD800 code #xDFFF)
      (let* ((char (code-char code))
             (d (char-code (char-downcase char)))
             (u (char-code (char-upcase char))))
        (unless (= d code) (incf down) (setf sum (mod (+ sum (* 31 code) d) 1000003)))
        (unless (= u code) (incf up) (setf sum (mod (+ sum (* 37 code) u) 1000003))))))
  (print (list down up sum)))
