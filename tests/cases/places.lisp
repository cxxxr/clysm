(defvar *v* (vector 1 2 3))
(incf (aref *v* 0) 10)
(print *v*)
(let ((h (make-hash-table)))
  (incf (gethash :a h 0) 5)
  (push 'x (gethash :list h))
  (print (list (gethash :a h) (gethash :list h))))
(let ((pl (list :a 1)))
  (incf (getf pl :a))
  (setf (getf pl :b) 'new)
  (remf pl :a)
  (print pl))
(defstruct box (val 0))
(let ((b (make-box)))
  (incf (box-val b) 3)
  (push 'p (box-val b))
  (print (box-val b)))
(let ((a 1) (b 2) (c 3))
  (rotatef a b c)
  (print (list a b c))
  (print (shiftf a b c 99))
  (print (list a b c)))
(let ((x (list 1 2 3)))
  (psetf (first x) (second x) (second x) (first x))
  (print x))
(define-modify-macro appendf (&rest lists) append)
(let ((l (list 1 2)))
  (appendf l '(3 4) '(5))
  (print l))
(defvar *store* (list 0 0 0))
(defun store-ref (i) (nth i *store*))
(defsetf store-ref (i) (v) `(setf (nth ,i *store*) ,v))
(setf (store-ref 1) 'one)
(incf (store-ref 2) 7)
(print *store*)
(defun (setf my-car) (new cell) (setf (car cell) new))
(let ((c (list 1 2)))
  (setf (my-car c) 'changed)
  (print c))
(define-setf-expander first-of (place &environment env)
  (multiple-value-bind (temps vals stores setter getter) (get-setf-expansion place env)
    (declare (ignore stores setter))
    (let ((store (gensym)))
      (values temps vals (list store)
              `(progn (setf (car ,getter) ,store) ,store)
              `(car ,getter)))))
(let ((l (list 'a 'b)))
  (setf (first-of l) 'z)
  (print l))
(let ((x 5))
  (multiple-value-setq (x) (floor 17 5))
  (print x))
(let (q r)
  (multiple-value-setq (q r) (truncate 17 5))
  (print (list q r)))
(let ((a (make-array '(2 2) :initial-element 0)))
  (setf (aref a 1 1) 'd (aref a 0 1) 'b)
  (print a))
(let ((s (copy-seq "hello")))
  (setf (char s 0) #\J (subseq s 1 3) "EL")
  (print s))
(let ((v (vector 1 2 3 4 5)))
  (setf (subseq v 1 3) '(a b))
  (print v))
(let ((l (list 1 2 3 4)))
  (setf (cddr l) '(x))
  (print l))
(let ((x (cons 1 2)))
  (setf (car x) 'a (cdr x) 'b)
  (print x))
(let ((sym (gensym)))
  (setf (symbol-value sym) 42)
  (print (symbol-value sym))
  (setf (get sym 'color) 'red)
  (print (get sym 'color)))
(let ((n 10))
  (decf n 3)
  (print n))
(let ((l '((a . 1) (b . 2))))
  (setf l (acons 'c 3 l))
  (print (cdr (assoc 'c l))))
(let ((cnt 0) (v (vector 0 0 0)))
  (incf (aref v (incf cnt)))
  (print (list cnt v)))
