;;; Variables declared of a structure type, slots declared of one, integer
;;; declarations whose checks the types decide, two-dimensional arrays.
(defstruct pa x (y 0d0 :type double-float))
(defstruct (pb (:include pa)) s1 s2 s3 s4 s5 s6 s7 s8 s9 s10 s11 s12 s13 s14 s15 s16 s17 s18 s19 s20
  s21 s22 s23 s24 s25 s26 s27 s28 s29 s30 s31 s32 s33)
(defstruct qa x y)
(defstruct (qb (:include qa)) s1 s2 s3 s4 s5 s6 s7 s8 s9 s10 s11 s12 s13 s14 s15 s16 s17 s18 s19 s20
  s21 s22 s23 s24 s25 s26 s27 s28 s29 s30 s31 s32 s33)
(defstruct (qc (:include qa)) z)
;; (an instance of an including structure with a slot vector takes the general path)
(declaim (notinline fa fq))
(defun fa (o) (declare (pa o)) (setf (pa-x o) (list (pa-x o))) (incf (pa-y o) 1.5d0) (list (pa-x o) (pa-y o)))
(defun fq (o) (declare (type qa o)) (setf (qa-y o) 7) (list (qa-x o) (qa-y o)))
(print (fa (make-pa :x 1 :y 2d0)))
(print (fa (make-pb :x 1 :y 2d0)))
(print (fq (make-qa :x 1)))
(print (fq (make-qb :x 2)))
(print (fq (make-qc :x 3)))
(defun fd (l) (let ((n 0)) (dolist (x l n) (declare (qa x)) (incf n (qa-x x)))))
(print (fd (list (make-qa :x 1) (make-qb :x 2) (make-qc :x 4))))
(defstruct tnode (next nil :type (or null tnode)) (v 0d0 :type double-float))
(defstruct btree (left nil :type (or null btree)) (val 0))
(defun depth (tr) (if (btree-left tr) (1+ (depth (btree-left tr))) 0))
(print (depth (make-btree :left (make-btree :left (make-btree)))))
(defstruct pt2 (x 0d0 :type double-float) (y 0d0 :type double-float))
(defstruct seg (a (make-pt2) :type pt2) (b (make-pt2) :type pt2) name)
(defun seg-len2 (s) (let ((dx (- (pt2-x (seg-a s)) (pt2-x (seg-b s)))) (dy (- (pt2-y (seg-a s)) (pt2-y (seg-b s)))))
                      (setf (pt2-x (seg-b s)) 10d0)
                      (+ (* dx dx) (* dy dy))))
(let ((s (make-seg :b (make-pt2 :x 3d0 :y 4d0)))) (print (list (seg-len2 s) (pt2-x (seg-b s)))))
(defun tsum (n) (let ((s 0d0)) (loop while n do (incf s (tnode-v n)) (setq n (tnode-next n))) s))
(print (tsum (make-tnode :v 1d0 :next (make-tnode :v 2d0))))
(defun bad (o) (declare (type qa o)) (qa-x o))
(print (handler-case (bad (make-pa)) (type-error () :type-error)))
(defun u (v) (let ((x 0)) (declare (type (unsigned-byte 32) x)) (setq x v) x))
(print (u 4000000000))
(defun s (v) (let ((x 0)) (declare (type (signed-byte 64) x)) (setq x v) x))
(print (list (s (- (expt 2 63))) (s (1- (expt 2 63)))))
(defun crc (data)
  (declare (type (simple-array (unsigned-byte 8) (*)) data))
  (let ((crc #xffffffff))
    (declare (type (unsigned-byte 32) crc))
    (dotimes (i (length data)) (setf crc (logxor (* 7 (logand (logxor crc (aref data i)) #xff)) (ash crc -8))))
    (logxor crc #xffffffff)))
(print (crc (make-array 100 :element-type '(unsigned-byte 8) :initial-element 200)))
(defun m2 (a) (declare (type (simple-array double-float (* *)) a))
  (dotimes (i 3) (dotimes (j 2) (incf (aref a i j) (+ i j)))) a)
(print (m2 (make-array '(3 2) :element-type 'double-float :initial-element 1d0)))
(print (handler-case (m2 (make-array '(2 2) :element-type 'double-float)) (error () :error)))
(print (handler-case (m2 (make-array '(3 1) :element-type 'double-float)) (error () :error)))
(defun m3 (a i j) (declare (type (simple-array t (* *)) a) (fixnum i j)) (aref a i j))
(print (handler-case (m3 (make-array '(3 3) :initial-element 1) 1 3) (error () :error)))
(print (handler-case (m3 (make-array '(3 3) :initial-element 1) 3 0) (error () :error)))
(print (m3 (make-array '(3 3) :initial-element 1) 2 2))
