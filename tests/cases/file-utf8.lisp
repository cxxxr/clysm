;;; Character file streams: UTF-8 written and read back with READ-LINE,
;;; READ-CHAR, PEEK-CHAR and UNREAD-CHAR (inline at the call site for ASCII).
(ensure-directories-exist "build/")
(defvar *text* (format nil "aé日本~C z~%second line~%~%last" (code-char #x1F600)))
(with-open-file (o "build/file-utf8.tmp" :direction :output :if-exists :supersede)
  (write-string *text* o)
  (write-line " more" o)
  (write-char #\λ o)
  (print (file-position o)))
(with-open-file (in "build/file-utf8.tmp")
  (print (loop for line = (read-line in nil) while line collect line)))
(with-open-file (in "build/file-utf8.tmp")
  (print (loop for c = (read-char in nil) while c collect (char-code c))))
(with-open-file (in "build/file-utf8.tmp")
  (print (list (peek-char nil in) (read-char in) (char-code (peek-char nil in)) (char-code (read-char in))
               (let ((c (read-char in))) (unread-char c in) (mapcar #'char-code (list c (peek-char nil in) (read-char in))))
               (read-line in) (peek-char t in) (read-char in nil :eof))))
(with-open-file (in "build/file-utf8.tmp")
  (print (list (read-line in) (file-position in) (read-char in))))
(with-open-file (in "build/file-utf8.tmp")
  (file-position in 1)
  (print (list (char-code (read-char in)) (char-code (read-char in nil :eof)))))
(let ((s (make-string-input-stream "xy")))
  (print (list (read-char s) (peek-char nil s) (read-char s) (read-char s nil :end) (peek-char nil s nil :end))))
(with-input-from-string (s "abc") (print (list (read-char s) (read-char s nil) (read-char s nil) (read-char s nil 'eof))))
(print (handler-case (with-open-file (in "build/file-utf8.tmp") (loop (read-char in))) (end-of-file () :eof)))
(terpri)
