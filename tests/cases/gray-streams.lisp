;;;; Gray streams (GRAY package; in SBCL it is SB-GRAY)
;; an upcasing output stream and a counting input stream
(defclass upcase-stream (gray:fundamental-character-output-stream)
  ((target :initarg :target) (col :initform 0)))
(defmethod gray:stream-write-char ((s upcase-stream) c)
  (with-slots (target col) s
    (setf col (if (char= c #\Newline) 0 (1+ col)))
    (write-char (char-upcase c) target)))
(defmethod gray:stream-line-column ((s upcase-stream)) (slot-value s 'col))

(defclass list-input-stream (gray:fundamental-character-input-stream)
  ((chars :initarg :chars) (pushed :initform nil)))
(defmethod gray:stream-read-char ((s list-input-stream))
  (with-slots (chars pushed) s
    (cond (pushed (prog1 pushed (setf pushed nil)))
          (chars (pop chars))
          (t :eof))))
(defmethod gray:stream-unread-char ((s list-input-stream) c) (setf (slot-value s 'pushed) c) nil)

(defclass octets (gray:fundamental-binary-input-stream gray:fundamental-binary-output-stream)
  ((data :initform (make-array 0 :adjustable t :fill-pointer 0))
   (pos :initform 0)))
(defmethod stream-element-type ((s octets)) '(unsigned-byte 8))
(defmethod gray:stream-write-byte ((s octets) b) (vector-push-extend b (slot-value s 'data)) b)
(defmethod gray:stream-read-byte ((s octets))
  (with-slots (data pos) s (if (< pos (length data)) (prog1 (aref data pos) (incf pos)) :eof)))

(let ((u (make-instance 'upcase-stream :target *standard-output*)))
  (format u "hello ~a~%" "world")
  (print '(a b "c") u)
  (fresh-line u)
  (format u "x~10Ty~%")
  (write-string "abcdef" u :start 2 :end 4)
  (terpri u)
  (print (list (streamp u) (typep u 'stream) (output-stream-p u) (input-stream-p u)
               (open-stream-p u) (stream-element-type u) (interactive-stream-p u))))
(terpri)
(let ((in (make-instance 'list-input-stream :chars (coerce "(1 2 foo) \"bar\" line2
last" 'list))))
  (print (read in))
  (print (read in))
  (print (peek-char t in))
  (print (multiple-value-list (read-line in)))
  (print (multiple-value-list (read-line in)))
  (print (read-line in nil :eof))
  (print (read-char in nil :done)))
(let ((o (make-instance 'octets)) (buf (make-array 3)))
  (write-sequence #(1 2 3 4) o)
  (write-byte 5 o)
  (print (list (read-byte o) (read-sequence buf o) buf (read-byte o) (read-byte o nil :eof)))
  (print (list (close o) (open-stream-p o))))
(with-open-stream (s (make-instance 'upcase-stream :target *standard-output*))
  (write-line "with-open-stream" s))
(let ((b (make-broadcast-stream (make-instance 'upcase-stream :target *standard-output*) *standard-output*)))
  (write-string "both" b) (terpri b))
(print (with-output-to-string (o) (let ((u (make-instance 'upcase-stream :target o))) (princ 12345 u) (write-char #\x u))))
(terpri)
