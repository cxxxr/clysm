;;; a batch of LOAD reads and compiles the forms after a compiled toplevel
;;; form before that form has run (%LOAD-BATCH, runtime/eval.lisp): what the
;;; form changes that reading or compiling them depends on (a macro, the
;;; reader's variables, the readtable, the package) is seen as when the forms
;;; are evaluated one by one
(let ((file (format nil "/tmp/clysm-load-batch-ahead-~D.lisp" (random 1000000 (make-random-state t)))))
  (with-open-file (out file :direction :output :if-exists :supersede)
    (write-string "(defun la-f (x) (* x 2))
(defun la-def-macro ()
  (setf (macro-function 'la-m) (lambda (form env) (declare (ignore env)) `(list :macro ,(second form)))))
(defun la-set-base () (setq *read-base* 16))
(defun la-reader ()
  (set-macro-character #\\! (lambda (s c) (declare (ignore c)) (list 'quote (list :bang (read s t nil t))))))
(defun la-make-package () (make-package \"LA-PKG\" :use '(\"COMMON-LISP\")))
(defun la-in-package (name) (setq *package* (find-package name)))
(defvar *la-v* 1)
(defun la-setv () (setq *la-v* 2))
(let ((x 1)) (la-f x))
(defun la-g () (la-f 3))
(print (la-g))
(let ((x 1)) (la-f x) (la-def-macro))
(defun la-use () (la-m 5))
(print (la-use))
(let ((x 1)) (la-setv) x)
(print '#.*la-v*)
(let ((x (la-f 1))) (la-set-base) x)
(print 10)
(setq *read-base* #10r10)
(print 10)
(let ((x (la-f 1))) (la-reader) x)
(print !a)
(let ((x (la-f 1))) (la-make-package) (la-in-package \"LA-PKG\") x)
(print (package-name (symbol-package 'la-bar)))
(common-lisp-user::la-in-package \"COMMON-LISP-USER\")
(print (package-name (symbol-package 'la-baz)))
(dotimes (i 2) (la-f i))
(defun la-h () (list (la-g) (la-use)))
(dotimes (i 2) (la-f i))
(print (la-h))
" out))
  (load file)
  (delete-file file))
(print (list (la-g) (la-h)))
