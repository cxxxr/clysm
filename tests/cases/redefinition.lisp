;;; instances of redefined classes are updated while instances are tracked
(sys::track-instances)
(defclass p () ((text :initarg :text :accessor p-text) (n :initform 1 :accessor p-n)))
(defclass q (p) ((extra :initform :e :accessor q-extra)))
(defvar *a* (make-instance 'p :text "keep"))
(defvar *b* (make-instance 'q :text "sub"))
(defmethod show ((x p)) (list (p-text x) (slot-value x 'n)))
(print (list (show *a*) (show *b*)))
(defmethod update-instance-for-redefined-class :after ((x p) added discarded plist &rest initargs)
  (declare (ignore initargs))
  (when (slot-boundp x (quote text)) (print (list :updated (p-text x) added discarded plist))))
(defclass p () ((due :initform :none :accessor p-due) (text :initarg :text :accessor p-text)))
(print (list (p-text *a*) (p-due *a*) (slot-exists-p *a* 'n)))
(print (list (p-text *b*) (p-due *b*) (q-extra *b*)))
(setf (p-due *a*) :today)
(print (list (p-due *a*) (p-due (make-instance 'p :text "new"))))
;; same slots: nothing to update
(defclass p () ((due :initform :none :accessor p-due) (text :initarg :text :accessor p-text)))
(print (p-due *a*))
;; a user metaclass
(defclass mc (standard-class) ())
(defmethod clysm-mop:validate-superclass ((c mc) (s standard-class)) t)
(defclass m () ((x :initarg :x :accessor m-x)) (:metaclass mc))
(defvar *m* (make-instance 'm :x 1))
(defclass m () ((y :initform 2 :accessor m-y) (x :initarg :x :accessor m-x)) (:metaclass mc))
(print (list (m-x *m*) (m-y *m*)))
(sys::track-instances nil)
