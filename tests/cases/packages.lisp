(defpackage :geometry
  (:use :cl)
  (:export #:make-vec #:vec-x #:vec-y #:vec+ #:*origin*))
(in-package :geometry)
(defstruct (vec (:constructor make-vec (x y))) x y)
(defun vec+ (a b) (make-vec (+ (vec-x a) (vec-x b)) (+ (vec-y a) (vec-y b))))
(defvar *origin* (make-vec 0 0))
(defun internal-helper () 'internal)
(in-package :cl-user)
(print (geometry:vec-x (geometry:vec+ (geometry:make-vec 1 2) (geometry:make-vec 3 4))))
(print (geometry::internal-helper))
(print (package-name (symbol-package 'geometry:make-vec)))
(print (multiple-value-list (find-symbol "VEC+" "GEOMETRY")))
(print (multiple-value-list (find-symbol "INTERNAL-HELPER" "GEOMETRY")))
(defpackage :user2 (:use :cl :geometry))
(in-package :user2)
(print (vec-y (vec+ (make-vec 1 2) (make-vec 10 20))))
(print (eq 'vec+ 'geometry:vec+))
(print *package*)
(in-package :cl-user)
(print (find-package :geometry))
(print (package-use-list :user2))
