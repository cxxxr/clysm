;;; Sums and counters of values of unknown type (integer accumulators kept
;;; in an i64: their steps by fixnums, by integers beyond the fixnums and
;;; beyond 64 bits, by doubles, singles, ratios and complex numbers, by
;;; what is not a number), sums of doubles whose steps are tested once, and
;;; integer arithmetic on constants done when the code is compiled.
(defun opaque (x) x)
(declaim (notinline opaque))

(defun sum-list (l) (let ((s 0)) (dolist (x l) (incf s x)) s))
(defun sum-vec (v) (let ((s 0)) (dotimes (i (length v)) (incf s (svref v i))) s))
(defun diff-list (l) (let ((s 0)) (dolist (x l) (decf s x)) s))
(defun sum-rev (l) (let ((s 0)) (dolist (x l) (setq s (+ x s))) s))
(defun sum-calls (f n) (let ((s 0)) (dotimes (i n) (incf s (funcall f i))) s))
(defun sum-from (start l) (let ((s start)) (dolist (x l) (incf s x)) s))
(defun sum-used (l) (let ((s 0) (r nil)) (dolist (x l) (push (incf s x) r)) (list s r)))
(defun sum-looked-at (l) (let ((s 0) (m 0)) (dolist (x l) (incf s x) (when (> s m) (setq m s))) (list s m)))
(defun sum-returned (l limit) (let ((s 0)) (dolist (x l) (incf s x) (when (> s limit) (return s))) s))
(defun sum-returned-2 (l stop)
  (let ((s 0)) (block nil (mapc (lambda (x) (if (eql x stop) (return) (incf s x))) l)) s))
(defun sum-nested (l) (let ((s 0)) (dolist (x l) (incf s (block b (unwind-protect (if (evenp x) (return-from b 1) 2) (incf s))))) s))
(defun count-and-mask (l) (let ((s 0)) (dolist (x l) (setq s (logand s #xFFFFFF)) (incf s x)) s))
(defun two-sums (l) (let ((a 0) (b 0)) (dolist (x l) (incf a x) (incf b (* x x))) (list a b)))
(defun sum-when (l) (let ((s 0)) (dolist (x l) (when (evenp x) (incf s x))) s))
(defun gen-sum (g) (let ((s 0)) (loop (multiple-value-bind (v ok) (funcall g) (if ok (incf s v) (return s))))))
(defun gen-range (n f) (let ((i 0)) (lambda () (if (< i n) (values (funcall f (prog1 i (incf i))) t) (values nil nil)))))
(defun sum-side (l) (let ((s 0)) (dolist (x l) (setq s (+ (progn (incf s 100) x) s))) s))
(defun sum-side-2 (l) (let ((s 0)) (dolist (x l) (setq s (+ s (progn (incf s 100) x)))) s))
(defun sum-side-3 (l) (let ((s 0)) (dolist (x l) (setq s (- s (progn (setq s (* s 2)) x)))) s))
(defun sqrt-sum (l) (let ((s 0)) (dolist (x l) (incf s (sqrt x))) s))
(defun dist (p q) (sqrt (+ (expt (- (car p) (car q)) 2) (expt (- (cdr p) (cdr q)) 2))))
(defun dist-sum (pts) (let ((s 0)) (dolist (p pts) (dolist (q pts) (incf s (dist p q)))) s))

(defun try (f &rest args)
  (handler-case (apply f args)
    (type-error () :type-error)
    (floating-point-overflow () :overflow)
    (arithmetic-error () :arithmetic-error)
    (error () :error)))

