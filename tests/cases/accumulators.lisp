;;; sums and products of doubles: one test of the result of a tree
(defun dot (x y n)
  (declare (type (simple-array double-float (*)) x y) (fixnum n))
  (let ((s 0d0)) (declare (double-float s)) (dotimes (i n) (incf s (* (aref x i) (aref y i)))) s))
(defun poly (a b c x) (declare (double-float a b c x)) (+ (* (+ (* a x) b) x) c))
(defun diff-prod (a b c d) (declare (double-float a b c d)) (- (* a b) (* c d)))
(defun mixed (a b i) (declare (double-float a b) (fixnum i)) (+ (* a i) (- b 1) (* 2 a b)))
(defun acc-sub (x n) (declare (type (simple-array double-float (*)) x) (fixnum n))
  (let ((s 1d0)) (declare (double-float s)) (dotimes (i n) (decf s (* (aref x i) 2d0)) (setq s (* s (+ (aref x i) 1d0)))) s))
(defun side (a v) (declare (double-float a) (simple-vector v))
  ;; the product overflows before the element is read: the overflow, not the index error
  (+ (* a a) (the double-float (svref v 5))))
(defun side2 (a v) (declare (double-float a) (simple-vector v))
  (+ (the double-float (svref v 5)) (* a a)))
(let ((x (make-array 4 :element-type 'double-float :initial-contents '(1d0 2d0 3d0 4d0)))
      (y (make-array 4 :element-type 'double-float :initial-contents '(0.5d0 0.25d0 2d0 -1d0)))
      (big (make-array 2 :element-type 'double-float :initial-contents (list most-positive-double-float 2d0))))
  (print (list (dot x y 4) (dot x y 0) (try #'dot big big 2) (try #'dot big y 2)
               (poly 1d0 2d0 3d0 4d0) (try #'poly 1d300 1d0 1d0 1d300) (try #'poly 1d0 1d308 1d0 1d1)
               (diff-prod 2d0 3d0 4d0 5d0) (try #'diff-prod 1d200 1d200 1d200 1d200) (try #'diff-prod 1d200 1d200 1d0 1d0)
               (mixed 1.5d0 2.5d0 3) (try #'mixed 1d308 1d308 3) (acc-sub x 4) (try #'acc-sub big 2)
               (try #'side 1d200 (vector 1 2)) (try #'side2 1d200 (vector 1 2)) (try #'side 1d0 (vector 1 2 3 4 5 6d0))
               (try #'side 1d200 (vector 1 2 3 4 5 6d0)))))
(defun und-dot (x y) (let ((s 0d0)) (dotimes (i (length x)) (incf s (* (aref x i) (aref y i)))) s))
(defun und-poly (a b x) (+ (* a x x) (* b x) 1d0))
(print (list (und-dot (vector 1d0 2d0) (vector 3d0 4d0)) (und-dot (vector 1 2) (vector 3d0 4))
             (try #'und-dot (vector 1d308 1d308) (vector 10d0 10d0)) (try #'und-dot (vector 1d0 'a) (vector 1d0 1d0))
             (und-poly 1d0 2d0 3d0) (und-poly 1 2 3) (try #'und-poly 1d200 1d0 1d200) (und-poly 1/2 2 3d0)))

