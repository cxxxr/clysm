;;; divisions with one argument, sequences made lists
(defun q1 (x) (list (truncate x) (floor x) (ceiling x) (round x)))
(defun q2 (x) (list (multiple-value-list (truncate x)) (multiple-value-list (floor x))
                    (multiple-value-list (ceiling x)) (multiple-value-list (round x))))
