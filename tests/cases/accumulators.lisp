;;; accumulators that hold an unboxed double between their steps
(defun fsum (l) (let ((s 0)) (dolist (x l) (incf s x)) s))
(defun fsum-peek (l) (let ((s 0) (m nil)) (dolist (x l) (incf s x) (when (and (realp s) (> s 10)) (push s m))) (list s m)))
(defun fsum-cmp (l limit) (let ((s 0) (n 0)) (dolist (x l) (incf s x) (when (< s limit) (incf n))) (list s n)))
(defun fdiff (l) (let ((s 0)) (dolist (x l) (decf s x)) s))
(defun fsum2 (l) (let ((s 0) (q 0)) (dolist (x l) (incf s x) (incf q (* x x))) (list s q)))
(defun fsum-tree (l) (let ((s 0)) (dolist (x l) (incf s x) (setq s (* s 2))) s))
(defun fsum-nested (l) (let ((s 0)) (dolist (x l) (incf s (progn (incf s 1) x))) s))
(defun fsum-type (l) (let ((s 0) (ts nil)) (dolist (x l) (incf s x) (push (type-of s) ts)) (list s (length ts) (typep s 'double-float))))
(defun fsum-key (l) (let ((s 0)) (dolist (c l) (incf s (car c))) s))
(defun fsum-vec (v) (let ((s 0)) (dotimes (i (length v)) (incf s (aref v i))) s))
(defun fsum-loop (l) (loop for x in l sum x))
(defun fsum-until (l) (let ((s 0)) (dolist (x l) (incf s x) (when (> s 5) (return s))) s))
