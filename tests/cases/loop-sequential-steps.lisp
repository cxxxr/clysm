;; Separate FOR clauses are stepped sequentially (CLHS 6.1.2.1): when a later
;; clause ends the loop, the variables of the earlier ones have their new
;; values (issue #124)
(print (loop for tail on '(1 2) for x in '(1) finally (return tail)))
(print (list (loop for a on '(1 2) for x on '(1) finally (return a))
             (loop for a on '(1 2) for x below 1 finally (return a))
             (loop for a on '(1 2) for x across #(1) finally (return a))))
(print (list (loop for a in '(1 2) for x in '(1) finally (return a))
             (loop for a in '(1 2) for x on '(1) finally (return a))
             (loop for a in '(1 2) for x below 1 finally (return a))
             (loop for a in '(1 2) for x across #(1) finally (return a))))
(print (list (loop for a across #(1 2) for x in '(1) finally (return a))
             (loop for a across "ab" for x below 1 finally (return a))
             (loop for a across #(1 2) for x across #(1) finally (return a))))
(print (list (loop for a = 10 then (1+ a) for x in '(1) finally (return a))
             (loop for a = 10 then (1+ a) for x on '(1) finally (return a))
             (loop for a = 10 then (1+ a) for x below 1 finally (return a))
             (loop for a = 10 then (1+ a) for x across #(1) finally (return a))))
(print (list (loop for a from 0 below 5 for x in '(1) finally (return a))
             (loop for a downfrom 5 above 0 for x below 1 finally (return a))
             (loop for a from 0 below 5 for x across #(1) finally (return a))))
(print (let ((h (make-hash-table)))
         (setf (gethash 1 h) 1 (gethash 2 h) 2)
         (let (f) (loop for k being the hash-keys of h for x in '(1)
                        do (setq f k) finally (return (not (eql f k)))))))
(print (let ((p (make-package "LOOP-SEQ-TEST" :use nil)))
         (intern "A" p) (intern "B" p)
         (let (f) (prog1 (loop for k being the present-symbols of p for x in '(1)
                               do (setq f k) finally (return (not (eq f k))))
                    (delete-package p)))))
;; the destructured variables, a REPEAT and a later clause that ends first
(print (loop for (a b) in '((1 2) (3 4)) for x below 1 finally (return (list a b))))
(print (loop repeat 3 for a in '(1 2 3) for x below 2 finally (return a)))
(print (loop for a in '(1 2 3) repeat 2 finally (return a)))
;; the clauses that end first, and the usual cases
(print (loop for a in '(1 2) for x below 5 finally (return (list a x))))
(print (loop for a in '(1 2 3) for b = a then (+ a b) collect b))
(print (loop for x on '(1 2 3) for y = (car x) collect y))
(print (loop for x in nil for y = (error "not evaluated") collect y))
