;;; consecutive definitions loaded from source are compiled into one module
;;; (in the image: %LOAD-BATCH); the calls between them see a redefinition
;;; as when the forms are compiled one by one
(defun b-add (x y) (+ x y))
(defun b-twice (x) (b-add x x))
(defun b-forward (x) (b-later x))
(defun b-later (x) (* x 10))
(defun b-ref () #'b-add)
(defun (setf b-place) (v cell) (setf (car cell) v))
(defun b-set (cell v) (setf (b-place cell) v) cell)
(defun b-loop (n) (let ((s 0)) (dotimes (i n s) (incf s (b-add i 1)))))
(defun b-fact (n) (if (< n 2) 1 (* n (b-fact (1- n)))))
(defun b-uses-fact (n) (b-fact n))
(print (list (b-twice 3) (b-forward 2) (funcall (b-ref) 1 2) (b-set (list 0) 7) (b-loop 10)
             (b-uses-fact 20) (b-uses-fact 25)))
;; redefined by a later form
(defun b-add (x y) (- x y))
(defun b-later (x) (list x))
(defun (setf b-place) (v cell) (setf (cdr cell) v))
(defun b-fact (n) (list :fact n))
(print (list (b-twice 3) (b-forward 2) (funcall (b-ref) 1 2) (b-set (list 0) 7) (b-loop 10)
             (b-uses-fact 20)))
;; by SETF of FDEFINITION
(setf (fdefinition 'b-add) (lambda (x y) (* x y)))
(print (list (b-twice 3) (b-loop 4)))
;; a function of the batch called while the batch is read and compiled
;; (by a macro, by #.): the forms are evaluated one by one, read again
(let ((file (format nil "/tmp/clysm-load-batch-~D.lisp" (random 1000000 (make-random-state t)))))
  (with-open-file (out file :direction :output :if-exists :supersede)
    (write-string "(defun b-helper (x) (* x 3))
(defmacro b-mac (x) (b-helper x))
(defun b-user () (b-mac 4))
(defun b-read-helper () 42)
(defun b-read-user () '#.(b-read-helper))
(defun b-read-user-2 () (list (b-read-user) (b-user)))
" out))
  (load file)
  (delete-file file))
(print (list (b-user) (b-read-user) (b-read-user-2)))
;; a function defined in the expansion of a macro, called by an earlier form
(defmacro b-define (name value) `(progn (defun ,name () ,value) (,name)))
(defun b-calls-defined () (b-defined))
(b-define b-defined 5)
(print (b-calls-defined))
(b-define b-defined 6)
(print (b-calls-defined))
;; an error in a form of a batch: the forms before it are defined
(defun b-ok () :ok)
(print (handler-case (progn (eval '(progn (defun b-bad () (error "x")) (b-bad))) :no-error)
         (error () (b-ok))))
;; keywords, optionals and rest arguments
(defun b-key (a &key (b 2) c) (list a b c))
(defun b-opt (a &optional (b 5) &rest r) (list a b r))
(defun b-call-key () (list (b-key 1) (b-key 1 :c 3) (b-opt 1) (b-opt 1 2 3 4)))
(print (b-call-key))
(defun b-key (a &key (b 20) c) (list :new a b c))
(print (b-call-key))
;; double floats
(defun b-sq (x) (* x x))
(defun b-norm (x y) (sqrt (+ (b-sq x) (b-sq y))))
(print (list (b-norm 3d0 4d0) (b-norm 3 4)))
(defun b-sq (x) (declare (ignore x)) 1)
(print (b-norm 3d0 4d0))
;; a small function returning from its block in a closure, copied into a
;; caller compiled later
(defun b-pick (v k)
  (let ((probe (lambda (i) (when (eql (svref v i) k) (return-from b-pick (list :at i))))))
    (funcall probe 0) (funcall probe 1)
    nil))
(print :separate)
(defun b-use-pick () (list (b-pick (vector 1 2) 2) (b-pick (vector 1 2) 3)))
(print (b-use-pick))
(defun b-pick (v k) (list :new (length v) k))
(print (b-use-pick))
;; a small function defined before a batch and again by a later form of the
;; batch: the callers between the two have a copy of the first definition,
;; which the second ends
(defun b-twice-defined (x) (list :first x))
(defmacro b-end-batch () nil)
(b-end-batch)
(defun b-caller (n) (b-twice-defined n))
(defun b-loop-caller (n) (let ((s nil)) (dotimes (i n s) (setq s (b-twice-defined i)))))
(print (list (b-caller 1) (b-loop-caller 3)))
(defun b-twice-defined (x) (list :second x x))
(b-end-batch)
(print (list (b-caller 1) (b-loop-caller 3)))
