;;; Trees of arithmetic under masks of 64 bits (unsigned i64s: hashes, generators, rotations), with operands of every kind
(defconstant +m+ #xFFFFFFFFFFFFFFFF)
(defun fnv64 (n) (let ((h #xcbf29ce484222325)) (dotimes (i n) (setq h (logand (* (logxor h (logand i 255)) #x100000001b3) #xFFFFFFFFFFFFFFFF))) h))
(defun xorshift64 (n) (let ((x 88172645463325252))
  (dotimes (i n) (setq x (logand (logxor x (ash x 13)) #xFFFFFFFFFFFFFFFF)) (setq x (logxor x (ash x -7))) (setq x (logand (logxor x (ash x 17)) #xFFFFFFFFFFFFFFFF))) x))
(defun splitmix (n) (let ((s 0) (z 0) (acc 0))
  (dotimes (i n)
    (setq s (logand (+ s #x9e3779b97f4a7c15) #xFFFFFFFFFFFFFFFF))
    (setq z s)
    (setq z (logand (* (logxor z (ash z -30)) #xbf58476d1ce4e5b9) #xFFFFFFFFFFFFFFFF))
    (setq z (logand (* (logxor z (ash z -27)) #x94d049bb133111eb) #xFFFFFFFFFFFFFFFF))
    (setq z (logxor z (ash z -31)))
    (setq acc (logxor acc z)))
  acc))
(defun rotl (x k) (logior (logand (ash x k) +m+) (ash x (- k 64))))
(defun rot13 (x) (logior (logand (ash x 13) +m+) (ash (logand x +m+) -51)))
(defun xoro (n) (let ((s0 1) (s1 2) (r 0))
  (dotimes (i n) (setq r (logand (+ s0 s1) +m+))
    (let ((tt (logxor s0 s1)))
      (setq s0 (logxor (logior (logand (ash s0 24) +m+) (ash s0 -40)) tt (logand (ash tt 16) +m+)))
      (setq s1 (logior (logand (ash tt 37) +m+) (ash tt -27)))))
  (list r s0 s1)))
(defun mix (a b) (let* ((x (logand (+ a b) +m+)) (y (logand (- a b) +m+)) (z (logand (* a b) +m+)))
  (list x y z (+ x 1) (- y 1) (* z 3) (ash x -3) (ash y 3) (logxor x y) (logior x z) (logand x y) (logand x -4096)
        (logand (+ (logxor x y) 1) +m+) (+ (logand x #xFFFFFFFF) (ash z -32)) (< x y) (= x z) (mod x 1000) (logand x 255)
        (logand (lognot x) +m+) (logand (- x) +m+) (logxor (logand a +m+) #x8000000000000000)
        (logand a #x8000000000000000) (logand #xF000000000000000 b) (logior (logand a +m+) #x8000000000000000)
        (ash (logand a +m+) -63) (ash (logand a +m+) -1) (logand (ash a 63) +m+) (logand (ash a -5) +m+)
        (logand (logior a b) +m+) (logand (* (logand a +m+) (logand b +m+)) #xFFFFFFFFFFFFFFFE))))
(defun acc64 (n) (let ((s 0) (u 0)) (dotimes (i n) (setq u (logand (* (+ u i) 6364136223846793005) +m+)) (incf s (ash u -40)) (incf s (logand u 7))) (list s u)))
(print (list (fnv64 3000) (xorshift64 3000) (splitmix 3000) (xoro 3000) (acc64 3000)))
(print (list (rotl #x8000000000000001 1) (rotl 1 63) (rot13 -1) (rot13 (ash 1 70)) (rot13 #xFFF8000000000000)))
(let ((vals (list 0 1 -1 2 -2 255 536870911 -536870912 536870912 #x7FFFFFFFFFFFFFFF #x8000000000000000 (- #x8000000000000000)
                  #xFFFFFFFFFFFFFFFF (- #xFFFFFFFFFFFFFFFF) #x10000000000000000 (- #x10000000000000000) #x123456789ABCDEF0123456789
                  (- #x123456789ABCDEF0123456789) #xDEADBEEFCAFEBABE 4294967296 -4294967297)))
  (dolist (a vals) (dolist (b vals) (print (mix a b)))))
(print (handler-case (mix 1.5 2) (error () :err)))
(print (handler-case (rot13 'a) (error () :err)))
