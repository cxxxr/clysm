(defun make-counter ()
  (let ((n 0)) (lambda () (setq n (+ n 1)))))
(let ((c1 (make-counter)) (c2 (make-counter)))
  (funcall c1) (funcall c1)
  (print (list (funcall c1) (funcall c2))))
(defun adder (n) (lambda (x) (+ x n)))
(print (mapcar (adder 10) '(1 2 3)))
(print (let ((fns nil))
         (dotimes (i 3) (let ((j i)) (push (lambda () j) fns)))
         (mapcar #'funcall fns)))
(defun compose (&rest fns)
  (if (null fns) #'identity
      (lambda (x) (funcall (car fns) (funcall (apply #'compose (cdr fns)) x)))))
(print (funcall (compose #'1+ (lambda (x) (* x 2))) 5))
(defun find-first (pred list)
  (dolist (x list) (when (funcall pred x) (return-from find-first x))))
(print (find-first #'evenp '(1 3 4 5 6)))
(defun nonlocal-exit-test ()
  (mapc (lambda (x) (when (> x 2) (return-from nonlocal-exit-test x))) '(1 2 3 4))
  'none)
(print (nonlocal-exit-test))
(defun tagbody-closure ()
  (let ((result nil))
    (tagbody
       (mapc (lambda (x) (push x result) (when (= x 2) (go done))) '(1 2 3))
     done)
    result))
(print (tagbody-closure))
(defun opt (a &optional (b 2) (c (+ a b) c-p)) (list a b c c-p))
(print (opt 1))
(print (opt 1 5))
(print (opt 1 5 7))
(defun keys (&key (x 1) (y 2 y-p) ((:zz z) 3)) (list x y y-p z))
(print (keys))
(print (keys :y 5 :zz 9))
(print (keys :x 0 :allow-other-keys t :bogus 1))
(defun rest-args (a &rest r) (list a r))
(print (rest-args 1 2 3 4 5 6 7))
(defun many (a b c d e f g) (list g f e d c b a))
(print (many 1 2 3 4 5 6 7))
(print (funcall #'many 1 2 3 4 5 6 7))
(print (apply #'many '(1 2 3 4 5 6 7)))
(defun tail-loop (n acc) (if (= n 0) acc (tail-loop (- n 1) (+ acc 1))))
(print (tail-loop 1000000 0))
