;;; global symbol macros, read and set inside functions
(defvar *cell* (list 1 2))
(define-symbol-macro first-item (car *cell*))
(define-symbol-macro second-item (cadr *cell*))
(print first-item)
(defun get-first () first-item)
(defun set-first (x) (setq first-item x))
(defun bump () (incf second-item 10) (push :a first-item))
(print (get-first))
(set-first nil)
(bump)
(bump)
(print *cell*)
(print (let ((first-item :lexical)) (list first-item (get-first))))
(print (symbol-macrolet ((first-item (cdr *cell*))) (setq first-item '(0)) first-item))
(print (list *cell* (macroexpand-1 'first-item)))
