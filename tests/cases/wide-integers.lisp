;;; Integers beyond the fixnums (2^29 .. 2^63 and beyond) through the
;;; inline paths: MOD/REM by constants in fused arithmetic, masks with
;;; constants beyond the fixnums, divisions of values of unknown type by a
;;; constant, accumulators and counters of unknown type (i64 beside the
;;; eqref), comparisons of those, and the generic helpers' integer paths.
(defvar *vals* (list 0 1 -1 7 -7 86399 86400 -86400 -86401 536870911 536870912 -536870913
                     1700000000 -1700000000 4294967295 4294967296 -4294967296 (expt 2 62) (- (expt 2 62))
                     (1- (expt 2 63)) (- (expt 2 63)) (expt 2 63) (- (expt 2 64) 1) (expt 2 70) (- (expt 2 70))
                     12345678901234 -12345678901234 2.5d0 -2.5d0 0.75 7/3 #c(1 2)))
(defun f1 (x) (mod (+ x 1) 86400))
(defun f2 (x) (rem (+ x 1) 86400))
(defun f3 (x) (mod (- x 3) -7))
(defun f4 (x) (rem (* x 3) -7))
(defun f5 (x) (mod (+ x 5) (expt 2 32)))
(defun f6 (x) (mod (* x 3) 1024))
(defun f7 (x) (+ (mod (* x 3) 1000003) (rem (- x 1) 4294967296)))
(defun f8 (x) (logand (+ x 7) #xFFFFFFFF))
(defun f9 (x) (logxor x #x811C9DC5))
(defun f10 (x) (+ x 4294967296))
(defun f11 (x) (let ((y (logand x #xFFFFFFFF))) (+ (* y 3) (ash y -3))))
(defun f12 (x) (mod (logxor x #xFFFFFFFFFF) 1000000007))
(defun f13 (x) (- (mod (ash x 3) 9223372036854775807) 1))
(defun f14 (x) (rem (+ x 1) 1))
(defun f15 (x) (mod (+ x 1) -1))
(defun f16 (x) (< x 4294967296))
(defun f17 (x) (= (+ x 1) 1700000001))
(defun f18 (x) (list (+ x 536870912) (- x 536870913) (- 4294967296 x)))
(defun g1 (x) (if (typep x '(signed-byte 62))
                  (let ((y x)) (declare (type (signed-byte 62) y))
                    (list (mod y 1024) (floor y 1024) (mod y (expt 2 32)) (floor y 8) (+ 1 (floor y 1)) (mod y 1)
                          (multiple-value-list (floor y 16)) (rem y 16) (truncate y 16)))
                  0))
(defun h1 (x) (multiple-value-bind (q r) (floor (+ x 1) 86400) (list q r)))
(defun h2 (x) (multiple-value-bind (q r) (truncate x 7) (list q r)))
(defun h3 (x) (multiple-value-bind (q r) (ceiling (* x 3) -10) (list q r)))
(defun h4 (x) (multiple-value-bind (q r) (round (- x 5) 4) (list q r)))
(defun h5 (x) (multiple-value-bind (q r) (round x 2) (+ q r)))
(defun h6 (x) (multiple-value-bind (q) (floor (+ x x) 3) q))
;; accumulators and counters starting from a value of unknown type
(defun k1 (x) (let ((s 0)) (dolist (y (list x 1 x 2.5d0 x)) (incf s y)) s))
(defun k2 (x) (let ((s x)) (dotimes (i 5) (incf s (* i 1000000000))) s))
(defun k3 (x) (let ((n 0)) (loop for k from x below (+ x 5) do (setq n (logxor n k))) n))
(defun k4 (x) (let ((s x) (c 0)) (dotimes (i 4) (setq s (* s 3)) (when (> s 1000000000) (incf c))) (list s c)))
(defun k5 (x) (let ((s 1) (n 0)) (dotimes (i 3) (setq s (+ s x)) (when (= s 2) (incf n)) (when (< s 0.5d0) (incf n))) (list s n)))
(defun k6 (x) (let ((k x)) (loop while (< k (+ x 3)) do (setq k (+ k 1/2))) k))
(dolist (f '(f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12 f13 f14 f15 f16 f17 f18 g1 h1 h2 h3 h4 h5 h6 k1 k2 k3 k4 k5 k6))
  (dolist (v *vals*)
    (format t "~A ~A ~A~%" f v
            (handler-case (funcall f v) (error () 'error)))))
;; a hash table of integers beyond the fixnums
(let ((h (make-hash-table)) (e (make-hash-table :test 'equal)) (n 0))
  (dotimes (i 100) (setf (gethash (+ (expt 2 40) i) h) i (gethash (+ (expt 2 40) i) e) i))
  (dotimes (i 200) (let ((v (gethash (+ (expt 2 40) i) h)) (w (gethash (+ (expt 2 40) i) e)))
                     (when v (incf n v)) (when w (incf n w))))
  (print (list n (gethash (expt 2 70) h) (gethash 1099511627776 e) (gethash 1099511627776.0d0 h))))
(terpri)
;; shifts by a count of a known range
(defun s1 (x n) (declare (type (unsigned-byte 32) x) (type (integer 0 31) n))
  (logand (logior (ash x n) (ash x (- n 32))) #xFFFFFFFF))
(defun s2 (x n) (declare (type (signed-byte 40) x) (type (integer -70 0) n)) (ash x n))
(defun s3 (x n) (declare (type (signed-byte 40) x) (type (integer -70 20) n)) (ash x n))
(defun s4 (x n) (declare (type (unsigned-byte 16) x) (type (integer -5 40) n)) (ash x n))
(print (loop for x in '(0 1 #xFFFFFFFF #x80000001 12345678) collect (loop for n in '(0 1 7 31) collect (s1 x n))))
(print (loop for x in (list 0 1 -1 (1- (expt 2 39)) (- (expt 2 39)) 1234567890)
             collect (loop for n in '(0 -1 -5 -38 -39 -40 -63 -64 -70) collect (s2 x n))))
(print (loop for x in (list 0 1 -1 (1- (expt 2 39)) (- (expt 2 39)) 1234567890)
             collect (loop for n in '(20 10 1 0 -1 -39 -63 -64 -70) collect (s3 x n))))
(print (loop for x in '(0 1 65535 4321) collect (loop for n in '(-5 -1 0 1 23 40) collect (s4 x n))))
(terpri)
;; functions of integers within 64 bits called with them (copies taking and
;; returning i64s): called from two places so that they are not inlined
(defun fmix32 (h)
  (declare (type (unsigned-byte 32) h))
  (setq h (logxor h (ash h -16)))
  (setq h (logand (* h #x85ebca6b) #xFFFFFFFF))
  (setq h (logxor h (ash h -13)))
  (setq h (logand (* h #xc2b2ae35) #xFFFFFFFF))
  (logxor h (ash h -16)))
(defun fmix (h)
  (setq h (logand h #xFFFFFFFF))
  (setq h (logxor h (ash h -16)))
  (setq h (logand (* h #x85ebca6b) #xFFFFFFFF))
  (setq h (logxor h (ash h -13)))
  (setq h (logand (* h #xc2b2ae35) #xFFFFFFFF))
  (logxor h (ash h -16)))
(defun sum-down (n acc)
  ;; a tail call of itself with an i64 accumulator
  (if (<= n 0) acc (sum-down (1- n) (logand (+ acc (* n 2654435761)) #xFFFFFFFFFFFF))))
(defun maybe-big (x)
  ;; within 64 bits on one path only: an eqref result
  (if (> x 100) (* x x x x x) (logand x #xFFFFFFFF)))
(let ((h 1) (s 0) (u 0))
  (dotimes (i 1000) (setq h (fmix32 (logand (+ h i) #xFFFFFFFF))) (setq s (logxor s (fmix32 i))))
  (dotimes (i 1000) (setq u (logxor u (fmix (+ h i)) (fmix (* i 4294967311)))))
  (print (list h s u (sum-down 1000 0) (sum-down 10 5) (maybe-big 99) (maybe-big (logand h #xFFFF))
               (maybe-big (logand s #xFFFFFFFF)))))
(terpri)
