;;; call sites of generic functions keep working when methods, classes and names change
(defclass p () ((x :initarg :x :accessor px) (y :initarg :y :accessor py)))
(defclass q (p) ((z :initarg :z :initform 9 :reader qz)))
(defgeneric size (o))
(defmethod size ((o p)) (+ (px o) (py o)))
(defgeneric pair (a b))
(defmethod pair ((a p) b) (list :p (px a) b))
(defun probe (o) (list (px o) (py o) (size o) (pair o 1)))
(defvar *p* (make-instance 'p :x 1 :y 2))
(defvar *q* (make-instance 'q :x 3 :y 4))
(defun show (tag) (print (list tag (probe *p*) (probe *q*))))
(show 1) (show 2)
(defmethod size ((o q)) (* 10 (call-next-method)))
(show 3)
(defmethod size :around ((o p)) (list :around (call-next-method)))
(show 4)
(defmethod px :around ((o q)) (- (call-next-method)))
(show 5)
(defmethod pair ((a q) (b integer)) (list :q-int (call-next-method)))
(defmethod pair (a (b (eql 1))) (list :eql-1 (if (next-method-p) (call-next-method) :none)))
(show 6)
(print (list (pair *p* 2) (pair *q* 2) (pair 5 1) (handler-case (pair 5 2) (error () :no-method))))
(remove-method #'size (find-method #'size '(:around) (list (find-class 'p))))
(show 7)
;; a reader on an unbound slot, and on other objects
(defclass u () ((s :reader us)))
(defun read-us (o) (us o))
(print (handler-case (read-us (make-instance 'u)) (unbound-slot () :unbound)))
(defmethod us ((o integer)) (* 2 o))
(print (list (read-us 21) (handler-case (read-us "s") (error () :no-method))))
;; many classes at one site
(defgeneric tag (o))
(defmacro def-tags (&rest names)
  `(progn ,@(loop for n in names for i from 0
                  collect `(defclass ,n () ()) collect `(defmethod tag ((o ,n)) ,i))))
(def-tags t0 t1 t2 t3 t4 t5)
(defun tags (l) (mapcar (lambda (o) (tag o)) l))
(let ((objs (mapcar #'make-instance '(t0 t1 t2 t3 t4 t5))))
  (dotimes (i 5) (print (tags objs)))
  (defmethod tag ((o t3)) :three)
  (print (tags objs)))
;; the class is redefined with the slots in another order
(defclass p () ((y :initarg :y :accessor py) (w :initform 0) (x :initarg :x :accessor px)))
(let ((n (make-instance 'p :x 7 :y 8))) (print (list (px n) (py n) (size n))))
;; the name becomes an ordinary function
(fmakunbound 'size)
(defun size (o) (list :plain o))
(print (list (car (third (probe (make-instance 'p :x 1 :y 1)))) (size 3)))
