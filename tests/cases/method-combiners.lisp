;;; effective methods of :BEFORE and :AFTER methods and of the short-form
;;; method combinations, whose combining code is made in the module of the
;;; methods (*METHOD-COMBINERS*, runtime/clos.lisp)
(defclass mc-a () ()) (defclass mc-b (mc-a) ()) (defclass mc-c (mc-b) ())
(defvar *mc-log* nil)
(defgeneric mc-w (x n))
(defmethod mc-w ((x mc-a) n) (push (list :a n) *mc-log*) (values n :second))
(defmethod mc-w :before ((x mc-b) n) (push (list :before-b n) *mc-log*))
(defmethod mc-w :before ((x mc-a) n) (push (list :before-a n) *mc-log*))
(defmethod mc-w :after ((x mc-a) n) (push (list :after-a n) *mc-log*))
(defmethod mc-w :after ((x mc-c) n) (push (list :after-c n) *mc-log*))
(defmethod mc-w :around ((x mc-c) n) (list :around (call-next-method x (+ n 1))))
(print (list (mc-w (make-instance 'mc-c) 1) (reverse *mc-log*)))
(setq *mc-log* nil)
(print (list (multiple-value-list (mc-w (make-instance 'mc-b) 2)) (reverse *mc-log*)))
(defgeneric mc-before-only (x y z))
(defmethod mc-before-only ((x mc-a) y z) (list x y z))
(defmethod mc-before-only :before ((x mc-b) y z) (push (list :b y z) *mc-log*))
(setq *mc-log* nil)
(print (list (cdr (mc-before-only (make-instance 'mc-b) 1 2)) *mc-log*))
(defgeneric mc-opt (x &optional y))
(defmethod mc-opt ((x mc-a) &optional (y 5)) (list :opt y))
(defmethod mc-opt :after ((x mc-b) &optional y) (push (list :after y) *mc-log*))
(setq *mc-log* nil)
(print (list (mc-opt (make-instance 'mc-b)) (mc-opt (make-instance 'mc-b) 3) *mc-log*))
(defgeneric mc-s (x) (:method-combination +))
(defmethod mc-s + ((x mc-a)) 1)
(defmethod mc-s + ((x mc-b)) 10)
(defmethod mc-s + ((x mc-c)) 100)
(defgeneric mc-ap (x y) (:method-combination append :most-specific-last))
(defmethod mc-ap append ((x mc-a) y) (list :a y))
(defmethod mc-ap append ((x mc-b) y) (list :b y))
(defmethod mc-ap append ((x mc-c) y) (list :c y))
(defmethod mc-ap :around ((x mc-c) y) (cons :around (call-next-method)))
(defgeneric mc-an (x) (:method-combination and))
(defmethod mc-an and ((x mc-a)) :a)
(defmethod mc-an and ((x mc-b)) :b)
(defgeneric mc-o (x &optional y) (:method-combination or))
(defmethod mc-o or ((x mc-a) &optional y) (and y :a))
(defmethod mc-o or ((x mc-b) &optional y) (declare (ignore y)) nil)
(defgeneric mc-mx (x) (:method-combination max))
(defmethod mc-mx max ((x mc-a)) 3)
(defmethod mc-mx max ((x mc-b)) 7)
(defgeneric mc-li (x) (:method-combination list))
(defmethod mc-li list ((x mc-a)) 1)
(defmethod mc-li list ((x mc-b)) 2)
(defgeneric mc-pr (x) (:method-combination progn))
(defmethod mc-pr progn ((x mc-a)) (push :pa *mc-log*) :pa)
(defmethod mc-pr progn ((x mc-b)) (push :pb *mc-log*) :pb)
(defgeneric mc-nc (x) (:method-combination nconc))
(defmethod mc-nc nconc ((x mc-a)) (list 1))
(defmethod mc-nc nconc ((x mc-b)) (list 2))
(defmethod mc-nc nconc ((x mc-c)) (list 3))
(defgeneric mc-mn (x) (:method-combination min))
(defmethod mc-mn min ((x mc-a)) 3)
(defmethod mc-mn min ((x mc-b)) 7)
(defmethod mc-mn min ((x mc-c)) -1)
(setq *mc-log* nil)
(print (list (mc-s (make-instance 'mc-c)) (mc-s (make-instance 'mc-b)) (mc-ap (make-instance 'mc-c) 0)
             (mc-ap (make-instance 'mc-b) 1) (mc-an (make-instance 'mc-b)) (mc-an (make-instance 'mc-a))
             (mc-o (make-instance 'mc-b)) (mc-o (make-instance 'mc-b) t) (mc-mx (make-instance 'mc-b))
             (mc-li (make-instance 'mc-b)) (mc-pr (make-instance 'mc-b)) *mc-log*
             (mc-nc (make-instance 'mc-c)) (mc-mn (make-instance 'mc-c)) (mc-mn (make-instance 'mc-b))))
;; in a loop (the call sites' caches)
(print (let ((s 0) (objs (list (make-instance 'mc-a) (make-instance 'mc-b) (make-instance 'mc-c))))
         (setq *mc-log* nil)
         (dotimes (i 100 (list s (length *mc-log*)))
           (dolist (o objs) (incf s (+ (mc-s o) (length (mc-ap o i)) (if (typep o (quote mc-c)) 0 (mc-w o 1))))))))
