(let ((h (make-hash-table)))
  (setf (gethash 'a h) 1 (gethash 'b h) 2 (gethash 'c h) 3)
  (print (gethash 'b h))
  (print (multiple-value-list (gethash 'z h)))
  (print (hash-table-count h))
  (remhash 'b h)
  (print (hash-table-count h))
  (maphash (lambda (k v) (print (list k v))) h)
  (print (loop for k being the hash-keys of h using (hash-value v) collect (cons k v))))
(let ((h (make-hash-table :test 'equal)))
  (setf (gethash "foo" h) 1 (gethash '(1 2) h) 2)
  (print (gethash "foo" h))
  (print (gethash (list 1 2) h))
  (print (gethash "FOO" h)))
(let ((h (make-hash-table :test 'equalp)))
  (setf (gethash "foo" h) 1)
  (print (gethash "FOO" h)))
(let ((h (make-hash-table)))
  (dotimes (i 1000) (setf (gethash i h) (* i i)))
  (print (gethash 999 h))
  (print (hash-table-count h))
  (dotimes (i 500) (remhash (* i 2) h))
  (print (hash-table-count h))
  (print (gethash 501 h)))
(let ((h (make-hash-table :test 'eq)))
  (let ((k1 (list 1)) (k2 (list 1)))
    (setf (gethash k1 h) 'one (gethash k2 h) 'two)
    (print (list (gethash k1 h) (gethash k2 h)))))
(let ((h (make-hash-table :test 'eql)))
  (setf (gethash 1.5 h) 'f (gethash (expt 2 80) h) 'big)
  (print (list (gethash 1.5 h) (gethash (expt 2 80) h))))
(print (hash-table-p (make-hash-table)))
(print (hash-table-test (make-hash-table :test #'equal)))
