;;; Local functions and closures with a loop: their entry versions for fixnum
;;; (or double) parameters and free variables, and the general version for
;;; anything else (bignums, ratios, floats, a free variable of another type).
(defun queens (n)
  (let ((count 0) (cols (make-array n :initial-element nil))
        (d1 (make-array (* 2 n) :initial-element nil)) (d2 (make-array (* 2 n) :initial-element nil)))
    (labels ((place (row)
               (if (= row n)
                   (incf count)
                   (dotimes (c n)
                     (unless (or (aref cols c) (aref d1 (+ row c)) (aref d2 (+ (- row c) n)))
                       (setf (aref cols c) t (aref d1 (+ row c)) t (aref d2 (+ (- row c) n)) t)
                       (place (1+ row))
                       (setf (aref cols c) nil (aref d1 (+ row c)) nil (aref d2 (+ (- row c) n)) nil))))))
      (place 0))
    count))
(print (list (queens 6) (queens 8)))
(defun make-summer (k)
  (lambda (n) (let ((s 0)) (dotimes (i n s) (incf s (* i k))))))
(print (list (funcall (make-summer 3) 10) (funcall (make-summer (expt 2 70)) 4)
             (funcall (make-summer 1/2) 5) (funcall (make-summer 0.5d0) 4)
             (funcall (make-summer 2) (expt 2 3))))
(defun scale-all (v f)
  (labels ((walk (i acc) (if (>= i (length v)) acc (walk (1+ i) (+ acc (* f (svref v i)))))))
    (list (walk 0 0) (walk 1 0.0d0))))
(print (scale-all (vector 1 2 3) 2))
(print (scale-all (vector 1 2 3) 1.5d0))
(print (scale-all (vector 1 2 3) (expt 10 20)))
(defun count-to (limit)
  (let ((hits 0))
    (flet ((try (x) (loop for i from x below limit do (when (evenp i) (incf hits)))))
      (try 0) (try (- limit 3)) (try (- limit 2)))
    hits))
(print (list (count-to 10) (count-to 11)))
(defun count-big (start)
  (let ((limit (+ start 5)) (hits 0))
    (flet ((try (x) (loop for i from x below limit do (when (evenp i) (incf hits)))))
      (try start) (try (+ start 2)))
    hits))
(print (list (count-big 10) (count-big (expt 2 64))))
(defun wrong-type (n) (labels ((f (i) (dotimes (j n i) (incf i j)))) (f 0)))
(print (handler-case (wrong-type "x") (error () :error)))
(print (wrong-type 5))
(print (wrong-type (expt 2 3)))
