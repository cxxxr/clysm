(defclass animal () ((name :initarg :name :accessor animal-name) (sound :initform "..." :reader sound)))
(defclass dog (animal) ((sound :initform "woof")))
(defclass cat (animal) () (:default-initargs :name "kitty"))
(defgeneric speak (a))
(defmethod speak ((a animal)) (format nil "~A says ~A" (animal-name a) (sound a)))
(defmethod speak ((d dog)) (concatenate 'string (call-next-method) "!"))
(print (speak (make-instance 'dog :name "rex")))
(print (speak (make-instance 'cat)))
(let ((d (make-instance 'dog :name "fido")))
  (setf (animal-name d) "buddy")
  (print (animal-name d))
  (print (slot-value d 'sound))
  (print (typep d 'animal))
  (print (class-name (class-of d)))
  (print (slot-boundp d 'name)))
(defmethod describe-thing ((x integer)) (list 'integer x))
(defmethod describe-thing ((x string)) (list 'string x))
(defmethod describe-thing ((x symbol)) (list 'symbol x))
(defmethod describe-thing ((x (eql 42))) (list 'the-answer (call-next-method)))
(defmethod describe-thing ((x t)) (list 'other x))
(print (mapcar #'describe-thing (list 1 "s" 'sym 42 1.5 nil)))
(defclass counter () ((count :initform 0 :accessor counter-count)))
(defmethod initialize-instance :after ((c counter) &key start)
  (when start (setf (counter-count c) start)))
(print (counter-count (make-instance 'counter :start 10)))
(print (counter-count (make-instance 'counter)))
(defgeneric trace-me (x))
(defmethod trace-me :before ((x integer)) (format t "~&before ~A" x))
(defmethod trace-me :after ((x integer)) (format t "~&after ~A" x))
(defmethod trace-me ((x integer)) (format t "~&primary ~A" x) (* x 2))
(defmethod trace-me :around ((x integer)) (format t "~&around-in") (prog1 (call-next-method) (format t "~&around-out")))
(print (trace-me 5))
(defgeneric total (x) (:method-combination +))
(defmethod total + ((x integer)) x)
(defmethod total + ((x number)) 100)
(print (total 5))
(defclass point () ((x :initarg :x) (y :initarg :y)))
(defmethod print-object ((p point) stream)
  (format stream "#<POINT ~A,~A>" (slot-value p 'x) (slot-value p 'y)))
(print (make-instance 'point :x 1 :y 2))
(print (format nil "~A" (make-instance 'point :x 3 :y 4)))
(let ((p (make-instance 'point :x 5 :y 6)))
  (with-slots (x y) p (print (+ x y)))
  (with-slots ((px x)) p (setf px 50) (print (slot-value p 'x))))
(defstruct sp a)
(defmethod print-object ((s sp) stream) (format stream "<sp ~A>" (sp-a s)))
(print (make-sp :a 1))
(defgeneric area (shape))
(defclass circle () ((r :initarg :r)))
(defclass square () ((s :initarg :s)))
(defmethod area ((c circle)) (* 3 (slot-value c 'r) (slot-value c 'r)))
(defmethod area ((s square)) (* (slot-value s 's) (slot-value s 's)))
(print (mapcar #'area (list (make-instance 'circle :r 2) (make-instance 'square :s 3))))
(print (handler-case (area 5) (error () 'no-method)))
(defclass a () ()) (defclass b (a) ()) (defclass c (a) ()) (defclass d (b c) ())

(defgeneric who (x))
(defmethod who ((x a)) '(a))
(defmethod who ((x b)) (cons 'b (call-next-method)))
(defmethod who ((x c)) (cons 'c (call-next-method)))
(defmethod who ((x d)) (cons 'd (call-next-method)))
(print (who (make-instance 'd)))
(defclass shared () ((counter :allocation :class :initform 0 :accessor shared-counter)))
(let ((s1 (make-instance 'shared)) (s2 (make-instance 'shared)))
  (incf (shared-counter s1))
  (print (shared-counter s2)))
(defgeneric (setf thing) (v obj))
(defmethod (setf thing) (v (obj cons)) (setf (car obj) v))
(let ((c (list 1 2))) (setf (thing c) 'x) (print c))
(print (subtypep 'dog 'animal))

(defun next-method-p-test () 1)
