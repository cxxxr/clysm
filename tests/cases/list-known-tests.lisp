;;; FIND, POSITION, COUNT, REMOVE, MEMBER and ASSOC on lists with the usual
;;; two-argument tests (called inline), with :KEY #'CAR, bounds and errors.
(defmacro try (form) `(print (handler-case ,form (error () :err))))
(defparameter *chars* (coerce "abcABCxyz" 'list))
(defparameter *strs* (list "foo" "Bar" "baz" "FOO" "bar"))
(defparameter *al* (mapcar (lambda (s) (cons s (length s))) *strs*))
(defparameter *cl* (mapcar #'list *chars*))
(defparameter *nums* (list 1 2.0 3 4 2 1/2))
(dolist (test (list #'char= #'char-equal 'char-equal))
  (try (list (find #\B *chars* :test test) (position #\B *chars* :test test)
             (position #\b *chars* :test test :start 3) (position #\b *chars* :test test :start 1 :end 4)
             (count #\a *chars* :test test) (count #\a *chars* :test test :start 1)
             (remove #\a *chars* :test test) (member #\B *chars* :test test)
             (position #\c *cl* :test test :key #'car) (find #\Z *cl* :test test :key #'first)
             (assoc #\Y (mapcar (lambda (c) (cons c 1)) *chars*) :test test))))
(dolist (test (list #'string= #'string-equal #'equal))
  (try (list (find "bar" *strs* :test test) (position "BAR" *strs* :test test)
             (count "foo" *strs* :test test) (remove "foo" *strs* :test test)
             (member "baz" *strs* :test test) (assoc "FOO" *al* :test test)
             (position "baz" *al* :test test :key #'car) (find "bar" *al* :test test :key #'car))))
(try (list (position 2 *nums* :test #'=) (count 2 *nums* :test #'=) (remove 1 *nums* :test #'=)
           (find 0.5 *nums* :test #'=) (member 4 *nums* :test #'=) (assoc 2 '((1 . a) (2.0 . b)) :test #'=)))
(try (let ((l (list #\a #\b))) (eq l (remove #\z l :test #'char=))))
(try (position #\a '(#\b 1 #\a) :test #'char=))
(try (position #\a *chars* :test #'char= :start 20))
(try (find #\a '((#\b) 3) :test #'char= :key #'car))
(try (position #\c *chars* :test-not #'char=))
(try (position #\c *chars* :test #'char= :from-end t))
(try (list (char-equal #\a #\A) (char-equal #\[ #\{) (char-equal #\U+00E9 #\U+00C9)
           (funcall #'char-equal #\z #\Z) (char-code (find #\U+00C9 (list #\a #\U+00E9) :test #'char-equal))))
