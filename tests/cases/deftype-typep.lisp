;;; TYPEP / TYPECASE with types defined by DEFTYPE (expanded at compile time)
(deftype small () '(integer 0 9))
(deftype maybe (x) `(or null ,x))
(deftype odd-one () (if (oddp 3) 'symbol 'string))
(defun kind (x) (typecase x (small :small) ((maybe string) :maybe-string) (odd-one :symbol) (t :other)))
(print (mapcar #'kind (list 3 10 nil "s" 'a (cons nil nil) (cons 1 2) 2.5)))
(print (list (typep 5 'small) (typep -1 'small) (typep nil '(maybe integer)) (typep 'x 'odd-one)))
(print (let ((*gensym-counter* 0)) (mapcar #'symbol-name (list (gensym "A") (gensym "B")))))
(print (eval '(let ((*gensym-counter* 0)) (let ((a (gensym "A")) (b (gensym "B"))) (mapcar #'symbol-name (list a b))))))
