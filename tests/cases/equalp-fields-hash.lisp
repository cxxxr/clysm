;;; Fast structure fields and vector hashes must agree with generic EQUALP,
;;; including Unicode, exact large numbers and character vectors as strings.
(defstruct comparison-fields a b c)
(defun wrapped (x) (make-comparison-fields :a x :b (copy-seq "MiXeD") :c (vector 1 2)))
(dolist (pair (list (list 1 1.0) (list -17 -17d0) (list 1.5 1.5d0)
                   (list 0.0 -0.0d0) (list #\a #\A) (list "ä" "Ä")
                   (list 9007199254740993 9007199254740992d0)
                   (list 1/2 0.5) (list 1/3 0.5) (list 'a 'b)
                   (list "ABC" (vector #\a #\b #\c))))
  (let ((a (first pair)) (b (second pair)))
    (print (list (equalp (wrapped a) (wrapped b))
                 (equalp (wrapped b) (wrapped a))))))
(let ((h (make-hash-table :test 'equalp)))
  (dolist (pair (list (list (vector 1 "abc" 2.0) (vector 1d0 "ABC" 2))
                     (list (vector "ä" 3/2) (vector "Ä" 1.5d0))
                     (list #() "") (list (vector #\a #\B) "Ab")
                     (list (vector #\a 3) (vector #\A 3.0))
                     (list (vector (vector (vector (vector (vector 1)))))
                           (vector (vector (vector (vector (vector 1.0))))))))
    (clrhash h)
    (setf (gethash (first pair) h) 'found)
    (print (multiple-value-list (gethash (second pair) h)))
    (setf (gethash (second pair) h) 'updated)
    (print (list (hash-table-count h) (gethash (first pair) h)))))
