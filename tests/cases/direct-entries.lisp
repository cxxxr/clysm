;;; Code loaded into the image calls the functions of other modules (the
;;; runtime's, those of earlier forms) by their entries, imported, as long as
;;; the symbol's function is the one it was when the call was compiled: a
;;; redefinition, (SETF FDEFINITION), a function made unbound and a wrong
;;; number of arguments are seen as with a call through the symbol.
(defun de-old (x) (list :old x))
(defmacro de-break () nil)
(de-break)
(defun de-call (x) (de-old x))
(defun de-tail (x) (if x (de-old x) (de-old 0)))
(defun de-loop (n) (let ((s 0)) (dotimes (i n s) (incf s (length (de-old i))))))
(defun de-runtime (l) (list (getf l :a) (get 'de-sym 'p 7) (string-upcase "ab") (gcd 12 18) (remprop 'de-sym 'q)))
(defun de-opt (s) (list (parse-integer s) (parse-integer s :radix 16) (string-trim " " s)))
(defun de-mv (x) (multiple-value-list (floor x 3)))
(defun de-wrong () (ignore-errors (funcall 'de-old 1 2)))
(defun de-wrong2 () (handler-case (eval '(de-old)) (error () :arg-error)))
(print (list (de-call 1) (de-tail nil) (de-loop 3) (de-runtime '(:a 1)) (de-opt "12") (de-mv 7) (de-wrong) (de-wrong2)))
(defun de-old (x) (list :new x x))
(print (list (de-call 1) (de-tail 2) (de-loop 3)))
(setf (fdefinition 'de-old) (lambda (x) (vector x)))
(print (list (de-call 1) (de-tail 2) (de-loop 3)))
(fmakunbound 'de-old)
(print (handler-case (de-call 1) (undefined-function (c) (list :undefined (cell-error-name c)))))
(defun de-old (x) x)
(print (list (de-call 5) (de-tail 6)))
;; a function wrapped as TRACE does, and restored (defined twice: a whole
;; program binds the calls of a function with one definition to it)
(defun my-de-helper (x) x)
(defun my-de-helper (x) (* x 2))
(de-break)
(defun de-user2 (x) (+ 1 (my-de-helper x)))
(print (de-user2 4))
(let ((old #'my-de-helper))
  (setf (fdefinition 'my-de-helper) (lambda (x) (+ 1000 (funcall old x))))
  (print (de-user2 4))
  (setf (fdefinition 'my-de-helper) old)
  (print (de-user2 4)))
;; non-local exits through such calls
(defun de-thrower (x) (throw 'de-tag (* x 10)))
(de-break)
(defun de-catch (x) (catch 'de-tag (de-thrower x) :not-reached))
(defun de-block (l) (block nil (mapc (lambda (x) (when (evenp x) (return x))) l) :none))
(defun de-uwp (x) (let ((r nil)) (catch 'de-tag (unwind-protect (de-thrower x) (push :cleanup r))) r))
(print (list (de-catch 3) (de-block '(1 3 4 5)) (de-block '(1 3)) (de-uwp 1)))
