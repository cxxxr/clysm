(js:library-options :lazy t :extension ".js")
(defvar *count* 0)
(js:export "next" (lambda () (incf *count*)) :entry "implementation" :type "() => number")
(js:export "internalOnly" 42 :entry "implementation")
(js:declare-types "export interface Item { value: number }" :entry "implementation")
(js:reexport "next" :from "./implementation.js" :entry "public")
(js:reexport '("Item") :from "./implementation.js" :entry "public" :type-only t)
(js:reexport #("external") :from "./external.js" :entry "public")
(js:reexport "next" :from "./implementation.js" :entry "again")
(js:export "own" "kept" :entry "again")
