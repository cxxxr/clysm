;;; A library for bin/clysm library --wasm-opt (tests/lib/wasm-opt.mjs):
;;; errors and a backtrace below some functions, whose names a stack trace
;;; has with and without wasm-opt.
(js:library-options :lazy t :embed t :compression :xz)
(declaim (notinline leaf middle outer (setf thing) bt))
(defvar *log* nil)
(defun leaf (x)
  (push x *log*)
  (when (> x 2) (error "leaf failed with ~A" x))
  (* x 2))
(defun middle (x)
  (let ((y (leaf (1+ x))))
    (push y *log*)
    (+ y 1)))
(defun outer (x)
  (let ((y (middle (* 2 x))))
    (push y *log*)
    (list y (length *log*))))
(defun (setf thing) (v x)
  (push v *log*)
  (when (> x 2) (error "setf failed"))
  v)
(defun setter (x)
  (let ((r (setf (thing x) 5)))
    (push r *log*)
    (1+ r)))
(defgeneric area (shape))
(defmethod area ((s number))
  (let ((r (outer s)))
    (push r *log*)
    (car r)))
(defun bt (x)
  (let ((r (when (> x 0) (sys::%backtrace-names))))
    (push r *log*)
    (format nil "~S" r)))
(defun bt-outer (x)
  (let ((r (bt x)))
    (push r *log*)
    r))
(js:export "outer" #'outer)
(js:export "setter" #'setter)
(js:export "area" (lambda (x) (area x)))
(js:export "bt" #'bt-outer)
(js:export "double" (lambda (x) (leaf x)))
