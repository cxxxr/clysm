;;; A condition can leave and re-enter its own instance, but not another heap.
(define-condition owned-error (error)
  ((message :initarg :message :reader owned-message))
  (:report (lambda (condition stream) (write-string (owned-message condition) stream))))
(defvar *last-error* nil)
(defun fail-owned ()
  (setf *last-error* (make-condition 'owned-error :message "from this instance"))
  (error *last-error*))
(defun describe-caught (condition)
  (cond ((typep condition 'js:js-error)
         (js:object "kind" "foreign" "message" (js:js-error-message condition)
                    "thrown" (js:js-error-thrown condition)))
        ((typep condition 'owned-error)
         (js:object "kind" "local" "message" (owned-message condition)
                    "same" (eq condition *last-error*)))
        (t (js:object "kind" "unexpected"))))
(js:export "fail" #'fail-owned)
(js:export "receive" (lambda (function)
                        (handler-case (js:funcall function)
                          (error (condition) (describe-caught condition)))))
(js:export "receiveAsync" (lambda (function)
                             (handler-case (js:await (js:funcall function))
                               (error (condition) (describe-caught condition)))) :async t)
(js:export "relay" (lambda (function) (js:funcall function)))
