;;;; types.lisp — flow-sensitive type inference over the AST
;;;;
;;;; Before a lambda is compiled, its body is interpreted abstractly: every
;;;; lexical variable of the lambda that is not both captured and assigned has
;;;; a type at each point of the body (assignments update it, tests refine it:
;;;; in the true branch of (< i n) with N an integer at most 99, I is at most
;;;; 98), loops (TAGBODY) are iterated to a fixed point with widening.  The
;;;; type of every node is recorded for the code generator, and every variable
;;;; gets the union of the values it is bound and assigned to, from which its
;;;; representation is chosen (a raw f64 or i32 local instead of an eqref).
;;;;
;;;; A type is a set of kinds (bits) and, for its integers, a range [lo, hi]
;;;; (NIL = unbounded).  Double-floats are split by sign so that (sqrt x) of a
;;;; double that is not MINUSP is known to be a double.

(in-package :clysm)

(defconstant +k-int+ 1)
(defconstant +k-ratio+ 2)
(defconstant +k-single+ 4)
(defconstant +k-dpos+ 8)                ; double-float, not MINUSP (also -0.0, NaN)
(defconstant +k-dneg+ 16)               ; double-float, MINUSP
(defconstant +k-complex+ 32)
(defconstant +k-char+ 64)
(defconstant +k-null+ 128)
(defconstant +k-sym+ 256)               ; symbols other than NIL
(defconstant +k-cons+ 512)
(defconstant +k-string+ 1024)           ; simple strings ($string)
(defconstant +k-svec+ 2048)             ; simple vectors ($vector)
(defconstant +k-func+ 4096)
(defconstant +k-other+ 8192)
(defconstant +k-limbs+ 16384)           ; bignum digit arrays ($limbs)
(defconstant +k-all+ 32767)
(defconstant +k-double+ 24)
(defconstant +k-float+ 28)
(defconstant +k-rational+ 3)
(defconstant +k-real+ 31)
(defconstant +k-number+ 63)
(defconstant +k-bool+ 384)
(defconstant +k-list+ 640)

(defstruct (ty (:constructor %ty (bits lo hi &optional cls))) (bits 0) (lo nil) (hi nil)
  (cls nil))   ; for instances only: the name of a structure class they belong to

(defun mkty (bits &optional lo hi cls)
  (if (logtest bits +k-int+)
      (if (and lo hi (> lo hi))
          (%ty (logandc2 bits +k-int+) nil nil)
          (%ty bits lo hi))
      (%ty bits nil nil (and (= bits +k-other+) cls))))

(defvar *ty-top* (%ty +k-all+ nil nil))
(defvar *ty-bottom* (%ty 0 nil nil))
(defvar *ty-bool* (%ty +k-bool+ nil nil))
(defvar *ty-fixnum* (%ty +k-int+ +most-negative-fixnum+ +most-positive-fixnum+))
(defvar *ty-index* (%ty +k-int+ 0 (1- +most-positive-fixnum+)))
(defvar *ty-number* (%ty +k-number+ nil nil))
(defvar char-code-limit* 1114112)

(defun ty-bottom-p (ty) (zerop (ty-bits ty)))
(defun ty-int-p (ty) (logtest (ty-bits ty) +k-int+))
(defun ty-only-p (ty mask) (and (not (ty-bottom-p ty)) (zerop (logandc2 (ty-bits ty) mask))))

(defun bound-min (a b) (and a b (min a b)))
(defun bound-max (a b) (and a b (max a b)))

(defun ty-union (a b)
  (cond ((ty-bottom-p a) b)
        ((ty-bottom-p b) a)
        (t (let ((ia (ty-int-p a)) (ib (ty-int-p b)))
             (mkty (logior (ty-bits a) (ty-bits b))
                   (cond ((and ia ib) (bound-min (ty-lo a) (ty-lo b))) (ia (ty-lo a)) (t (ty-lo b)))
                   (cond ((and ia ib) (bound-max (ty-hi a) (ty-hi b))) (ia (ty-hi a)) (t (ty-hi b)))
                   (and (eq (ty-cls a) (ty-cls b)) (ty-cls a)))))))

(defun ty-intersect (a b)
  (mkty (logand (ty-bits a) (ty-bits b))
        (cond ((null (ty-lo a)) (ty-lo b)) ((null (ty-lo b)) (ty-lo a)) (t (max (ty-lo a) (ty-lo b))))
        (cond ((null (ty-hi a)) (ty-hi b)) ((null (ty-hi b)) (ty-hi a)) (t (min (ty-hi a) (ty-hi b))))
        (or (ty-cls b) (ty-cls a))))

(defun ty-remove (ty mask) (mkty (logandc2 (ty-bits ty) mask) (ty-lo ty) (ty-hi ty)))

(defun ty-equal (a b)
  (and (= (ty-bits a) (ty-bits b)) (eq (ty-cls a) (ty-cls b))
       (or (not (ty-int-p a)) (and (eql (ty-lo a) (ty-lo b)) (eql (ty-hi a) (ty-hi b))))))

(defun ty-in-range-p (ty lo hi)
  "TY is only integers within [LO, HI]."
  (and (ty-only-p ty +k-int+) (ty-lo ty) (ty-hi ty) (>= (ty-lo ty) lo) (<= (ty-hi ty) hi)))

(defun ty-fixnum-p (ty) (ty-in-range-p ty +most-negative-fixnum+ +most-positive-fixnum+))
(defun ty-int32-p (ty) (ty-in-range-p ty (- (expt 2 31)) (1- (expt 2 31))))
(defun ty-int64-p (ty) (ty-in-range-p ty (- (expt 2 63)) (1- (expt 2 63))))
(defun ty-double-p (ty) (ty-only-p ty +k-double+))
(defun ty-nonneg-p (ty)
  "Every real in TY is >= 0 (or a double that is not MINUSP)."
  (and (zerop (logand (ty-bits ty) (logior +k-ratio+ +k-single+ +k-dneg+ +k-complex+)))
       (or (not (ty-int-p ty)) (and (ty-lo ty) (>= (ty-lo ty) 0)))))

(defun int-ty (lo hi) (mkty +k-int+ lo hi))

(defun const-ty (x)
  (cond ((null x) (mkty +k-null+))
        ((symbolp x) (mkty +k-sym+))
        ((integerp x) (int-ty x x))
        ((typep x 'ratio) (mkty +k-ratio+))
        ((typep x 'double-float) (mkty (if (minusp x) +k-dneg+ +k-dpos+)))
        ((floatp x) (mkty +k-single+))
        ((complexp x) (mkty +k-complex+))
        ((characterp x) (mkty +k-char+))
        ((consp x) (mkty +k-cons+))
        ((simple-string-p x) (mkty +k-string+))
        ((simple-vector-p x) (mkty +k-svec+))
        (t (mkty +k-other+))))

(defun declared-ty (spec)
  "The type of the Lisp type specifier SPEC (an over-approximation)."
  (let ((name (if (consp spec) (car spec) spec)))
    (flet ((int-range (lo hi)
             (int-ty (cond ((integerp lo) lo) ((and (consp lo) (integerp (car lo))) (1+ (car lo))))
                     (cond ((integerp hi) hi) ((and (consp hi) (integerp (car hi))) (1- (car hi)))))))
      (case name
        (fixnum *ty-fixnum*)
        (integer (if (consp spec) (int-range (second spec) (third spec)) (int-ty nil nil)))
        (unsigned-byte (int-ty 0 (if (and (consp spec) (integerp (second spec))) (1- (expt 2 (second spec))) nil)))
        (signed-byte (if (and (consp spec) (integerp (second spec)))
                         (int-ty (- (expt 2 (1- (second spec)))) (1- (expt 2 (1- (second spec)))))
                         (int-ty nil nil)))
        (bit (int-ty 0 1))
        (double-float (mkty +k-double+))
        ((single-float short-float) (mkty +k-single+))
        (float (mkty +k-float+))
        (rational (mkty +k-rational+))
        (real (mkty +k-real+))
        (number (mkty +k-number+))
        ((character base-char standard-char) (mkty +k-char+))
        (cons (mkty +k-cons+))
        (list (mkty +k-list+))
        (null (mkty +k-null+))
        (symbol (mkty (logior +k-null+ +k-sym+)))
        (simple-string (mkty +k-string+))
        (simple-vector (mkty +k-svec+))
        (function (mkty +k-func+))
        (t *ty-top*)))))

;;; ------------------------------------------------------------
;;; Arithmetic
;;; ------------------------------------------------------------

(defun range-op (op alo ahi blo bhi)
  (ecase op
    (:add (values (and alo blo (+ alo blo)) (and ahi bhi (+ ahi bhi))))
    (:sub (values (and alo bhi (- alo bhi)) (and ahi blo (- ahi blo))))
    (:mul (if (and alo ahi blo bhi)
              (let ((ps (list (* alo blo) (* alo bhi) (* ahi blo) (* ahi bhi))))
                (values (reduce #'min ps) (reduce #'max ps)))
              (values nil nil)))))

(defun arith-ty (op a b)
  "The type of (OP A B) for OP in :add :sub :mul :div (the result of a call that returns)."
  (let ((ab (ty-bits a)) (bb (ty-bits b)) (bits 0) (lo nil) (hi nil) (int-unbounded nil))
    (when (or (not (logtest ab +k-number+)) (not (logtest bb +k-number+)))
      (return-from arith-ty *ty-bottom*))
    (when (or (logtest ab +k-complex+) (logtest bb +k-complex+))
      (return-from arith-ty *ty-number*))
    (flet ((has (bits k) (logtest bits k)))
      ;; integer x integer
      (when (and (has ab +k-int+) (has bb +k-int+))
        (if (eq op :div)
            (setf bits (logior bits +k-int+ +k-ratio+) int-unbounded t)
            (progn (setf bits (logior bits +k-int+))
                   (multiple-value-setq (lo hi) (range-op op (ty-lo a) (ty-hi a) (ty-lo b) (ty-hi b))))))
      ;; ratios
      (when (or (and (has ab +k-ratio+) (has bb +k-rational+))
                (and (has bb +k-ratio+) (has ab +k-rational+)))
        (setf bits (logior bits +k-int+ +k-ratio+) int-unbounded t))
      ;; single floats
      (when (or (and (has ab +k-single+) (has bb (logior +k-rational+ +k-single+)))
                (and (has bb +k-single+) (has ab (logior +k-rational+ +k-single+))))
        (setf bits (logior bits +k-single+)))
      ;; doubles
      (when (or (and (has ab +k-double+) (has bb +k-real+))
                (and (has bb +k-double+) (has ab +k-real+)))
        (setf bits (logior bits
                           (if (and (member op '(:add :mul :div)) (ty-nonneg-p a) (ty-nonneg-p b))
                               +k-dpos+
                               +k-double+))))
      (if int-unbounded (mkty bits nil nil) (mkty bits lo hi)))))

(defun negate-ty (a)
  (let ((r (arith-ty :sub (int-ty 0 0) a)))
    (if (logtest (ty-bits a) +k-double+) (mkty (logior (ty-bits r) +k-double+) (ty-lo r) (ty-hi r)) r)))

(defun bit-bound (lo hi)
  "N such that [LO, HI] is within [-2^N, 2^N), or NIL."
  (and lo hi (max (integer-length lo) (integer-length hi))))

(defun logical-ty (op a b)
  (if (not (and (ty-int-p a) (ty-int-p b)))
      *ty-bottom*
      (let* ((a (ty-intersect a (int-ty nil nil))) (b (ty-intersect b (int-ty nil nil)))
             (na (and (ty-lo a) (>= (ty-lo a) 0))) (nb (and (ty-lo b) (>= (ty-lo b) 0)))
             (ka (bit-bound (ty-lo a) (ty-hi a))) (kb (bit-bound (ty-lo b) (ty-hi b))))
        (cond ((and (eq op :and) na nb) (int-ty 0 (cond ((null (ty-hi a)) (ty-hi b)) ((null (ty-hi b)) (ty-hi a))
                                                           (t (min (ty-hi a) (ty-hi b))))))
              ((and (eq op :and) na) (int-ty 0 (ty-hi a)))
              ((and (eq op :and) nb) (int-ty 0 (ty-hi b)))
              ((and ka kb)
               (let ((k (max ka kb)))
                 (if (and na nb) (int-ty 0 (1- (expt 2 k))) (int-ty (- (expt 2 k)) (1- (expt 2 k))))))
              (t (int-ty nil nil))))))

(defun ash-ty (a c)
  (if (not (and (ty-int-p a) (ty-int-p c)))
      *ty-bottom*
      (let ((lo (ty-lo a)) (hi (ty-hi a)) (clo (ty-lo c)) (chi (ty-hi c)))
        (cond ((and clo chi (<= chi 0) lo hi)
               ;; right shift: the range shrinks toward 0 / -1
               (int-ty (min 0 (ash lo clo) (ash lo chi)) (max 0 (ash hi clo) (ash hi chi))))
              ((and clo chi (>= clo 0) (<= chi 64) lo hi)
               (int-ty (min (ash lo clo) (ash lo chi)) (max (ash hi clo) (ash hi chi))))
              (t (int-ty nil nil))))))

;;; ------------------------------------------------------------
;;; Result types of primitives and known functions
;;; ------------------------------------------------------------

(defvar *ti-rules* (make-hash-table :test 'eq) "name -> fn (arg-types) -> result type")
(defvar *ti-test-rules* (make-hash-table :test 'eq)
  "name -> fn (arg-types) -> list of (argument-index true-type false-type)")
(defvar *ti-noreturn* (make-hash-table :test 'eq))

(defmacro def-ti-rule (names (args) &body body)
  `(let ((fn (lambda (,args) (declare (ignorable ,args)) ,@body)))
     (dolist (n ',(if (listp names) names (list names))) (setf (gethash n *ti-rules*) fn))))

(defmacro def-ti-test (names (args) &body body)
  `(let ((fn (lambda (,args) (declare (ignorable ,args)) ,@body)))
     (dolist (n ',(if (listp names) names (list names))) (setf (gethash n *ti-test-rules*) fn))))

(dolist (s '(error clysm-sys::%type-error)) (setf (gethash s *ti-noreturn*) t))

(def-ti-rule + (a) (if (= (length a) 2) (arith-ty :add (first a) (second a)) *ty-number*))
(def-ti-rule - (a) (case (length a)
                     (1 (negate-ty (first a)))
                     (2 (arith-ty :sub (first a) (second a)))
                     (t *ty-number*)))
(def-ti-rule * (a) (if (= (length a) 2) (arith-ty :mul (first a) (second a)) *ty-number*))
(def-ti-rule / (a) (if (= (length a) 2) (arith-ty :div (first a) (second a)) *ty-number*))
(def-ti-rule 1+ (a) (arith-ty :add (first a) (int-ty 1 1)))
(def-ti-rule 1- (a) (arith-ty :sub (first a) (int-ty 1 1)))
(def-ti-rule logand (a) (if (= (length a) 2) (logical-ty :and (first a) (second a)) (int-ty nil nil)))
(def-ti-rule logior (a) (if (= (length a) 2) (logical-ty :or (first a) (second a)) (int-ty nil nil)))
(def-ti-rule logxor (a) (if (= (length a) 2) (logical-ty :xor (first a) (second a)) (int-ty nil nil)))
(def-ti-rule ash (a) (ash-ty (first a) (second a)))
(def-ti-rule (clysm-sys::%fx+ clysm-sys::%fx- clysm-sys::%fx* clysm-sys::%fxlogand clysm-sys::%fxlogior
              clysm-sys::%fxlogxor clysm-sys::%fxtruncate clysm-sys::%fxrem clysm-sys::%fxash-left
              clysm-sys::%fxash-right)
    (a) *ty-fixnum*)
(def-ti-rule (< > <= >= = /= eq eql equal not null consp atom listp symbolp functionp characterp zerop
              plusp minusp evenp oddp integerp floatp realp numberp rationalp stringp simple-string-p
              vectorp simple-vector-p arrayp keywordp char= char< char> char<= char>= char/=
              char-equal string= clysm-sys::fixnump clysm-sys::%bignump clysm-sys::%ratiop
              clysm-sys::%single-float-p clysm-sys::%double-float-p clysm-sys::%complexp
              clysm-sys::%simple-string-p clysm-sys::%simple-vector-p clysm-sys::%instancep
              boundp fboundp clysm-sys::%fx< clysm-sys::%fx> clysm-sys::%fx<= clysm-sys::%fx>=
              clysm-sys::%fx= typep)
    (a) *ty-bool*)
(def-ti-rule (char-code clysm-sys::%char-code char-int) (a) (int-ty 0 (1- char-code-limit*)))
(def-ti-rule (code-char char schar clysm-sys::%schar char-upcase char-downcase) (a) (mkty +k-char+))
(def-ti-rule (length clysm-sys::%svlength clysm-sys::%string-length clysm-sys::%bytes-length
              clysm-sys::%bits-length clysm-sys::%f64vec-length array-total-size)
    (a) (int-ty 0 (1- +most-positive-fixnum+)))
(def-ti-rule cons (a) (mkty +k-cons+))
(def-ti-rule (clysm-sys::%make-limbs clysm-sys::%bignum-mag clysm-sys::%limbs-prefix) (a) (mkty +k-limbs+))
(def-ti-rule clysm-sys::%lref (a) *ty-fixnum*)
(def-ti-rule clysm-sys::%llen (a) (int-ty 0 (1- +most-positive-fixnum+)))
(def-ti-rule clysm-sys::%lset (a) (third a))

;;; After a call of these that returns, the argument is of that type (they
;;; signal an error otherwise): name -> list of (argument-index . type)
(defvar *ti-asserts* (make-hash-table :test 'eq))
(dolist (e (list (list '(clysm-sys::%lref clysm-sys::%lset clysm-sys::%llen) (mkty +k-limbs+))
                 (list '(car cdr first rest) (mkty +k-list+))
                 (list '(rplaca rplacd clysm-sys::%setcar clysm-sys::%setcdr) (mkty +k-cons+))
                 (list '(clysm-sys::%svref clysm-sys::%set-svref clysm-sys::%svlength) (mkty +k-svec+))))
  (dolist (name (first e)) (setf (gethash name *ti-asserts*) (list (cons 0 (second e))))))
(def-ti-rule (list list*) (a) (mkty +k-list+))
(def-ti-rule (make-string clysm-sys::%make-string string-upcase string-downcase) (a) (mkty +k-string+))
(def-ti-rule clysm-sys::%make-simple-vector (a) (mkty +k-svec+))
(def-ti-rule (sqrt) (a)
  (let ((x (first a)))
    (cond ((and (ty-double-p x) (ty-nonneg-p x)) (mkty +k-dpos+))
          ((ty-double-p x) (mkty (logior +k-dpos+ +k-complex+)))
          (t *ty-number*))))
(def-ti-rule (float) (a)
  (let ((x (first a)) (proto (second a)))
    (flet ((sign (bits) (if (and (logtest (ty-bits x) +k-real+) (ty-nonneg-p x)) (logandc2 bits +k-dneg+) bits)))
      (cond ((and proto (ty-double-p proto)) (mkty (sign +k-double+)))
            ((and (null proto) (ty-double-p x)) x)
            ((and (null proto) (ty-only-p x (logior +k-rational+ +k-single+))) (mkty +k-single+))
            (t (mkty (sign +k-float+)))))))
(def-ti-rule (abs) (a)
  (let ((x (first a)))
    (cond ((ty-double-p x) (mkty +k-dpos+))
          ((ty-only-p x +k-int+)
           (let ((lo (ty-lo x)) (hi (ty-hi x)))
             (int-ty (cond ((and lo (>= lo 0)) lo) ((and hi (<= hi 0)) (- hi)) (t 0))
                     (and lo hi (max (abs lo) (abs hi))))))
          (t (mkty +k-real+)))))
(def-ti-rule (sin cos tan) (a)
  (if (and (= (length a) 1) (ty-double-p (first a))) (mkty +k-double+) *ty-number*))
(def-ti-rule (exp) (a)
  (if (ty-double-p (first a)) (mkty +k-dpos+) *ty-number*))
(def-ti-rule (max min) (a)
  (if (and (= (length a) 2) (ty-only-p (first a) +k-int+) (ty-only-p (second a) +k-int+))
      (ty-union (first a) (second a))
      (if (every (lambda (x) (ty-double-p x)) a) (mkty +k-double+) (mkty +k-real+))))
(def-ti-rule (floor truncate ceiling round) (a)
  (let ((x (first a)) (d (second a)))
    (cond ((and (ty-only-p x +k-int+) (or (null d) (and (ty-only-p d +k-int+) (ty-lo d) (> (ty-lo d) 0))))
           (let ((dlo (if d (ty-lo d) 1)))
             (int-ty (and (ty-lo x) (if (>= (ty-lo x) 0) 0 (ty-lo x)))
                     (and (ty-hi x) (if (<= (ty-hi x) 0) 0 (ceiling (ty-hi x) dlo))))))
          (t (int-ty nil nil)))))
(def-ti-rule (mod) (a)
  (let ((x (first a)) (d (second a)))
    (cond ((and (ty-only-p x +k-int+) (ty-only-p d +k-int+) (ty-lo d) (ty-hi d) (> (ty-lo d) 0))
           (if (and (ty-lo x) (>= (ty-lo x) 0) (ty-hi x))
               (int-ty 0 (min (ty-hi x) (1- (ty-hi d))))
               (int-ty 0 (1- (ty-hi d)))))
          ((and (ty-only-p x +k-int+) (ty-only-p d +k-int+)) (int-ty nil nil))
          (t (mkty +k-real+)))))
(def-ti-rule (rem) (a)
  (let ((x (first a)) (d (second a)))
    (cond ((and (ty-only-p x +k-int+) (ty-only-p d +k-int+) (ty-lo d) (ty-hi d))
           (let ((m (1- (max (abs (ty-lo d)) (abs (ty-hi d))))))
             (int-ty (if (and (ty-lo x) (>= (ty-lo x) 0)) 0 (- m))
                     (if (and (ty-hi x) (<= (ty-hi x) 0)) 0 m))))
          ((and (ty-only-p x +k-int+) (ty-only-p d +k-int+)) (int-ty nil nil))
          (t (mkty +k-real+)))))
(def-ti-rule (integer-length) (a) (int-ty 0 nil))
(def-ti-rule (logcount) (a) (int-ty 0 nil))


;;; Tests: each rule returns a list of (argument-index true-type false-type);
;;; the argument (when it is a variable) is intersected with the type in that branch.
(defun ty-not (ty) (lambda (x) (ty-remove x (ty-bits ty))))

(defun cmp-refinements (op a b)
  "(OP A B) for OP in :lt :le :eq; returns refinements for A and B."
  (let* ((real (mkty +k-real+))
         (ai (ty-only-p (ty-intersect a real) +k-int+))
         (bi (ty-only-p (ty-intersect b real) +k-int+)))
    (flet ((upper (hi) (mkty +k-all+ nil hi))
           (lower (lo) (mkty +k-all+ lo nil))
           (r (x) (ty-intersect x real)))
      (ecase op
        (:lt (list (list 0 (r (if bi (ty-intersect real (upper (and (ty-hi b) (1- (ty-hi b))))) real))
                         (r (if bi (ty-intersect real (lower (ty-lo b))) real)))
                   (list 1 (r (if ai (ty-intersect real (lower (and (ty-lo a) (1+ (ty-lo a))))) real))
                         (r (if ai (ty-intersect real (upper (ty-hi a))) real)))))
        (:le (list (list 0 (r (if bi (ty-intersect real (upper (ty-hi b))) real))
                         (r (if bi (ty-intersect real (lower (and (ty-lo b) (1+ (ty-lo b))))) real)))
                   (list 1 (r (if ai (ty-intersect real (lower (ty-lo a))) real))
                         (r (if ai (ty-intersect real (upper (and (ty-hi a) (1- (ty-hi a))))) real)))))
        (:eq (let ((num *ty-number*))
               (list (list 0 (if bi (ty-union (ty-remove num +k-int+) (ty-intersect b (int-ty nil nil))) num) num)
                     (list 1 (if ai (ty-union (ty-remove num +k-int+) (ty-intersect a (int-ty nil nil))) num) num))))))))

(defun swap-refinements (refs)
  (mapcar (lambda (r) (list (- 1 (first r)) (second r) (third r))) refs))

(def-ti-test (< clysm-sys::%fx<) (a) (cmp-refinements :lt (first a) (second a)))
(def-ti-test (> clysm-sys::%fx>) (a) (swap-refinements (cmp-refinements :lt (second a) (first a))))
(def-ti-test (<= clysm-sys::%fx<=) (a) (cmp-refinements :le (first a) (second a)))
(def-ti-test (>= clysm-sys::%fx>=) (a) (swap-refinements (cmp-refinements :le (second a) (first a))))
(def-ti-test (= clysm-sys::%fx=) (a) (cmp-refinements :eq (first a) (second a)))
(def-ti-test zerop (a) (list (list 0 (ty-union (ty-remove *ty-number* +k-int+) (int-ty 0 0)) *ty-number*)))
(def-ti-test plusp (a) (list (list 0 (ty-remove (mkty +k-real+ 1 nil) +k-dneg+) (mkty +k-real+ nil 0))))
(def-ti-test minusp (a) (list (list 0 (ty-remove (mkty +k-real+ nil -1) +k-dpos+)
                                    (ty-remove (mkty +k-real+ 0 nil) +k-dneg+))))
(def-ti-test (evenp oddp) (a) (list (list 0 (int-ty nil nil) (int-ty nil nil))))
(def-ti-test clysm-sys::%structure-typep (a) nil)
(def-ti-test (null not) (a) (list (list 0 (mkty +k-null+) (ty-remove *ty-top* +k-null+))))
(macrolet ((pred (names mask &optional exact)
             `(def-ti-test ,names (a) (list (list 0 (mkty ,mask)
                                                  ,(if exact `(ty-remove *ty-top* ,mask) '*ty-top*))))))
  (pred consp +k-cons+ t)
  (pred listp +k-list+ t)
  (pred (symbolp) (logior +k-null+ +k-sym+) t)
  (pred (characterp) +k-char+ t)
  (pred (functionp) +k-func+ t)
  (pred (integerp) +k-int+ t)
  (pred (rationalp) +k-rational+ t)
  (pred (floatp) +k-float+ t)
  (pred (realp) +k-real+ t)
  (pred (numberp) +k-number+ t)
  (pred (clysm-sys::%double-float-p) +k-double+ t)
  (pred (clysm-sys::%single-float-p) +k-single+ t)
  (pred (clysm-sys::%ratiop) +k-ratio+ t)
  (pred (clysm-sys::%complexp) +k-complex+ t)
  (pred (clysm-sys::%simple-string-p) +k-string+ t)
  (pred (clysm-sys::%simple-vector-p) +k-svec+ t)
  (pred (clysm-sys::%bignump) +k-int+))
(def-ti-test atom (a) (list (list 0 (ty-remove *ty-top* +k-cons+) (mkty +k-cons+))))
(def-ti-test clysm-sys::fixnump (a) (list (list 0 *ty-fixnum* *ty-top*)))

;;; ------------------------------------------------------------
;;; Abstract interpretation
;;; ------------------------------------------------------------

(defvar *node-types* (make-hash-table :test 'eq) "node -> type (union over all visits)")
(defvar *ti-lam* nil "the lambda being analyzed")
(defvar *ti-slots* nil "lvar -> index into the environment vector")
(defvar *ti-nslots* 0)
(defvar *env* nil "vector of types indexed by slot, or :BOTTOM when unreachable")
(defvar *ti-regions* nil "active regions collecting assigned types: vectors of types")
(defvar *ti-exits* nil "blk/tb -> exit record")
(defvar *ti-uwps* nil "active unwind-protect cleanups: (depth . assigned-lvars)")
(defvar *ti-depth* 0)
(defvar *ti-analyzed* (make-hash-table :test 'eq))
(defvar *ti-let-vars* nil)

(defstruct texit (env :bottom) (ty *ty-bottom*) depth (tags nil))

(defun node-ty (node)
  (or (gethash node *node-types*) *ty-top*))

(defun note-ty (node ty)
  (let ((old (gethash node *node-types*)))
    (setf (gethash node *node-types*) (if old (ty-union old ty) ty))))

(defun env-copy (env) (if (eq env :bottom) :bottom (copy-seq env)))
(defun env-join (a b)
  (cond ((eq a :bottom) (env-copy b))
        ((eq b :bottom) (env-copy a))
        (t (let ((r (make-array (length a))))
             (dotimes (i (length a) r) (setf (svref r i) (ty-union (svref a i) (svref b i))))))))
(defun env-equal (a b)
  (cond ((eq a :bottom) (eq b :bottom))
        ((eq b :bottom) nil)
        (t (every #'ty-equal a b))))

(defparameter *widen-lo* (list 0 -1 +most-negative-fixnum+ (- (expt 2 31)) (- (expt 2 63))))
(defparameter *widen-hi* (list 0 +most-positive-fixnum+ (1- (expt 2 31)) (1- (expt 2 63))))

(defun widen-ty (old new)
  (let ((u (ty-union old new)))
    (if (and (ty-int-p u) (ty-int-p old))
        (mkty (ty-bits u)
              (let ((l (ty-lo u)))
                (if (or (null l) (and (ty-lo old) (>= l (ty-lo old)))) l
                    (find-if (lambda (x) (<= x l)) *widen-lo*)))
              (let ((h (ty-hi u)))
                (if (or (null h) (and (ty-hi old) (<= h (ty-hi old)))) h
                    (find-if (lambda (x) (>= x h)) *widen-hi*))))
        u)))

(defun env-widen (old new)
  (cond ((eq old :bottom) (env-copy new))
        ((eq new :bottom) (env-copy old))
        (t (let ((r (make-array (length old))))
             (dotimes (i (length old) r) (setf (svref r i) (widen-ty (svref old i) (svref new i))))))))

(defun ti-slot (lv) (gethash lv *ti-slots*))

(defun lvar-static-ty (lv)
  (if (or (lvar-special lv) (boxed-p lv)) *ty-top* (or (lvar-type lv) *ty-top*)))

(defun note-lvar-ty (lv ty)
  (setf (lvar-type lv) (if (lvar-type lv) (ty-union (lvar-type lv) ty) ty)))

(defun ti-bind (lv ty)
  (unless (lvar-special lv)
    (note-lvar-ty lv ty)
    (let ((k (ti-slot lv)))
      (when (and k (not (eq *env* :bottom)))
        (setf (svref *env* k) ty)))))

(defun ti-assign (lv ty)
  (note-lvar-ty lv ty)
  (let ((k (ti-slot lv)))
    (when k
      (dolist (r *ti-regions*) (setf (svref r k) (ty-union (svref r k) ty)))
      (unless (eq *env* :bottom) (setf (svref *env* k) ty)))))

(defun new-region () (make-array *ti-nslots* :initial-element *ty-bottom*))
(defun region-env (entry region)
  "ENTRY with every variable widened by the values assigned in REGION."
  (if (eq entry :bottom) :bottom
      (let ((r (make-array (length entry))))
        (dotimes (i (length entry) r) (setf (svref r i) (ty-union (svref entry i) (svref region i)))))))

;;; slots: the variables bound by the lambda itself (not inside nested lambdas)
(defun ti-collect (node)
  (labels ((add (lv)
             (when (and (not (lvar-special lv)) (not (boxed-p lv)) (not (ti-slot lv)))
               (setf (gethash lv *ti-slots*) *ti-nslots*)
               (incf *ti-nslots*)))
           (walk (n)
             (when (consp n)
               (case (car n)
                 (:let (dolist (b (second n)) (add (car b)) (push (car b) *ti-let-vars*) (walk (cdr b)))
                  (walk (third n)))
                 (:mvbind (mapc #'add (second n)) (walk (third n)) (walk (fourth n)))
                 (t (map-subnodes #'walk n))))))
    (walk node)))

(defun map-subnodes (fn node)
  "Call FN on the subnodes of NODE evaluated in the same function."
  (case (car node)
    ((:const :lref :sref :fref :symtab :lambda :go) nil)
    ((:lset :sset) (funcall fn (third node)))
    ((:if :progn :values) (mapc fn (cdr node)))
    (:let (dolist (b (second node)) (funcall fn (cdr b))) (funcall fn (third node)))
    (:mvbind (funcall fn (third node)) (funcall fn (fourth node)))
    ((:call :lcall :prim) (mapc fn (cddr node)))
    ((:funcall :mvcall :apply) (mapc fn (cdr node)))
    ((:flet :labels) (funcall fn (third node)))
    (:block (funcall fn (third node)))
    (:return-from (funcall fn (third node)))
    (:tagbody (dolist (s (third node)) (mapc fn (cdr s))))
    ((:catch :throw :unwind-protect :mvprog1) (funcall fn (second node)) (funcall fn (third node)))
    (:the (funcall fn (third node)))
    (:ltv (funcall fn (second node)))
    (:progv (mapc fn (cdr node)))
    ((:wasm :wasm-test) (mapc fn (if (eq (car node) :wasm) (third node) (second node))))
    (:defun (funcall fn (third node)))
    (t nil)))

(defun assigned-lvars (node)
  (let ((r nil))
    (labels ((walk (n)
               (when (consp n)
                 (when (eq (car n) :lset) (pushnew (second n) r))
                 (map-subnodes #'walk n))))
      (walk node))
    r))

(defun infer-lam (lam &optional param-types)
  "Analyze LAM's body (once).  PARAM-TYPES: the types of the required parameters."
  (unless (gethash lam *ti-analyzed*)
    (setf (gethash lam *ti-analyzed*) t)
    (let ((*ti-lam* lam) (*ti-slots* (make-hash-table :test 'eq)) (*ti-nslots* 0) (*ti-let-vars* nil)
          (*ti-regions* nil) (*ti-exits* (make-hash-table :test 'eq)) (*ti-uwps* nil) (*ti-depth* 0))
      (let ((params (append (lam-req lam)
                            (loop for (lv nil sv) in (lam-opt lam) collect lv when sv collect sv)
                            (when (lam-rest lam) (list (lam-rest lam)))
                            (loop for (nil lv nil sv) in (lam-keys lam) collect lv when sv collect sv))))
        (dolist (lv params)
          (when (and (not (lvar-special lv)) (not (boxed-p lv)))
            (setf (gethash lv *ti-slots*) *ti-nslots*) (incf *ti-nslots*)))
        (ti-collect (lam-body lam))
        (let ((*env* (make-array *ti-nslots* :initial-element *ty-top*)))
          (loop for lv in params for i from 0
                do (let ((ty (if (< i (length param-types)) (nth i param-types) *ty-top*)))
                     (note-lvar-ty lv ty)
                     (let ((k (ti-slot lv))) (when k (setf (svref *env* k) ty)))))
          (ti (lam-body lam)))
        (dolist (lv (lam-req lam)) (setf (lvar-rep lv) (choose-rep lv)))
        (dolist (lv *ti-let-vars*) (setf (lvar-rep lv) (choose-rep lv)))))))

(defun choose-rep (lv)
  (let ((ty (lvar-type lv)))
    (cond ((or (null ty) (ty-bottom-p ty) (lvar-special lv) (boxed-p lv)) nil)
          ((ty-double-p ty) :f64)
          ((ty-int32-p ty) :i32)
          ((ty-int64-p ty) :i64)
          (t nil))))

(defun ti (node)
  (if (eq *env* :bottom)
      *ty-bottom*
      (let ((ty (ti-1 node)))
        (note-ty node ty)
        ty)))

(defun ti-args (nodes) (mapcar #'ti nodes))

(defun ti-1 (node)
  (case (car node)
    (:const (const-ty (second node)))
    (:lref (let ((lv (second node)))
             (let ((k (ti-slot lv)))
               (if k (svref *env* k) (lvar-static-ty lv)))))
    (:lset (let ((ty (ti (third node)))) (ti-assign (second node) ty) ty))
    (:sref *ty-top*)
    (:sset (ti (third node)))
    (:if (multiple-value-bind (et ef) (ti-cond (second node))
           (setf *env* et)
           (let* ((ta (ti (third node))) (ea *env*))
             (setf *env* ef)
             (let ((tb (ti (fourth node))))
               (setf *env* (env-join ea *env*))
               (ty-union ta tb)))))
    (:progn (let ((ty (mkty +k-null+))) (dolist (n (cdr node) ty) (setf ty (ti n)))))
    (:let (let ((tys (loop for b in (second node) collect (ti (cdr b)))))
            (loop for b in (second node) for ty in tys do (ti-bind (car b) ty))
            (ti (third node))))
    (:mvbind (destructuring-bind (lvars vnode body) (cdr node)
               (let ((ty (ti vnode)) (mvs (mv-types vnode)))
                 (loop for lv in lvars for i from 0
                       do (ti-bind lv (cond ((and mvs (< i (length mvs))) (nth i mvs))
                                            (mvs (mkty +k-null+))
                                            ((= i 0) (ty-union ty (mkty +k-null+)))
                                            (t *ty-top*))))
                 (ti body))))
    (:lambda (mkty +k-func+))
    (:fref (mkty +k-func+))
    (:call (let ((tys (ti-args (cddr node))) (sym (second node)))
             (cond ((gethash sym *ti-noreturn*) (setf *env* :bottom) *ty-bottom*)
                   ((eq sym 'make-array) (make-array-ty (cddr node)))
                   ((gethash sym *ti-rules*)
                    (if (some #'ty-bottom-p tys) *ty-bottom* (funcall (gethash sym *ti-rules*) tys)))
                   (t (let ((lam (known-global-lam sym)))
                        (if lam (lam-return-ty lam) *ty-top*))))))
    (:prim (let ((tys (ti-args (cddr node))) (name (prim-name (second node))))
             ;; after a structure slot access, the object is of that structure class
             (when (member name '(clysm-sys::%struct-ref clysm-sys::%struct-set))
               (let ((x (third node)) (cls (struct-class-node-name (fourth node))))
                 (when (and cls (eq (car x) :lref) (ti-slot (second x)) (not (eq *env* :bottom)))
                   (setf *env* (refine-env *env* (ti-slot (second x)) (mkty +k-other+ nil nil cls))))))
             (let ((asserts (gethash name *ti-asserts*)))
               (when asserts
                 (loop for (i . ty) in asserts
                       do (let ((x (nth i (cddr node))))
                            (when (and x (eq (car x) :lref) (ti-slot (second x)) (not (eq *env* :bottom)))
                              (setf *env* (refine-env *env* (ti-slot (second x)) ty)))))))
             (cond ((eq (prim-kind (second node)) :test) *ty-bool*)
                   ((and (eq name 'clysm-sys::%make-instance) (struct-class-node-name (third node)))
                    (mkty +k-other+ nil nil (struct-class-node-name (third node))))
                   ((gethash name *ti-rules*)
                    (if (some #'ty-bottom-p tys) *ty-bottom* (funcall (gethash name *ti-rules*) tys)))
                   (t *ty-top*))))
    ((:funcall :mvcall :apply) (ti-args (cdr node)) *ty-top*)
    (:lcall (ti-args (cddr node)) *ty-top*)
    ((:flet :labels) (dolist (f (second node)) (note-lvar-ty (fun-lvar f) (mkty +k-func+)))
     (ti (third node)))
    (:block (ti-block node))
    (:return-from (destructuring-bind (blk value) (cdr node)
                    (let ((ty (ti value)))
                      (when (eq (blk-lam blk) *ti-lam*) (ti-exit blk ty nil))
                      (setf *env* :bottom)
                      *ty-bottom*)))
    (:tagbody (ti-tagbody node))
    (:go (destructuring-bind (tb idx) (cdr node)
           (when (eq (tb-lam tb) *ti-lam*) (ti-exit tb nil idx))
           (setf *env* :bottom)
           *ty-bottom*))
    (:catch (ti (second node))
     (let* ((entry (env-copy *env*)) (region (new-region))
            (*ti-depth* (1+ *ti-depth*)))
       (let ((*ti-regions* (cons region *ti-regions*))) (ti (third node)))
       (setf *env* (env-join *env* (region-env entry region)))
       *ty-top*))
    (:throw (ti (second node)) (ti (third node)) (setf *env* :bottom) *ty-bottom*)
    (:unwind-protect
     (let* ((entry (env-copy *env*)) (region (new-region))
            (ty (let ((*ti-regions* (cons region *ti-regions*))
                      (*ti-depth* (1+ *ti-depth*))
                      (*ti-uwps* (cons (cons (1+ *ti-depth*) (assigned-lvars (third node))) *ti-uwps*)))
                  (ti (second node)))))
       (let ((normal-bottom (eq *env* :bottom)))
         (setf *env* (env-join *env* (region-env entry region)))
         (ti (third node))
         (when normal-bottom (setf *env* :bottom))
         ty)))
    (:mvprog1 (let ((ty (ti (second node)))) (ti (third node)) ty))
    (:the (ty-intersect (ti (third node)) (declared-ty (second node))))
    (:ltv (ti (second node)))
    (:progv (ti (second node)) (ti (third node)) (ti (fourth node)))
    (:wasm (ti-args (third node))
     (ecase (second node)
       (:eqref *ty-top*)
       ((nil) (mkty +k-null+))
       (:i32 (mkty (logior +k-int+ +k-char+) +most-negative-fixnum+ +most-positive-fixnum+))
       (:bool *ty-bool*)))
    (:wasm-test (ti-args (second node)) *ty-bool*)
    (:symtab (mkty +k-cons+))
    (:defun (ti (third node)) (mkty +k-sym+))
    (:values (let ((tys (ti-args (cdr node)))) (if tys (first tys) (mkty +k-null+))))
    (t *ty-top*)))

(defun make-array-ty (args)
  "The type of (MAKE-ARRAY . ARGS): a simple vector or string when it is one
dimensional with no other options than the initial element or contents."
  (let ((dims (first args)) (keys (rest args)))
    (if (and (ty-only-p (node-ty dims) +k-int+) (evenp (length keys))
             (loop for (k v) on keys by #'cddr
                   always (and (eq (car k) :const)
                               (or (member (second k) '(:initial-element :initial-contents))
                                   (and (eq (second k) :element-type) (eq (car v) :const))))))
        (let ((et (loop for (k v) on keys by #'cddr
                        when (eq (second k) :element-type) return (list (second v)))))
          (cond ((or (null et) (eq (car et) t)) (mkty +k-svec+))
                ((member (car et) '(character base-char standard-char)) (mkty +k-string+))
                (t (mkty +k-other+))))
        (mkty (logior +k-svec+ +k-string+ +k-other+)))))

(defvar *ti-in-progress* nil "the lambdas being analyzed")

(defun lam-return-ty (lam)
  "The type of the values LAM returns (its body analyzed first if needed)."
  (cond ((or (eq lam *ti-lam*) (member lam *ti-in-progress*)) *ty-top*)
        (t (unless (gethash lam *ti-analyzed*)
             (let ((*ti-in-progress* (cons *ti-lam* *ti-in-progress*)))
               (inline-calls lam)
               (infer-lam lam)))
           (or (gethash (lam-body lam) *node-types*) *ty-top*))))

(defun mv-types (node)
  "Types of the values of NODE when known (a list), else NIL."
  (case (car node)
    (:values (mapcar #'node-ty (cdr node)))
    ((:call :prim)
     (let ((name (if (eq (car node) :call) (second node) (prim-name (second node)))))
       (when (member name '(floor truncate ceiling round))
         (let ((tys (mapcar #'node-ty (cddr node))))
           (when (and (every (lambda (x) (ty-only-p x +k-int+)) tys) (<= 1 (length tys) 2))
             (list (node-ty node)
                   (if (= (length tys) 1) (int-ty 0 0)
                       (let ((d (second tys)))
                         (if (and (ty-lo d) (ty-hi d))
                             (let ((m (max (abs (ty-lo d)) (abs (ty-hi d)))))
                               (if (and (eq name 'floor) (> (ty-lo d) 0)) (int-ty 0 (1- m)) (int-ty (- m) m)))
                             (int-ty nil nil))))))))))
    (t nil)))

(defun ti-exit (target ty idx)
  "Record the current environment as flowing to TARGET (a blk, or a tb with tag IDX)."
  (let ((rec (gethash target *ti-exits*)))
    (when rec
      (let ((env (env-copy *env*)))
        ;; unwind-protect cleanups between here and the target may assign variables
        (dolist (u *ti-uwps*)
          (when (> (car u) (texit-depth rec))
            (unless (eq env :bottom)
              (dolist (lv (cdr u))
                (let ((k (ti-slot lv))) (when k (setf (svref env k) *ty-top*)))))))
        (if idx
            (let ((cell (assoc idx (texit-tags rec))))
              (if cell
                  (setf (cdr cell) (env-join (cdr cell) env))
                  (push (cons idx env) (texit-tags rec))))
            (setf (texit-env rec) (env-join (texit-env rec) env)
                  (texit-ty rec) (ty-union (texit-ty rec) ty)))))))

(defun ti-block (node)
  (destructuring-bind (blk body) (cdr node)
    (let* ((rec (make-texit :depth *ti-depth*))
           (entry (env-copy *env*))
           (region (and (blk-nonlocal blk) (new-region))))
      (setf (gethash blk *ti-exits*) rec)
      (let ((ty (let ((*ti-regions* (if region (cons region *ti-regions*) *ti-regions*)))
                  (ti body))))
        (setf *env* (env-join *env* (texit-env rec)))
        (setf ty (ty-union ty (texit-ty rec)))
        (when region
          (setf *env* (env-join *env* (region-env entry region)) ty *ty-top*))
        ty))))

(defun ti-tagbody (node)
  (destructuring-bind (tb segments) (cdr node)
    (let* ((rec (make-texit :depth *ti-depth*))
           (entry (env-copy *env*))
           (region (and (tb-nonlocal tb) (new-region)))
           (heads (make-array (length segments) :initial-element :bottom)))
      (setf (gethash tb *ti-exits*) rec)
      (let ((*ti-regions* (if region (cons region *ti-regions*) *ti-regions*)))
        (loop for iter from 0
              do (let ((changed nil))
                   (setf *env* (env-copy entry))
                   (loop for (idx . forms) in segments for k from 0
                         do (when (> k 0)
                              (let* ((in (env-join *env* (or (cdr (assoc idx (texit-tags rec))) :bottom)))
                                     (in (if region (env-join in (region-env entry region)) in))
                                     (new (if (> iter 1) (env-widen (svref heads k) in) (env-join (svref heads k) in))))
                                (unless (env-equal new (svref heads k))
                                  (setf changed t (svref heads k) new))
                                (setf *env* (env-copy new))))
                            (dolist (f forms) (ti f)))
                   (when (not changed)
                     (when (> iter 1) (ti-tagbody-narrow node rec entry region heads))
                     (return))
                   (when (> iter 30)
                     ;; no fixed point: forget what is known about every variable in the loop
                     (dotimes (k (length heads))
                       (unless (eq (svref heads k) :bottom)
                         (setf (svref heads k) (make-array *ti-nslots* :initial-element *ty-top*))))
                     (setf *env* (env-copy entry))
                     (loop for (nil . forms) in segments for k from 0
                           do (when (> k 0)
                                (setf *env* (make-array *ti-nslots* :initial-element *ty-top*)))
                              (dolist (f forms) (ti f)))
                     (return)))))
      (mkty +k-null+))))

(defun clear-node-types (node)
  (when (consp node)
    (remhash node *node-types*)
    (map-subnodes #'clear-node-types node)))

(defun ti-tagbody-narrow (node rec entry region heads)
  "HEADS is a fixed point reached by widening.  Recompute the loop heads once
from it (still a fixed point, and narrower), then analyze the body again
with them, replacing the node types of the widened iterations."
  (let* ((segments (third node)) (n (length segments))
         (new (make-array n :initial-element :bottom)))
    (setf (texit-tags rec) nil)
    (setf *env* (env-copy entry))
    (loop for (nil . forms) in segments for k from 0
          do (when (> k 0)
               (setf (svref new k) (env-copy *env*))
               (setf *env* (env-copy (svref heads k))))
             (dolist (f forms) (ti f)))
    (loop for (idx) in segments for k from 0
          when (> k 0)
            do (let ((in (env-join (svref new k) (or (cdr (assoc idx (texit-tags rec))) :bottom))))
                 (setf (svref new k) (if region (env-join in (region-env entry region)) in))))
    (dolist (s segments) (mapc #'clear-node-types (cdr s)))
    (setf (texit-tags rec) nil)
    (setf *env* (env-copy entry))
    (loop for (nil . forms) in segments for k from 0
          do (when (> k 0) (setf *env* (env-copy (svref new k))))
             (dolist (f forms) (ti f)))))

(defun ti-cond (node)
  "Analyze NODE as a test; returns the environments when it is true and false."
  (if (eq *env* :bottom)
      (values :bottom :bottom)
      (case (car node)
        (:const (if (second node) (values (env-copy *env*) :bottom) (values :bottom (env-copy *env*))))
        (:if (destructuring-bind (c a b) (cdr node)
               (multiple-value-bind (ct cf) (ti-cond c)
                 (setf *env* ct)
                 (multiple-value-bind (at af) (ti-cond a)
                   (setf *env* cf)
                   (multiple-value-bind (bt bf) (ti-cond b)
                     (setf *env* :bottom)
                     (values (env-join at bt) (env-join af bf)))))))
        (:progn (if (cdr node)
                    (progn (dolist (n (butlast (cdr node))) (ti n))
                           (ti-cond (car (last node))))
                    (values :bottom (env-copy *env*))))
        (:let
         ;; (or a b) is (let ((g a)) (if g g b))
         (let ((b (second node)) (body (third node)))
           (if (and (= (length b) 1) (eq (car body) :if)
                    (equal (second body) `(:lref ,(car (first b))))
                    (equal (third body) `(:lref ,(car (first b)))))
               (progn
                 (ti-bind (car (first b)) *ty-top*)
                 (multiple-value-bind (at af) (ti-cond (cdr (first b)))
                   (setf *env* af)
                   (multiple-value-bind (bt bf) (ti-cond (fourth body))
                     (setf *env* :bottom)
                     (note-ty (third body) *ty-top*) (note-ty (second body) *ty-top*)
                     (values (env-join at bt) bf))))
               (let ((ty (ti node))) (declare (ignore ty)) (values (env-copy *env*) (env-copy *env*))))))
        (:lref (let ((ty (ti node)) (k (ti-slot (second node))))
                 (declare (ignore ty))
                 (if k
                     (values (refine-env *env* k (ty-remove *ty-top* +k-null+))
                             (refine-env *env* k (mkty +k-null+)))
                     (values (env-copy *env*) (env-copy *env*)))))
        ((:prim :call)
         (let* ((name (if (eq (car node) :prim) (prim-name (second node)) (second node)))
                (rule (and (symbolp name) (gethash name *ti-test-rules*)))
                (args (cddr node)))
           (if (null rule)
               (progn (ti node) (values (env-copy *env*) (env-copy *env*)))
               (let ((tys (ti-args args)))
                 (note-ty node *ty-bool*)
                 (if (eq *env* :bottom)
                     (values :bottom :bottom)
                     (let ((et (env-copy *env*)) (ef (env-copy *env*)))
                       (when (and (member name '(eq eql)) (= (length args) 2))
                         ;; (eq x 'const)
                         (loop for i from 0 for a in args for other in (reverse args)
                               do (when (and (eq (car a) :lref) (ti-slot (second a)) (eq (car other) :const))
                                    (setf et (refine-env et (ti-slot (second a)) (const-ty (second other))))
                                    (when (null (second other))
                                      (setf ef (refine-env ef (ti-slot (second a)) (ty-remove *ty-top* +k-null+)))))))
                       (when (and (eq name 'clysm-sys::%structure-typep) (eq (car (first args)) :lref)
                                  (ti-slot (second (first args))) (struct-class-node-name (second args)))
                         (setf et (refine-env et (ti-slot (second (first args)))
                                              (mkty +k-other+ nil nil (struct-class-node-name (second args))))))
                       (dolist (r (funcall rule tys))
                         (let ((a (nth (first r) args)))
                           (when (and a (eq (car a) :lref) (ti-slot (second a)))
                             (let ((k (ti-slot (second a))))
                               (setf et (refine-env et k (second r))
                                     ef (refine-env ef k (third r)))))))
                       (values et ef)))))))
        (t (ti node) (values (env-copy *env*) (env-copy *env*))))))

(defun struct-class-node-name (node)
  "NODE is (LOAD-TIME-VALUE (FIND-CLASS 'NAME)): NAME."
  (and (eq (car node) :ltv)
       (let ((f (second node)))
         (and (eq (car f) :call) (eq (second f) 'find-class) (= (length f) 3)
              (eq (car (third f)) :const) (symbolp (second (third f)))
              (second (third f))))))

(defun refine-env (env k ty)
  (if (eq env :bottom) :bottom
      (let ((new (ty-intersect (svref env k) ty)))
        (if (ty-bottom-p new)
            :bottom
            (let ((e (copy-seq env))) (setf (svref e k) new) e)))))
